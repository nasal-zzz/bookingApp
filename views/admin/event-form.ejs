<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= event ? 'Edit Event' : 'New Event' %> — Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:#0B0B0F;color:#FFFFFF;font-family:'Outfit',sans-serif;min-height:100vh;}
    /* Admin layout */
    :root{--bg:#0B0B0F;--surface:#14141C;--card:#14141C;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--accent-dim:rgba(106,13,173,0.15);--text:#FFFFFF;--muted:#B3B3B3;--error:#FF4444;--success:#00FF88;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;z-index:10;overflow-y:auto;}
    .s-logo{display:block;padding:0 0.5rem 1rem;border-bottom:1px solid var(--border);margin-bottom:0.5rem;}
    .s-section{font-family:'Space Mono',monospace;font-size:0.48rem;letter-spacing:2px;color:rgba(255,255,255,0.3);text-transform:uppercase;padding:0.6rem 0.8rem 0.2rem;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.65rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(106,13,173,0.07);border-color:rgba(106,13,173,0.15);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.65rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,92,92,0.08);border-color:rgba(255,92,92,0.2);}
    .main{padding:2rem;overflow-x:hidden;position:relative;z-index:1;}
    .container{max-width:900px;}
    .page-title{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;color:#fff;margin-bottom:0.4rem;}
    .page-sub{color:#B3B3B3;font-size:0.88rem;margin-bottom:2.5rem;}

    /* Section cards */
    .section{background:#14141C;border:1px solid rgba(255,255,255,0.08);border-radius:12px;overflow:hidden;margin-bottom:1.5rem;}
    .section-head{padding:1rem 1.5rem;border-bottom:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;gap:0.8rem;}
    .section-num{width:28px;height:28px;border-radius:50%;background:#6A0DAD;color:#fff;font-family:'Anton',sans-serif;font-size:0.8rem;display:flex;align-items:center;justify-content:center;}
    .section-title{font-weight:700;font-size:1rem;color:#fff;}
    .section-body{padding:1.5rem;}

    /* Fields */
    .field-row{display:grid;gap:1rem;margin-bottom:1rem;}
    .field-row.cols-2{grid-template-columns:1fr 1fr;}
    .field-row.cols-3{grid-template-columns:1fr 1fr 1fr;}
    .field-group{display:flex;flex-direction:column;gap:0.4rem;}
    .field-label{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#B3B3B3;text-transform:uppercase;}
    .field-input{background:#0B0B0F;border:1.5px solid rgba(255,255,255,0.08);border-radius:8px;color:#FFFFFF;font-size:0.92rem;padding:0.75rem 1rem;font-family:'Outfit',sans-serif;outline:none;transition:border-color 0.2s;width:100%;}
    .field-input:focus{border-color:#6A0DAD;}
    textarea.field-input{resize:vertical;min-height:90px;}
    select.field-input{cursor:pointer;}
    .field-input.is-invalid{border-color:#FF4444 !important;background:rgba(255,68,68,0.04);}
    .field-input.is-valid{border-color:#00FF88 !important;}
    .field-error{font-size:0.72rem;color:#FF4444;margin-top:0.3rem;display:none;font-family:'Space Mono',monospace;}
    .field-error.show{display:block;}

    /* Banner upload areas */
    .banner-upload{border:2px dashed rgba(255,255,255,0.12);border-radius:10px;padding:1.5rem;text-align:center;cursor:pointer;transition:border-color 0.2s;position:relative;background:#0B0B0F;}
    .banner-upload:hover{border-color:#6A0DAD;}
    .banner-upload input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
    .banner-upload i{font-size:2rem;color:#B3B3B3;display:block;margin-bottom:0.5rem;}
    .banner-upload .up-label{font-size:0.85rem;color:#B3B3B3;}
    .banner-upload .up-sub{font-size:0.72rem;color:rgba(255,255,255,0.3);margin-top:0.2rem;}
    .banner-preview{width:100%;max-height:160px;object-fit:cover;border-radius:8px;display:none;margin-top:0.8rem;}
    .banner-change-btn{margin-top:0.5rem;display:none;padding:0.3rem 0.8rem;background:rgba(106,13,173,0.15);border:1px solid rgba(106,13,173,0.35);border-radius:5px;color:#9D4EDD;font-size:0.72rem;cursor:pointer;font-family:inherit;}
    /* Crop Modal */
    #cropModal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:2000;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(8px);}
    #cropModal.open{display:flex;}
    .crop-modal-box{background:#14141C;border:1px solid rgba(255,255,255,0.09);border-radius:14px;width:100%;max-width:560px;overflow:hidden;}
    .crop-modal-top{height:3px;background:linear-gradient(90deg,#6A0DAD,#9D4EDD,#6A0DAD);}
    .crop-modal-head{padding:1rem 1.2rem 0.6rem;display:flex;align-items:center;justify-content:space-between;}
    .crop-modal-head h3{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:2px;color:#fff;}
    .crop-modal-head button{background:none;border:none;color:#555;font-size:1.3rem;cursor:pointer;line-height:1;}
    .crop-area-wrap{position:relative;margin:0 1.2rem;background:#08080e;border-radius:8px;overflow:hidden;touch-action:none;border:1px solid rgba(255,255,255,0.07);cursor:grab;}
    .crop-area-wrap.landscape{aspect-ratio:16/6;max-height:280px;}
    .crop-area-wrap.portrait{aspect-ratio:3/4;max-height:420px;}
    #cropPreviewImg{position:absolute;top:50%;left:50%;transform-origin:center center;transform:translate(-50%,-50%) scale(1);cursor:grab;user-select:none;max-width:none;pointer-events:none;}
    #cropCanvas{display:block;width:100%;height:100%;}
    .crop-dashed{position:absolute;inset:0;border:2px dashed rgba(106,13,173,0.5);border-radius:8px;pointer-events:none;}
    .crop-ctrls{padding:0.9rem 1.2rem;display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap;}
    .crop-ctrls label{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;color:#555;text-transform:uppercase;}
    .crop-ctrls input[type=range]{flex:1;min-width:80px;accent-color:#6A0DAD;}
    .crop-footer{padding:0.8rem 1.2rem 1.2rem;display:flex;gap:0.7rem;}
    .crop-cancel-btn{flex:1;padding:0.7rem;background:transparent;border:1px solid rgba(255,255,255,0.1);border-radius:7px;color:#888;font-family:inherit;font-size:0.85rem;cursor:pointer;}
    .crop-save-btn{flex:2;padding:0.7rem;background:#6A0DAD;border:none;border-radius:7px;color:#fff;font-family:inherit;font-weight:700;font-size:0.85rem;cursor:pointer;letter-spacing:1px;}
    .size-warn{font-size:0.7rem;color:#FF4444;display:none;padding:0 1.2rem 0.5rem;}
    /* Artist crop modal — circular */
    #artistCropModal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:2000;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(8px);}
    #artistCropModal.open{display:flex;}
    .ac-box{background:#14141C;border:1px solid rgba(255,255,255,0.09);border-radius:14px;width:100%;max-width:400px;overflow:hidden;}
    .ac-top{height:3px;background:linear-gradient(90deg,#6A0DAD,#9D4EDD,#6A0DAD);}
    .ac-head{padding:1rem 1.2rem 0.6rem;display:flex;align-items:center;justify-content:space-between;}
    .ac-head h3{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:2px;color:#fff;}
    .ac-area{margin:0 1.2rem;position:relative;width:220px;height:220px;border-radius:50%;overflow:hidden;border:2px solid rgba(106,13,173,0.5);background:#08080e;touch-action:none;margin-left:auto;margin-right:auto;}
    #acCanvas{display:block;width:100%;height:100%;}
    .ac-ctrls{padding:0.9rem 1.2rem;display:flex;align-items:center;gap:0.8rem;}
    .ac-ctrls label{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;color:#555;}
    .ac-ctrls input[type=range]{flex:1;accent-color:#6A0DAD;}
    .ac-footer{padding:0.8rem 1.2rem 1.2rem;display:flex;gap:0.7rem;}

    /* Artists */
    .artist-list{display:flex;flex-direction:column;gap:0.8rem;}
    .artist-row{background:#0B0B0F;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:1rem;display:grid;grid-template-columns:80px 1fr 1fr auto;gap:1rem;align-items:center;}
    .artist-photo-wrap{position:relative;width:80px;height:80px;}
    .artist-photo-wrap input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
    .artist-photo-box{width:80px;height:80px;border-radius:50%;background:#14141C;border:2px dashed rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;font-size:1.5rem;overflow:hidden;cursor:pointer;}
    .artist-photo-box img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:none;}
    .btn-add{display:flex;align-items:center;gap:0.5rem;padding:0.65rem 1.2rem;background:rgba(106,13,173,0.12);border:1px solid rgba(106,13,173,0.3);border-radius:8px;color:#9D4EDD;font-size:0.85rem;font-weight:600;cursor:pointer;transition:all 0.2s;font-family:'Outfit',sans-serif;}
    .btn-add:hover{background:rgba(106,13,173,0.2);}
    .btn-remove{background:rgba(255,68,68,0.1);border:1px solid rgba(255,68,68,0.2);border-radius:6px;padding:0.4rem 0.6rem;color:#FF4444;cursor:pointer;font-size:0.85rem;transition:all 0.2s;}
    .btn-remove:hover{background:rgba(255,68,68,0.2);}

    /* Ticket categories */
    .ticket-categories{display:flex;flex-direction:column;gap:1rem;}
    .ticket-cat{border-radius:12px;overflow:hidden;border:1.5px solid rgba(255,255,255,0.08);}
    .ticket-cat-head{padding:0.9rem 1.2rem;display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none;}
    .ticket-cat-head:hover{background:rgba(255,255,255,0.03);}
    .cat-badge{font-family:'Space Mono',monospace;font-size:0.62rem;letter-spacing:2px;padding:0.2rem 0.7rem;border-radius:10px;font-weight:700;}
    .cat-platinum .ticket-cat-head{background:rgba(157,78,221,0.08);}
    .cat-platinum .cat-badge{background:rgba(157,78,221,0.2);color:#9D4EDD;border:1px solid rgba(157,78,221,0.3);}
    .cat-gold .ticket-cat-head{background:rgba(245,200,66,0.08);}
    .cat-gold .cat-badge{background:rgba(245,200,66,0.2);color:#f5c842;border:1px solid rgba(245,200,66,0.3);}
    .cat-silver .ticket-cat-head{background:rgba(192,200,216,0.08);}
    .cat-silver .cat-badge{background:rgba(192,200,216,0.15);color:#c0c8d8;border:1px solid rgba(192,200,216,0.3);}
    .cat-fanfit .ticket-cat-head{background:rgba(0,255,136,0.06);}
    .cat-fanfit .cat-badge{background:rgba(0,255,136,0.15);color:#00FF88;border:1px solid rgba(0,255,136,0.3);}
    .cat-family .ticket-cat-head{background:rgba(255,107,107,0.08);}
    .cat-family .cat-badge{background:rgba(255,107,107,0.15);color:#FF6B6B;border:1px solid rgba(255,107,107,0.3);}
    .ticket-cat-body{padding:1.2rem;background:#0B0B0F;display:none;}
    .ticket-cat-body.open{display:block;}
    .cat-enabled-toggle{display:flex;align-items:center;gap:0.6rem;cursor:pointer;}
    .toggle-sw{width:38px;height:20px;background:rgba(255,255,255,0.1);border-radius:10px;position:relative;transition:background 0.2s;}
    .toggle-sw.on{background:#6A0DAD;}
    .toggle-sw::after{content:'';position:absolute;top:3px;left:3px;width:14px;height:14px;border-radius:50%;background:#fff;transition:left 0.2s;}
    .toggle-sw.on::after{left:21px;}
    .combo-note{background:rgba(255,107,107,0.08);border:1px solid rgba(255,107,107,0.2);border-radius:8px;padding:0.8rem 1rem;font-size:0.82rem;color:#FF6B6B;margin-bottom:1rem;}

    /* Save button */
    .save-bar{background:#14141C;border-top:1px solid rgba(255,255,255,0.08);padding:1.5rem;display:flex;align-items:center;justify-content:flex-end;gap:1rem;position:sticky;bottom:0;z-index:50;}
    .btn-save{padding:0.9rem 2.5rem;background:#6A0DAD;color:#fff;border:none;border-radius:8px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;cursor:pointer;letter-spacing:1px;transition:box-shadow 0.2s,transform 0.15s;}
    .btn-save:hover{box-shadow:0 0 30px rgba(106,13,173,0.5);transform:translateY(-1px);}
    .btn-cancel{padding:0.9rem 1.5rem;background:transparent;color:#B3B3B3;border:1px solid rgba(255,255,255,0.12);border-radius:8px;text-decoration:none;font-size:0.9rem;font-family:'Outfit',sans-serif;}
    /* Toast notifications */
    #toast-container{position:fixed;top:1.2rem;right:1.2rem;z-index:9999;display:flex;flex-direction:column;gap:0.6rem;pointer-events:none;max-width:340px;}
    .ef-toast{pointer-events:all;background:rgba(20,20,28,0.97);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:0.85rem 1rem;display:flex;align-items:center;gap:0.7rem;box-shadow:0 20px 60px rgba(0,0,0,0.5);animation:efToastIn 0.3s ease both;font-size:0.88rem;}
    .ef-toast.ok {border-left:3px solid #00FF88;color:#00FF88;}
    .ef-toast.err{border-left:3px solid #FF4444;color:#FF4444;}
    .ef-toast.warn{border-left:3px solid #f5c842;color:#f5c842;}
    @keyframes efToastIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
    @keyframes efToastOut{from{opacity:1;transform:translateX(0)}to{opacity:0;transform:translateX(20px)}}

    .btn-back-dash{display:inline-flex;align-items:center;gap:0.3rem;color:var(--muted);text-decoration:none;font-size:0.78rem;font-family:'Space Mono',monospace;letter-spacing:1px;padding:0.35rem 0.75rem;border:1px solid var(--border);border-radius:5px;background:rgba(255,255,255,0.03);margin-bottom:1.5rem;transition:all 0.15s;}
    .btn-back-dash:hover{color:#fff;border-color:rgba(255,255,255,0.2);}
    @media(max-width:900px){.admin-layout{grid-template-columns:1fr;}.sidebar{display:none;}}
    @media(max-width:640px){.field-row.cols-2,.field-row.cols-3{grid-template-columns:1fr;}.artist-row{grid-template-columns:60px 1fr;grid-template-rows:auto auto;}}
  </style>
</head>
<body>
<div id="toast-container"></div>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { activePage: 'new-event', isSuperAdmin: locals.isSuperAdmin }) %>
  <%- include('../partials/admin-confirm') %>
  
  <main class="main">
  <div class="container">
    <a href="/admin" class="btn-back-dash"><i class="bi bi-arrow-left-short"></i> Dashboard</a>
    <div class="page-title"><%= event ? 'EDIT EVENT' : 'NEW EVENT' %></div>
    <div class="page-sub"><%= event ? 'Update event details below' : 'Fill in the details to create a new event' %></div>

  <form id="eventForm" method="POST" action="<%= event ? '/admin/events/' + event._id : '/admin/events' %>" onsubmit="return prepareSubmit()">

    <!-- ① BASIC INFO -->
    <div class="section">
      <div class="section-head"><div class="section-num">1</div><div class="section-title">Basic Information</div></div>
      <div class="section-body">
        <div class="field-row">
          <div class="field-group">
            <label class="field-label">Event Name *</label>
            <input class="field-input" name="name" required placeholder="e.g. MELATTUR PATTU NIGHT" value="<%= event ? event.name : '' %>"/>
          </div>
        </div>
        <div class="field-row">
          <div class="field-group">
            <label class="field-label">Short Description</label>
            <input class="field-input" name="shortDescription" placeholder="One line teaser..." value="<%= event ? event.shortDescription : '' %>"/>
          </div>
        </div>
        <div class="field-row">
          <div class="field-group">
            <label class="field-label">About the Event</label>
            <textarea class="field-input" name="about" placeholder="Full event description..."><%= event ? event.about : '' %></textarea>
          </div>
        </div>
        <div class="field-row cols-2">
          <div class="field-group">
            <label class="field-label">Convenience Fee (₹)</label>
            <input class="field-input" type="number" name="convenienceFee" value="<%= event ? event.convenienceFee : 0 %>"/>
          </div>
        </div>
      </div>
    </div>

    <!-- ② BANNERS -->
    <div class="section">
      <div class="section-head"><div class="section-num">2</div><div class="section-title">Banners & Media</div></div>
      <div class="section-body">
        <div class="field-row cols-3">
          <div class="field-group">
            <label class="field-label">Landing Page Banner (Desktop)</label>
            <div class="banner-upload" id="wrap-bannerDesktop">
              <input type="file" accept="image/*" id="file-bannerDesktop" onchange="previewBanner(this,'bannerDesktop')" style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;"/>
              <i class="bi bi-image"></i>
              <div class="up-label">Click to upload · max 10 MB</div>
              <div class="up-sub">1920×600 recommended · auto-cropped</div>
              <img id="prev-bannerDesktop" class="banner-preview" src="<%= event && event.bannerDesktop ? event.bannerDesktop : '' %>"/>
            </div>
            <input type="hidden" name="bannerDesktop" id="bannerDesktop" value="<%= event ? event.bannerDesktop : '' %>"/>
          </div>
          <div class="field-group">
            <label class="field-label">Landing Page Banner (Mobile)</label>
            <div class="banner-upload" id="wrap-bannerMobile">
              <input type="file" accept="image/*" id="file-bannerMobile" onchange="previewBanner(this,'bannerMobile')" style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;"/>
              <i class="bi bi-phone"></i>
              <div class="up-label">Click to upload · max 10 MB</div>
              <div class="up-sub">800×600 recommended · auto-cropped</div>
              <img id="prev-bannerMobile" class="banner-preview" src="<%= event && event.bannerMobile ? event.bannerMobile : '' %>"/>
            </div>
            <input type="hidden" name="bannerMobile" id="bannerMobile" value="<%= event ? event.bannerMobile : '' %>"/>
          </div>
          <div class="field-group">
            <label class="field-label">Event Detail Page Banner</label>
            <div class="banner-upload" id="wrap-bannerDetail">
              <input type="file" accept="image/*" id="file-bannerDetail" onchange="previewBanner(this,'bannerDetail')" style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;"/>
              <i class="bi bi-card-image"></i>
              <div class="up-label">Click to upload · max 10 MB</div>
              <div class="up-sub">1200×400 recommended · auto-cropped</div>
              <img id="prev-bannerDetail" class="banner-preview" src="<%= event && event.bannerDetail ? event.bannerDetail : '' %>"/>
            </div>
            <input type="hidden" name="bannerDetail" id="bannerDetail" value="<%= event ? event.bannerDetail : '' %>"/>
          </div>
        </div>
      </div>
    </div>

    <!-- ③ ARTISTS -->
    <div class="section">
      <div class="section-head"><div class="section-num">3</div><div class="section-title">Artists / Performers</div></div>
      <div class="section-body">
        <div class="artist-list" id="artistList"></div>
        <button type="button" class="btn-add" style="margin-top:1rem;" onclick="addArtist()">
          <i class="bi bi-plus-circle"></i> Add Artist
        </button>
        <input type="hidden" name="artistsJson" id="artistsJson" value="[]"/>
      </div>
    </div>

    <!-- ④ DATE & TIME -->
    <div class="section">
      <div class="section-head"><div class="section-num">4</div><div class="section-title">Date & Time</div></div>
      <div class="section-body">
        <div class="field-row cols-3">
          <div class="field-group">
            <label class="field-label">Event Date *</label>
            <input class="field-input" type="date" name="date" required value="<%= event ? new Date(event.date).toISOString().split('T')[0] : '' %>"/>
          </div>
          <div class="field-group">
            <label class="field-label">Doors Open</label>
            <input class="field-input" name="doorsOpen" placeholder="8:00 PM" value="<%= event ? event.doorsOpen : '8:00 PM' %>"/>
          </div>
          <div class="field-group">
            <label class="field-label">End Time</label>
            <input class="field-input" name="endTime" placeholder="4:00 AM" value="<%= event ? event.endTime : '4:00 AM' %>"/>
          </div>
        </div>
      </div>
    </div>

    <!-- ⑤ LOCATION -->
    <div class="section">
      <div class="section-head"><div class="section-num">5</div><div class="section-title">Location</div></div>
      <div class="section-body">
        <div class="field-row cols-2">
          <div class="field-group">
            <label class="field-label">Venue Name *</label>
            <input class="field-input" name="venue" required placeholder="e.g. Club Axis" value="<%= event ? event.venue : '' %>"/>
          </div>
          <div class="field-group">
            <label class="field-label">Venue Address</label>
            <input class="field-input" name="venueAddress" placeholder="Full address..." value="<%= event ? event.venueAddress : '' %>"/>
          </div>
        </div>
        <div class="field-row">
          <div class="field-group">
            <label class="field-label">Google Maps Link</label>
            <input class="field-input" name="googleMapLink" type="url" placeholder="https://maps.google.com/..." value="<%= event ? event.googleMapLink : '' %>"/>
          </div>
        </div>
      </div>
    </div>

    <!-- ⑥ TICKETS -->
    <div class="section">
      <div class="section-head"><div class="section-num">6</div><div class="section-title">Ticket Categories</div></div>
      <div class="section-body">
        <div style="margin-bottom:1rem;font-size:0.82rem;color:#777;">Add as many ticket categories as you need. Each can have a custom name and color.</div>
        <div id="ticketCatList" style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1rem;"></div>
        <button type="button" class="btn-add" onclick="addTicketCat()">
          <i class="bi bi-plus-circle-fill"></i> Add Ticket Category
        </button>
        <input type="hidden" name="ticketTypesJson" id="ticketTypesJson" value="[]"/>
      </div>
    </div>

    <!-- ⑦ SETTINGS -->
    <div class="section">
      <div class="section-head"><div class="section-num">7</div><div class="section-title">Settings</div></div>
      <div class="section-body">
        <div class="field-row cols-2">
          <label style="display:flex;align-items:center;gap:0.8rem;cursor:pointer;">
            <input type="checkbox" name="isActive" value="true" <%= event && event.isActive !== false ? 'checked' : '' %> style="width:18px;height:18px;accent-color:#6A0DAD;"/>
            <span>Event is Active (visible to users)</span>
          </label>
          <label style="display:flex;align-items:center;gap:0.8rem;cursor:pointer;">
            <input type="checkbox" name="isFeatured" value="true" <%= event && event.isFeatured ? 'checked' : '' %> style="width:18px;height:18px;accent-color:#6A0DAD;"/>
            <span>Feature this event (highlighted on homepage)</span>
          </label>
        </div>
      </div>
    </div>

    <!-- SAVE BAR -->
    <div class="save-bar">
      <a href="/admin" class="btn-cancel">Cancel</a>
      <button type="submit" class="btn-save"><i class="bi bi-check-circle-fill"></i> <%= event ? 'Update Event' : 'Create Event' %></button>
    </div>

  </form>
</div>

<!-- ── Banner Crop Modal ── -->
<div id="cropModal">
  <div class="crop-modal-box">
    <div class="crop-modal-top"></div>
    <div class="crop-modal-head">
      <h3 id="cropModalTitle">CROP BANNER</h3>
      <button onclick="closeBannerCrop()">×</button>
    </div>
    <div class="size-warn" id="cropSizeWarn">⚠ File exceeds 10 MB limit</div>
    <!-- Crop viewport: fixed aspect-ratio frame, image pans inside -->
    <div id="cropViewport" class="crop-area-wrap landscape" style="overflow:hidden;position:relative;">
      <img id="cropPreviewImg" src="" alt=""
        style="position:absolute;top:50%;left:50%;transform-origin:center center;transform:translate(-50%,-50%) scale(1);cursor:grab;user-select:none;max-width:none;"/>
      <div class="crop-dashed"></div>
    </div>
    <div class="crop-ctrls">
      <label>Zoom</label>
      <input type="range" id="cropZoom" min="1" max="5" step="0.02" value="1" oninput="updateCropTransform()"/>
      <button type="button" onclick="resetCrop()" style="padding:0.3rem 0.7rem;border:1px solid rgba(245,200,66,0.3);background:rgba(245,200,66,0.07);color:#f5c842;border-radius:5px;font-size:0.72rem;cursor:pointer;font-family:inherit;white-space:nowrap;"><i class="bi bi-arrows-fullscreen"></i> Fit</button>
    </div>
    <div style="font-size:0.6rem;color:#555;text-align:center;font-family:'Space Mono',monospace;margin-top:-0.2rem;">Drag to pan · scroll/pinch to zoom</div>
    <div class="crop-footer">
      <button class="crop-cancel-btn" onclick="closeBannerCrop()">Cancel</button>
      <button class="crop-save-btn" onclick="saveBannerCrop()"><i class="bi bi-crop"></i> Use This Crop</button>
    </div>
  </div>
</div>

<!-- ── Artist Photo Crop Modal ── -->
<div id="artistCropModal">
  <div class="ac-box">
    <div class="ac-top"></div>
    <div class="ac-head"><h3>CROP PHOTO</h3><button onclick="closeArtistCrop()">×</button></div>
    <div class="size-warn" id="artistSizeWarn">⚠ File exceeds 10 MB limit</div>
    <div class="ac-area" id="acArea">
      <canvas id="acCanvas"></canvas>
    </div>
    <div class="ac-ctrls">
      <label>Zoom</label>
      <input type="range" id="acZoom" min="0.1" max="5" step="0.01" value="1" oninput="drawArtistCrop()"/>
      <button type="button" onclick="fitArtistCrop()" style="padding:0.3rem 0.7rem;border:1px solid rgba(106,13,173,0.4);background:rgba(106,13,173,0.1);color:#9D4EDD;border-radius:5px;font-size:0.72rem;cursor:pointer;white-space:nowrap;font-family:inherit;">⊡ Fit</button>
    </div>
    <div style="font-size:0.62rem;color:#555;text-align:center;margin-top:0.2rem;font-family:'Space Mono',monospace;">Drag to pan · Pinch or scroll to zoom</div>
    <div class="ac-footer">
      <button class="crop-cancel-btn" onclick="closeArtistCrop()">Cancel</button>
      <button class="crop-save-btn" onclick="saveArtistCrop()"><i class="bi bi-person-circle"></i> Use Photo</button>
    </div>
  </div>
</div>


<script>
// ── Existing event data for pre-population ──
const EXISTING_ARTISTS = <%- JSON.stringify(event && event.artists ? event.artists : []) %>;

// ── Banner Crop System (CSS-transform, pixel-perfect) ──
const MAX_SIZE_BYTES = 10 * 1024 * 1024;

const BANNER_CONFIGS = {
  bannerDesktop: { ar:'landscape', ow:1920, oh:600,  label:'DESKTOP BANNER' },
  bannerMobile:  { ar:'portrait',  ow:800,  oh:1067, label:'MOBILE BANNER'  },
  bannerDetail:  { ar:'landscape', ow:1200, oh:400,  label:'DETAIL BANNER'  },
};

let cropFieldId = null, cropCfg = null;
let cropScale = 1, cropX = 0, cropY = 0;

function previewBanner(input, fieldId) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > MAX_SIZE_BYTES) {
    showToast('Image exceeds 10 MB limit. Please choose a smaller file.', 'err');
    input.value = ''; return;
  }
  const reader = new FileReader();
  reader.onload = ev => {
    const img = new Image();
    img.onload = () => {
      cropFieldId = fieldId;
      // Detect orientation and choose crop config
      const isPortrait = img.height > img.width;
      let cfg;
      if (fieldId === 'bannerMobile' || isPortrait) {
        cfg = { ar:'portrait', ow:800, oh:1067, label:'MOBILE / PORTRAIT BANNER' };
      } else if (fieldId === 'bannerDetail') {
        cfg = { ar:'landscape', ow:1200, oh:400, label:'DETAIL BANNER (3:1 wide)' };
      } else {
        cfg = BANNER_CONFIGS[fieldId];
      }
      cropCfg = cfg;
      // Set viewport class for aspect ratio
      const vp = document.getElementById('cropViewport');
      vp.className = 'crop-area-wrap ' + cfg.ar;
      // Load image into preview img tag
      const pi = document.getElementById('cropPreviewImg');
      pi.src = ev.target.result;
      pi.onload = () => {
        resetCrop();
        document.getElementById('cropModalTitle').textContent = cfg.label;
        document.getElementById('cropModal').classList.add('open');
      };
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
}

function resetCrop() {
  cropScale = 1; cropX = 0; cropY = 0;
  document.getElementById('cropZoom').value = 1;
  updateCropTransform();
}

function updateCropTransform() {
  cropScale = parseFloat(document.getElementById('cropZoom').value) || 1;
  const pi = document.getElementById('cropPreviewImg');
  pi.style.transform = `translate(calc(-50% + ${cropX}px), calc(-50% + ${cropY}px)) scale(${cropScale})`;
}

function saveBannerCrop() {
  if (!cropFieldId || !cropCfg) return;
  const pi = document.getElementById('cropPreviewImg');
  const vp = document.getElementById('cropViewport');
  const vpRect = vp.getBoundingClientRect();
  const piRect = pi.getBoundingClientRect();
  // Map viewport crop region to source image coords
  const scaleX = pi.naturalWidth  / piRect.width;
  const scaleY = pi.naturalHeight / piRect.height;
  const sx = Math.max(0, (vpRect.left - piRect.left) * scaleX);
  const sy = Math.max(0, (vpRect.top  - piRect.top ) * scaleY);
  const sw = Math.min(vpRect.width  * scaleX, pi.naturalWidth  - sx);
  const sh = Math.min(vpRect.height * scaleY, pi.naturalHeight - sy);
  const out = document.createElement('canvas');
  out.width  = cropCfg.ow;
  out.height = cropCfg.oh;
  out.getContext('2d').drawImage(pi, sx, sy, sw, sh, 0, 0, cropCfg.ow, cropCfg.oh);
  const dataUrl = out.toDataURL('image/jpeg', 0.88);
  document.getElementById(cropFieldId).value = dataUrl;
  const prev = document.getElementById('prev-' + cropFieldId);
  if (prev) { prev.src = dataUrl; prev.style.display = 'block'; }
  closeBannerCrop();
}

function closeBannerCrop() {
  document.getElementById('cropModal').classList.remove('open');
  cropFieldId = null; cropCfg = null;
  document.getElementById('cropPreviewImg').src = '';
}

// Drag-to-pan + scroll-to-zoom on banner crop
(function(){
  let drag=false,sx=0,sy=0,ox=0,oy=0;
  const pi = ()=>document.getElementById('cropPreviewImg');
  const xy = e => e.touches ? {x:e.touches[0].clientX,y:e.touches[0].clientY} : {x:e.clientX,y:e.clientY};
  document.getElementById('cropViewport').addEventListener('mousedown',  e=>{e.preventDefault();drag=true;const p=xy(e);sx=p.x;sy=p.y;ox=cropX;oy=cropY;pi().style.cursor='grabbing';});
  document.getElementById('cropViewport').addEventListener('touchstart', e=>{drag=true;const p=xy(e);sx=p.x;sy=p.y;ox=cropX;oy=cropY;},{passive:true});
  window.addEventListener('mousemove', e=>{if(!drag)return;const p=xy(e);cropX=ox+(p.x-sx);cropY=oy+(p.y-sy);updateCropTransform();});
  window.addEventListener('touchmove', e=>{if(!drag)return;const p=xy(e);cropX=ox+(p.x-sx);cropY=oy+(p.y-sy);updateCropTransform();},{passive:true});
  window.addEventListener('mouseup',  ()=>{drag=false;const p=pi();if(p)p.style.cursor='grab';});
  window.addEventListener('touchend', ()=>{drag=false;});
  document.getElementById('cropViewport').addEventListener('wheel', e=>{
    e.preventDefault();
    cropScale = Math.min(5, Math.max(1, cropScale + (e.deltaY>0?-0.1:0.1)));
    document.getElementById('cropZoom').value = cropScale;
    updateCropTransform();
  },{passive:false});
})();

function openArtistCrop(file, idx) {
  if (!file) return;
  if (file.size > MAX_SIZE_BYTES) { showToast('Image exceeds 10 MB limit.', 'err'); return; }
  document.getElementById('artistSizeWarn').style.display='none';
  acArtistIndex = idx;
  const reader=new FileReader();
  reader.onload=e=>{
    const img=new Image();
    img.onload=()=>{
      acImg=img; acOffX=0; acOffY=0;
      document.getElementById('acZoom').value=1;
      document.getElementById('artistCropModal').classList.add('open');
      requestAnimationFrame(()=>requestAnimationFrame(drawArtistCrop));
    };
    img.src=e.target.result;
  };
  reader.readAsDataURL(file);
}

function drawArtistCrop(){
  if(!acImg)return;
  const canvas=document.getElementById('acCanvas');
  const area=document.getElementById('acArea');
  const S=area.clientWidth||220;
  canvas.width=S;canvas.height=S;
  const ctx=canvas.getContext('2d');
  ctx.clearRect(0,0,S,S);
  ctx.save();ctx.beginPath();ctx.arc(S/2,S/2,S/2,0,Math.PI*2);ctx.clip();
  const zoom=parseFloat(document.getElementById('acZoom').value)||1;
  const scale=Math.max(S/acImg.width,S/acImg.height)*zoom;
  const dx=(S-acImg.width*scale)/2+acOffX;
  const dy=(S-acImg.height*scale)/2+acOffY;
  ctx.drawImage(acImg,dx,dy,acImg.width*scale,acImg.height*scale);
  ctx.restore();
}

function fitArtistCrop(){
  acOffX=0;acOffY=0;
  document.getElementById('acZoom').value=1;
  drawArtistCrop();
}

function saveArtistCrop(){
  if(!acImg||acArtistIndex<0)return;
  const out=document.createElement('canvas');
  out.width=400;out.height=400;
  const ctx=out.getContext('2d');
  ctx.save();ctx.beginPath();ctx.arc(200,200,200,0,Math.PI*2);ctx.clip();
  const zoom=parseFloat(document.getElementById('acZoom').value)||1;
  const scaleR=400/(document.getElementById('acArea').clientWidth||220);
  const scale=Math.max(400/acImg.width,400/acImg.height)*zoom;
  const dx=(400-acImg.width*scale)/2+acOffX*scaleR;
  const dy=(400-acImg.height*scale)/2+acOffY*scaleR;
  ctx.drawImage(acImg,dx,dy,acImg.width*scale,acImg.height*scale);
  ctx.restore();
  const dataUrl=out.toDataURL('image/jpeg',0.9);
  artists[acArtistIndex].photo=dataUrl;
  renderArtists();
  closeArtistCrop();
}

function closeArtistCrop(){
  document.getElementById('artistCropModal').classList.remove('open');
  acImg=null;acArtistIndex=-1;
}

// drag to pan artist crop
(function(){
  let dr=false,sx=0,sy=0;
  let pinchDist=0,pinchBase=1;
  const ca=document.getElementById('acCanvas');
  if(!ca)return;
  function gp(e){return e.touches?{x:e.touches[0].clientX,y:e.touches[0].clientY}:{x:e.clientX,y:e.clientY};}
  ca.style.cursor='grab';
  ca.addEventListener('mousedown',e=>{dr=true;const p=gp(e);sx=p.x;sy=p.y;ca.style.cursor='grabbing';e.preventDefault();});
  ca.addEventListener('touchstart',e=>{
    if(e.touches.length===1){dr=true;const p=gp(e);sx=p.x;sy=p.y;}
    else if(e.touches.length===2){
      dr=false;
      pinchDist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
      pinchBase=parseFloat(document.getElementById('acZoom').value)||1;
    }
    e.preventDefault();
  },{passive:false});
  window.addEventListener('mousemove',e=>{
    if(!dr)return;
    acOffX+=(e.clientX-sx);acOffY+=(e.clientY-sy);sx=e.clientX;sy=e.clientY;drawArtistCrop();
  });
  window.addEventListener('touchmove',e=>{
    if(e.touches.length===1&&dr){acOffX+=(e.touches[0].clientX-sx);acOffY+=(e.touches[0].clientY-sy);sx=e.touches[0].clientX;sy=e.touches[0].clientY;drawArtistCrop();}
    else if(e.touches.length===2){
      const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
      const nv=Math.min(5,Math.max(0.1,pinchBase*(d/pinchDist)));
      document.getElementById('acZoom').value=nv;drawArtistCrop();
    }
    e.preventDefault();
  },{passive:false});
  window.addEventListener('mouseup',()=>{dr=false;ca.style.cursor='grab';});
  window.addEventListener('touchend',()=>{dr=false;});
  // Scroll to zoom
  ca.addEventListener('wheel',e=>{
    const cur=parseFloat(document.getElementById('acZoom').value)||1;
    const nv=Math.min(5,Math.max(0.1,cur-(e.deltaY>0?0.1:-0.1)));
    document.getElementById('acZoom').value=nv;drawArtistCrop();
    e.preventDefault();
  },{passive:false});
})();

// Show existing banner previews
['bannerDesktop','bannerMobile','bannerDetail'].forEach(id => {
  const val = document.getElementById(id).value;
  if (val) {
    document.getElementById('prev-' + id).style.display = 'block';
  }
});

// ── Artist management ──
let artists = EXISTING_ARTISTS.map(a => ({ ...a }));

function renderArtists() {
  const list = document.getElementById('artistList');
  list.innerHTML = '';
  if (artists.length === 0) {
    list.innerHTML = '<div style="color:#B3B3B3;font-size:0.85rem;padding:0.5rem 0;">No artists added yet.</div>';
    return;
  }
  artists.forEach((a, i) => {
    const row = document.createElement('div');
    row.className = 'artist-row';
    row.innerHTML = `
      <div class="artist-photo-wrap">
        <input type="file" accept="image/*" onchange="setArtistPhoto(${i}, this)"/>
        <div class="artist-photo-box" title="Click to upload photo">
          ${a.photo ? `<img src="${a.photo}" style="display:block;"/>` : '📷'}
        </div>
      </div>
      <div class="field-group">
        <label class="field-label">Artist Name</label>
        <input class="field-input" placeholder="e.g. DJ Arjun" value="${a.name||''}" oninput="artists[${i}].name=this.value"/>
      </div>
      <div class="field-group">
        <label class="field-label">Designation</label>
        <input class="field-input" placeholder="e.g. DJ / Live Act / MC" value="${a.designation||''}" oninput="artists[${i}].designation=this.value"/>
      </div>
      <button type="button" class="btn-remove" onclick="removeArtist(${i})"><i class="bi bi-trash"></i></button>
    `;
    list.appendChild(row);
  });
}

function addArtist() {
  artists.push({ name: '', designation: '', photo: '' });
  renderArtists();
}

function removeArtist(i) {
  artists.splice(i, 1);
  renderArtists();
}

function setArtistPhoto(i, input) {
  const file = input.files[0];
  if (!file) return;
  openArtistCrop(file, i);
}

// ── Dynamic Ticket Categories ──
let catCounter = 0;
const PRESET_COLORS = ['#9D4EDD','#f5c842','#c0c8d8','#00FF88','#FF6B6B','#FF8C42','#4ECDC4','#45B7D1'];

// Load existing categories from server (edit mode)
const EXISTING_CATS = <%- JSON.stringify(event && event.ticketTypes ? event.ticketTypes : []) %>;
EXISTING_CATS.forEach(t => addTicketCat(t));
if (EXISTING_CATS.length === 0) addTicketCat(); // start with one empty

function addTicketCat(existing) {
  const id = 'cat_' + (++catCounter);
  const color = existing?.color || PRESET_COLORS[(catCounter - 1) % PRESET_COLORS.length];
  const isActive = existing ? (existing.isActive !== false) : true;
  const isMultiple = existing?.ticketType === 'multiple';

  const el = document.createElement('div');
  el.id = id;
  el.style.cssText = `border-radius:10px;border:1.5px solid rgba(255,255,255,0.08);overflow:hidden;background:#0d0d14;`;

  el.innerHTML = `
    <div style="padding:0.9rem 1.2rem;display:flex;align-items:center;justify-content:space-between;cursor:pointer;background:rgba(255,255,255,0.02);" onclick="toggleCatBody('${id}')">
      <div style="display:flex;align-items:center;gap:0.8rem;">
        <input type="color" value="${color}" id="${id}_color" onclick="event.stopPropagation()"
          onchange="updateCatColor('${id}',this.value)"
          style="width:28px;height:28px;border-radius:6px;border:none;cursor:pointer;background:none;padding:0;"/>
        <input type="text" id="${id}_name" value="${existing?.category||''}" placeholder="e.g. Gold, VIP, Family"
          onclick="event.stopPropagation()"
          style="background:transparent;border:none;outline:none;color:#fff;font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:2px;width:180px;"
          oninput="updateCatLabel('${id}')"/>
        <span id="${id}_badge" style="font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:1px;padding:0.15rem 0.55rem;border-radius:8px;background:${color}22;color:${color};border:1px solid ${color}44;">${existing?.category?.toUpperCase()||'NEW'}</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.8rem;" onclick="event.stopPropagation()">
        <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer;font-size:0.82rem;color:#B3B3B3;">
          <div id="${id}_tog" class="toggle-sw ${isActive?'on':''}" onclick="flipCatToggle('${id}')"></div>
          <span id="${id}_toglbl">${isActive?'Active':'Disabled'}</span>
        </label>
        <button type="button" onclick="removeCat('${id}')" style="background:rgba(255,68,68,0.1);border:1px solid rgba(255,68,68,0.25);color:#FF4444;border-radius:5px;padding:0.25rem 0.5rem;cursor:pointer;font-size:0.75rem;">✕</button>
        <i class="bi bi-chevron-down" id="${id}_chev" style="color:#B3B3B3;transition:transform 0.2s;"></i>
      </div>
    </div>
    <div id="${id}_body" style="padding:1.2rem;display:none;border-top:1px solid rgba(255,255,255,0.06);">
      <div class="field-row cols-3">
        <div class="field-group"><label class="field-label">Price (₹) *</label>
          <input class="field-input" type="number" id="${id}_price" placeholder="0" value="${existing?.price||''}"/></div>
        <div class="field-group"><label class="field-label">Age Limit (0=any)</label>
          <input class="field-input" type="number" id="${id}_ageLimit" placeholder="0" value="${existing?.ageLimit||0}"/></div>
        <div class="field-group"><label class="field-label">Total Seats *</label>
          <input class="field-input" type="number" id="${id}_totalSeats" placeholder="100" value="${existing?.totalSeats||''}"/></div>
      </div>
      <div class="field-row cols-2">
        <div class="field-group"><label class="field-label">Ticket Type</label>
          <select class="field-input" id="${id}_ticketType" onchange="toggleCatCombo('${id}')">
            <option value="single" ${!isMultiple?'selected':''}>Single Entry</option>
            <option value="multiple" ${isMultiple?'selected':''}>Multiple Entry (Group / Combo)</option>
          </select></div>
        <div class="field-group" id="${id}_comboWrap" style="display:${isMultiple?'block':'none'};">
          <label class="field-label">People per Ticket *</label>
          <input class="field-input" type="number" id="${id}_comboCount" min="2" max="20" placeholder="e.g. 4" value="${existing?.comboCount>1?existing.comboCount:2}"/>
          <small style="color:#777;font-size:0.7rem;margin-top:0.25rem;display:block;">Each purchase = this many attendees (all fill their details)</small>
        </div>
        <div class="field-group"><label class="field-label">Booked Seats</label>
          <input class="field-input" type="number" id="${id}_bookedSeats" value="${existing?.bookedSeats||0}" min="0"/></div>
      </div>
      <!-- ── Combo Offer ── -->
      <div style="background:rgba(245,200,66,0.05);border:1px solid rgba(245,200,66,0.18);border-radius:8px;padding:0.9rem 1rem;margin-top:0.2rem;">
        <div style="font-family:'Space Mono',monospace;font-size:0.56rem;letter-spacing:2px;color:#f5c842;margin-bottom:0.7rem;">🎯 COMBO OFFER (OPTIONAL)</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;">
          <div class="field-group">
            <label class="field-label">Min Tickets to Qualify</label>
            <input class="field-input" type="number" id="${id}_comboOfferMinQty" min="0" placeholder="0 = off" value="${existing?.comboOfferMinQty||0}" style="border-color:rgba(245,200,66,0.25);"/>
            <small style="color:#777;font-size:0.68rem;margin-top:0.2rem;display:block;">e.g. 4 = buy 4+ to get discount</small>
          </div>
          <div class="field-group">
            <label class="field-label">Discount Amount (₹)</label>
            <input class="field-input" type="number" id="${id}_comboOfferDiscount" min="0" placeholder="0" value="${existing?.comboOfferDiscount||0}" style="border-color:rgba(245,200,66,0.25);"/>
            <small style="color:#777;font-size:0.68rem;margin-top:0.2rem;display:block;">flat ₹ off total (shown to user)</small>
          </div>
        </div>
      </div>
      <div class="field-row" style="margin-top:0.8rem;">
        <div class="field-group"><label class="field-label">Terms & Conditions</label>
          <textarea class="field-input" id="${id}_terms" placeholder="Entry conditions, refund policy..." style="min-height:60px;">${existing?.terms||''}</textarea></div>
      </div>
    </div>`;

  document.getElementById('ticketCatList').appendChild(el);
  // Auto-open if existing
  if (existing) toggleCatBody(id);
  updateCatColor(id, color);
}

function toggleCatBody(id) {
  const body = document.getElementById(id+'_body');
  const chev = document.getElementById(id+'_chev');
  const open = body.style.display === 'none';
  body.style.display = open ? 'block' : 'none';
  chev.style.transform = open ? 'rotate(180deg)' : '';
}

function updateCatColor(id, color) {
  const badge = document.getElementById(id+'_badge');
  if (badge) {
    badge.style.background = color+'22';
    badge.style.color = color;
    badge.style.borderColor = color+'44';
  }
}

function updateCatLabel(id) {
  const val = document.getElementById(id+'_name').value.toUpperCase()||'NEW';
  const badge = document.getElementById(id+'_badge');
  if (badge) badge.textContent = val;
}

function flipCatToggle(id) {
  const tog = document.getElementById(id+'_tog');
  const lbl = document.getElementById(id+'_toglbl');
  const active = tog.classList.toggle('on');
  lbl.textContent = active ? 'Active' : 'Disabled';
}

function removeCat(id) {
  const el = document.getElementById(id);
  if (el) el.remove();
}

function toggleCatCombo(id) {
  const val = document.getElementById(id+'_ticketType').value;
  const wrap = document.getElementById(id+'_comboWrap');
  if (wrap) wrap.style.display = val === 'multiple' ? 'block' : 'none';
}

// ── Submit — inject JSON fields ──
// ── Inline validation helpers ──
function markField(el, valid, msg) {
  el.classList.toggle('is-invalid', !valid);
  el.classList.toggle('is-valid', valid);
  const errEl = el.parentElement.querySelector('.field-error');
  if (errEl) { errEl.textContent = msg || ''; errEl.classList.toggle('show', !valid && !!msg); }
  return valid;
}

function validateField(el) {
  const val = el.value.trim();
  const name = el.name || el.id || '';
  if (el.required && !val) return markField(el, false, 'This field is required.');
  if (el.type === 'date' && val) {
    const d = new Date(val);
    if (isNaN(d.getTime())) return markField(el, false, 'Enter a valid date.');
    // For event date — block if in the past
    if (name === 'date') {
      const today = new Date(); today.setHours(0,0,0,0);
      if (d < today) return markField(el, false, 'Event date cannot be in the past.');
    }
    return markField(el, true, '');
  }
  // Time fields (doorsOpen, endTime) — must be like "8:00 PM" or "20:00"
  if ((name === 'doorsOpen' || name === 'endTime') && val) {
    var timeRe = /^([0-9]{1,2}):([0-9]{2})\s*(AM|PM)?$/i;
    if (!timeRe.test(val)) return markField(el, false, 'Use format like "8:00 PM" or "20:00".');
    return markField(el, true, '');
  }
  if (el.type === 'url' && val) {
    try { new URL(val); return markField(el, true, ''); }
    catch(e) { return markField(el, false, 'Enter a valid URL (starting with https://).'); }
  }
  if (el.type === 'number' && val !== '') {
    const n = Number(val);
    if (isNaN(n)) return markField(el, false, 'Must be a number.');
    if (el.min !== '' && n < Number(el.min)) return markField(el, false, 'Value too low (min ' + el.min + ').');
    return markField(el, true, '');
  }
  if (val) return markField(el, true, '');
  return markField(el, false, '');
}

// Attach live validation to all field-inputs on page load
(function attachLiveValidation() {
  document.querySelectorAll('.field-input').forEach(function(el) {
    // Add error placeholder if not already there
    if (!el.parentElement.querySelector('.field-error')) {
      const e = document.createElement('div');
      e.className = 'field-error';
      el.parentElement.appendChild(e);
    }
    el.addEventListener('blur', function() { validateField(el); });
    el.addEventListener('input', function() {
      if (el.classList.contains('is-invalid')) validateField(el); // clear error on fix
    });
  });

  // Date field: prevent past dates from being submitted without warning
  const dateEl = document.querySelector('input[name="date"]');
  if (dateEl) {
    dateEl.addEventListener('change', function() {
      const d = new Date(dateEl.value);
      if (d < new Date()) {
        markField(dateEl, false, '⚠ Date is in the past — are you sure?');
        // Don't block — just warn
        dateEl.classList.remove('is-invalid'); // keep orange-ish but allow save
        dateEl.style.borderColor = '#f5c842';
      } else {
        markField(dateEl, true, '');
        dateEl.style.borderColor = '';
      }
    });
  }

  // Time fields: validate HH:MM AM/PM format
  ['doorsOpen','endTime'].forEach(function(fname) {
    const el = document.querySelector('input[name="' + fname + '"]');
    if (!el) return;
    el.addEventListener('blur', function() {
      const v = el.value.trim();
      if (!v) { markField(el, false, ''); return; }
      const ok = /^\d{1,2}:\d{2}\s*(AM|PM|am|pm)$/i.test(v);
      markField(el, ok, ok ? '' : 'Format: 8:00 PM or 4:00 AM');
    });
  });
})();

function prepareSubmit() {
  let valid = true;

  // Validate required text fields
  ['input[name="name"]', 'input[name="date"]', 'input[name="venue"]'].forEach(function(sel) {
    const el = document.querySelector(sel);
    if (el && !el.value.trim()) {
      markField(el, false, 'This field is required.');
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      valid = false;
    }
  });

  // Validate URL fields if filled
  document.querySelectorAll('.field-input[type="url"]').forEach(function(el) {
    if (el.value.trim()) {
      try { new URL(el.value.trim()); markField(el, true, ''); }
      catch(e) { markField(el, false, 'Enter a valid URL starting with https://'); valid = false; }
    }
  });

  // Validate date is not empty
  const dateEl = document.querySelector('input[name="date"]');
  if (dateEl && dateEl.value) {
    const d = new Date(dateEl.value);
    if (isNaN(d.getTime())) { markField(dateEl, false, 'Enter a valid date.'); valid = false; }
  }

  if (!valid) {
    showToast('Please fix the errors highlighted in red before saving.', 'err');
    return false;
  }

  // Artists JSON
  document.getElementById('artistsJson').value = JSON.stringify(artists);

  // Ticket types JSON — collect from all dynamic cat cards
  const tickets = [];
  let ticketErrors = [];
  document.querySelectorAll('#ticketCatList > div').forEach(el => {
    const id = el.id;
    const nameEl = document.getElementById(id+'_name');
    const priceEl = document.getElementById(id+'_price');
    const seatsEl = document.getElementById(id+'_totalSeats');
    const name = (nameEl?.value||'').trim();
    const price = parseInt(priceEl?.value) || 0;
    const totalSeats = parseInt(seatsEl?.value) || 0;
    if (!name && !priceEl?.value && !seatsEl?.value) return; // totally empty row - skip
    if (!name) { ticketErrors.push('Ticket category name is required.'); if(nameEl)nameEl.classList.add('is-invalid'); return; }
    if (price <= 0) { ticketErrors.push('Price must be greater than 0 for "' + name + '".'); if(priceEl)priceEl.classList.add('is-invalid'); return; }
    if (totalSeats <= 0) { ticketErrors.push('Total seats must be greater than 0 for "' + name + '".'); if(seatsEl)seatsEl.classList.add('is-invalid'); return; }
    const color = document.getElementById(id+'_color')?.value || '#6A0DAD';
    const ageLimit = parseInt(document.getElementById(id+'_ageLimit')?.value) || 0;
    const ticketType = document.getElementById(id+'_ticketType')?.value || 'single';
    const bookedSeats = parseInt(document.getElementById(id+'_bookedSeats')?.value) || 0;
    const terms = document.getElementById(id+'_terms')?.value || '';
    const rawCombo = parseInt(document.getElementById(id+'_comboCount')?.value) || 2;
    const comboCount = ticketType === 'multiple' ? rawCombo : 1;
    const isActive = document.getElementById(id+'_tog')?.classList.contains('on') || false;
    tickets.push({
      category: name.toLowerCase().replace(/\s+/g,'_'),
      name, color, price, ageLimit, ticketType,
      totalSeats, bookedSeats, terms,
      isActive, isCombo: ticketType === 'multiple', comboCount,
      comboOfferMinQty:   parseInt(document.getElementById(id+'_comboOfferMinQty')?.value)  || 0,
      comboOfferDiscount: parseInt(document.getElementById(id+'_comboOfferDiscount')?.value) || 0,
    });
  });

  if (ticketErrors.length > 0) {
    showToast(ticketErrors[0], 'err');
    return false;
  }

  if (tickets.length === 0) {
    showToast('Add at least one ticket category with name, price and seats.', 'err');
    return false;
  }

  document.getElementById('ticketTypesJson').value = JSON.stringify(tickets);
  return true;
}

function showToast(msg, type) {
  type = type || 'ok';
  var container = document.getElementById('toast-container');
  var icons = { ok: '✅', err: '❌', warn: '⚠️' };
  var el = document.createElement('div');
  el.className = 'ef-toast ' + type;
  el.innerHTML = '<span>' + (icons[type]||'ℹ️') + '</span><span>' + msg + '</span>';
  container.appendChild(el);
  var timer = setTimeout(function() {
    el.style.animation = 'efToastOut 0.3s ease forwards';
    setTimeout(function() { if(el.parentNode) el.parentNode.removeChild(el); }, 300);
  }, 4000);
  el.addEventListener('click', function() {
    clearTimeout(timer);
    el.style.animation = 'efToastOut 0.3s ease forwards';
    setTimeout(function() { if(el.parentNode) el.parentNode.removeChild(el); }, 300);
  });
}

// Init
renderArtists();

// ── UNSAVED CHANGES GUARD ──
var _formDirty = false;
var _formSubmitting = false;

// Mark dirty on any input change
document.querySelectorAll('#eventForm input, #eventForm textarea, #eventForm select').forEach(function(el) {
  el.addEventListener('change', function() { _formDirty = true; });
  el.addEventListener('input',  function() { _formDirty = true; });
});

// Intercept submit — clear dirty flag so we don't warn on save
document.getElementById('eventForm').addEventListener('submit', function() {
  _formSubmitting = true;
  _formDirty = false;
});

// Browser back / tab close
window.addEventListener('beforeunload', function(e) {
  if (_formDirty && !_formSubmitting) {
    e.preventDefault();
    e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
    return e.returnValue;
  }
});

// Cancel button — show custom confirm modal instead of browser default
document.querySelector('.btn-cancel').addEventListener('click', function(e) {
  if (!_formDirty) return; // no changes, allow navigation
  e.preventDefault();
  document.getElementById('leaveConfirmModal').style.display = 'flex';
});
function _confirmLeave()  { _formDirty = false; window.location.href = '/admin'; }
function _cancelLeave()   { document.getElementById('leaveConfirmModal').style.display = 'none'; }
</script>

<!-- Leave Confirm Modal -->
<div id="leaveConfirmModal" style="display:none;position:fixed;inset:0;background:rgba(8,8,14,0.88);backdrop-filter:blur(8px);z-index:9999;align-items:center;justify-content:center;padding:1rem;">
  <div style="background:#14141C;border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:2rem;max-width:400px;width:100%;text-align:center;animation:slideUp 0.25s ease both;">
    <div style="font-size:2rem;margin-bottom:0.8rem;">⚠️</div>
    <div style="font-family:'Anton',sans-serif;font-size:1.4rem;letter-spacing:2px;color:#fff;margin-bottom:0.6rem;">UNSAVED CHANGES</div>
    <p style="font-size:0.88rem;color:#B3B3B3;line-height:1.6;margin-bottom:1.5rem;">You have unsaved changes on this form. If you leave now, all changes will be lost.</p>
    <div style="display:flex;gap:0.8rem;justify-content:center;">
      <button onclick="_cancelLeave()" style="padding:0.75rem 1.5rem;background:transparent;border:1px solid rgba(255,255,255,0.15);border-radius:7px;color:#B3B3B3;font-family:'Outfit',sans-serif;font-size:0.88rem;cursor:pointer;">Stay &amp; Keep Editing</button>
      <button onclick="_confirmLeave()" style="padding:0.75rem 1.5rem;background:#FF4444;border:none;border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.88rem;cursor:pointer;">Leave Without Saving</button>
    </div>
  </div>
</div>
  </div><!-- /container -->
  </main>
</div><!-- /admin-layout -->
  <%- include('../partials/admin-confirm') %>
</body>
</html>
