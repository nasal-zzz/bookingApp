<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#08080e;--surface:#0f0f18;--card:#13131e;--card2:#161620;--border:rgba(255,255,255,0.08);--accent:#c8ff00;--text:#e8e8f0;--muted:#5a5a72;--error:#ff5c5c;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;}
    .s-logo{font-family:'Anton',sans-serif;font-size:1.3rem;letter-spacing:3px;color:#fff;text-decoration:none;display:block;padding:0 0.5rem 1.2rem;border-bottom:1px solid var(--border);margin-bottom:0.8rem;}
    .s-logo span{color:var(--accent);}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover{background:rgba(200,255,0,0.07);border-color:rgba(200,255,0,0.15);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;}
    .s-logout:hover{background:rgba(255,92,92,0.08);}
    .main{padding:2rem;position:relative;z-index:1;}
    .page-header{display:flex;align-items:center;gap:1rem;margin-bottom:2rem;}
    .back-btn{display:flex;align-items:center;gap:0.4rem;color:var(--muted);text-decoration:none;font-size:0.82rem;}
    .back-btn:hover{color:#fff;}
    .page-title{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;color:#fff;}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;max-width:900px;}
    .form-full{grid-column:1/-1;}
    .form-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.5rem;margin-bottom:1.2rem;max-width:900px;}
    .form-card-title{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:2px;color:#fff;margin-bottom:1.2rem;padding-bottom:0.8rem;border-bottom:1px solid var(--border);}
    .lbl{font-family:'Space Mono',monospace;font-size:0.56rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;display:block;margin-bottom:0.4rem;}
    input[type=text],input[type=number],input[type=datetime-local],select,textarea{width:100%;background:var(--surface);border:2px solid var(--border);border-radius:7px;color:var(--text);font-size:0.9rem;padding:0.75rem 0.9rem;font-family:'Outfit',sans-serif;outline:none;transition:border-color 0.2s;}
    input:focus,select:focus,textarea:focus{border-color:var(--accent);}
    textarea{resize:vertical;min-height:70px;}
    select option{background:#0f0f18;}
    .toggle-wrap{display:flex;align-items:center;gap:0.8rem;}
    .toggle-wrap input[type=checkbox]{width:20px;height:20px;accent-color:var(--accent);}
    .tier-row{background:var(--card2);border:1px solid var(--border);border-radius:8px;padding:1.2rem;margin-bottom:0.8rem;position:relative;}
    .tier-row-grid{display:grid;grid-template-columns:1fr 1fr 120px 120px;gap:0.8rem;margin-bottom:0.8rem;}
    .tier-remove{position:absolute;top:0.8rem;right:0.8rem;background:none;border:1px solid rgba(255,92,92,0.3);color:var(--error);width:28px;height:28px;border-radius:4px;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;}
    .tier-remove:hover{background:rgba(255,92,92,0.1);}
    .btn-add-tier{display:flex;align-items:center;gap:0.5rem;padding:0.7rem 1.2rem;background:transparent;border:1px dashed rgba(200,255,0,0.3);border-radius:6px;color:var(--accent);font-family:'Outfit',sans-serif;font-size:0.85rem;cursor:pointer;width:100%;justify-content:center;transition:all 0.2s;}
    .btn-add-tier:hover{background:rgba(200,255,0,0.05);}
    .btn-submit{display:flex;align-items:center;gap:0.5rem;padding:0.9rem 2rem;background:var(--accent);color:#000;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;border:none;border-radius:7px;cursor:pointer;box-shadow:0 0 20px rgba(200,255,0,0.15);transition:all 0.2s;}
    .btn-submit:hover{transform:translateY(-2px);box-shadow:0 0 35px rgba(200,255,0,0.3);}
    .btn-submit:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
    .err{background:rgba(255,92,92,0.08);border:1px solid rgba(255,92,92,0.3);border-radius:6px;padding:0.8rem 1rem;color:var(--error);font-size:0.85rem;margin-bottom:1.2rem;max-width:900px;}
    /* Hidden field that carries JSON */
    #ticketTypesJson{display:none;}
  </style>
</head>
<body>
<div class="admin-layout">
  <aside class="sidebar">
    <a href="/admin" class="s-logo">NIGHT<span>PASS</span></a>
    <a href="/admin" class="s-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <a href="/admin/bookings" class="s-link"><i class="bi bi-ticket-perforated-fill"></i> Bookings</a>
    <a href="/admin/events/new" class="s-link"><i class="bi bi-plus-circle-fill"></i> New Event</a>
    <a href="/" class="s-link" target="_blank"><i class="bi bi-box-arrow-up-right"></i> View Site</a>
    <a href="/admin/logout" class="s-logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </aside>

  <main class="main">
    <div class="page-header">
      <a href="/admin" class="back-btn"><i class="bi bi-arrow-left"></i> Back</a>
      <div class="page-title"><%= event ? 'EDIT EVENT' : 'NEW EVENT' %></div>
    </div>

    <% if (error) { %><div class="err"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div><% } %>

    <!--
      STRATEGY: Normal HTML form POST (urlencoded).
      Ticket tiers are collected by JS into a single hidden JSON field
      before submit. Controller reads req.body.ticketTypesJson and parses it.
      No fetch, no credentials issues, no bracket array parsing problems.
    -->
    <form id="eventForm"
          method="POST"
          action="<%= event ? '/admin/events/' + event._id : '/admin/events' %>"
          onsubmit="return injectTiersAndSubmit()">

      <!-- Hidden field — JS fills this before submit -->
      <input type="hidden" name="ticketTypesJson" id="ticketTypesJson" value="[]"/>

      <!-- Basic Info -->
      <div class="form-card">
        <div class="form-card-title">EVENT DETAILS</div>
        <div class="form-grid">
          <div>
            <label class="lbl">Event Name *</label>
            <input type="text" name="name" value="<%= event ? event.name : '' %>" placeholder="Eclipse Dark Night" required/>
          </div>
          <div>
            <label class="lbl">Tagline</label>
            <input type="text" name="tagline" value="<%= event ? event.tagline : '' %>" placeholder="One Night. One Frequency."/>
          </div>
          <div>
            <label class="lbl">Date & Time *</label>
            <input type="datetime-local" name="date" value="<%= event ? new Date(event.date).toISOString().slice(0,16) : '' %>" required/>
          </div>
          <div>
            <label class="lbl">Venue *</label>
            <input type="text" name="venue" value="<%= event ? event.venue : '' %>" placeholder="Club Axis, MG Road" required/>
          </div>
          <div>
            <label class="lbl">Doors Open</label>
            <input type="text" name="doorsOpen" value="<%= event ? event.doorsOpen : '8:00 PM' %>" placeholder="8:00 PM"/>
          </div>
          <div>
            <label class="lbl">End Time</label>
            <input type="text" name="endTime" value="<%= event ? event.endTime : '4:00 AM' %>" placeholder="4:00 AM"/>
          </div>
          <div>
            <label class="lbl">Dress Code</label>
            <input type="text" name="dressCode" value="<%= event ? event.dressCode : 'All Black' %>" placeholder="All Black"/>
          </div>
          <div>
            <label class="lbl">Genre</label>
            <input type="text" name="genre" value="<%= event ? event.genre : 'Electronic' %>" placeholder="Techno, House..."/>
          </div>
          <div>
            <label class="lbl">Age Limit</label>
            <input type="number" name="ageLimit" value="<%= event ? event.ageLimit : 18 %>" min="0"/>
          </div>
          <div>
            <label class="lbl">Convenience Fee (₹)</label>
            <input type="number" name="convenienceFee" value="<%= event ? event.convenienceFee : 20 %>"/>
          </div>
          <div>
            <label class="lbl">Poster Emoji</label>
            <input type="text" name="poster" value="<%= event ? event.poster : '🎶' %>" placeholder="🎶"/>
          </div>
          <div>
            <label class="lbl">Venue Address</label>
            <input type="text" name="venueAddress" value="<%= event ? event.venueAddress : '' %>" placeholder="Full address"/>
          </div>
          <div class="form-full">
            <label class="lbl">Description</label>
            <textarea name="description" placeholder="Event description..."><%= event ? event.description : '' %></textarea>
          </div>
          <div class="toggle-wrap">
            <input type="checkbox" name="isActive" id="isActive" <%= (!event || event.isActive) ? 'checked' : '' %>/>
            <label class="lbl" for="isActive" style="margin:0;cursor:pointer;">Show on website (Active)</label>
          </div>
          <div class="toggle-wrap">
            <input type="checkbox" name="isFeatured" id="isFeatured" <%= (event && event.isFeatured) ? 'checked' : '' %>/>
            <label class="lbl" for="isFeatured" style="margin:0;cursor:pointer;">Featured event</label>
          </div>
        </div>
      </div>

      <!-- Ticket Tiers — UI only, not real form fields -->
      <div class="form-card">
        <div class="form-card-title">TICKET TIERS</div>
        <div id="tierList">
          <% if (event && event.ticketTypes.length > 0) { %>
            <% event.ticketTypes.forEach(function(t, i) { %>
            <div class="tier-row" data-tier>
              <button type="button" class="tier-remove" onclick="removeTier(this)">×</button>
              <div class="tier-row-grid">
                <div><label class="lbl">Tier Name</label><input type="text" data-field="name" value="<%= t.name %>" placeholder="Gold"/></div>
                <div><label class="lbl">Category</label>
                  <select data-field="category">
                    <% ['standard','silver','gold','platinum','vip','general'].forEach(function(cat){ %>
                      <option value="<%= cat %>" <%= t.category===cat?'selected':'' %>><%= cat.charAt(0).toUpperCase()+cat.slice(1) %></option>
                    <% }); %>
                  </select>
                </div>
                <div><label class="lbl">Price (₹)</label><input type="number" data-field="price" value="<%= t.price %>" min="0"/></div>
                <div><label class="lbl">Total Seats</label><input type="number" data-field="totalSeats" value="<%= t.totalSeats %>" min="1"/></div>
              </div>
              <div style="margin-bottom:0.6rem;">
                <label class="lbl">Booked Seats</label>
                <input type="number" data-field="bookedSeats" value="<%= t.bookedSeats %>" min="0" style="max-width:140px;"/>
              </div>
              <div><label class="lbl">Includes (one per line)</label>
                <textarea data-field="includes" rows="3"><%= (t.includes||[]).join('\n') %></textarea>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <div class="tier-row" data-tier>
              <button type="button" class="tier-remove" onclick="removeTier(this)">×</button>
              <div class="tier-row-grid">
                <div><label class="lbl">Tier Name</label><input type="text" data-field="name" value="Standard" placeholder="Standard"/></div>
                <div><label class="lbl">Category</label>
                  <select data-field="category">
                    <option value="standard" selected>Standard</option><option value="silver">Silver</option>
                    <option value="gold">Gold</option><option value="platinum">Platinum</option>
                    <option value="vip">VIP</option><option value="general">General</option>
                  </select>
                </div>
                <div><label class="lbl">Price (₹)</label><input type="number" data-field="price" value="599" min="0"/></div>
                <div><label class="lbl">Total Seats</label><input type="number" data-field="totalSeats" value="200" min="1"/></div>
              </div>
              <div><label class="lbl">Includes (one per line)</label>
                <textarea data-field="includes" rows="3" placeholder="Entry Pass&#10;Welcome Drink"></textarea>
              </div>
            </div>
          <% } %>
        </div>
        <button type="button" class="btn-add-tier" onclick="addTier()">
          <i class="bi bi-plus-circle"></i> Add Ticket Tier
        </button>
      </div>

      <button type="submit" class="btn-submit" id="submitBtn">
        <i class="bi bi-check2-circle"></i> <%= event ? 'Update Event' : 'Create Event' %>
      </button>
    </form>
  </main>
</div>

<script>
  // ── Called on form submit — collects tiers into hidden JSON field ──
  function injectTiersAndSubmit() {
    const rows = document.querySelectorAll('[data-tier]');
    const tiers = [];

    for (const row of rows) {
      const name = (row.querySelector('[data-field="name"]')?.value || '').trim();
      if (!name) { alert('All tier names are required.'); return false; }
      tiers.push({
        name,
        category:    row.querySelector('[data-field="category"]')?.value || 'standard',
        price:       parseInt(row.querySelector('[data-field="price"]')?.value)      || 0,
        totalSeats:  parseInt(row.querySelector('[data-field="totalSeats"]')?.value) || 0,
        bookedSeats: parseInt(row.querySelector('[data-field="bookedSeats"]')?.value)|| 0,
        includes:    (row.querySelector('[data-field="includes"]')?.value || '')
                       .split('\n').map(s => s.trim()).filter(Boolean),
        isActive: true,
      });
    }

    // Inject into hidden field and let the normal form POST proceed
    document.getElementById('ticketTypesJson').value = JSON.stringify(tiers);
    console.log('📤 Injecting tiers:', tiers.length, JSON.stringify(tiers));
    return true; // allow form to submit normally
  }

  function addTier() {
    const div = document.createElement('div');
    div.className = 'tier-row';
    div.setAttribute('data-tier', '');
    div.innerHTML = `
      <button type="button" class="tier-remove" onclick="removeTier(this)">×</button>
      <div class="tier-row-grid">
        <div><label class="lbl">Tier Name</label><input type="text" data-field="name" placeholder="Gold"/></div>
        <div><label class="lbl">Category</label>
          <select data-field="category">
            <option value="standard">Standard</option><option value="silver">Silver</option>
            <option value="gold">Gold</option><option value="platinum">Platinum</option>
            <option value="vip">VIP</option><option value="general">General</option>
          </select>
        </div>
        <div><label class="lbl">Price (₹)</label><input type="number" data-field="price" placeholder="999" min="0"/></div>
        <div><label class="lbl">Total Seats</label><input type="number" data-field="totalSeats" placeholder="100" min="1"/></div>
      </div>
      <div><label class="lbl">Includes (one per line)</label>
        <textarea data-field="includes" rows="3" placeholder="Entry Pass&#10;Welcome Drink&#10;Photo Booth"></textarea>
      </div>`;
    document.getElementById('tierList').appendChild(div);
  }

  function removeTier(btn) {
    const rows = document.querySelectorAll('[data-tier]');
    if (rows.length > 1) btn.closest('[data-tier]').remove();
    else alert('At least one ticket tier is required.');
  }
</script>
</body>
</html>
