<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--text:#fff;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    .layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;overflow-y:auto;}
    .s-logo{display:block;padding:0 0.5rem 1rem;border-bottom:1px solid var(--border);margin-bottom:0.5rem;}
    .s-section{font-family:'Space Mono',monospace;font-size:0.48rem;letter-spacing:2px;color:#333;text-transform:uppercase;padding:0.6rem 0.8rem 0.2rem;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(106,13,173,0.08);border-color:rgba(106,13,173,0.2);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,68,68,0.08);}
/* ── Sidebar ── */
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;z-index:10;overflow-y:auto;scrollbar-width:none;-ms-overflow-style:none;}
    .sidebar::-webkit-scrollbar{display:none;}
    .s-logo{display:block;padding:0 0.5rem 1rem;border-bottom:1px solid var(--border);margin-bottom:0.5rem;text-decoration:none;}
    .s-section{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.5rem 0.5rem 0.2rem;margin-top:0.3rem;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(106,13,173,0.08);border-color:rgba(106,13,173,0.2);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,68,68,0.08);}

    .page-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;}
    .page-title{font-family:'Poppins',sans-serif;font-size:2rem;letter-spacing:2px;}
    .btn-new{display:inline-flex;align-items:center;gap:0.5rem;background:var(--accent);color:#fff;padding:0.65rem 1.4rem;border-radius:7px;font-weight:700;font-size:0.85rem;letter-spacing:1px;border:none;cursor:pointer;transition:box-shadow 0.2s;}
    .btn-new:hover{box-shadow:0 0 24px rgba(106,13,173,0.5);}


    .main{padding:2rem;overflow-x:hidden;}
    .page-title{font-family:'Poppins',sans-serif;font-size:1.8rem;letter-spacing:2px;margin-bottom:0.3rem;}
    .page-sub{font-size:0.78rem;color:var(--muted);margin-bottom:2rem;}
    .filter-bar{display:flex;gap:1rem;align-items:flex-end;margin-bottom:1.5rem;flex-wrap:wrap;}
    .f-grp{display:flex;flex-direction:column;gap:0.3rem;flex:1;min-width:260px;}
    .f-lbl{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:1px;color:#555;text-transform:uppercase;}
    .f-sel{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.88rem;padding:0.65rem 0.85rem;outline:none;width:100%;}
    .f-sel option{background:#1a1a2e;}
    .filter-btn{padding:0.7rem 1.5rem;background:var(--accent);color:#fff;border:none;border-radius:7px;font-weight:700;font-size:0.85rem;cursor:pointer;}
    .stat-row{display:flex;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;}
    .stat-box{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:0.9rem 1.2rem;display:flex;align-items:center;gap:0.8rem;min-width:140px;}
    .stat-box i{font-size:1.4rem;color:var(--accent);}
    .stat-val{font-family:'Poppins',sans-serif;font-size:1.4rem;letter-spacing:1px;}
    .stat-lbl{font-size:0.68rem;color:var(--muted);}
    .search-bar{display:flex;gap:0.5rem;margin-bottom:1rem;}
    .search-inp{flex:1;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.85rem;padding:0.6rem 0.85rem;outline:none;}
    .search-inp::placeholder{color:#444;}
    .table-wrap{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .table-scroll{overflow-x:auto;}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:#555;text-transform:uppercase;padding:0.7rem 1rem;border-bottom:1px solid var(--border);text-align:left;white-space:nowrap;}
    td{padding:0.85rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.84rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.015);}
    .badge{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:1px;padding:0.18rem 0.55rem;border-radius:4px;display:inline-block;}
    .badge-type{background:rgba(106,13,173,0.12);border:1px solid rgba(106,13,173,0.3);color:#bf80ff;}
    .badge-grp{background:rgba(245,200,66,0.1);border:1px solid rgba(245,200,66,0.3);color:#f5c842;}
    .badge-single{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);color:#00FF88;}
    .gender-m{color:#64b5f6;}.gender-f{color:#f48fb1;}.gender-o{color:#ce93d8;}
    .empty{text-align:center;padding:3rem;color:#555;}
    .empty i{font-size:2.5rem;display:block;margin-bottom:0.8rem;}
    .ev-header{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.2rem 1.5rem;margin-bottom:1.2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;}
    .ev-name{font-family:'Poppins',sans-serif;font-size:1.1rem;letter-spacing:2px;}
    .ev-meta{font-size:0.78rem;color:var(--muted);margin-top:0.2rem;}
    @media(max-width:900px){.layout{grid-template-columns:1fr;}.sidebar{display:none;}}
    .btn-back-dash{display:inline-flex;align-items:center;gap:0.3rem;color:var(--muted);text-decoration:none;font-size:0.78rem;font-family:'Space Mono',monospace;letter-spacing:1px;padding:0.35rem 0.75rem;border:1px solid var(--border);border-radius:5px;background:rgba(255,255,255,0.03);margin-bottom:1.5rem;transition:all 0.15s;}
    .btn-back-dash:hover{color:#fff;border-color:rgba(255,255,255,0.2);background:rgba(255,255,255,0.06);}
  </style>
</head>
<body>
<div class="layout">
    <%- include('../partials/admin-sidebar', { activePage: 'entered-tickets' }) %>
    <%- include('../partials/admin-confirm') %>

  <main class="main">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.8rem;margin-bottom:0.3rem;">
      <h1 class="page-title">ENTERED TICKETS</h1>
      <div style="display:flex;align-items:center;gap:0.6rem;">
        <span id="autoRefreshLbl" style="font-family:'Space Mono',monospace;font-size:0.6rem;color:#555;letter-spacing:1px;">AUTO-REFRESH: ON</span>
        <button onclick="toggleAutoRefresh()" id="arBtn" style="padding:0.35rem 0.8rem;background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);color:#00FF88;border-radius:5px;font-size:0.72rem;cursor:pointer;font-family:'Space Mono',monospace;">⏸ Pause</button>
        <button onclick="manualRefresh()" style="padding:0.35rem 0.8rem;background:rgba(106,13,173,0.1);border:1px solid rgba(106,13,173,0.3);color:#bf80ff;border-radius:5px;font-size:0.72rem;cursor:pointer;font-family:'Space Mono',monospace;">↻ Refresh</button>
      </div>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.8rem;margin-bottom:1.5rem;">
      <p class="page-sub" style="margin-bottom:0;">Real-time gate log. <span id="lastRefreshed" style="color:#555;font-size:0.7rem;"></span></p>
      <div style="display:flex;align-items:center;gap:0.7rem;">
        <span id="autoRefreshStatus" style="font-family:'Space Mono',monospace;font-size:0.58rem;color:#555;letter-spacing:1px;"></span>
        <button onclick="manualRefresh()" style="background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.2);color:#00FF88;padding:0.4rem 0.9rem;border-radius:6px;font-size:0.75rem;font-family:'Space Mono',monospace;cursor:pointer;display:flex;align-items:center;gap:0.4rem;"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        <button id="autoBtn" onclick="toggleAuto()" style="background:rgba(106,13,173,0.1);border:1px solid rgba(106,13,173,0.3);color:#bf80ff;padding:0.4rem 0.9rem;border-radius:6px;font-size:0.75rem;font-family:'Space Mono',monospace;cursor:pointer;">⏱ Auto: OFF</button>
      </div>
    </div>

    <form method="GET" action="/admin/entered-tickets" class="filter-bar">
      <div class="f-grp">
        <label class="f-lbl">Select Event</label>
        <select class="f-sel" name="eventId" onchange="this.form.submit()">
          <% events.forEach(function(ev){ %>
          <option value="<%= ev._id %>" <%= selectedEventId===ev._id.toString()?'selected':'' %>><%= ev.name %> — <%= new Date(ev.date).toLocaleDateString('en-IN') %></option>
          <% }); %>
        </select>
      </div>
    </form>

    <% if(selectedEvent){ %>
    <div class="ev-header">
      <div>
        <div class="ev-name"><%= selectedEvent.name.toUpperCase() %></div>
        <div class="ev-meta"><%= new Date(selectedEvent.date).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></div>
      </div>
      <div style="font-family:'Space Mono',monospace;font-size:0.7rem;letter-spacing:2px;color:var(--accent);"><%= logs.length %> ENTRIES</div>
    </div>

    <% if(logs.length > 0){ %>
    <div class="stat-row">
      <div class="stat-box"><i class="bi bi-door-open-fill"></i><div><div class="stat-val"><%= logs.length %></div><div class="stat-lbl">Total Entries</div></div></div>
      <div class="stat-box"><i class="bi bi-person-fill" style="color:#64b5f6;"></i><div><div class="stat-val"><%= logs.filter(function(l){return l.attendeeGender==='male';}).length %></div><div class="stat-lbl">Male</div></div></div>
      <div class="stat-box"><i class="bi bi-person-fill" style="color:#f48fb1;"></i><div><div class="stat-val"><%= logs.filter(function(l){return l.attendeeGender==='female';}).length %></div><div class="stat-lbl">Female</div></div></div>
      <div class="stat-box"><i class="bi bi-people-fill" style="color:#f5c842;"></i><div><div class="stat-val"><%= logs.filter(function(l){return l.isGroup;}).length %></div><div class="stat-lbl">Group Entries</div></div></div>
    </div>

    <div class="search-bar">
      <input class="search-inp" type="text" id="searchInp" placeholder="Search name, ticket ID, ref, staff..." oninput="filterTable(this.value)"/>
    </div>
    <% } %>

    <div class="table-wrap">
      <div class="table-scroll">
      <% if(logs.length === 0){ %>
      <div class="empty"><i class="bi bi-door-closed"></i>No entries recorded yet for this event.<br/><span style="font-size:0.75rem;margin-top:0.4rem;display:block;">Records appear here when QR codes are scanned at the gate.</span></div>
      <% } else { %>
      <table id="etTable">
        <thead><tr>
          <th>#</th><th>Attendee</th><th>Age</th><th>Gender</th><th>Ticket Type</th><th>Entry Type</th><th>Ticket ID</th><th>Booking Ref</th><th>Scanned By</th><th>Time</th>
        </tr></thead>
        <tbody>
        <% logs.forEach(function(log, i){ %>
        <tr>
          <td style="color:var(--muted);font-family:'Space Mono',monospace;font-size:0.72rem;"><%= i+1 %></td>
          <td><strong><%= log.attendeeName || '—' %></strong></td>
          <td style="color:var(--muted);"><%= log.attendeeAge > 0 ? log.attendeeAge : '—' %></td>
          <td>
            <% if(log.attendeeGender==='male'){ %><span class="gender-m"><i class="bi bi-gender-male"></i> M</span>
            <% } else if(log.attendeeGender==='female'){ %><span class="gender-f"><i class="bi bi-gender-female"></i> F</span>
            <% } else { %><span style="color:#555;">—</span><% } %>
          </td>
          <td><span class="badge badge-type"><%= (log.ticketType||'—').toUpperCase() %></span></td>
          <td>
            <% if(log.isGroup){ %><span class="badge badge-grp"><i class="bi bi-people-fill"></i> GROUP (<%= log.groupSize %>)</span>
            <% } else { %><span class="badge badge-single"><i class="bi bi-person-fill"></i> SINGLE</span><% } %>
          </td>
          <td style="font-family:'Space Mono',monospace;font-size:0.68rem;color:var(--muted);"><%= log.ticketId %></td>
          <td style="font-family:'Space Mono',monospace;font-size:0.68rem;color:#bf80ff;"><%= log.bookingRef %></td>
          <td style="font-size:0.8rem;color:var(--muted);"><%= log.staffName || log.scannedBy || '—' %></td>
          <td style="font-family:'Space Mono',monospace;font-size:0.7rem;color:var(--muted);white-space:nowrap;"><%= new Date(log.scannedAt).toLocaleString('en-IN',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></td>
        </tr>
        <% }); %>
        </tbody>
      </table>
      <% } %>
      </div>
    </div>
    <% } %>
  </main>
</div>
<script>
function filterTable(q){
  q = q.toLowerCase();
  document.querySelectorAll('#etTable tbody tr').forEach(function(r){
    r.style.display = r.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
}

// ── Auto-refresh ──
var autoInterval = null;
var autoOn = false;
var refreshSecs = 30;
var countdown = refreshSecs;

function manualRefresh(){
  window.location.reload();
}

function toggleAuto(){
  autoOn = !autoOn;
  var btn = document.getElementById('autoBtn');
  if(autoOn){
    countdown = refreshSecs;
    btn.style.background = 'rgba(0,255,136,0.1)';
    btn.style.borderColor = 'rgba(0,255,136,0.3)';
    btn.style.color = '#00FF88';
    btn.textContent = '⏱ Auto: ON';
    autoInterval = setInterval(function(){
      countdown--;
      var st = document.getElementById('autoRefreshStatus');
      if(st) st.textContent = 'Refreshing in '+countdown+'s';
      if(countdown<=0){ window.location.reload(); }
    }, 1000);
  } else {
    clearInterval(autoInterval);
    btn.style.background = 'rgba(106,13,173,0.1)';
    btn.style.borderColor = 'rgba(106,13,173,0.3)';
    btn.style.color = '#bf80ff';
    btn.textContent = '⏱ Auto: OFF';
    var st = document.getElementById('autoRefreshStatus');
    if(st) st.textContent = '';
  }
}

// Auto-refresh
var arInterval = null;
var arOn = true;
var AR_SECONDS = 30;

function setLastRefreshed(){
  var el = document.getElementById('lastRefreshed');
  if(el) el.textContent = 'Last refreshed: ' + new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
}

function manualRefresh(){
  setLastRefreshed();
  location.reload();
}

function toggleAutoRefresh(){
  arOn = !arOn;
  var btn = document.getElementById('arBtn');
  var lbl = document.getElementById('autoRefreshLbl');
  if(arOn){
    btn.textContent = '⏸ Pause';
    btn.style.color = '#00FF88';
    btn.style.borderColor = 'rgba(0,255,136,0.25)';
    btn.style.background  = 'rgba(0,255,136,0.08)';
    if(lbl) lbl.textContent = 'AUTO-REFRESH: ON';
    startAR();
  } else {
    btn.textContent = '▶ Resume';
    btn.style.color = '#f5c842';
    btn.style.borderColor = 'rgba(245,200,66,0.25)';
    btn.style.background  = 'rgba(245,200,66,0.06)';
    if(lbl) lbl.textContent = 'AUTO-REFRESH: OFF';
    clearInterval(arInterval);
  }
}

function startAR(){
  clearInterval(arInterval);
  arInterval = setInterval(function(){
    setLastRefreshed();
    location.reload();
  }, AR_SECONDS * 1000);
}

setLastRefreshed();
startAR();
</script>
</body>
</html>
