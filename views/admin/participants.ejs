<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--text:#fff;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;z-index:10;overflow-y:auto;}
    .s-logo{display:block;padding:0 0.5rem 1.2rem;border-bottom:1px solid var(--border);margin-bottom:0.8rem;}
    .s-section{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:var(--muted);padding:0.5rem;margin-top:0.5rem;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(106,13,173,0.07);border-color:rgba(106,13,173,0.15);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;}
    .s-logout:hover{background:rgba(255,92,92,0.08);}
    .main{padding:2rem;position:relative;z-index:1;}
    .page-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;}
    .page-title{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;}
    .filter-bar{display:flex;gap:0.8rem;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;}
    .f-sel{background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.88rem;padding:0.6rem 0.85rem;outline:none;min-width:260px;}
    .f-sel:focus{border-color:rgba(106,13,173,0.45);}
    .search-inp{flex:1;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.88rem;padding:0.6rem 0.85rem;outline:none;min-width:200px;}
    .search-inp:focus{border-color:rgba(106,13,173,0.45);}
    .stat-row{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;}
    .stat-chip{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:0.7rem 1.2rem;display:flex;align-items:center;gap:0.6rem;font-size:0.82rem;}
    .stat-chip i{color:var(--accent);}
    .stat-num{font-family:'Anton',sans-serif;font-size:1.3rem;letter-spacing:1px;color:#fff;}
    .table-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .table-scroll{overflow-x:auto;}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.54rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.8rem 1rem;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap;}
    td{padding:0.75rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.82rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.015);}
    .badge-m{background:rgba(106,13,173,0.15);color:#bf80ff;border:1px solid rgba(106,13,173,0.3);font-size:0.6rem;padding:0.1rem 0.45rem;border-radius:8px;font-family:'Space Mono',monospace;}
    .badge-f{background:rgba(255,92,150,0.1);color:#ff92b4;border:1px solid rgba(255,92,150,0.3);font-size:0.6rem;padding:0.1rem 0.45rem;border-radius:8px;font-family:'Space Mono',monospace;}
    .badge-o{background:rgba(255,255,255,0.06);color:#999;border:1px solid rgba(255,255,255,0.12);font-size:0.6rem;padding:0.1rem 0.45rem;border-radius:8px;font-family:'Space Mono',monospace;}
    .badge-g{background:rgba(0,255,136,0.07);color:#00FF88;border:1px solid rgba(0,255,136,0.2);font-size:0.6rem;padding:0.1rem 0.45rem;border-radius:8px;font-family:'Space Mono',monospace;}
    .ref{font-family:'Space Mono',monospace;font-size:0.68rem;color:var(--accent);}
    .empty{text-align:center;padding:4rem 2rem;color:#555;}
    @media(max-width:900px){.admin-layout{grid-template-columns:1fr;}.sidebar{display:none;}}
    .btn-back-dash{display:inline-flex;align-items:center;gap:0.3rem;color:var(--muted);text-decoration:none;font-size:0.78rem;font-family:'Space Mono',monospace;letter-spacing:1px;padding:0.35rem 0.75rem;border:1px solid var(--border);border-radius:5px;background:rgba(255,255,255,0.03);margin-bottom:1.5rem;transition:all 0.15s;}
    .btn-back-dash:hover{color:#fff;border-color:rgba(255,255,255,0.2);background:rgba(255,255,255,0.06);}
  </style>
</head>
<body>
<div class="admin-layout">
    <%- include('../partials/admin-sidebar', { activePage: 'participants' }) %>
  <main class="main">
    <div class="page-header">
      <div>
        <div class="page-title">PARTICIPANTS</div>
        <div style="font-size:0.78rem;color:var(--muted);margin-top:0.2rem;">People who entered events via QR scan</div>
      </div>
    </div>

    <!-- Event selector + search -->
    <form method="GET" action="/admin/participants" class="filter-bar" id="filterForm">
      <select class="f-sel" name="event" onchange="this.form.submit()">
        <% events.forEach(function(ev){ %>
        <option value="<%= ev._id %>" <%= selectedId===ev._id.toString()?'selected':'' %>>
          <%= ev.name %> — <%= new Date(ev.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
        </option>
        <% }); %>
      </select>
      <input class="search-inp" id="searchInp" placeholder="Search by name, ref, ticket type…" oninput="filterTable()" />
    </form>

    <% if(logs.length > 0){ %>
    <!-- Stats -->
    <div class="stat-row">
      <div class="stat-chip"><i class="bi bi-people-fill"></i><div><div class="stat-num"><%= logs.length %></div><div style="font-size:0.68rem;color:var(--muted);">Total Scanned</div></div></div>
      <div class="stat-chip"><i class="bi bi-person-fill" style="color:#bf80ff;"></i><div><div class="stat-num"><%= logs.filter(l=>l.attendeeGender==='male').length %></div><div style="font-size:0.68rem;color:var(--muted);">Male</div></div></div>
      <div class="stat-chip"><i class="bi bi-person-fill" style="color:#ff92b4;"></i><div><div class="stat-num"><%= logs.filter(l=>l.attendeeGender==='female').length %></div><div style="font-size:0.68rem;color:var(--muted);">Female</div></div></div>
      <div class="stat-chip"><i class="bi bi-qr-code-scan"></i><div><div class="stat-num"><%= logs.filter(l=>l.isGroup).length %></div><div style="font-size:0.68rem;color:var(--muted);">Group Entries</div></div></div>
    </div>
    <% } %>

    <div class="table-card">
      <div class="table-scroll">
        <% if(logs.length === 0){ %>
        <div class="empty">
          <i class="bi bi-qr-code-scan" style="font-size:2.5rem;display:block;margin-bottom:0.8rem;color:#333;"></i>
          <div style="font-size:0.88rem;">No scan records for this event yet.</div>
          <div style="font-size:0.72rem;margin-top:0.3rem;color:#444;">Records appear here after QR codes are scanned at the venue.</div>
        </div>
        <% } else { %>
        <table id="partTable">
          <thead><tr>
            <th>#</th>
            <th>Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Ticket Type</th>
            <th>Booking Ref</th>
            <th>Scanned By</th>
            <th>Scanned At</th>
            <th>Entry</th>
          </tr></thead>
          <tbody>
            <% logs.forEach(function(log, idx){ %>
            <tr>
              <td style="color:#555;font-size:0.72rem;"><%= idx+1 %></td>
              <td style="font-weight:600;color:#fff;"><%= log.attendeeName||'—' %></td>
              <td style="color:var(--muted);"><%= log.attendeeAge||'—' %></td>
              <td>
                <% if(log.attendeeGender==='male'){ %><span class="badge-m">♂ Male</span>
                <% }else if(log.attendeeGender==='female'){ %><span class="badge-f">♀ Female</span>
                <% }else if(log.attendeeGender){ %><span class="badge-o"><%= log.attendeeGender %></span>
                <% }else{ %><span style="color:#444;">—</span><% } %>
              </td>
              <td style="font-size:0.78rem;color:var(--muted);"><%= log.ticketType||'—' %></td>
              <td><span class="ref"><%= log.bookingRef||'—' %></span></td>
              <td style="font-size:0.78rem;"><%= log.scannedBy||'—' %></td>
              <td style="font-size:0.72rem;color:var(--muted);white-space:nowrap;"><%= new Date(log.scannedAt).toLocaleString('en-IN',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></td>
              <td>
                <% if(log.isGroup){ %><span class="badge-g">Group × <%= log.groupSize %></span>
                <% }else{ %><span style="font-size:0.68rem;color:#555;">Single</span><% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>
  </main>
</div>
<script>
function filterTable(){
  const q=document.getElementById('searchInp').value.toLowerCase();
  document.querySelectorAll('#partTable tbody tr').forEach(r=>{
    r.style.display=r.textContent.toLowerCase().includes(q)?'':'none';
  });
}
</script>
</body>
</html>
