<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--card:#14141C;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--text:#FFFFFF;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    /* Sidebar */
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;z-index:10;}
    .s-logo{font-family:'Anton',sans-serif;font-size:1.3rem;letter-spacing:3px;color:#fff;text-decoration:none;display:block;padding:0 0.5rem 1.2rem;border-bottom:1px solid var(--border);margin-bottom:0.8rem;}
    .s-logo span{color:var(--accent);}
    .s-section{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.5rem;margin-top:0.5rem;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(106,13,173,0.07);border-color:rgba(106,13,173,0.15);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,92,92,0.08);border-color:rgba(255,92,92,0.2);}
    /* Main */
    .main{padding:2rem;position:relative;z-index:1;overflow-x:hidden;}
    .table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
    .page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;}
    .page-title{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;color:#fff;}
    .btn-primary{display:inline-flex;align-items:center;gap:0.5rem;background:var(--accent);color:#fff;padding:0.7rem 1.4rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:0.85rem;letter-spacing:1px;transition:all 0.2s;border:none;cursor:pointer;}
    .btn-primary:hover{box-shadow:0 0 20px rgba(106,13,173,0.4);color:#000;}
    /* Stats */
    .stats-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;margin-bottom:2rem;}
    .stat-card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:1.2rem;}
    .stat-val{font-family:'Anton',sans-serif;font-size:2rem;color:var(--accent);margin-bottom:0.2rem;}
    .stat-lbl{font-size:0.78rem;color:var(--muted);}
    /* Flash */
    .flash{background:rgba(144,78,221,0.08);border:1px solid rgba(144,78,221,0.25);border-radius:6px;padding:0.8rem 1.2rem;color:var(--success);font-size:0.85rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;}
    /* Events table */
    .table-card{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .table-header{padding:1.2rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
    .table-title{font-family:'Anton',sans-serif;font-size:1.2rem;letter-spacing:1px;color:#fff;}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.8rem 1.2rem;text-align:left;border-bottom:1px solid var(--border);}
    td{padding:1rem 1.2rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.85rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.02);}
    .badge{display:inline-flex;align-items:center;gap:0.3rem;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;}
    .badge-on{background:rgba(106,13,173,0.15);border:1px solid rgba(144,78,221,0.3);color:var(--success);}
    .badge-off{background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.3);color:var(--error);}
    .action-btns{display:flex;gap:0.5rem;flex-wrap:wrap;}
    .btn-sm{display:inline-flex;align-items:center;gap:0.3rem;padding:0.35rem 0.75rem;border-radius:4px;font-size:0.78rem;font-family:'Outfit',sans-serif;font-weight:600;cursor:pointer;text-decoration:none;border:1px solid var(--border);background:transparent;color:var(--text);transition:all 0.15s;}
    .btn-sm:hover{border-color:var(--accent);color:var(--accent);}
    .btn-sm.danger{border-color:rgba(255,92,92,0.3);color:var(--error);}
    .btn-sm.danger:hover{background:rgba(255,92,92,0.08);}
    .tier-pill{display:inline-block;font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;padding:0.15rem 0.5rem;border-radius:10px;margin-right:2px;margin-bottom:2px;}
    .event-name{font-weight:600;color:#fff;margin-bottom:0.2rem;}
    .event-date{font-size:0.75rem;color:var(--muted);}
    @media(max-width:900px){.admin-layout{grid-template-columns:1fr;}.sidebar{display:none;}.stats-grid{grid-template-columns:repeat(2,1fr);}}
  </style>
</head>
<body>
<div class="admin-layout">
  <aside class="sidebar">
    <a href="/admin" class="s-logo"><img src="/img/mee-logo.png" alt="MEE" style="height:28px;width:auto;object-fit:contain;"/></a>
    <div class="s-section">Main</div>
    <a href="/admin" class="s-link active"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <a href="/admin/bookings" class="s-link"><i class="bi bi-ticket-perforated-fill"></i> Bookings</a>
    <a href="/admin/participants" class="s-link"><i class="bi bi-person-check-fill"></i> Participants</a>
    <a href="/admin/entered-tickets" class="s-link"><i class="bi bi-door-open-fill"></i> Entered Tickets</a>
    <a href="/admin/users-by-event" class="s-link"><i class="bi bi-people-fill"></i> Users by Event</a>
    <div class="s-section">Events</div>
    <a href="/admin/events/new" class="s-link"><i class="bi bi-plus-circle-fill"></i> New Event</a>
    <a href="/admin/reviews"      class="s-link"><i class="bi bi-star-fill"></i> Reviews</a>
    <a href="/admin/banners"       class="s-link"><i class="bi bi-image-fill"></i> Banners</a>
    <a href="/" class="s-link" target="_blank"><i class="bi bi-box-arrow-up-right"></i> View Site</a>
    <a href="/admin/coupons"        class="s-link"><i class="bi bi-tag-fill"></i> Coupons</a>
    <a href="/admin/staff" class="s-link"><i class="bi bi-people-fill"></i> Staff</a>
        <a href="/admin/profile" class="s-link"><i class="bi bi-person-circle"></i> My Profile</a>
    <% if(locals.isSuperAdmin){ %>
    <a href="/superadmin" class="s-link" style="color:#9D4EDD;border-color:rgba(157,78,221,0.2);background:rgba(157,78,221,0.06);"><i class="bi bi-shield-lock-fill" style="color:#9D4EDD;"></i> SuperAdmin Panel</a>
    <% } %>
    <a href="/admin/logout" class="s-logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </aside>

  <main class="main">
    <div class="page-header">
      <div class="page-title">DASHBOARD</div>
      <a href="/admin/events/new" class="btn-primary"><i class="bi bi-plus-lg"></i> New Event</a>
    </div>

    <% if (locals.query && query && query.success) { %>
      <div class="flash"><i class="bi bi-check-circle-fill"></i> <%= query.success %></div>
    <% } %>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-val"><%= stats.totalEvents %></div><div class="stat-lbl">Total Events</div></div>
      <div class="stat-card"><div class="stat-val"><%= stats.activeEvents %></div><div class="stat-lbl">Active Events</div></div>
      <div class="stat-card"><div class="stat-val"><%= stats.totalBookings %></div><div class="stat-lbl">Bookings</div></div>
      <div class="stat-card"><div class="stat-val"><%= stats.totalUsers %></div><div class="stat-lbl">Users</div></div>
      <div class="stat-card"><div class="stat-val">₹<%= (stats.revenue/1000).toFixed(1) %>k</div><div class="stat-lbl">Revenue</div></div>
    </div>

    <!-- Events Table -->
    <div class="table-card">
      <div class="table-header">
        <div class="table-title">ALL EVENTS</div>
        <a href="/admin/events/new" class="btn-primary"><i class="bi bi-plus-lg"></i> Add Event</a>
      </div>
      <% if (events.length === 0) { %>
        <div style="padding:3rem;text-align:center;color:var(--muted);">
          No events yet. <a href="/admin/events/new" style="color:var(--accent);">Create your first event →</a>
        </div>
      <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Ticket Tiers</th>
            <th>Bookings</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% events.forEach(function(ev) { %>
          <tr>
            <td>
              <div class="event-name"><%= ev.poster %> <%= ev.name %></div>
              <div class="event-date"><%= ev.venue %></div>
            </td>
            <td><%= new Date(ev.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></td>
            <td>
              <% const tierColors = {standard:'#a0a0a0',silver:'#c0c8d8',gold:'#f5c842',platinum:'#6A0DAD',vip:'#bf80ff',general:'#a0a0a0'}; %>
              <% ev.ticketTypes.forEach(function(t) { %>
                <span class="tier-pill" id="tp-<%= ev._id %>-<%= t.category %>"
                  style="background:rgba(106,13,173,0.07);border:1px solid <%= t.isActive===false?'rgba(255,68,68,0.3)':'rgba(106,13,173,0.15)' %>;color:<%= t.isActive===false?'#FF4444':tierColors[t.category]||'#6A0DAD' %>;cursor:pointer;user-select:none;"
                  title="<%= t.isActive===false?'Selling Stopped — click to resume':'Click to stop selling' %>"
                  onclick="toggleTicketCat('<%= ev._id %>','<%= t.category %>',this)">
                  <%= t.isActive===false?'⛔ ':'✓ ' %><%= t.name %> ₹<%= t.price %>
                </span>
              <% }); %>
            </td>
            <td>
              <% const booked = ev.ticketTypes.reduce((s,t)=>s+t.bookedSeats,0); %>
              <% const total  = ev.ticketTypes.reduce((s,t)=>s+t.totalSeats,0); %>
              <%= booked %> / <%= total %>
            </td>
            <td>
              <% if (ev.isActive) { %>
                <span class="badge badge-on"><i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> ACTIVE</span>
              <% } else { %>
                <span class="badge badge-off"><i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> HIDDEN</span>
              <% } %>
            </td>
            <td>
              <div class="action-btns">
                <button class="btn-sm" onclick="viewEvent('<%= ev._id %>')" style="background:rgba(106,13,173,0.1);color:#9D4EDD;border-color:rgba(106,13,173,0.2);"><i class="bi bi-eye-fill"></i> View</button>
                <a href="/admin/events/<%= ev._id %>/edit" class="btn-sm"><i class="bi bi-pencil-fill"></i> Edit</a>
                <%
                  const allStopped = ev.ticketTypes.length > 0 && ev.ticketTypes.every(t => t.isActive === false);
                  const anyStopped = ev.ticketTypes.some(t => t.isActive === false);
                %>
                <button class="btn-sm" id="stbtn-<%= ev._id %>"
                  style="<%= allStopped ? 'border-color:rgba(0,255,136,0.3);color:#00FF88;background:rgba(0,255,136,0.07);' : 'border-color:rgba(255,68,68,0.3);color:#FF4444;background:rgba(255,68,68,0.07);' %>"
                  title="<%= allStopped ? 'Resume all ticket selling' : 'Stop all ticket selling for this event' %>"
                  onclick="toggleAllTickets('<%= ev._id %>', <%= allStopped ? 'false' : 'true' %>, this)">
                  <i class="bi bi-<%= allStopped ? 'play-fill' : 'stop-fill' %>"></i>
                  <%= allStopped ? 'Resume' : 'Stop All' %>
                </button>
                <a href="/admin/seatmap/<%= ev._id %>" class="btn-sm" style="background:rgba(0,255,136,0.1);color:#00FF88;border-color:rgba(0,255,136,0.2);"><i class="bi bi-grid-3x3-gap-fill"></i> Seat Map</a>
                <form method="POST" action="/admin/events/<%= ev._id %>/toggle" style="display:inline;">
                  <button type="submit" class="btn-sm"><i class="bi bi-toggle-<%= ev.isActive ? 'on' : 'off' %>"></i> <%= ev.isActive ? 'Hide' : 'Show' %></button>
                </form>
                <form method="POST" action="/admin/events/<%= ev._id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this event?')">
                  <button type="submit" class="btn-sm danger"><i class="bi bi-trash-fill"></i> Delete</button>
                </form>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
      <% } %>
    </div>
  </main>
</div>
<script>
  // Pass query params to EJS flash
  const urlParams = new URLSearchParams(window.location.search);
  const success = urlParams.get('success');
  if (success) {
    const flash = document.querySelector('.flash');
    if (!flash) {
      const f = document.createElement('div');
      f.className = 'flash';
      f.innerHTML = '<i class="bi bi-check-circle-fill"></i> ' + success;
      document.querySelector('.main').insertBefore(f, document.querySelector('.stats-grid'));
    }
  }
</script>

<!-- ── Event Detail Modal ── -->
<div id="evModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.7);backdrop-filter:blur(6px);overflow-y:auto;">
  <div style="max-width:700px;margin:3rem auto;background:#14141C;border:1px solid rgba(255,255,255,0.1);border-radius:14px;overflow:hidden;position:relative;">
    <div style="height:3px;background:linear-gradient(90deg,transparent,#6A0DAD,#9D4EDD,transparent);"></div>
    <div style="padding:1.5rem;border-bottom:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:space-between;">
      <div id="modalTitle" style="font-family:'Anton',sans-serif;font-size:1.4rem;letter-spacing:2px;color:#fff;"></div>
      <div style="display:flex;gap:0.5rem;align-items:center;">
        <a id="modalEditBtn" href="#" class="btn-sm" style="color:#9D4EDD;border-color:rgba(106,13,173,0.3);"><i class="bi bi-pencil-fill"></i> Edit</a>
        <button onclick="closeModal()" style="background:none;border:none;color:#B3B3B3;cursor:pointer;font-size:1.4rem;line-height:1;padding:0.2rem 0.4rem;">&times;</button>
      </div>
    </div>
    <div id="modalBody" style="padding:1.5rem;"></div>
  </div>
</div>

<script>
const EVENT_DATA = <%- JSON.stringify(events.map(e=>({_id:e._id,name:e.name,date:e.date,doorsOpen:e.doorsOpen,endTime:e.endTime,venue:e.venue,venueAddress:e.venueAddress,googleMapLink:e.googleMapLink,dressCode:e.dressCode,about:e.about,shortDescription:e.shortDescription,artists:e.artists,ticketTypes:e.ticketTypes,isFeatured:e.isFeatured,isActive:e.isActive,convenienceFee:e.convenienceFee}))) %>;
const CAT_COLORS={platinum:'#9D4EDD',gold:'#f5c842',silver:'#c0c8d8',fanfit:'#00FF88',family:'#FF6B6B'};

function viewEvent(id){
  const ev=EVENT_DATA.find(e=>e._id===id);
  if(!ev)return;
  document.getElementById('modalTitle').textContent=ev.name.toUpperCase();
  document.getElementById('modalEditBtn').href=`/admin/events/${id}/edit`;
  const isSoldOut=ev.ticketTypes.length>0&&ev.ticketTypes.every(t=>t.bookedSeats>=t.totalSeats);
  const d=new Date(ev.date).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  document.getElementById('modalBody').innerHTML=`
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-bottom:1.2rem;">
      <div style="background:#0B0B0F;border-radius:8px;padding:1rem;">
        <div style="font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#B3B3B3;margin-bottom:0.8rem;">EVENT INFO</div>
        <div style="font-size:0.85rem;line-height:2;color:#B3B3B3;">
          <div><i class="bi bi-calendar3" style="color:#9D4EDD;width:18px;display:inline-block;"></i> ${d}</div>
          <div><i class="bi bi-clock" style="color:#9D4EDD;width:18px;display:inline-block;"></i> ${ev.doorsOpen} – ${ev.endTime}</div>
          <div><i class="bi bi-geo-alt-fill" style="color:#9D4EDD;width:18px;display:inline-block;"></i> ${ev.venue}</div>
          ${ev.venueAddress?`<div style="margin-left:22px;font-size:0.75rem;">${ev.venueAddress}</div>`:''}
          ${ev.dressCode?`<div><i class="bi bi-star-fill" style="color:#9D4EDD;width:18px;display:inline-block;"></i> ${ev.dressCode}</div>`:''}
          ${ev.googleMapLink?`<div><a href="${ev.googleMapLink}" target="_blank" style="color:#9D4EDD;font-size:0.75rem;"><i class="bi bi-map"></i> View Map</a></div>`:''}
          <div><i class="bi bi-currency-rupee" style="color:#9D4EDD;width:18px;display:inline-block;"></i> Conv. Fee: ₹${ev.convenienceFee||0}</div>
        </div>
      </div>
      <div style="background:#0B0B0F;border-radius:8px;padding:1rem;">
        <div style="font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#B3B3B3;margin-bottom:0.8rem;">STATUS</div>
        <div style="margin-bottom:0.5rem;">
          <span style="padding:0.25rem 0.7rem;border-radius:10px;font-size:0.72rem;font-weight:700;${ev.isActive?'background:rgba(0,255,136,0.1);color:#00FF88;border:1px solid rgba(0,255,136,0.3);':'background:rgba(255,68,68,0.1);color:#FF4444;border:1px solid rgba(255,68,68,0.3);'}">
            ${ev.isActive?'● ACTIVE':'○ INACTIVE'}
          </span>
          ${ev.isFeatured?'<span style="margin-left:0.4rem;padding:0.25rem 0.7rem;border-radius:10px;font-size:0.72rem;background:rgba(106,13,173,0.15);color:#9D4EDD;border:1px solid rgba(106,13,173,0.3);">★ FEATURED</span>':''}
        </div>
        <div style="font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#B3B3B3;margin:0.8rem 0 0.4rem;">TICKET CATEGORIES</div>
        ${ev.ticketTypes.map(t=>{
          const rem=t.totalSeats-t.bookedSeats;
          return `<div style="display:flex;align-items:center;justify-content:space-between;padding:0.3rem 0;border-bottom:1px solid rgba(255,255,255,0.04);">
            <div style="display:flex;align-items:center;gap:0.4rem;font-size:0.8rem;">
              <div style="width:8px;height:8px;border-radius:50%;background:${CAT_COLORS[t.category]||'#6A0DAD'};"></div>
              <span>${t.category.toUpperCase()}</span>
            </div>
            <div style="font-size:0.75rem;color:#B3B3B3;">₹${t.price} · ${t.bookedSeats}/${t.totalSeats} booked</div>
          </div>`;
        }).join('')}
      </div>
    </div>
    ${(ev.about||ev.shortDescription)?`<div style="background:#0B0B0F;border-radius:8px;padding:1rem;margin-bottom:1rem;font-size:0.85rem;color:#B3B3B3;line-height:1.7;">${ev.about||ev.shortDescription}</div>`:''}
    ${ev.artists&&ev.artists.length?`<div style="background:#0B0B0F;border-radius:8px;padding:1rem;">
      <div style="font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#B3B3B3;margin-bottom:0.8rem;">ARTISTS</div>
      <div style="display:flex;flex-wrap:wrap;gap:0.8rem;">
        ${ev.artists.map(a=>`<div style="display:flex;align-items:center;gap:0.6rem;background:#14141C;border-radius:8px;padding:0.5rem 0.8rem;">
          <div style="width:32px;height:32px;border-radius:50%;background:#1a0a2e;display:flex;align-items:center;justify-content:center;overflow:hidden;font-size:1.1rem;">
            ${a.photo?`<img src="${a.photo}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"/>`:'🎤'}
          </div>
          <div><div style="font-size:0.82rem;font-weight:700;">${a.name}</div><div style="font-size:0.68rem;color:#B3B3B3;">${a.designation||'ARTIST'}</div></div>
        </div>`).join('')}
      </div>
    </div>`:''}
    <div style="margin-top:1.2rem;display:flex;gap:0.6rem;">
      <a href="/event/${ev._id}" target="_blank" class="btn-sm" style="color:#9D4EDD;border-color:rgba(106,13,173,0.3);"><i class="bi bi-box-arrow-up-right"></i> View Public Page</a>
      <a href="/admin/seatmap/${ev._id}" class="btn-sm" style="color:#00FF88;border-color:rgba(0,255,136,0.2);"><i class="bi bi-grid-3x3-gap-fill"></i> Seat Map Builder</a>
      <button onclick="closeModal()" class="btn-sm danger" style="margin-left:auto;"><i class="bi bi-x"></i> Close</button>
    </div>
  `;
  document.getElementById('evModal').style.display='block';
  document.body.style.overflow='hidden';
}

function closeModal(){
  document.getElementById('evModal').style.display='none';
  document.body.style.overflow='';
}
document.getElementById('evModal').addEventListener('click',e=>{if(e.target===document.getElementById('evModal'))closeModal();});

// Toggle individual ticket category selling on/off
async function toggleAllTickets(eventId, stop, btn) {
  btn.disabled = true;
  const origHTML = btn.innerHTML;
  btn.innerHTML = '<span style="width:10px;height:10px;border:2px solid rgba(255,255,255,0.2);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;"></span>';
  try {
    const r = await fetch(`/admin/events/${eventId}/stop-all-tickets`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ stop: String(stop) }),
      credentials: 'include'
    });
    const d = await r.json();
    if (d.success) {
      if (d.stopped) {
        btn.innerHTML = '<i class="bi bi-play-fill"></i> Resume';
        btn.style.cssText = 'border-color:rgba(0,255,136,0.3);color:#00FF88;background:rgba(0,255,136,0.07);';
        btn.setAttribute('onclick', `toggleAllTickets('${eventId}', false, this)`);
        // Update all tier pills to stopped state
        document.querySelectorAll('[id^="tp-' + eventId + '-"]').forEach(el => {
          el.style.color = '#FF4444';
          el.style.borderColor = 'rgba(255,68,68,0.3)';
          const txt = el.textContent.trim().replace(/^✓ /, '');
          el.textContent = '⛔ ' + txt;
        });
      } else {
        btn.innerHTML = '<i class="bi bi-stop-fill"></i> Stop All';
        btn.style.cssText = 'border-color:rgba(255,68,68,0.3);color:#FF4444;background:rgba(255,68,68,0.07);';
        btn.setAttribute('onclick', `toggleAllTickets('${eventId}', true, this)`);
        // Update all tier pills to active state
        document.querySelectorAll('[id^="tp-' + eventId + '-"]').forEach(el => {
          el.style.color = '';
          el.style.borderColor = '';
          const txt = el.textContent.trim().replace(/^⛔ /, '');
          el.textContent = '✓ ' + txt;
        });
      }
      btn.disabled = false;
    } else {
      btn.innerHTML = origHTML; btn.disabled = false;
    }
  } catch(e) { btn.innerHTML = origHTML; btn.disabled = false; }
}

async function toggleTicketCat(eventId, category, el) {
  el.style.opacity='0.5';
  try {
    const r = await fetch(`/admin/events/${eventId}/ticket-toggle`, {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ category })
    });
    const d = await r.json();
    if (d.success) {
      if (d.isActive) {
        el.style.border='1px solid rgba(106,13,173,0.15)';
        el.style.color='#6A0DAD';
        el.innerHTML = el.innerHTML.replace('⛔ ','✓ ');
        el.title = 'Click to stop selling';
      } else {
        el.style.border='1px solid rgba(255,68,68,0.3)';
        el.style.color='#FF4444';
        el.innerHTML = el.innerHTML.replace('✓ ','⛔ ');
        el.title = 'Selling Stopped — click to resume';
      }
    }
  } catch(e) {}
  el.style.opacity='1';
}
</script>

