<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Admin Login — NightPass</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/index.css"/>
<script src="/js/ui.js" defer></script>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:#0B0B0F;color:#FFFFFF;font-family:'Outfit',sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .orb{position:fixed;top:-150px;left:50%;transform:translateX(-50%);width:600px;height:400px;border-radius:50%;background:radial-gradient(ellipse,rgba(106,13,173,0.15) 0%,transparent 65%);pointer-events:none;}
    .card{background:#14141C;border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:2.5rem;width:100%;max-width:400px;position:relative;z-index:1;box-shadow:0 40px 80px rgba(0,0,0,0.6);}
    .card-top{height:3px;background:linear-gradient(90deg,transparent,#6A0DAD,#9D4EDD,transparent);margin:-2.5rem -2.5rem 2.2rem;border-radius:14px 14px 0 0;}
    .logo{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:4px;color:#fff;text-align:center;margin-bottom:0.2rem;}
    .logo span{color:#6A0DAD;}
    .sub{text-align:center;font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:3px;color:#B3B3B3;margin-bottom:0.5rem;}
    .admin-badge{display:inline-flex;align-items:center;gap:0.5rem;background:rgba(106,13,173,0.12);border:1px solid rgba(106,13,173,0.3);border-radius:20px;padding:0.3rem 1rem;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#9D4EDD;margin:0 auto 2rem;display:flex;justify-content:center;}
    .lbl{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#B3B3B3;text-transform:uppercase;display:block;margin-bottom:0.45rem;}
    .field{margin-bottom:1.2rem;}
    input{width:100%;background:#0B0B0F;border:1.5px solid rgba(255,255,255,0.08);border-radius:8px;color:#FFFFFF;font-size:0.95rem;padding:0.85rem 1rem;font-family:'Outfit',sans-serif;outline:none;transition:border-color 0.2s;}
    input:focus{border-color:#6A0DAD;box-shadow:0 0 0 3px rgba(106,13,173,0.1);}
    .btn{width:100%;padding:0.95rem;background:#6A0DAD;color:#fff;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;border:none;border-radius:8px;cursor:pointer;letter-spacing:1px;transition:box-shadow 0.2s,transform 0.15s;margin-top:0.5rem;}
    .btn:hover{box-shadow:0 0 30px rgba(106,13,173,0.5);transform:translateY(-1px);}
    .err{background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.3);border-radius:8px;padding:0.8rem 1rem;color:#FF4444;font-size:0.85rem;margin-bottom:1.2rem;display:flex;align-items:center;gap:0.5rem;}
    .lock-icon{text-align:center;font-size:2.5rem;margin-bottom:1rem;}
  </style>
</head>
<body>
  <div class="orb"></div>
  <div class="card">
    <div class="card-top"></div>
    <div class="logo">NIGHT<span>PASS</span></div>
    <div class="sub">MELATTUR PATTU</div>
    <div class="admin-badge">🔐 ADMIN PANEL</div>

    <% if (error) { %>
      <div class="err">⚠ <%= error %></div>
    <% } %>

    <form method="POST" action="/admin/login">
      <div class="field">
        <label class="lbl">Username</label>
        <input type="text" name="username" placeholder="Enter admin username" required autofocus autocomplete="username"/>
      </div>
      <div class="field">
        <label class="lbl">Password</label>
        <input type="password" name="password" placeholder="Enter admin password" required autocomplete="current-password"/>
      </div>
      <button type="submit" class="btn">🔓 Enter Admin Panel</button>
    </form>
  </div>
</body>
</html>
