<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Error — Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--text:#fff;--muted:#B3B3B3;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;z-index:10;}
    .s-logo{display:block;padding:0 0.5rem 1.2rem;border-bottom:1px solid var(--border);margin-bottom:0.8rem;}
    .s-section{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:var(--muted);padding:0.5rem;margin-top:0.5rem;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover{background:rgba(106,13,173,0.07);border-color:rgba(106,13,173,0.15);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,92,92,0.08);}
    .main{padding:2rem;display:flex;align-items:center;justify-content:center;position:relative;z-index:1;}
    .err-card{background:var(--surface);border:1px solid rgba(255,68,68,0.2);border-radius:16px;padding:3rem 2.5rem;max-width:520px;width:100%;text-align:center;}
    .err-icon{font-size:3.5rem;color:var(--error);margin-bottom:1.2rem;}
    .err-code{font-family:'Space Mono',monospace;font-size:0.62rem;letter-spacing:3px;color:#555;margin-bottom:0.5rem;}
    .err-title{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;color:#fff;margin-bottom:0.8rem;}
    .err-msg{font-size:0.88rem;color:var(--muted);line-height:1.6;margin-bottom:2rem;}
    .err-detail{background:rgba(255,68,68,0.05);border:1px solid rgba(255,68,68,0.15);border-radius:8px;padding:1rem;margin-bottom:2rem;font-family:'Space Mono',monospace;font-size:0.7rem;color:#FF8888;text-align:left;word-break:break-word;display:<%= locals.errDetail ? 'block' : 'none' %>;}
    .btn-row{display:flex;gap:0.7rem;justify-content:center;flex-wrap:wrap;}
    .btn{display:inline-flex;align-items:center;gap:0.45rem;padding:0.75rem 1.4rem;border-radius:7px;font-weight:700;font-size:0.85rem;text-decoration:none;transition:all 0.18s;cursor:pointer;border:none;}
    .btn-primary{background:var(--accent);color:#fff;}.btn-primary:hover{box-shadow:0 0 20px rgba(106,13,173,0.4);color:#fff;}
    .btn-ghost{background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--muted);}.btn-ghost:hover{color:#fff;}
    @media(max-width:900px){.admin-layout{grid-template-columns:1fr;}.sidebar{display:none;}}
  </style>
</head>
<body>
<div class="admin-layout">
  <aside class="sidebar">
    <a href="/admin" class="s-logo"><img src="/img/mee-logo.png" alt="MEE" style="height:28px;width:auto;object-fit:contain;"/></a>
    <div class="s-section">Main</div>
    <a href="/admin"          class="s-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <a href="/admin/bookings" class="s-link"><i class="bi bi-ticket-perforated-fill"></i> Bookings</a>
    <div class="s-section">Events</div>
    <a href="/admin/events/new" class="s-link"><i class="bi bi-plus-circle-fill"></i> New Event</a>
    <a href="/admin/reviews"    class="s-link"><i class="bi bi-star-fill"></i> Reviews</a>
    <a href="/admin/banners"    class="s-link"><i class="bi bi-image-fill"></i> Banners</a>
    <a href="/" class="s-link" target="_blank"><i class="bi bi-box-arrow-up-right"></i> View Site</a>
    <a href="/admin/logout" class="s-logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </aside>
  <main class="main">
    <div class="err-card">
      <div class="err-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
      <div class="err-code">ERROR <%= locals.status || 500 %></div>
      <div class="err-title"><%= locals.errTitle || 'SOMETHING WENT WRONG' %></div>
      <div class="err-msg"><%= locals.errMessage || 'An unexpected error occurred. Please try again or go back to the dashboard.' %></div>
      <% if(locals.errDetail){ %>
      <div class="err-detail"><%= errDetail %></div>
      <% } %>
      <div class="btn-row">
        <a href="javascript:history.back()" class="btn btn-ghost"><i class="bi bi-arrow-left"></i> Go Back</a>
        <a href="/admin" class="btn btn-primary"><i class="bi bi-speedometer2"></i> Dashboard</a>
      </div>
    </div>
  </main>
</div>
</body>
</html>
