<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Login — NightPass</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--card:#14141C;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--accent-dim:rgba(106,13,173,0.09);--text:#FFFFFF;--muted:#B3B3B3;--error:#FF4444;--success:#00FF88;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;display:flex;flex-direction:column;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;z-index:0;}
    .orb1{position:fixed;top:-150px;left:-100px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(106,13,173,0.05) 0%,transparent 65%);pointer-events:none;}
    .orb2{position:fixed;bottom:-150px;right:-100px;width:450px;height:450px;border-radius:50%;background:radial-gradient(circle,rgba(100,50,220,0.06) 0%,transparent 65%);pointer-events:none;}
    nav{position:relative;z-index:1;padding:1.1rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);}
    .logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:4px;color:#fff;text-decoration:none;}
    .logo span{color:var(--accent);}
    .back-link{display:flex;align-items:center;gap:0.4rem;color:var(--muted);text-decoration:none;font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s;}
    .back-link:hover{color:#fff;}
    .auth-wrapper{flex:1;display:flex;align-items:center;justify-content:center;padding:2rem 1rem;position:relative;z-index:1;}
    .auth-card{background:var(--card);border:1px solid var(--border);border-radius:14px;width:100%;max-width:440px;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,0.5);}
    .card-top-bar{height:3px;background:linear-gradient(90deg,transparent,#6A0DAD,transparent);}
    .card-inner{padding:2.2rem;}
    .event-badge{display:flex;align-items:center;gap:0.8rem;background:var(--accent-dim);border:1px solid rgba(106,13,173,0.18);border-radius:8px;padding:0.8rem 1rem;margin-bottom:1.8rem;}
    .event-badge-icon{font-size:1.4rem;}
    .event-badge-name{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:2px;color:#fff;}
    .event-badge-sub{font-size:0.72rem;color:var(--muted);margin-top:2px;}
    .eyebrow{font-family:'Space Mono',monospace;font-size:0.62rem;letter-spacing:3px;color:var(--accent);display:block;margin-bottom:0.4rem;}
    h1{font-family:'Anton',sans-serif;font-size:2.6rem;letter-spacing:2px;color:#fff;line-height:1;margin-bottom:0.5rem;}
    .subtitle{font-size:0.88rem;color:var(--muted);line-height:1.6;margin-bottom:1.6rem;}
    .subtitle a{color:var(--accent);text-decoration:none;font-weight:600;}
    .subtitle a:hover{text-decoration:underline;}
    .alert-error{display:flex;align-items:center;gap:0.5rem;background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.3);color:var(--error);padding:0.8rem 1rem;border-radius:6px;font-size:0.84rem;margin-bottom:1rem;}
    .btn-google{width:100%;padding:0.85rem 1.2rem;background:var(--surface);border:2px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;gap:0.8rem;color:var(--text);font-size:0.9rem;font-weight:500;cursor:pointer;transition:all 0.2s;text-decoration:none;font-family:'Outfit',sans-serif;}
    .btn-google:hover{border-color:rgba(255,255,255,0.2);background:rgba(255,255,255,0.04);color:#fff;}
    .google-icon{width:20px;height:20px;flex-shrink:0;}
    .divider{display:flex;align-items:center;gap:0.8rem;margin:1.2rem 0;}
    .divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--border);}
    .divider-text{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);white-space:nowrap;}
    label.field-label{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;display:block;margin-bottom:0.5rem;}
    .phone-wrap{display:flex;border:2px solid var(--border);border-radius:8px;overflow:hidden;background:var(--surface);transition:border-color 0.2s,box-shadow 0.2s;}
    .phone-wrap:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(106,13,173,0.08);}
    .phone-wrap.has-error{border-color:var(--error);}
    .country-code{display:flex;align-items:center;padding:0 1rem;border-right:1px solid var(--border);font-size:0.9rem;color:var(--text);white-space:nowrap;flex-shrink:0;background:rgba(255,255,255,0.03);}
    .phone-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-size:1rem;padding:0.88rem 1rem;font-family:'Outfit',sans-serif;letter-spacing:1px;width:100%;}
    .phone-input::placeholder{color:var(--muted);font-size:0.9rem;letter-spacing:0;}
    .hint{font-size:0.74rem;color:var(--muted);margin-top:0.5rem;}
    .error-box{display:none;align-items:center;gap:0.5rem;background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.3);border-radius:6px;padding:0.7rem 1rem;font-size:0.82rem;color:var(--error);margin-top:0.8rem;}
    .error-box.visible{display:flex;}
    .btn-submit{width:100%;padding:1rem;background:var(--accent);color:#000;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;letter-spacing:0.5px;border:none;border-radius:8px;cursor:pointer;margin-top:1.2rem;display:flex;align-items:center;justify-content:center;gap:0.6rem;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 0 25px rgba(106,13,173,0.25);}
    .btn-submit:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 0 45px rgba(106,13,173,0.5);}
    .btn-submit:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
    .spinner{width:18px;height:18px;border:2px solid rgba(0,0,0,0.25);border-top-color:#000;border-radius:50%;animation:spin 0.7s linear infinite;display:none;}
    @keyframes spin{to{transform:rotate(360deg)}}
    .footer-links{margin-top:1.5rem;text-align:center;font-size:0.84rem;color:var(--muted);}
    .footer-links a{color:var(--accent);text-decoration:none;font-weight:600;}
    .terms{margin-top:1rem;font-size:0.7rem;color:var(--muted);text-align:center;line-height:1.6;}
    .terms a{color:var(--muted);text-decoration:underline;}
    @media(max-width:480px){.card-inner{padding:1.6rem 1.2rem;}h1{font-size:2rem;}}
  </style>
</head>
<body>
  <div class="orb1"></div>
  <div class="orb2"></div>

  <nav>
    <a href="/" class="logo">NIGHT<span>PASS</span></a>
    <a href="/" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
  </nav>

  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="card-top-bar"></div>
      <div class="card-inner">

        <div class="event-badge">
          <div class="event-badge-icon">🎉</div>
          <div>
            <div class="event-badge-name">ECLIPSE DARK NIGHT</div>
            <div class="event-badge-sub">15 March 2026 · Club Axis, Kochi</div>
          </div>
        </div>

        <% if (locals.error && error) { %>
          <div class="alert-error"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
        <% } %>
        <% if (locals.success && success) { %>
          <div style="display:flex;align-items:center;gap:0.5rem;background:rgba(106,13,173,0.15);border:1px solid rgba(144,78,221,0.3);color:#00FF88;padding:0.8rem 1rem;border-radius:6px;font-size:0.84rem;margin-bottom:1rem;"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>

        <span class="eyebrow">// step 1 of 3</span>
        <h1>WELCOME<br/>BACK</h1>
        <p class="subtitle">Log in to book your entry pass. New here? <a href="/auth/signup">Create an account</a></p>

        <a href="/auth/google" class="btn-google">
          <svg class="google-icon" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Continue with Google
        </a>

        <div class="divider"><span class="divider-text">OR LOGIN WITH PHONE</span></div>

        <label class="field-label">Phone Number</label>
        <div class="phone-wrap" id="phoneWrap">
          <div class="country-code">🇮🇳 +91</div>
          <input type="tel" class="phone-input" id="phoneInput"
            placeholder="98765 43210" maxlength="10" inputmode="numeric" autocomplete="tel"/>
        </div>
        <p class="hint">We'll send a 6-digit OTP to verify your number</p>

        <div class="error-box" id="errorBox">
          <i class="bi bi-exclamation-circle-fill"></i>
          <span id="errorText"></span>
        </div>

        <button class="btn-submit" id="submitBtn" onclick="handleLogin()">
          <i class="bi bi-phone-fill" id="btnIcon"></i>
          <span id="btnText">Send OTP</span>
          <div class="spinner" id="spinner"></div>
        </button>

        <div class="footer-links">Don't have an account? <a href="/auth/signup">Sign up for free</a></div>
        <div class="terms">By continuing, you agree to our <a href="#">Terms</a> and <a href="#">Privacy Policy</a></div>
      </div>
    </div>
  </div>

  <script>
    const phoneInput = document.getElementById('phoneInput');
    const phoneWrap  = document.getElementById('phoneWrap');
    const errorBox   = document.getElementById('errorBox');
    const errorText  = document.getElementById('errorText');
    const submitBtn  = document.getElementById('submitBtn');
    const btnIcon    = document.getElementById('btnIcon');
    const btnText    = document.getElementById('btnText');
    const spinner    = document.getElementById('spinner');

    phoneInput.addEventListener('input', function() {
      this.value = this.value.replace(/\D/g, '').slice(0, 10);
      clearError();
    });

    phoneInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') handleLogin();
    });

    function showError(msg) {
      errorText.textContent = msg;
      errorBox.classList.add('visible');
      phoneWrap.classList.add('has-error');
      phoneInput.focus();
    }

    function clearError() {
      errorBox.classList.remove('visible');
      phoneWrap.classList.remove('has-error');
    }

    function setLoading(on) {
      submitBtn.disabled = on;
      btnIcon.style.display = on ? 'none' : 'inline';
      btnText.textContent = on ? 'Sending...' : 'Send OTP';
      spinner.style.display = on ? 'block' : 'none';
    }

    async function handleLogin() {
      const phone = phoneInput.value.trim();
      clearError();

      if (!phone) { showError('Please enter your phone number.'); return; }
      if (phone.length < 10) { showError('Phone number must be 10 digits.'); return; }
      if (!/^[6-9]\d{9}$/.test(phone)) { showError('Enter a valid Indian mobile number (starts with 6, 7, 8, or 9).'); return; }

      setLoading(true);
      try {
        const res = await fetch('/auth/send-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone }),
        });
        const data = await res.json();
        if (data.success) {
          window.location.replace(data.redirect || '/auth/otp');
        } else {
          showError(data.message || 'Something went wrong. Try again.');
          setLoading(false);
          if (data.redirect) setTimeout(() => window.location.replace(data.redirect), 2000);
        }
      } catch(e) {
        showError('Network error. Check your connection and try again.');
        setLoading(false);
      }
    }
  </script>

  <script>
    // Back-button guard — if session token exists, go forward not back
    (function() {
      // Replace current history entry so back button skips this page
      if (window.history && window.history.replaceState) {
        window.history.replaceState(null, '', window.location.href);
      }
    })();
  </script>
</body>
</html>
