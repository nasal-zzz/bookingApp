<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="theme-color" content="#0B0B0F"/>
  <title><%= event.name %> — MEE</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/main.css"/>
  <style>
    :root {
      --bg:#0B0B0F; --surface:#14141C; --card:#14141C;
      --border:rgba(255,255,255,0.08); --accent:#6A0DAD;
      --accent-dim:rgba(106,13,173,0.12); --text:#FFFFFF;
      --muted:#B3B3B3; --success:#00FF88; --error:#FF4444;
      --font-display:'Montserrat',sans-serif;
      --font-body:'Poppins',sans-serif;
      --font-mono:'Space Mono',monospace;
      --title-max:3rem; --body-max:1rem; --desc-max:0.75rem;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{background:var(--bg);color:var(--text);font-family:var(--font-body);min-height:100vh;overflow-x:hidden;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;z-index:0;}

    /* ── HERO BANNER ── */
    .event-hero {
      position: relative;
      width: 100%;
      height: 62vh;
      min-height: 340px;
      max-height: 620px;
      overflow: hidden;
      background: linear-gradient(135deg,#0a0014,#1a0030,#2a0050);
    }
    .event-hero-bg {
      position: absolute; inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
    .event-hero-bg::after {
      content:'';
      position: absolute; inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(8,8,14,0.3) 0%,
        rgba(8,8,14,0.55) 50%,
        rgba(8,8,14,0.95) 100%
      );
    }
    .event-hero-content {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 2.5rem 5vw;
      z-index: 2;
    }
    .event-back-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      color: rgba(255,255,255,0.7); text-decoration: none;
      font-size: var(--desc-max); font-family: var(--font-mono);
      letter-spacing: 1px; margin-bottom: 1.2rem;
      transition: color 0.2s;
    }
    .event-back-btn:hover { color: #fff; }
    .event-status-badge {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-family: var(--font-mono); font-size: var(--desc-max);
      letter-spacing: 1px; padding: 0.25rem 0.8rem;
      border-radius: 20px; margin-bottom: 0.8rem;
    }
    .event-status-badge.live { background:rgba(0,255,136,0.1); border:1px solid rgba(0,255,136,0.35); color:var(--success); }
    .event-status-badge.upcoming { background:rgba(106,13,173,0.15); border:1px solid rgba(106,13,173,0.4); color:#bf80ff; }
    .event-status-badge.soldout { background:rgba(255,68,68,0.1); border:1px solid rgba(255,68,68,0.3); color:var(--error); }
    .event-hero-name {
      font-family: var(--font-display);
      font-size: clamp(2rem,5vw,var(--title-max));
      font-weight: 800;
      color: #fff;
      line-height: 1.05;
      margin-bottom: 0.6rem;
    }
    .event-hero-name .accent { color: var(--accent); }
    .event-hero-meta {
      display: flex; flex-wrap: wrap; gap: 1.2rem;
      align-items: center;
    }
    .event-hero-meta-item {
      display: flex; align-items: center; gap: 0.4rem;
      font-size: var(--desc-max); color: rgba(255,255,255,0.75);
    }
    .event-hero-meta-item i { color: var(--accent); }

    /* ── MAIN LAYOUT ── */
    .event-layout {
      max-width: 1100px; margin: 0 auto;
      padding: 2.5rem 2rem;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 2.5rem;
      position: relative; z-index: 1;
    }
    @media(max-width:900px) {
      .event-layout { grid-template-columns:1fr; }
      .event-sidebar { order:1; position:static; }  /* sidebar below content on mobile */
    }
    @media(max-width:600px){
      .event-layout { padding:1.2rem 1rem; gap:1.5rem; }
    }

    /* ── CONTENT BLOCKS ── */

    /* ── ARTIST SECTION ── */
    .artists-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); gap:1rem; margin-top:0.8rem; }
    .artist-card { text-align:center; }
    .artist-photo { width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid rgba(106,13,173,0.5); margin:0 auto 0.5rem; display:block; background:#14141C; }
    .artist-photo-placeholder { width:80px; height:80px; border-radius:50%; background:linear-gradient(135deg,#1a0030,#2a0050); display:flex; align-items:center; justify-content:center; font-size:1.8rem; margin:0 auto 0.5rem; border:2px solid rgba(106,13,173,0.4); }
    .artist-name { font-family:var(--font-display); font-size:0.82rem; letter-spacing:1px; color:#fff; margin-bottom:0.2rem; }
    .artist-designation { font-family:var(--font-mono); font-size:0.6rem; color:var(--accent); letter-spacing:1px; }

    .content-block {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.8rem;
      margin-bottom: 1.4rem;
    }
    .content-block:last-child { margin-bottom: 0; }
    .block-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      color: #fff;
      margin-bottom: 1.2rem;
      padding-bottom: 0.7rem;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 0.5rem;
    }
    .block-title i { color: var(--accent); }

    /* Description */
    .event-description {
      font-size: var(--desc-max);
      color: var(--muted);
      line-height: 1.85;
    }

    /* Details grid */
    .details-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    @media(max-width:480px){ .details-grid{grid-template-columns:1fr;} }
    .detail-item { display: flex; flex-direction: column; gap: 0.25rem; }
    .detail-lbl {
      font-family: var(--font-mono);
      font-size: 0.58rem; letter-spacing: 1.5px;
      color: var(--muted); text-transform: uppercase;
    }
    .detail-val {
      font-size: var(--desc-max);
      color: #fff; font-weight: 500;
      display: flex; align-items: center; gap: 0.4rem;
    }
    .detail-val i { color: var(--accent); font-size: 0.85rem; }

    /* Ticket tiers list */
    .tier-list { display: flex; flex-direction: column; gap: 0.8rem; }
    .tier-row {
      display: flex; align-items: center; justify-content: space-between;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.2rem;
      transition: border-color 0.2s;
    }
    .tier-row:hover { border-color: rgba(106,13,173,0.25); }
    .tier-row-left { display: flex; flex-direction: column; gap: 0.25rem; }
    .tier-name {
      font-family: var(--font-display);
      font-weight: 700; font-size: 0.9rem; color: #fff;
    }
    .tier-avail {
      font-family: var(--font-mono); font-size: 0.58rem;
      letter-spacing: 1px; color: var(--muted);
    }
    .tier-avail.low { color: #ffaa44; }
    .tier-avail.out { color: var(--error); }
    .tier-price {
      font-family: var(--font-display);
      font-weight: 700; font-size: 1.2rem; color: var(--accent);
    }
    .tier-price small { font-family: var(--font-body); font-size: 0.6rem; color: var(--muted); font-weight: 400; }

    /* Other events */
    .other-events { display: flex; flex-direction: column; gap: 0.8rem; }
    .other-card {
      display: flex; gap: 0.9rem; align-items: center;
      text-decoration: none;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border); border-radius: 10px;
      padding: 0.8rem 1rem;
      transition: border-color 0.2s, background 0.2s;
    }
    .other-card:hover { border-color: rgba(106,13,173,0.3); background: rgba(106,13,173,0.05); }
    .other-thumb {
      width: 54px; height: 54px; border-radius: 8px; flex-shrink: 0;
      background: linear-gradient(135deg,#1a0030,#2d0050);
      overflow: hidden; display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
    }
    .other-thumb img { width:100%; height:100%; object-fit:cover; }
    .other-info { flex: 1; min-width: 0; }
    .other-name {
      font-family: var(--font-display); font-weight: 700;
      font-size: 0.8rem; color: #fff;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .other-date { font-size: 0.65rem; color: var(--muted); margin-top: 0.2rem; }
    .other-price { font-family: var(--font-display); font-size: 0.85rem; color: var(--accent); flex-shrink: 0; }

    /* ── SIDEBAR ── */
    .event-sidebar { position: sticky; top: 80px; align-self: start; }
    .sidebar-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 1.2rem;
    }
    .sidebar-card:last-child { margin-bottom: 0; }
    .sidebar-header {
      padding: 1.4rem 1.5rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    .sidebar-price-label {
      font-family: var(--font-mono); font-size: 0.6rem;
      letter-spacing: 1.5px; color: var(--muted); text-transform: uppercase;
      margin-bottom: 0.25rem;
    }
    .sidebar-price {
      font-family: var(--font-display);
      font-size: 2rem; font-weight: 800;
      color: var(--accent);
    }
    .sidebar-price small { font-family: var(--font-body); font-size: 0.7rem; color: var(--muted); font-weight: 400; }
    .sidebar-body { padding: 1.2rem 1.5rem; }

    .tier-selector { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.2rem; }
    .tier-opt {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.75rem 1rem;
      border: 1px solid var(--border); border-radius: 8px;
      cursor: pointer; transition: border-color 0.2s, background 0.2s;
      user-select: none;
    }
    .tier-opt:hover { border-color: rgba(106,13,173,0.4); background: rgba(106,13,173,0.05); }
    .tier-opt.selected { border-color: var(--accent); background: rgba(106,13,173,0.12); }
    .tier-opt-left { display: flex; align-items: center; gap: 0.6rem; }
    .tier-opt-radio {
      width: 16px; height: 16px; border-radius: 50%;
      border: 2px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: border-color 0.2s;
    }
    .tier-opt.selected .tier-opt-radio { border-color: var(--accent); }
    .tier-opt-radio::after {
      content:''; width:8px; height:8px; border-radius:50%;
      background: var(--accent); opacity:0; transition:opacity 0.2s;
    }
    .tier-opt.selected .tier-opt-radio::after { opacity:1; }
    .tier-opt-name { font-size: var(--desc-max); color: #fff; font-weight: 500; }
    .tier-opt-price { font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--accent); }
    .tier-opt-sold { font-family: var(--font-mono); font-size: 0.6rem; color: var(--error); }

    /* Qty picker */
    .qty-row {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 1.2rem;
    }
    .qty-lbl { font-size: var(--desc-max); color: #fff; font-weight: 500; }
    .qty-control { display: flex; align-items: center; gap: 0.5rem; }
    .qty-btn {
      width: 32px; height: 32px; border-radius: 6px;
      background: var(--accent-dim); border: 1px solid rgba(106,13,173,0.3);
      color: var(--accent); cursor: pointer; font-size: 1rem;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.2s; line-height: 1;
    }
    .qty-btn:hover { background: rgba(106,13,173,0.25); }
    .qty-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .qty-num {
      font-family: var(--font-display); font-weight: 700;
      font-size: 1.2rem; color: #fff; min-width: 28px; text-align: center;
    }

    /* Summary line */
    .summary-line {
      display: flex; justify-content: space-between; align-items: center;
      font-size: var(--desc-max); padding: 0.4rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .summary-line:last-of-type { border-bottom: none; }
    .summary-line span:first-child { color: var(--muted); }
    .summary-line span:last-child { color: #fff; font-weight: 600; }
    .summary-total {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 0.8rem; padding-top: 0.8rem;
      border-top: 1px solid var(--border);
    }
    .summary-total-lbl { font-size: var(--desc-max); color: var(--muted); }
    .summary-total-val { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; color: var(--accent); }

    /* CTA button */
    .btn-book-cta {
      display: flex; align-items: center; justify-content: center; gap: 0.6rem;
      width: 100%; padding: 0.95rem;
      background: var(--accent); color: #fff;
      border: none; border-radius: 8px; cursor: pointer;
      font-family: var(--font-body); font-weight: 700;
      font-size: var(--body-max); letter-spacing: 0.5px;
      text-decoration: none;
      transition: box-shadow 0.2s, transform 0.15s;
      box-shadow: 0 0 28px rgba(106,13,173,0.3);
      margin-top: 1.2rem;
    }
    .btn-book-cta:hover { transform: translateY(-2px); box-shadow: 0 0 45px rgba(106,13,173,0.55); color: #fff; }
    .btn-book-cta:disabled, .btn-book-cta.sold-out {
      background: rgba(255,255,255,0.08); color: var(--muted);
      cursor: not-allowed; pointer-events: none; box-shadow: none;
    }

    .sidebar-trust {
      display: flex; justify-content: center; gap: 1.2rem;
      margin-top: 0.9rem; flex-wrap: wrap;
    }
    .trust-item {
      display: flex; align-items: center; gap: 0.3rem;
      font-size: 0.65rem; color: var(--muted);
    }
    .trust-item i { color: var(--success); }

    /* Share card */
    .share-row { display: flex; gap: 0.7rem; }
    .share-btn {
      flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.4rem;
      padding: 0.6rem; border-radius: 8px;
      border: 1px solid var(--border); background: transparent;
      color: var(--muted); font-size: 0.78rem; cursor: pointer;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
      text-decoration: none;
    }
    .share-btn:hover { border-color: rgba(106,13,173,0.4); color: #fff; background: rgba(106,13,173,0.08); }

    /* Sold out banner */
    .sold-out-banner {
      background: rgba(255,68,68,0.07);
      border: 1px solid rgba(255,68,68,0.25);
      border-radius: 8px; padding: 0.85rem 1.1rem;
      display: flex; align-items: center; gap: 0.6rem;
      font-size: var(--desc-max); color: var(--error);
      margin-bottom: 1rem;
    }

    a { color: inherit; }
  
    /* ── Reviews ── */
    .reviews-list { display: flex; flex-direction: column; gap: 0.9rem; }
    .review-card { background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 1rem 1.2rem; }
    .review-card.dummy { opacity: 0.7; border-style: dashed; }
    .review-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
    .review-name { font-size: 0.85rem; font-weight: 600; color: #fff; }
    .review-stars { color: #f5c842; font-size: 0.85rem; letter-spacing: 1px; }
    .review-text { font-size: 0.82rem; color: var(--muted); line-height: 1.55; }
    .review-badge { font-family: 'Space Mono', monospace; font-size: 0.52rem; letter-spacing: 1px; color: #555; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 5px; padding: 0.1rem 0.4rem; }
</style>
</head>
<body>

  <%- include('../partials/navbar') %>

  <%
    const tierColors = {standard:'#a0a0a0',silver:'#c0c8d8',gold:'#f5c842',platinum:'#6A0DAD',vip:'#bf80ff',general:'#a0a0a0'};
    const activeTiers = event.ticketTypes.filter(t => t.isActive);
    const availTiers  = activeTiers.filter(t => t.bookedSeats < t.totalSeats);
    // House Full = all active categories are fully booked
    const isHouseFull = activeTiers.length > 0 && activeTiers.every(t => t.bookedSeats >= t.totalSeats);
    // Legacy alias
    const isSoldOut = isHouseFull;
    const minPrice    = availTiers.length ? Math.min(...availTiers.map(t => t.price)) : 0;
    const eventDate   = new Date(event.date);
    const now         = new Date();
    const isPast      = eventDate < now;
    const nameParts   = event.name.trim().split(' ');
    const firstName   = nameParts[0] || '';
    const restName    = nameParts.slice(1).join(' ') || '';

    // Other events (exclude current)
    const otherEvents = (events || []).filter(e => e._id.toString() !== event._id.toString()).slice(0,4);
  %>

  <!-- ═══ HERO BANNER ═══ -->
  <div class="event-hero">
    <div class="event-hero-bg"
      <% if(event.bannerDesktop){ %>
        style="background-image:url('<%= event.bannerDesktop %>')"
      <% } %>
    ></div>
    <div class="event-hero-content">
      <a href="/" class="event-back-btn"><i class="bi bi-arrow-left"></i> Back to Events</a>

      <% if(isHouseFull){ %>
        <div class="event-status-badge soldout"><i class="bi bi-house-fill"></i> House Full</div>
      <% } else if(isPast){ %>
        <div class="event-status-badge soldout"><i class="bi bi-clock-history"></i> Event Ended</div>
      <% } else { %>
        <div class="event-status-badge upcoming"><i class="bi bi-lightning-charge-fill"></i> Tickets Available</div>
      <% } %>

      <div class="event-hero-name">
        <%= firstName %>
        <% if(restName){ %><br/><span class="accent"><%= restName %></span><% } %>
      </div>

      <div class="event-hero-meta">
        <div class="event-hero-meta-item"><i class="bi bi-calendar3"></i>
          <%= eventDate.toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %>
        </div>
        <div class="event-hero-meta-item"><i class="bi bi-clock-fill"></i> <%= event.doorsOpen %> – <%= event.endTime %></div>
        <div class="event-hero-meta-item"><i class="bi bi-geo-alt-fill"></i> <%= event.venue %></div>
      </div>
    </div>
  </div>

  <!-- ═══ MAIN LAYOUT ═══ -->
  <div class="event-layout">

    <!-- ── LEFT: Event Info ── -->
    <div class="event-main">

      <!-- About -->
      <!-- Artists / Performers -->
      <% if(event.artists && event.artists.length > 0){ %>
      <div class="content-block">
        <div class="block-title"><i class="bi bi-mic-fill"></i> Performers</div>
        <div class="artists-grid">
          <% event.artists.forEach(function(artist){ %>
          <div class="artist-card">
            <% if(artist.photo){ %>
              <img class="artist-photo" src="<%= artist.photo %>" alt="<%= artist.name %>"/>
            <% } else { %>
              <div class="artist-photo-placeholder">🎤</div>
            <% } %>
            <div class="artist-name"><%= artist.name %></div>
            <% if(artist.designation){ %><div class="artist-designation"><%= artist.designation %></div><% } %>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <div class="content-block">
        <div class="block-title"><i class="bi bi-info-circle-fill"></i> About This Event</div>
        <p class="event-description">
          <% if(event.description){ %>
            <%= event.description %>
          <% } else { %>
            Join us for an unforgettable night of music, lights and celebration at <%= event.venue %>. Get your tickets now before they sell out!
          <% } %>
        </p>
      </div>

      <!-- Details -->
      <div class="content-block">
        <div class="block-title"><i class="bi bi-card-checklist"></i> Event Details</div>
        <div class="details-grid">
          <div class="detail-item">
            <div class="detail-lbl">Date</div>
            <div class="detail-val"><i class="bi bi-calendar3"></i>
              <%= eventDate.toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %>
            </div>
          </div>
          <div class="detail-item">
            <div class="detail-lbl">Time</div>
            <div class="detail-val"><i class="bi bi-clock"></i> <%= event.doorsOpen %> – <%= event.endTime %></div>
          </div>
          <div class="detail-item">
            <div class="detail-lbl">Venue</div>
            <div class="detail-val"><i class="bi bi-geo-alt-fill"></i> <%= event.venue %></div>
          </div>
          <div class="detail-item">
            <div class="detail-lbl">Age Limit</div>
            <div class="detail-val"><i class="bi bi-person-check-fill"></i> <%= event.ageLimit %>+ only</div>
          </div>
          <div class="detail-item">
            <div class="detail-lbl">Dress Code</div>
            
          </div>
          <div class="detail-item">
            <div class="detail-lbl">Genre</div>
            <div class="detail-val"><i class="bi bi-music-note-beamed"></i> <%= event.genre || 'Electronic / Live' %></div>
          </div>
        </div>
      </div>

      <!-- Ticket Tiers -->
      <!-- <% if(activeTiers.length > 0){ %>
      <div class="content-block">
        <div class="block-title"><i class="bi bi-ticket-perforated-fill"></i> Ticket Tiers</div>
        <div class="tier-list">
          <% activeTiers.forEach(function(t){ %>
          <%
            const avail = t.totalSeats - t.bookedSeats;
            const isOut = avail <= 0;
            const isLow = !isOut && avail <= 10;
            const tc = tierColors[t.category] || '#6A0DAD';
          %>
          <div class="tier-row">
            <div class="tier-row-left">
              <div class="tier-name" style="color:<%= tc %>"><%= t.name %></div>
              <% if(isOut){ %>
                <div class="tier-avail out">SOLD OUT</div>
              <% } else if(isLow){ %>
                <div class="tier-avail low"><%= avail %> seats left — hurry!</div>
              <% } else { %>
                <div class="tier-avail"><%= avail %> seats available</div>
              <% } %>
            </div>
            <div class="tier-price">₹<%= t.price.toLocaleString('en-IN') %> <small>per person</small></div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %> -->

      <!-- ── Reviews Section ── -->
      <%
        const DUMMY_REVIEWS = [
          { _id:'d1', name:'Arjun K.', stars:5, text:'Amazing event! The energy was incredible from start to finish. Definitely coming back next time.' },
          { _id:'d2', name:'Priya M.', stars:5, text:'Well organised and the artists were phenomenal. Sound quality was top-notch. 10/10 experience!' },
          { _id:'d3', name:'Rahul S.', stars:4, text:'Great show overall. Loved the vibe and the crowd. Just a small delay at entry but otherwise perfect.' },
        ];
        const realRevs = locals.realReviews || [];
        // Show dummies until real reviews fill their spots (remove one dummy per real review)
        const dummiesNeeded = Math.max(0, DUMMY_REVIEWS.length - realRevs.length);
        const displayDummies = DUMMY_REVIEWS.slice(0, dummiesNeeded);
        const allDisplayReviews = [...realRevs, ...displayDummies];
      %>
      <div class="content-block">
        <div class="block-title"><i class="bi bi-star-fill"></i> What People Say</div>
        <div class="reviews-list">
          <% allDisplayReviews.forEach(function(rv){ %>
          <% const isDummy = !rv.user; %>
          <div class="review-card <%= isDummy ? 'dummy' : '' %>">
            <div class="review-header">
              <div style="display:flex;align-items:center;gap:0.5rem;">
                <div style="width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#6A0DAD,#9D4EDD);display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;color:#fff;flex-shrink:0;">
                  <%= isDummy ? rv.name[0] : (rv.user.firstName||'?')[0].toUpperCase() %>
                </div>
                <div>
                  <div class="review-name"><%= isDummy ? rv.name : ((rv.user.firstName||'') + ' ' + (rv.user.lastName||'').trim().charAt(0) + '.') %></div>
                  <div class="review-stars">
                    <% const stars = isDummy ? rv.stars : rv.rating; %>
                    <% for(let s=1;s<=5;s++){ %><%= s<=stars?'★':'☆' %><% } %>
                  </div>
                </div>
              </div>
              <% if(isDummy){ %><span class="review-badge">Verified</span><% } else { %><span class="review-badge">Attended</span><% } %>
            </div>
            <div class="review-text"><%= isDummy ? rv.text : rv.text %></div>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- Other Events -->
      <% if(otherEvents.length > 0){ %>
      <div class="content-block">
        <div class="block-title"><i class="bi bi-calendar-event-fill"></i> Other Events</div>
        <div class="other-events">
          <% otherEvents.forEach(function(oe){ %>
          <%
            const oeMin = oe.ticketTypes.filter(t=>t.isActive&&t.bookedSeats<t.totalSeats);
            const oePrice = oeMin.length ? Math.min(...oeMin.map(t=>t.price)) : 0;
          %>
          <a href="/event/<%= oe._id %>" class="other-card">
            <div class="other-thumb">
              <% if(oe.bannerDesktop||oe.bannerMobile){ %>
                <img src="<%= oe.bannerDesktop||oe.bannerMobile %>" alt="<%= oe.name %>"/>
              <% } else { %>🎶<% } %>
            </div>
            <div class="other-info">
              <div class="other-name"><%= oe.name %></div>
              <div class="other-date">
                <i class="bi bi-calendar3" style="color:var(--accent);font-size:0.65rem;"></i>
                <%= new Date(oe.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                · <%= oe.venue %>
              </div>
            </div>
            <% if(oePrice > 0){ %>
              <div class="other-price">₹<%= oePrice.toLocaleString('en-IN') %></div>
            <% } %>
          </a>
          <% }); %>
        </div>
      </div>
      <% } %>

    </div><!-- /event-main -->

    <!-- ── RIGHT: Sidebar Booking Panel ── -->
    <div class="event-sidebar">

      <!-- Ticket booking card -->
      <div class="sidebar-card">
        <div class="sidebar-header">
          <div class="sidebar-price-label">Starting from</div>
          <% if(isHouseFull){ %>
            <div class="sidebar-price" style="color:var(--error);">🏠 House Full</div>
          <% } else if(availTiers.length === 0){ %>
            <div class="sidebar-price" style="color:var(--error);">Sold Out</div>
          <% } else { %>
            <div class="sidebar-price">₹<%= minPrice.toLocaleString('en-IN') %> <small>onwards</small></div>
          <% } %>
        </div>

        <div class="sidebar-body">

          <% if(isHouseFull){ %>
          <div class="sold-out-banner" style="background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.25);border-radius:8px;padding:1rem;text-align:center;">
            <div style="font-family:'Space Mono',monospace;font-size:0.9rem;letter-spacing:3px;color:#FF4444;font-weight:700;">🏠 HOUSE FULL</div>
            <div style="font-size:0.78rem;color:#B3B3B3;margin-top:0.3rem;">All ticket categories are sold out.</div>
          </div>
          <% } else if(activeTiers.length > 0){ %>

          <!-- Ticket price list (qty selection is in step 2) -->
          <div style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:1.5px;color:var(--muted);margin-bottom:0.6rem;text-transform:uppercase;">Ticket Categories</div>
          <div style="display:flex;flex-direction:column;gap:0.4rem;margin-bottom:1.2rem;">
            <% activeTiers.forEach(function(t){ %>
            <% const avail=t.totalSeats-t.bookedSeats, isOut=avail<=0, tc=tierColors[t.category]||'#6A0DAD'; %>
            <div style="display:flex;align-items:center;justify-content:space-between;padding:0.6rem 0.8rem;border-radius:8px;background:<%= isOut ? 'rgba(255,68,68,0.04)' : 'rgba(255,255,255,0.025)' %>;border:1px solid <%= isOut ? 'rgba(255,68,68,0.2)' : 'rgba(255,255,255,0.06)' %>;">
              <div style="display:flex;align-items:center;gap:0.5rem;">
                <div style="width:8px;height:8px;border-radius:50%;background:<%= isOut ? '#555' : tc %>;flex-shrink:0;"></div>
                <div>
                  <span style="font-size:0.82rem;color:<%= isOut ? '#666' : '#fff' %>;<%= isOut ? 'text-decoration:line-through;' : '' %>"><%= t.name||t.category.toUpperCase() %></span>
                  <% if(!isOut && t.comboOfferMinQty > 0 && t.comboOfferDiscount > 0){ %>
                  <div style="font-size:0.58rem;color:#f5c842;font-family:var(--font-mono);margin-top:0.1rem;">🎯 Buy <%= t.comboOfferMinQty %>+ → ₹<%= t.comboOfferDiscount %> off</div>
                  <% } %>
                </div>
              </div>
              <% if(isOut){ %>
                <span style="font-family:var(--font-mono);font-size:0.58rem;color:#FF4444;letter-spacing:1px;background:rgba(255,68,68,0.1);padding:0.2rem 0.5rem;border-radius:5px;border:1px solid rgba(255,68,68,0.25);">SOLD OUT</span>
              <% } else { %>
                <div style="text-align:right;">
                  <span style="font-family:var(--font-mono);font-size:0.85rem;color:<%= tc %>;font-weight:700;">₹<%= t.price.toLocaleString('en-IN') %></span>
                  <% if(avail <= 10){ %>
                  <div style="font-size:0.58rem;color:#f5c842;font-family:var(--font-mono);margin-top:0.1rem;"><%= avail %> left</div>
                  <% } %>
                </div>
              <% } %>
            </div>
            <% }); %>
          </div>

          <% } %>

          <!-- CTA -->
          <% if(isHouseFull){ %>
            <button class="btn-book-cta sold-out" disabled style="background:rgba(255,68,68,0.1);border-color:rgba(255,68,68,0.3);cursor:not-allowed;"><i class="bi bi-house-fill"></i> House Full</button>
          <% } else if(!locals.user || !user){ %>
            <a href="/auth/login?next=/booking/seatmap/<%= event._id %>" class="btn-book-cta">
              <i class="bi bi-ticket-perforated-fill"></i> Login to Book
            </a>
          <% } else if(locals.userHasMultipleEntry){ %>
            <a href="/booking/seatmap/<%= event._id %>" class="btn-book-cta" id="bookBtn">
              <i class="bi bi-plus-circle-fill"></i> Book Another Ticket
            </a>
            <div style="font-size:0.7rem;color:#f5c842;margin-top:0.5rem;text-align:center;font-family:'Space Mono',monospace;">
              ✓ You already have a group entry. You can still book other categories.
            </div>
          <% } else { %>
            <a href="/booking/seatmap/<%= event._id %>" class="btn-book-cta" id="bookBtn">
              <i class="bi bi-ticket-perforated-fill"></i> Book Now
            </a>
          <% } %>

          <div class="sidebar-trust">
            <div class="trust-item"><i class="bi bi-shield-check-fill"></i> Secure</div>
            <div class="trust-item"><i class="bi bi-x-circle-fill"></i> Non-Refundable</div>
            <div class="trust-item"><i class="bi bi-qr-code"></i> Instant QR</div>
          </div>

        </div>
      </div>

      <!-- Share card -->
      <div class="sidebar-card">
        <div class="sidebar-body" style="padding:1.2rem 1.5rem;">
          <div style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:1.5px;color:var(--muted);margin-bottom:0.8rem;text-transform:uppercase;">Share Event</div>
          <div class="share-row">
            <a href="https://wa.me/?text=Check+out+<%= encodeURIComponent(event.name) %>+on+Melattur Entertainment Events!+<%= locals.appUrl || '' %>%2Fevent%2F<%= event._id %>"
               target="_blank" class="share-btn">
              <i class="bi bi-whatsapp"></i> WhatsApp
            </a>
            <a href="https://www.instagram.com/" target="_blank" class="share-btn">
              <i class="bi bi-instagram"></i> Instagram
            </a>
            <button onclick="copyLink()" class="share-btn" id="copyBtn">
              <i class="bi bi-link-45deg"></i> Copy
            </button>
          </div>
        </div>
      </div>

    </div><!-- /sidebar -->

  </div><!-- /event-layout -->

  <script>
  // Copy link
  function copyLink() {
    navigator.clipboard.writeText(window.location.href).then(function(){
      const btn = document.getElementById('copyBtn');
      btn.innerHTML = '<i class="bi bi-check2"></i> Copied!';
      setTimeout(()=>btn.innerHTML='<i class="bi bi-link-45deg"></i> Copy', 2000);
    });
  }
  </script>

</body>
</html>
