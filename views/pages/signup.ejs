<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Sign Up — NightPass</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#08080e;--surface:#0f0f18;--card:#13131e;--border:rgba(255,255,255,0.08);--accent:#c8ff00;--accent-dim:rgba(200,255,0,0.09);--text:#e8e8f0;--muted:#5a5a72;--error:#ff5c5c;--success:#4cdf80;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;display:flex;flex-direction:column;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .orb1{position:fixed;top:-150px;left:-100px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(200,255,0,0.05) 0%,transparent 65%);pointer-events:none;}
    .orb2{position:fixed;bottom:-150px;right:-100px;width:450px;height:450px;border-radius:50%;background:radial-gradient(circle,rgba(100,50,220,0.06) 0%,transparent 65%);pointer-events:none;}
    nav{position:relative;z-index:1;padding:1.1rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);}
    .logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:4px;color:#fff;text-decoration:none;}
    .logo span{color:var(--accent);}
    .back-link{display:flex;align-items:center;gap:0.4rem;color:var(--muted);text-decoration:none;font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s;}
    .back-link:hover{color:#fff;}
    .auth-wrapper{flex:1;display:flex;align-items:center;justify-content:center;padding:2rem 1rem;position:relative;z-index:1;}
    .auth-card{background:var(--card);border:1px solid var(--border);border-radius:14px;width:100%;max-width:460px;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,0.5);}
    .card-top-bar{height:3px;background:linear-gradient(90deg,transparent,var(--accent),transparent);}
    .card-inner{padding:2.2rem;}
    .event-badge{display:flex;align-items:center;gap:0.8rem;background:var(--accent-dim);border:1px solid rgba(200,255,0,0.18);border-radius:8px;padding:0.8rem 1rem;margin-bottom:1.8rem;}
    .event-badge-icon{font-size:1.4rem;}
    .event-badge-name{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:2px;color:#fff;}
    .event-badge-sub{font-size:0.72rem;color:var(--muted);margin-top:2px;}
    .eyebrow{font-family:'Space Mono',monospace;font-size:0.62rem;letter-spacing:3px;color:var(--accent);display:block;margin-bottom:0.4rem;}
    h1{font-family:'Anton',sans-serif;font-size:2.4rem;letter-spacing:2px;color:#fff;line-height:1;margin-bottom:0.5rem;}
    .subtitle{font-size:0.88rem;color:var(--muted);line-height:1.6;margin-bottom:1.5rem;}
    .subtitle a{color:var(--accent);text-decoration:none;font-weight:600;}
    .btn-google{width:100%;padding:0.85rem 1.2rem;background:var(--surface);border:2px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;gap:0.8rem;color:var(--text);font-size:0.9rem;font-weight:500;cursor:pointer;transition:all 0.2s;text-decoration:none;font-family:'Outfit',sans-serif;margin-bottom:0.5rem;}
    .btn-google:hover{border-color:rgba(255,255,255,0.2);background:rgba(255,255,255,0.04);color:#fff;}
    .google-icon{width:20px;height:20px;flex-shrink:0;}
    .divider{display:flex;align-items:center;gap:0.8rem;margin:1.2rem 0;}
    .divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--border);}
    .divider-text{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);white-space:nowrap;}
    .row-2{display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;}
    .field-group{margin-bottom:1rem;}
    .field-label{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;display:block;margin-bottom:0.5rem;}
    .field-input{width:100%;background:var(--surface);border:2px solid var(--border);border-radius:8px;color:var(--text);font-size:0.95rem;padding:0.85rem 1rem;font-family:'Outfit',sans-serif;outline:none;transition:border-color 0.2s,box-shadow 0.2s;}
    .field-input::placeholder{color:var(--muted);}
    .field-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(200,255,0,0.08);}
    .field-input.has-error{border-color:var(--error);}
    .field-error{display:none;font-size:0.74rem;color:var(--error);margin-top:0.4rem;align-items:center;gap:0.3rem;}
    .field-error.visible{display:flex;}
    .phone-wrap{display:flex;border:2px solid var(--border);border-radius:8px;overflow:hidden;background:var(--surface);transition:border-color 0.2s,box-shadow 0.2s;}
    .phone-wrap:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(200,255,0,0.08);}
    .phone-wrap.has-error{border-color:var(--error);}
    .country-code{display:flex;align-items:center;padding:0 1rem;border-right:1px solid var(--border);font-size:0.9rem;color:var(--text);white-space:nowrap;flex-shrink:0;background:rgba(255,255,255,0.03);}
    .phone-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-size:1rem;padding:0.88rem 1rem;font-family:'Outfit',sans-serif;letter-spacing:1px;}
    .phone-input::placeholder{color:var(--muted);font-size:0.9rem;letter-spacing:0;}
    .global-error{display:none;align-items:center;gap:0.5rem;background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.3);border-radius:6px;padding:0.7rem 1rem;font-size:0.82rem;color:var(--error);margin-bottom:0.8rem;}
    .global-error.visible{display:flex;}
    .btn-submit{width:100%;padding:1rem;background:var(--accent);color:#000;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;border:none;border-radius:8px;cursor:pointer;margin-top:0.5rem;display:flex;align-items:center;justify-content:center;gap:0.6rem;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 0 25px rgba(200,255,0,0.2);}
    .btn-submit:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 0 45px rgba(200,255,0,0.4);}
    .btn-submit:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
    .spinner{width:18px;height:18px;border:2px solid rgba(0,0,0,0.25);border-top-color:#000;border-radius:50%;animation:spin 0.7s linear infinite;display:none;}
    @keyframes spin{to{transform:rotate(360deg)}}
    .footer-links{margin-top:1.5rem;text-align:center;font-size:0.84rem;color:var(--muted);}
    .footer-links a{color:var(--accent);text-decoration:none;font-weight:600;}
    .terms{margin-top:1rem;font-size:0.7rem;color:var(--muted);text-align:center;line-height:1.6;}
    .terms a{color:var(--muted);text-decoration:underline;}
    @media(max-width:480px){.card-inner{padding:1.5rem 1.1rem;}h1{font-size:2rem;}.row-2{grid-template-columns:1fr;}}
  </style>
</head>
<body>
  <div class="orb1"></div>
  <div class="orb2"></div>

  <nav>
    <a href="/" class="logo">NIGHT<span>PASS</span></a>
    <a href="/" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
  </nav>

  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="card-top-bar"></div>
      <div class="card-inner">

        <div class="event-badge">
          <div class="event-badge-icon">🎉</div>
          <div>
            <div class="event-badge-name">ECLIPSE DARK NIGHT</div>
            <div class="event-badge-sub">15 March 2026 · Club Axis, Kochi</div>
          </div>
        </div>

        <span class="eyebrow">// create account</span>
        <h1>JOIN THE<br/>NIGHT</h1>
        <p class="subtitle">Already have an account? <a href="/auth/login">Log in</a></p>

        <a href="/auth/google" class="btn-google">
          <svg class="google-icon" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Sign up with Google
        </a>

        <div class="divider"><span class="divider-text">OR SIGN UP WITH PHONE</span></div>

        <!-- Name Row -->
        <div class="row-2">
          <div class="field-group">
            <label class="field-label">First Name *</label>
            <input type="text" class="field-input" id="firstName" placeholder="Arjun" autocomplete="given-name"/>
            <div class="field-error" id="firstNameErr"><i class="bi bi-exclamation-circle"></i> First name is required</div>
          </div>
          <div class="field-group">
            <label class="field-label">Last Name</label>
            <input type="text" class="field-input" id="lastName" placeholder="Menon" autocomplete="family-name"/>
          </div>
        </div>

        <!-- Email -->
        <div class="field-group">
          <label class="field-label">Email Address</label>
          <input type="email" class="field-input" id="emailInput" placeholder="you@example.com" autocomplete="email"/>
          <div class="field-error" id="emailErr"><i class="bi bi-exclamation-circle"></i> Enter a valid email address</div>
        </div>

        <!-- Phone -->
        <div class="field-group">
          <label class="field-label">Phone Number *</label>
          <div class="phone-wrap" id="phoneWrap">
            <div class="country-code">🇮🇳 +91</div>
            <input type="tel" class="phone-input" id="phoneInput" placeholder="98765 43210" maxlength="10" inputmode="numeric" autocomplete="tel"/>
          </div>
          <div class="field-error" id="phoneErr"><i class="bi bi-exclamation-circle"></i> Enter a valid 10-digit Indian mobile number</div>
        </div>

        <!-- Global error -->
        <div class="global-error" id="globalError">
          <i class="bi bi-exclamation-circle-fill"></i>
          <span id="globalErrorText"></span>
        </div>

        <button class="btn-submit" id="submitBtn" onclick="handleSignup()">
          <i class="bi bi-rocket-takeoff-fill" id="btnIcon"></i>
          <span id="btnText">Create Account &amp; Send OTP</span>
          <div class="spinner" id="spinner"></div>
        </button>

        <div class="footer-links">Already have an account? <a href="/auth/login">Log in</a></div>
        <div class="terms">By signing up, you agree to our <a href="#">Terms</a> and <a href="#">Privacy Policy</a></div>
      </div>
    </div>
  </div>

  <script>
    // Only allow digits in phone
    document.getElementById('phoneInput').addEventListener('input', function() {
      this.value = this.value.replace(/\D/g, '').slice(0, 10);
      clearFieldError('phoneWrap', 'phoneErr');
    });

    // Clear errors on typing
    document.getElementById('firstName').addEventListener('input', () => clearFieldError('firstName', 'firstNameErr'));
    document.getElementById('emailInput').addEventListener('input', () => clearFieldError('emailInput', 'emailErr'));

    function clearFieldError(inputId, errId) {
      const inp = document.getElementById(inputId);
      const err = document.getElementById(errId);
      if (inp) inp.classList.remove('has-error');
      if (err) err.classList.remove('visible');
      document.getElementById('globalError').classList.remove('visible');
    }

    function showFieldError(inputId, errId) {
      const inp = document.getElementById(inputId);
      const err = document.getElementById(errId);
      if (inp) inp.classList.add('has-error');
      if (err) err.classList.add('visible');
    }

    function showGlobalError(msg) {
      document.getElementById('globalErrorText').textContent = msg;
      document.getElementById('globalError').classList.add('visible');
    }

    function setLoading(on) {
      document.getElementById('submitBtn').disabled = on;
      document.getElementById('btnIcon').style.display = on ? 'none' : 'inline';
      document.getElementById('btnText').textContent = on ? 'Sending OTP...' : 'Create Account & Send OTP';
      document.getElementById('spinner').style.display = on ? 'block' : 'none';
    }

    async function handleSignup() {
      const firstName = document.getElementById('firstName').value.trim();
      const lastName  = document.getElementById('lastName').value.trim();
      const email     = document.getElementById('emailInput').value.trim();
      const phone     = document.getElementById('phoneInput').value.trim();

      // Clear all errors
      ['firstName','emailInput'].forEach(id => document.getElementById(id).classList.remove('has-error'));
      document.getElementById('phoneWrap').classList.remove('has-error');
      ['firstNameErr','emailErr','phoneErr'].forEach(id => document.getElementById(id).classList.remove('visible'));
      document.getElementById('globalError').classList.remove('visible');

      // Validate
      let hasError = false;

      if (!firstName) {
        showFieldError('firstName', 'firstNameErr');
        hasError = true;
      }

      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showFieldError('emailInput', 'emailErr');
        hasError = true;
      }

      if (!phone || phone.length !== 10 || !/^[6-9]\d{9}$/.test(phone)) {
        showFieldError('phoneWrap', 'phoneErr');
        hasError = true;
      }

      if (hasError) return;

      setLoading(true);

      try {
        const res = await fetch('/auth/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ firstName, lastName, email, phone }),
        });

        const data = await res.json();

        if (data.success) {
          window.location.href = data.redirect || '/auth/otp';
        } else {
          showGlobalError(data.message || 'Something went wrong. Please try again.');
          setLoading(false);
          if (data.redirect) setTimeout(() => window.location.href = data.redirect, 2000);
        }
      } catch(e) {
        showGlobalError('Network error. Please check your connection and try again.');
        setLoading(false);
      }
    }
  </script>
</body>
</html>
