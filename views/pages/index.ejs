      const loading=document.getElementById('reviewsLoading');
      if(loading) loading.remove();
      if(!d.success||!d.reviews||d.reviews.length===0){
        grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:3rem 1rem;color:#555;"><div style="font-size:2rem;margin-bottom:0.5rem;">⭐</div><p style="font-size:0.82rem;">No reviews yet — be the first!</p></div>';
        return;
      }
      grid.innerHTML=d.reviews.map(r=>{
        const initials=((r.user?.firstName||'?')[0]+(r.user?.lastName||'?')[0]).toUpperCase();
        const name=(r.user?.firstName||'')+(r.user?.lastName?' '+r.user.lastName:'');
        const stars=[1,2,3,4,5].map(s=>`<i class="bi bi-star-fill" style="color:${s<=r.rating?'#f5c842':'#333'};font-size:0.72rem;"></i>`).join('');
        return `<div class="review-card">
          <div class="review-top">
            <div class="review-avatar">${initials}</div>
            <div style="flex:1;min-width:0;">
              <div class="review-name">${name}</div>
              <div style="font-size:0.65rem;color:#555;">${r.event?.name||''}</div>
            </div>
            <div class="review-stars">${stars}</div>
          </div>
          <p class="review-text">"${r.text}"</p>
        </div>`;
      }).join('');
    }catch(e){console.warn('Reviews load error',e);}
  })();

  // ── Review modal ──
  let selectedStar=0;
  function openReviewModal(){document.getElementById('reviewModal').style.display='flex';}
  function closeReviewModal(){document.getElementById('reviewModal').style.display='none';}
  function setStar(n){selectedStar=n;document.getElementById('revRating').value=n;updateStars(n);}
  function hoverStar(n){updateStars(n);}
  function resetStars(){updateStars(selectedStar);}
  function updateStars(n){document.querySelectorAll('.rev-star').forEach((s,i)=>s.style.color=i<n?'#f5c842':'#333');}

  async function submitReview(){
    const eventId=document.getElementById('revEventId').value;
    const rating=document.getElementById('revRating').value;
    const text=document.getElementById('revText').value.trim();
    const msg=document.getElementById('revMsg');
    const btn=document.getElementById('revSubmitBtn');

    if(!eventId){showRevMsg('Please select an event.','err');return;}
    if(!rating||rating==='0'){showRevMsg('Please select a star rating.','err');return;}
    if(!text||text.length<5){showRevMsg('Please write a review (min 5 chars).','err');return;}

    btn.disabled=true;btn.innerHTML='<i class="bi bi-hourglass-split"></i> Submitting…';
    try{
      const res=await fetch('/user/review',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({eventId,rating,text})});
      const d=await res.json();
      if(d.success){
        showRevMsg('Review submitted! Thank you.','ok');
        setTimeout(()=>{closeReviewModal();location.reload();},1500);
      } else showRevMsg(d.message||'Error submitting.','err');
    }catch(e){showRevMsg('Network error.','err');}
    btn.disabled=false;btn.innerHTML='<i class="bi bi-send-fill"></i> Submit Review';
  }
  function showRevMsg(txt,type){
    const m=document.getElementById('revMsg');
    m.textContent=txt;m.style.display='block';
    m.style.background=type==='ok'?'rgba(0,255,136,0.08)':'rgba(255,68,68,0.08)';
    m.style.border=type==='ok'?'1px solid rgba(0,255,136,0.25)':'1px solid rgba(255,68,68,0.28)';
    m.style.color=type==='ok'?'#00FF88':'#FF4444';
  }
  document.getElementById('reviewModal').addEventListener('click',function(e){if(e.target===this)closeReviewModal();});
  </script>

  <script>
