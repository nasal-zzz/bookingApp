<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>NightPass — Eclipse Dark Night</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#08080e;--surface:#0f0f18;--card:#13131e;--border:rgba(255,255,255,0.08);--accent:#c8ff00;--accent-dim:rgba(200,255,0,0.09);--text:#e8e8f0;--muted:#5a5a72;--success:#4cdf80;--error:#ff5c5c;}
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;overflow-x:hidden;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;z-index:0;}
    .orb1{position:fixed;top:-200px;left:50%;transform:translateX(-50%);width:700px;height:500px;border-radius:50%;background:radial-gradient(ellipse,rgba(200,255,0,0.06) 0%,transparent 65%);pointer-events:none;}
    .orb2{position:fixed;bottom:-200px;left:-150px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(100,50,220,0.07) 0%,transparent 65%);pointer-events:none;}
    .orb3{position:fixed;bottom:-100px;right:-100px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(200,255,0,0.04) 0%,transparent 65%);pointer-events:none;}

    /* ── NAV ── */
    nav{padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:rgba(8,8,14,0.9);backdrop-filter:blur(20px);position:sticky;top:0;z-index:100;}
    .logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:4px;color:#fff;text-decoration:none;}
    .logo span{color:var(--accent);}
    .nav-links{display:flex;align-items:center;gap:1.5rem;}
    .nav-txt{color:var(--muted);text-decoration:none;font-size:0.85rem;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s;}
    .nav-txt:hover{color:#fff;}
    .btn-nav{background:var(--accent);color:#000;padding:0.55rem 1.3rem;border-radius:4px;text-decoration:none;font-weight:700;font-size:0.85rem;letter-spacing:1px;transition:box-shadow 0.2s,transform 0.15s;}
    .btn-nav:hover{box-shadow:0 0 25px rgba(200,255,0,0.4);transform:translateY(-1px);}
    .btn-nav-outline{color:var(--muted);text-decoration:none;font-size:0.82rem;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s;padding:0.45rem 0.8rem;border-radius:4px;border:1px solid var(--border);}
    .btn-nav-outline:hover{color:#fff;border-color:rgba(255,255,255,0.2);}

    /* User dropdown */
    .user-dd-wrap{position:relative;}
    .user-trigger{display:flex;align-items:center;gap:0.6rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:0.4rem 0.9rem 0.4rem 0.5rem;cursor:pointer;color:var(--text);font-family:'Outfit',sans-serif;font-size:0.85rem;transition:border-color 0.2s;}
    .user-trigger:hover{border-color:rgba(200,255,0,0.35);}
    .u-avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#1c2200,#3a4a00);border:1px solid rgba(200,255,0,0.3);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.7rem;color:var(--accent);flex-shrink:0;}
    .u-name{font-weight:600;color:#fff;}
    .u-chevron{font-size:0.7rem;color:var(--muted);transition:transform 0.2s;}
    .u-chevron.open{transform:rotate(180deg);}
    .user-dd{display:none;position:absolute;top:calc(100% + 8px);right:0;background:var(--card);border:1px solid var(--border);border-radius:10px;min-width:220px;box-shadow:0 20px 60px rgba(0,0,0,0.7);z-index:300;overflow:hidden;}
    .user-dd.open{display:block;animation:ddIn 0.15s ease both;}
    @keyframes ddIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
    .dd-head{padding:0.9rem 1.1rem;display:flex;align-items:center;gap:0.8rem;background:rgba(255,255,255,0.02);border-bottom:1px solid var(--border);}
    .dd-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#1c2200,#3a4a00);border:1px solid rgba(200,255,0,0.3);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.95rem;color:var(--accent);flex-shrink:0;}
    .dd-uname{font-weight:700;font-size:0.88rem;color:#fff;}
    .dd-phone{font-family:'Space Mono',monospace;font-size:0.62rem;color:var(--muted);}
    .dd-item{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 1.1rem;color:var(--text);text-decoration:none;font-size:0.85rem;transition:background 0.15s;}
    .dd-item:hover{background:rgba(255,255,255,0.04);color:#fff;}
    .dd-item i{width:16px;color:var(--muted);font-size:0.85rem;}
    .dd-item:hover i{color:var(--accent);}
    .dd-divider{height:1px;background:var(--border);}
    .dd-item.danger{color:var(--error);}
    .dd-item.danger i{color:var(--error);}
    .dd-item.danger:hover{background:rgba(255,92,92,0.06);}

    /* Hamburger */
    .ham-btn{display:none;background:none;border:1px solid var(--border);border-radius:6px;padding:0.45rem 0.7rem;cursor:pointer;color:var(--text);}

    /* Mobile drawer */
    .mobile-drawer{display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:200;background:rgba(8,8,14,0.98);backdrop-filter:blur(20px);flex-direction:column;padding:1.5rem;}
    .mobile-drawer.open{display:flex;}
    .drawer-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:1.2rem;border-bottom:1px solid var(--border);margin-bottom:1.5rem;}
    .drawer-user{display:flex;align-items:center;gap:1rem;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1rem;margin-bottom:1rem;}
    .drawer-links{flex:1;display:flex;flex-direction:column;gap:0.3rem;}
    .drawer-link{display:flex;align-items:center;gap:0.8rem;padding:0.9rem 1rem;color:var(--text);text-decoration:none;border-radius:8px;font-size:0.95rem;border:1px solid transparent;transition:all 0.2s;}
    .drawer-link:hover{background:var(--surface);border-color:var(--border);}
    .drawer-link i{color:var(--accent);width:20px;}
    .drawer-footer{padding-top:1.2rem;border-top:1px solid var(--border);}
    .btn-drawer-cta{display:flex;align-items:center;justify-content:center;gap:0.6rem;width:100%;padding:1rem;background:var(--accent);border-radius:8px;color:#000;font-weight:700;text-decoration:none;font-size:0.9rem;letter-spacing:1px;border:none;cursor:pointer;}
    .btn-drawer-logout{display:flex;align-items:center;justify-content:center;gap:0.6rem;width:100%;padding:0.9rem;background:transparent;border:1px solid rgba(255,92,92,0.3);border-radius:8px;color:var(--error);font-weight:600;text-decoration:none;font-size:0.9rem;}

    /* ── HERO ── */
    .hero{min-height:calc(100vh - 65px);display:flex;align-items:center;justify-content:center;position:relative;z-index:1;padding:4rem 2rem;}
    .hero-inner{max-width:900px;text-align:center;}
    .hero-tag{display:inline-flex;align-items:center;gap:0.6rem;background:var(--accent-dim);border:1px solid rgba(200,255,0,0.2);border-radius:20px;padding:0.5rem 1.2rem;font-family:'Space Mono',monospace;font-size:0.68rem;letter-spacing:2px;color:var(--accent);margin-bottom:2rem;animation:fadeUp 0.6s ease both;}
    .hero-live-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pulse 1.5s infinite;}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.8)}}
    .hero-title{font-family:'Anton',sans-serif;font-size:clamp(3.5rem,10vw,8rem);letter-spacing:3px;color:#fff;line-height:0.92;margin-bottom:1rem;animation:fadeUp 0.6s 0.1s ease both;}
    .hero-title .accent{color:var(--accent);}
    .hero-title .dim{color:rgba(255,255,255,0.18);}
    .hero-sub{font-size:1.1rem;color:var(--muted);line-height:1.7;max-width:550px;margin:0 auto 2.5rem;animation:fadeUp 0.6s 0.2s ease both;}
    .hero-meta{display:flex;align-items:center;justify-content:center;gap:2rem;flex-wrap:wrap;margin-bottom:2.5rem;animation:fadeUp 0.6s 0.3s ease both;}
    .hero-meta-item{display:flex;align-items:center;gap:0.5rem;font-size:0.88rem;color:var(--muted);}
    .hero-meta-item i{color:var(--accent);}
    .hero-cta{display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap;animation:fadeUp 0.6s 0.4s ease both;}
    .btn-hero-primary{display:inline-flex;align-items:center;gap:0.6rem;background:var(--accent);color:#000;padding:1rem 2.5rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:1rem;letter-spacing:1px;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 0 30px rgba(200,255,0,0.2);}
    .btn-hero-primary:hover{transform:translateY(-3px);box-shadow:0 0 60px rgba(200,255,0,0.5);color:#000;}
    .btn-hero-secondary{display:inline-flex;align-items:center;gap:0.6rem;background:transparent;color:var(--text);padding:1rem 2rem;border-radius:6px;text-decoration:none;font-weight:600;font-size:0.95rem;border:1px solid var(--border);transition:border-color 0.2s,color 0.2s;}
    .btn-hero-secondary:hover{border-color:rgba(255,255,255,0.25);color:#fff;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

    /* ── COUNTDOWN ── */
    .countdown-bar{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:1.5rem 2rem;position:relative;z-index:1;}
    .countdown-inner{max-width:800px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:3rem;flex-wrap:wrap;}
    .cd-item{text-align:center;}
    .cd-num{font-family:'Anton',sans-serif;font-size:2.5rem;color:var(--accent);line-height:1;letter-spacing:2px;}
    .cd-lbl{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);margin-top:0.2rem;}
    .cd-sep{font-family:'Anton',sans-serif;font-size:2rem;color:var(--border);line-height:1;}

    /* ── DETAILS ── */
    .section{max-width:1000px;margin:0 auto;padding:5rem 2rem;position:relative;z-index:1;}
    .section-tag{font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:3px;color:var(--accent);display:block;margin-bottom:0.5rem;}
    .section-title{font-family:'Anton',sans-serif;font-size:clamp(2rem,4vw,3rem);letter-spacing:2px;color:#fff;margin-bottom:2rem;}
    .details-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;}
    .detail-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.5rem;transition:border-color 0.2s,transform 0.2s;}
    .detail-card:hover{border-color:rgba(200,255,0,0.2);transform:translateY(-3px);}
    .detail-icon{width:44px;height:44px;border-radius:8px;background:var(--accent-dim);border:1px solid rgba(200,255,0,0.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;margin-bottom:1rem;}
    .detail-label{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;margin-bottom:0.4rem;}
    .detail-val{font-size:1rem;font-weight:700;color:#fff;line-height:1.4;}

    /* ── LINEUP ── */
    .lineup-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem;}
    .lineup-card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:1.2rem;text-align:center;transition:border-color 0.2s;}
    .lineup-card:hover{border-color:rgba(200,255,0,0.2);}
    .lineup-avatar{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#1c2200,#3a4a00);border:2px solid rgba(200,255,0,0.2);display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 0.8rem;}
    .lineup-name{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:1px;color:#fff;margin-bottom:0.2rem;}
    .lineup-role{font-size:0.72rem;color:var(--muted);}
    .lineup-time{font-family:'Space Mono',monospace;font-size:0.62rem;color:var(--accent);margin-top:0.4rem;}

    /* ── TICKET TYPES ── */
    .ticket-types{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;}
    .ttype-card{background:var(--card);border:2px solid var(--border);border-radius:12px;padding:2rem;position:relative;overflow:hidden;transition:border-color 0.2s,transform 0.2s;}
    .ttype-card:hover{transform:translateY(-4px);}
    .ttype-card.featured{border-color:rgba(200,255,0,0.35);}
    .ttype-card.featured::before{content:'MOST POPULAR';position:absolute;top:12px;right:-28px;background:var(--accent);color:#000;font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;padding:0.25rem 2.5rem;transform:rotate(45deg);font-weight:700;}
    .ttype-name{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:2px;color:#fff;margin-bottom:0.3rem;}
    .ttype-price{font-family:'Anton',sans-serif;font-size:2.5rem;color:var(--accent);letter-spacing:1px;margin-bottom:1.2rem;}
    .ttype-price span{font-size:1rem;color:var(--muted);}
    .ttype-includes{list-style:none;display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1.5rem;}
    .ttype-includes li{display:flex;align-items:center;gap:0.6rem;font-size:0.88rem;color:var(--muted);}
    .ttype-includes li::before{content:'✓';color:var(--accent);font-weight:700;flex-shrink:0;}
    .ttype-sold{font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:2px;color:var(--error);background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.3);padding:0.5rem 1rem;border-radius:4px;text-align:center;}
    .btn-get-ticket{display:flex;align-items:center;justify-content:center;gap:0.5rem;width:100%;padding:0.9rem;background:var(--accent);color:#000;border:none;border-radius:6px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.9rem;letter-spacing:1px;cursor:pointer;text-decoration:none;transition:box-shadow 0.2s,transform 0.15s;}
    .btn-get-ticket:hover{box-shadow:0 0 30px rgba(200,255,0,0.4);transform:translateY(-2px);color:#000;}
    .btn-get-ticket.outline{background:transparent;color:var(--text);border:2px solid var(--border);}
    .btn-get-ticket.outline:hover{border-color:rgba(255,255,255,0.25);color:#fff;box-shadow:none;transform:translateY(-2px);}

    /* ── FOOTER ── */
    footer{border-top:1px solid var(--border);padding:2rem;text-align:center;position:relative;z-index:1;}
    .footer-logo{font-family:'Anton',sans-serif;font-size:1.8rem;letter-spacing:4px;color:#fff;margin-bottom:0.5rem;}
    .footer-logo span{color:var(--accent);}
    .footer-sub{font-size:0.8rem;color:var(--muted);}

    @media(max-width:768px){
      .nav-links{display:none;}
      .ham-btn{display:flex;}
      .details-grid{grid-template-columns:1fr 1fr;}
      .ticket-types{grid-template-columns:1fr;}
      .hero-meta{gap:1rem;}
      .countdown-inner{gap:1.5rem;}
    }
    @media(max-width:480px){.details-grid{grid-template-columns:1fr;}.hero-title{font-size:3rem;}}
  </style>
</head>
<body>
  <div class="orb1"></div>
  <div class="orb2"></div>
  <div class="orb3"></div>

  <!-- ── NAV ── -->
  <nav>
    <a href="/" class="logo">NIGHT<span>PASS</span></a>

    <div class="nav-links">
      <a href="#details" class="nav-txt">Details</a>
      <a href="#lineup" class="nav-txt">Lineup</a>
      <a href="#tickets" class="nav-txt">Tickets</a>

      <% if (locals.user && user) { %>
        <!-- Logged in — user dropdown -->
        <div class="user-dd-wrap" id="ddWrap">
          <button class="user-trigger" onclick="toggleDD()">
            <div class="u-avatar">
              <%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %>
            </div>
            <span class="u-name"><%= user.firstName %></span>
            <i class="bi bi-chevron-down u-chevron" id="ddChevron"></i>
          </button>
          <div class="user-dd" id="userDD">
            <div class="dd-head">
              <div class="dd-avatar"><%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %></div>
              <div>
                <div class="dd-uname"><%= (user.firstName + ' ' + (user.lastName||'')).trim() %></div>
                <div class="dd-phone"><%= user.phone %></div>
              </div>
            </div>
            <a href="/user/profile"        class="dd-item"><i class="bi bi-person-fill"></i> My Profile</a>
            <a href="/booking"             class="dd-item"><i class="bi bi-ticket-perforated-fill"></i> Book Tickets</a>
            <a href="/booking/my-bookings" class="dd-item"><i class="bi bi-collection-fill"></i> My Bookings</a>
            <div class="dd-divider"></div>
            <a href="/auth/logout"         class="dd-item danger"><i class="bi bi-box-arrow-right"></i> Sign Out</a>
          </div>
        </div>
      <% } else { %>
        <!-- Not logged in -->
        <a href="/auth/login" class="btn-nav-outline">Login</a>
        <a href="/auth/login?next=/booking" class="btn-nav">Get Tickets</a>
      <% } %>
    </div>

    <!-- Hamburger -->
    <button class="ham-btn" onclick="toggleMobile()">
      <i class="bi bi-list" style="font-size:1.3rem;"></i>
    </button>
  </nav>

  <!-- ── MOBILE DRAWER ── -->
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="drawer-head">
      <span class="logo">NIGHT<span>PASS</span></span>
      <button onclick="toggleMobile()" style="background:none;border:1px solid var(--border);border-radius:6px;padding:0.45rem 0.7rem;cursor:pointer;color:var(--text);">
        <i class="bi bi-x" style="font-size:1.3rem;"></i>
      </button>
    </div>

    <% if (locals.user && user) { %>
      <div class="drawer-user">
        <div class="dd-avatar"><%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %></div>
        <div>
          <div style="font-weight:700;color:#fff;font-size:0.95rem;"><%= (user.firstName + ' ' + (user.lastName||'')).trim() %></div>
          <div style="font-size:0.75rem;color:var(--muted);font-family:'Space Mono',monospace;"><%= user.phone %></div>
        </div>
      </div>
    <% } %>

    <div class="drawer-links">
      <a href="#details" class="drawer-link" onclick="toggleMobile()"><i class="bi bi-info-circle-fill"></i> Event Details</a>
      <a href="#lineup"  class="drawer-link" onclick="toggleMobile()"><i class="bi bi-music-note-list"></i> Lineup</a>
      <a href="#tickets" class="drawer-link" onclick="toggleMobile()"><i class="bi bi-ticket-perforated"></i> Tickets</a>

      <% if (locals.user && user) { %>
        <a href="/user/profile"        class="drawer-link" onclick="toggleMobile()"><i class="bi bi-person-fill"></i> My Profile</a>
        <a href="/booking/my-bookings" class="drawer-link" onclick="toggleMobile()"><i class="bi bi-collection-fill"></i> My Bookings</a>
      <% } else { %>
        <a href="/auth/login"  class="drawer-link" onclick="toggleMobile()"><i class="bi bi-person-fill"></i> Login</a>
        <a href="/auth/signup" class="drawer-link" onclick="toggleMobile()"><i class="bi bi-person-plus-fill"></i> Sign Up</a>
      <% } %>
    </div>

    <div class="drawer-footer">
      <% if (locals.user && user) { %>
        <a href="/booking" class="btn-drawer-cta" onclick="toggleMobile()"><i class="bi bi-ticket-perforated-fill"></i> Book Tickets</a>
        <a href="/auth/logout" class="btn-drawer-logout" style="margin-top:0.6rem;"><i class="bi bi-box-arrow-right"></i> Sign Out</a>
      <% } else { %>
        <a href="/auth/login?next=/booking" class="btn-drawer-cta" onclick="toggleMobile()"><i class="bi bi-ticket-perforated-fill"></i> Get Tickets</a>
      <% } %>
    </div>
  </div>

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-tag">
        <div class="hero-live-dot"></div>
        KOCHI'S BIGGEST UNDERGROUND NIGHT · 2026
      </div>
      <h1 class="hero-title">
        ECLIPSE<br/>
        <span class="accent">DARK</span>
        <span class="dim"> NIGHT</span>
      </h1>
      <p class="hero-sub">One night. One frequency. Total eclipse. Kochi's most anticipated underground party returns — bigger, darker, louder.</p>
      <div class="hero-meta">
        <div class="hero-meta-item"><i class="bi bi-calendar3"></i> Sunday, 15 March 2026</div>
        <div class="hero-meta-item"><i class="bi bi-clock"></i> 8:30 PM – 4:00 AM</div>
        <div class="hero-meta-item"><i class="bi bi-geo-alt-fill"></i> Club Axis, MG Road, Kochi</div>
        <div class="hero-meta-item"><i class="bi bi-person-check-fill"></i> 18+ · Valid ID Required</div>
      </div>
      <div class="hero-cta">
        <% if (locals.user && user) { %>
          <a href="/booking" class="btn-hero-primary"><i class="bi bi-ticket-perforated-fill"></i> Book Your Pass Now</a>
          <a href="/user/profile" class="btn-hero-secondary"><i class="bi bi-person-fill"></i> My Profile</a>
        <% } else { %>
          <a href="/auth/login?next=/booking" class="btn-hero-primary"><i class="bi bi-ticket-perforated-fill"></i> Get Your Pass</a>
          <a href="/auth/signup" class="btn-hero-secondary"><i class="bi bi-person-plus"></i> Create Account</a>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ── COUNTDOWN ── -->
  <div class="countdown-bar">
    <div class="countdown-inner">
      <div class="cd-item"><div class="cd-num" id="cdDays">--</div><div class="cd-lbl">Days</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><div class="cd-num" id="cdHours">--</div><div class="cd-lbl">Hours</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><div class="cd-num" id="cdMins">--</div><div class="cd-lbl">Minutes</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><div class="cd-num" id="cdSecs">--</div><div class="cd-lbl">Seconds</div></div>
    </div>
  </div>

  <!-- ── DETAILS ── -->
  <section class="section" id="details">
    <span class="section-tag">// event details</span>
    <div class="section-title">THE NIGHT</div>
    <div class="details-grid">
      <div class="detail-card"><div class="detail-icon">📅</div><div class="detail-label">Date</div><div class="detail-val">Sunday<br/>15 March 2026</div></div>
      <div class="detail-card"><div class="detail-icon">🕘</div><div class="detail-label">Time</div><div class="detail-val">Doors Open 8:30 PM<br/>Until 4:00 AM</div></div>
      <div class="detail-card"><div class="detail-icon">📍</div><div class="detail-label">Venue</div><div class="detail-val">Club Axis<br/>MG Road, Kochi</div></div>
      <div class="detail-card"><div class="detail-icon">👗</div><div class="detail-label">Dress Code</div><div class="detail-val">All Black<br/><span style="font-size:0.78rem;color:var(--muted);">Strictly Enforced</span></div></div>
      <div class="detail-card"><div class="detail-icon">🪪</div><div class="detail-label">Age Limit</div><div class="detail-val">18+ Only<br/><span style="font-size:0.78rem;color:var(--muted);">Valid Govt. ID Required</span></div></div>
      <div class="detail-card"><div class="detail-icon">🎶</div><div class="detail-label">Music</div><div class="detail-val">Techno · House<br/>Dark Electronic</div></div>
    </div>
  </section>

  <!-- ── LINEUP ── -->
  <section class="section" id="lineup" style="padding-top:0;">
    <span class="section-tag">// artist lineup</span>
    <div class="section-title">WHO'S PLAYING</div>
    <div class="lineup-grid">
      <div class="lineup-card"><div class="lineup-avatar">🎧</div><div class="lineup-name">DJ CIPHER</div><div class="lineup-role">Techno · Berlin</div><div class="lineup-time">9:00 PM – 11:00 PM</div></div>
      <div class="lineup-card"><div class="lineup-avatar">🎵</div><div class="lineup-name">NYX</div><div class="lineup-role">Dark House · Mumbai</div><div class="lineup-time">11:00 PM – 1:00 AM</div></div>
      <div class="lineup-card"><div class="lineup-avatar">🔊</div><div class="lineup-name">VORTEX</div><div class="lineup-role">Industrial · Kochi</div><div class="lineup-time">1:00 AM – 3:00 AM</div></div>
      <div class="lineup-card"><div class="lineup-avatar">🌙</div><div class="lineup-name">ECLIPSE</div><div class="lineup-role">Ambient · Closing Set</div><div class="lineup-time">3:00 AM – 4:00 AM</div></div>
    </div>
  </section>

  <!-- ── TICKETS ── -->
  <section class="section" id="tickets" style="padding-top:0;">
    <span class="section-tag">// get your pass</span>
    <div class="section-title">TICKET TYPES</div>
    <div class="ticket-types">
      <!-- General -->
      <div class="ttype-card featured">
        <div class="ttype-name">GENERAL</div>
        <div class="ttype-price">₹999 <span>/ person</span></div>
        <ul class="ttype-includes">
          <li>Entry Pass (9 PM – 4 AM)</li>
          <li>Welcome Drink</li>
          <li>Photo Booth Access</li>
          <li>Full Night Access</li>
        </ul>
        <% if (locals.user && user) { %>
          <a href="/booking" class="btn-get-ticket">Book General Pass</a>
        <% } else { %>
          <a href="/auth/login?next=/booking" class="btn-get-ticket">Login to Book</a>
        <% } %>
      </div>
      <!-- VIP -->
      <div class="ttype-card">
        <div class="ttype-name">VIP</div>
        <div class="ttype-price">₹1,999 <span>/ person</span></div>
        <ul class="ttype-includes">
          <li>Priority Entry (Fast Lane)</li>
          <li>Reserved Table</li>
          <li>3 Premium Drinks</li>
          <li>Photo Booth Access</li>
          <li>Full Night Access</li>
        </ul>
        <div class="ttype-sold"><i class="bi bi-x-circle-fill"></i> SOLD OUT</div>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ── -->
  <footer>
    <div class="footer-logo">NIGHT<span>PASS</span></div>
    <div class="footer-sub">© 2026 NightPass · Eclipse Dark Night · Club Axis, Kochi · All rights reserved.</div>
  </footer>

  <script>
    // ── Dropdown toggle ──
    function toggleDD() {
      const dd = document.getElementById('userDD');
      const chevron = document.getElementById('ddChevron');
      dd.classList.toggle('open');
      chevron.classList.toggle('open');
      if (dd.classList.contains('open')) {
        setTimeout(() => document.addEventListener('click', closeDDOutside, { once: true }), 10);
      }
    }
    function closeDDOutside(e) {
      const wrap = document.getElementById('ddWrap');
      if (wrap && !wrap.contains(e.target)) {
        document.getElementById('userDD').classList.remove('open');
        const c = document.getElementById('ddChevron');
        if (c) c.classList.remove('open');
      }
    }

    // ── Mobile menu ──
    function toggleMobile() {
      const drawer = document.getElementById('mobileDrawer');
      const isOpen = drawer.classList.contains('open');
      drawer.classList.toggle('open');
      document.body.style.overflow = isOpen ? '' : 'hidden';
    }

    // ── Countdown ──
    function updateCountdown() {
      const target = new Date('2026-03-15T21:00:00').getTime();
      const now = Date.now();
      const diff = target - now;
      if (diff <= 0) {
        document.getElementById('cdDays').textContent = '00';
        document.getElementById('cdHours').textContent = '00';
        document.getElementById('cdMins').textContent = '00';
        document.getElementById('cdSecs').textContent = '00';
        return;
      }
      const days  = Math.floor(diff / 86400000);
      const hours = Math.floor((diff % 86400000) / 3600000);
      const mins  = Math.floor((diff % 3600000) / 60000);
      const secs  = Math.floor((diff % 60000) / 1000);
      const pad = n => String(n).padStart(2, '0');
      document.getElementById('cdDays').textContent  = pad(days);
      document.getElementById('cdHours').textContent = pad(hours);
      document.getElementById('cdMins').textContent  = pad(mins);
      document.getElementById('cdSecs').textContent  = pad(secs);
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // ── Handle ?next redirect after login ──
    // The /auth/login?next=/booking is handled server-side
    // This ensures smooth navigation
  </script>
</body>
</html>
