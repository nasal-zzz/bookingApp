  <!-- ═══════════════ SLIDER SCRIPT ═══════════════ -->
  <script>
  (function(){
    const slides = document.querySelectorAll('.slide');
    const dots   = document.querySelectorAll('.slider-dot');
    const total  = slides.length;
    if(!total) return;

    let current = 0;
    let timer   = null;

    // Mobile: swap bg image to mobile banner
    const isMobile = window.innerWidth <= 768;

    <% sliderEvents.forEach(function(ev, idx){ %>
    <% if(ev.bannerMobile || ev.bannerDesktop){ %>
    (function(){
      const bg = document.getElementById('slideBg<%= idx %>');
      if(bg && isMobile){
        const mobileUrl = '<%= ev.bannerMobile || ev.bannerDesktop %>';
        if(mobileUrl) bg.style.backgroundImage = "url('" + mobileUrl + "')";
      }
    })();
    <% } %>
    <% }); %>

    function goTo(n) {
      slides[current].classList.remove('active');
      dots[current] && dots[current].classList.remove('active');
      current = (n + total) % total;
      slides[current].classList.add('active');
      dots[current] && dots[current].classList.add('active');
    }

    window.sliderMove = function(dir){ clearTimer(); goTo(current + dir); startTimer(); }
    window.sliderGo   = function(n)  { clearTimer(); goTo(n);             startTimer(); }

    function startTimer(){ timer = setInterval(function(){ goTo(current + 1); }, 5000); }
    function clearTimer(){ clearInterval(timer); }

    if(total > 1) startTimer();

    // Pause on hover
    const slider = document.getElementById('heroSlider');
    if(slider){
      slider.addEventListener('mouseenter', clearTimer);
      slider.addEventListener('mouseleave', function(){ if(total>1) startTimer(); });
    }
  })();
  </script>

  <script>
    function handleContactForm(e) {
      e.preventDefault();
      const btn = e.target.querySelector('.cf-submit');
      btn.disabled = true;
      btn.innerHTML = '<span style="width:16px;height:16px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin 0.7s linear infinite;display:inline-block;"></span> Sending...';
      setTimeout(function() {
        btn.innerHTML = '<i class="bi bi-send-fill"></i> Send Message';
        btn.disabled = false;
        e.target.reset();
        const ok = document.getElementById('cfSuccess');
        if(ok){ ok.style.display='flex'; setTimeout(()=>ok.style.display='none', 5000); }
      }, 1500);
    }
  </script>
