<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="theme-color" content="#0B0B0F"/>
  <title>MEE — Book Your Event Entry</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    /* ── VARIABLES & RESET ── */
    :root {
      --bg:#0B0B0F; --surface:#14141C; --card:#14141C;
      --border:rgba(255,255,255,0.08); --accent:#6A0DAD;
      --accent-dim:rgba(106,13,173,0.12); --text:#FFFFFF;
      --muted:#B3B3B3; --success:#00FF88; --error:#FF4444;
      --font-display:'Montserrat',sans-serif;
      --font-body:'Poppins',sans-serif;
      --font-mono:'Space Mono',monospace;

      /* ── TYPOGRAPHY SCALE ── */
      --title-max: 3rem;       /* headings / event names */
      --body-max: 1rem;        /* body text */
      --desc-max: 0.75rem;     /* descriptions / labels */
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{background:var(--bg);color:var(--text);font-family:var(--font-body);min-height:100vh;overflow-x:hidden;font-size:var(--body-max);}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;z-index:0;}

    /* ── HERO SLIDER ── */
    .hero-slider {
      position: relative;
      width: 100%;
      height: calc(100vh - 60px);
      min-height: 400px;
      max-height: 860px;   /* taller on large screens */
      overflow: hidden;
      background: #0a0a0f;
    }
    @media(min-width:1400px){.hero-slider{max-height:980px;}}  /* 4K / large laptops */
    @media(min-width:1200px) and (max-width:1399px){.hero-slider{max-height:820px;}}

    /* Each slide */
    .slide {
      position: absolute; inset: 0;
      opacity: 0;
      transition: opacity 0.7s ease;
      display: flex; align-items: flex-end;
    }
    .slide.active { opacity: 1; z-index: 2; }
    .slide.prev   { opacity: 0; z-index: 1; }

    /* Banner image — desktop vs mobile */
    .slide-bg {
      position: absolute; inset: 0;
      background-size: cover;
      background-position: center top;
      background-repeat: no-repeat;
    }
    /* Dark gradient over image so text is legible */
    .slide-bg::after {
      content:'';
      position:absolute; inset:0;
      background: linear-gradient(
        to right,
        rgba(8,8,14,0.92) 0%,
        rgba(8,8,14,0.7)  40%,
        rgba(8,8,14,0.2)  70%,
        rgba(8,8,14,0.05) 100%
      );
    }
    /* On mobile: also darken from bottom for readability */
    @media(max-width:768px){
      .slide-bg::after {
        background: linear-gradient(
          to top,
          rgba(8,8,14,0.95) 0%,
          rgba(8,8,14,0.7)  50%,
          rgba(8,8,14,0.2)  100%
        );
      }
    }

    /* Slide content */
    .slide-content {
      position: relative; z-index: 3;
      padding: 0 5vw 5vh;
      max-width: 560px;
      animation: slideUp 0.5s ease both;
    }
    @keyframes slideUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

    .slide-date {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--desc-max);
      letter-spacing: 0.5px;
      color: #fff;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 20px;
      padding: 0.28rem 0.85rem;
      margin-bottom: 1rem;
      text-transform: uppercase;
    }
    .slide-name {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, var(--title-max));
      letter-spacing: 0.5px;
      color: #fff;
      line-height: 1.05;
      margin-bottom: 0.15rem;
    }
    .slide-name .accent { color: var(--accent); }
    .slide-venue {
      display: flex; align-items: center; gap: 0.4rem;
      font-size: var(--desc-max);
      color: rgba(255,255,255,0.7);
      margin-bottom: 0.9rem;
    }
    .slide-venue i { color: var(--accent); }
    .slide-desc {
      font-size: var(--desc-max);
      color: rgba(255,255,255,0.6);
      line-height: 1.65;
      max-width: 420px;
      margin-bottom: 1.4rem;
    }
    .slide-btns { display: flex; gap: 0.8rem; flex-wrap: wrap; }
    .btn-book-now {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: var(--accent); color: #fff;
      padding: 0.7rem 1.5rem; border-radius: 6px;
      text-decoration: none; font-weight: 700;
      font-size: var(--desc-max); letter-spacing: 0.5px;
      transition: box-shadow 0.2s, transform 0.15s;
      box-shadow: 0 0 24px rgba(106,13,173,0.35);
    }
    .btn-book-now:hover { transform: translateY(-2px); box-shadow: 0 0 40px rgba(106,13,173,0.55); color: #fff; }
    .btn-view-details {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: transparent; color: #fff;
      padding: 0.7rem 1.4rem; border-radius: 6px;
      text-decoration: none; font-weight: 600;
      font-size: var(--desc-max);
      border: 1px solid rgba(255,255,255,0.25);
      transition: border-color 0.2s, background 0.2s;
    }
    .btn-view-details:hover { border-color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.06); color: #fff; }

    /* Slider arrows */
    .slider-arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      z-index: 10; width: 44px; height: 44px;
      background: rgba(8,8,14,0.65);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50%; cursor: pointer; color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; transition: background 0.2s, border-color 0.2s;
    }
    .slider-arrow:hover { background: rgba(106,13,173,0.45); border-color: rgba(106,13,173,0.5); }
    .slider-arrow.prev { left: 1.2rem; }
    .slider-arrow.next { right: 1.2rem; }

    /* Slider dots */
    .slider-dots {
      position: absolute; bottom: 1.4rem; left: 50%; transform: translateX(-50%);
      z-index: 10; display: flex; align-items: center; gap: 0.5rem;
    }
    .slider-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: rgba(255,255,255,0.3); cursor: pointer;
      transition: background 0.3s, width 0.3s, border-radius 0.3s;
    }
    .slider-dot.active {
      width: 24px; border-radius: 4px;
      background: var(--accent);
    }

    /* ── SPONSORS MARQUEE ── */
    .sp-banner-item {
      height: 90px;
      min-width: 260px;
      max-width: 340px;
      border-radius: 10px;
      overflow: hidden;
      flex-shrink: 0;
      cursor: pointer;
      border: 1px solid rgba(255,255,255,0.08);
      background: #0d0d15;
      transition: border-color 0.2s, transform 0.2s;
    }
    .sp-banner-item:hover { border-color: rgba(106,13,173,0.4); transform: translateY(-2px); }
    .sp-banner-item img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }
    #sponsorTrack:hover { animation-play-state: paused; }
    #sponsorSection { padding: 2.5rem 0 0; }
    .sp-track-wrap { overflow: hidden; width: 100%; }
    @keyframes spScroll { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    @media(min-width:1400px){ .sp-banner-item { height: 110px; min-width: 320px; } }
    @media(min-width:768px) and (max-width:1199px){ .sp-banner-item { height: 80px; min-width: 230px; } }
    @media(max-width:767px){
      .sp-banner-item { height: 64px; min-width: 180px; border-radius: 8px; }
    }
    @media(max-width:480px){
      .sp-banner-item { height: 54px; min-width: 150px; }
    }

    /* ── EVENTS GRID ── */
    .section { max-width:1100px; margin:0 auto; padding:4rem 2rem; position:relative; z-index:1; }
    .section-tag { font-family:var(--font-mono); font-size:var(--desc-max); letter-spacing:0.5px; color:var(--accent); display:block; margin-bottom:0.4rem; text-transform:uppercase; }
    .section-title { font-family:var(--font-display); font-size:clamp(1.6rem,3.5vw,var(--title-max)); letter-spacing:0.5px; color:#fff; margin-bottom:1.8rem; }

    .events-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1.2rem; }
    .event-card { background:var(--card); border:1px solid var(--border); border-radius:12px; overflow:hidden; transition:border-color 0.2s, transform 0.2s; display:flex; flex-direction:column; }
    .event-card:hover { border-color:rgba(106,13,173,0.3); transform:translateY(-4px); }
    .event-card.featured { border-color:rgba(106,13,173,0.4); }
    .event-card-top { height:2px; background:linear-gradient(90deg,transparent,#6A0DAD,transparent); }

    .event-poster {
      height: 130px;
      background: linear-gradient(135deg,#0B0B0F,#1a0a2e,#2d0a5c);
      display: flex; align-items: center; justify-content: center;
      font-size: 3rem; position: relative; overflow: hidden;
    }
    .event-poster img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .featured-badge { position:absolute; top:8px; left:8px; background:var(--accent); color:#fff; font-family:var(--font-mono); font-size:0.55rem; letter-spacing:0.5px; padding:0.18rem 0.55rem; border-radius:2px; font-weight:700; z-index:2; }
    .sold-out-overlay { position:absolute; inset:0; background:rgba(8,8,14,0.75); display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-size:1.3rem; letter-spacing:0.5px; color:var(--error); z-index:3; }

    .event-body { padding:1.1rem; flex:1; display:flex; flex-direction:column; }
    .event-name { font-family:var(--font-display); font-size:1.2rem; letter-spacing:1.5px; color:#fff; margin-bottom:0.65rem; }
    .event-meta { display:flex; flex-direction:column; gap:0.32rem; margin-bottom:0.8rem; }
    .event-meta-item { display:flex; align-items:center; gap:0.4rem; font-size:var(--desc-max); color:var(--muted); }
    .event-meta-item i { color:var(--accent); width:13px; }
    .tier-pills { display:flex; flex-wrap:wrap; gap:0.35rem; margin-bottom:1rem; }
    .tier-pill { font-family:var(--font-mono); font-size:0.55rem; letter-spacing:1px; padding:0.18rem 0.55rem; border-radius:10px; border:1px solid; }
    .event-footer { display:flex; align-items:center; justify-content:space-between; margin-top:auto; }
    .event-price { font-family:var(--font-display); font-size:1.3rem; color:var(--accent); }
    .event-price span { font-family:var(--font-body); font-size:var(--desc-max); color:var(--muted); font-weight:400; }
    .btn-ev-book {
      display:flex; align-items:center; gap:0.35rem;
      background:var(--accent); color:#fff;
      padding:0.55rem 1.1rem; border-radius:5px;
      text-decoration:none; font-weight:700;
      font-size:var(--desc-max); letter-spacing:0.5px;
      transition:box-shadow 0.2s, transform 0.15s; border:none; cursor:pointer;
    }
    .btn-ev-book:hover { box-shadow:0 0 20px rgba(106,13,173,0.4); transform:translateY(-1px); color:#fff; }
    .btn-ev-book.disabled { background:rgba(255,255,255,0.08); color:var(--muted); cursor:not-allowed; pointer-events:none; }

    .no-events { text-align:center; padding:3.5rem; background:var(--card); border:1px solid var(--border); border-radius:12px; }
    .no-events-icon { font-size:2.5rem; margin-bottom:0.8rem; }
    .no-events-title { font-family:var(--font-display); font-size:1.3rem; color:#fff; margin-bottom:0.4rem; }
    .no-events-sub { color:var(--muted); font-size:var(--desc-max); }

    footer { border-top:1px solid var(--border); padding:1.8rem 2rem; text-align:center; position:relative; z-index:1; }
    .f-logo { font-family:var(--font-display); font-size:1.5rem; letter-spacing:1px; color:#fff; margin-bottom:0.3rem; }
    .f-logo span { color:var(--accent); }
    .f-sub { font-size:var(--desc-max); color:var(--muted); }

    @media(max-width:768px){
      .hero-slider{ height:70vw; min-height:300px; max-height:500px; }
      .events-grid{ grid-template-columns:1fr; }
      .slider-arrow{ display:none; }
    }
    @media(max-width:480px){
      .hero-slider{ height:85vw; min-height:260px; max-height:420px; }
    }
  </style>
</head>
<body>

  <%- include('../partials/navbar') %>

  <!-- ═══════════════ HERO SLIDER ═══════════════ -->
  <%
    const tierColors = {standard:'#a0a0a0',silver:'#c0c8d8',gold:'#f5c842',platinum:'#6A0DAD',vip:'#bf80ff',general:'#a0a0a0'};
    const sliderEvents = events && events.length ? events : [];
  %>

  <% if (sliderEvents.length > 0) { %>
  <div class="hero-slider" id="heroSlider">

    <% sliderEvents.forEach(function(ev, idx){ %>
    <%
      const evSoldOut = ev.ticketTypes.length > 0 && ev.ticketTypes.every(t => t.bookedSeats >= t.totalSeats);
      const evMinPrice = ev.ticketTypes.filter(t=>t.isActive&&t.bookedSeats<t.totalSeats);
      const minP = evMinPrice.length ? Math.min(...evMinPrice.map(t=>t.price)) : 0;

      // Choose banner: use bannerDesktop/bannerMobile if set, else gradient fallback
      const hasBanner = ev.bannerDesktop || ev.bannerMobile;
      const bgDesktop = ev.bannerDesktop || '';
      const bgMobile  = ev.bannerMobile  || ev.bannerDesktop || '';
    %>
    <div class="slide <%= idx===0?'active':'' %>" data-index="<%= idx %>">

      <!-- Background banner -->
      <div class="slide-bg"
        style="<% if(hasBanner){ %>background-image:url('<%= bgDesktop %>')<% } else { %>background:linear-gradient(135deg,#0a0014 0%,#1a0030 40%,#2a0050 70%,#600020 100%)<% } %>;"
        id="slideBg<%= idx %>">
      </div>

      <!-- Content overlay -->
      <div class="slide-content">
        <span class="slide-date">
          <%= new Date(ev.date).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}).toUpperCase() %>
        </span>

        <!-- Split name: first word white, second purple -->
        <%
          const nameParts = ev.name.trim().split(' ');
          const firstName = nameParts[0] || '';
          const restName  = nameParts.slice(1).join(' ') || '';
        %>
        <div class="slide-name">
          <%= firstName %><% if(restName){ %><br/><span class="accent"><%= restName %></span><% } %>
        </div>

        <div class="slide-venue">
          <i class="bi bi-geo-alt-fill"></i>
          <%= ev.venue %>
        </div>

        <% if(ev.description){ %>
        <p class="slide-desc"><%= ev.description.substring(0,120) %><%= ev.description.length>120?'…':'' %></p>
        <% } %>

        <div class="slide-btns">
          <% if (evSoldOut) { %>
            <span class="btn-book-now" style="opacity:0.5;cursor:not-allowed;">Sold Out</span>
          <% } else if (locals.user && user) { %>
            <a href="/booking/seatmap/<%= ev._id %>" class="btn-book-now"><i class="bi bi-ticket-perforated-fill"></i> Book Now</a>
          <% } else { %>
            <a href="/auth/login?next=/booking/seatmap/<%= ev._id %>" class="btn-book-now"><i class="bi bi-ticket-perforated-fill"></i> Book Now</a>
          <% } %>
          <a href="/event/<%= ev._id %>" class="btn-view-details">View Details <i class="bi bi-arrow-right"></i></a>
        </div>
      </div>
    </div>
    <% }); %>

    <!-- Arrows -->
    <% if(sliderEvents.length > 1){ %>
    <button class="slider-arrow prev" onclick="sliderMove(-1)" aria-label="Previous">
      <i class="bi bi-chevron-left"></i>
    </button>
    <button class="slider-arrow next" onclick="sliderMove(1)" aria-label="Next">
      <i class="bi bi-chevron-right"></i>
    </button>
    <% } %>

    <!-- Dots -->
    <div class="slider-dots" id="sliderDots">
      <% sliderEvents.forEach(function(ev, idx){ %>
      <div class="slider-dot <%= idx===0?'active':'' %>" onclick="sliderGo(<%= idx %>)"></div>
      <% }); %>
    </div>
  </div>
  <% } else { %>
  <!-- Fallback hero if no events -->
  <div class="hero-slider" style="display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;background:linear-gradient(135deg,#0a0014,#1a0030);">
    <div style="font-family:'Montserrat',sans-serif;font-size:var(--title-max);color:#fff;letter-spacing:0.5px;text-align:center;">YOUR NIGHT<br/><span style="color:var(--accent);">STARTS HERE</span></div>
    <p style="color:var(--muted);font-size:var(--desc-max);text-align:center;">Kochi's most electrifying underground parties.</p>
    <a href="/auth/signup" class="btn-book-now"><i class="bi bi-person-plus"></i> Create Account</a>
  </div>
  <% } %>

  <!-- ═══════════════ SPONSORS ═══════════════ -->
  <div id="sponsorSection" style="display:none;padding:2.5rem 1.5rem 0;position:relative;z-index:1;max-width:1100px;margin:0 auto;">
    <div style="display:flex;align-items:center;gap:0.8rem;margin-bottom:1rem;">
      <div style="height:1px;flex:1;background:rgba(255,255,255,0.07);"></div>
      <span style="font-family:var(--font-mono);font-size:0.55rem;letter-spacing:3px;color:#555;text-transform:uppercase;white-space:nowrap;">Our Sponsors</span>
      <div style="height:1px;flex:1;background:rgba(255,255,255,0.07);"></div>
    </div>
    <div style="overflow:hidden;border-radius:10px;border:1px solid rgba(255,255,255,0.06);background:rgba(255,255,255,0.02);">
      <div id="sponsorTrack" style="display:flex;gap:0.8rem;padding:0.6rem;width:max-content;animation:spScroll 20s linear infinite;">
      </div>
    </div>
  </div>

  <!-- ═══════════════ EVENTS GRID ═══════════════ -->
  <div class="section" id="events">
    <span class="section-tag">// upcoming events</span>
    <div class="section-title">EVENTS</div>

    <% if (!events || events.length === 0) { %>
    <div class="no-events">
      <div class="no-events-icon">🎶</div>
      <div class="no-events-title">NO EVENTS YET</div>
      <div class="no-events-sub">Check back soon — something big is coming.</div>
    </div>
    <% } else { %>
    <div class="events-grid">
      <% events.forEach(function(ev){ %>
      <%
        const activeTiers = ev.ticketTypes.filter(t => t.isActive);
        const isHouseFull = activeTiers.length > 0 && activeTiers.every(t => t.bookedSeats >= t.totalSeats);
        const isSoldOut = isHouseFull; // alias
        const minPrice = activeTiers.filter(t => t.bookedSeats < t.totalSeats).length
          ? Math.min(...activeTiers.filter(t => t.bookedSeats < t.totalSeats).map(t => t.price)) : 0;
      %>
      <div class="event-card <%= ev.isFeatured?'featured':'' %>">
        <div class="event-card-top"></div>
        <div class="event-poster">
          <% if(ev.bannerDesktop || ev.bannerMobile){ %>
            <img src="<%= ev.bannerDesktop||ev.bannerMobile %>" alt="<%= ev.name %>" loading="lazy"/>
          <% } else { %>
            <%= ev.poster || '🎶' %>
          <% } %>
          <% if(ev.isFeatured){ %><div class="featured-badge">FEATURED</div><% } %>
          <% if(isHouseFull){ %><div class="sold-out-overlay" style="background:rgba(0,0,0,0.75);font-size:0.9rem;letter-spacing:3px;">🏠 HOUSE FULL</div><% } %>
        </div>
        <div class="event-body">
          <div class="event-name"><%= ev.name.toUpperCase() %></div>
          <div class="event-meta">
            <div class="event-meta-item"><i class="bi bi-calendar3"></i> <%= new Date(ev.date).toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'long',year:'numeric'}) %></div>
            <div class="event-meta-item"><i class="bi bi-clock"></i> <%= ev.doorsOpen %> – <%= ev.endTime %></div>
            <div class="event-meta-item"><i class="bi bi-geo-alt-fill"></i> <%= ev.venue %></div>
            
          </div>
          <div class="tier-pills">
            <% activeTiers.forEach(function(t){ %>
            <% const tOut = t.bookedSeats >= t.totalSeats; %>
            <span class="tier-pill" style="<%= tOut ? 'color:#555;border-color:rgba(255,68,68,0.2);background:rgba(255,68,68,0.04);text-decoration:line-through;' : 'color:'+( tierColors[t.category]||'#6A0DAD' )+';border-color:'+(tierColors[t.category]||'#6A0DAD')+'33;background:'+(tierColors[t.category]||'#6A0DAD')+'11;' %>">
              <%= t.name %><% if(!tOut){ %> · ₹<%= t.price.toLocaleString('en-IN') %><% } else { %> · Sold Out<% } %>
            </span>
            <% }); %>
          </div>
          <div class="event-footer">
            <div class="event-price">
              <% if(minPrice > 0){ %>₹<%= minPrice.toLocaleString('en-IN') %> <span>onwards</span><% } %>
            </div>
            <% if(isHouseFull){ %>
              <span class="btn-ev-book disabled" style="background:rgba(255,68,68,0.1);"><i class="bi bi-house-fill"></i> House Full</span>
            <% } else if(locals.user && user){ %>
              <a href="/booking/seatmap/<%= ev._id %>" class="btn-ev-book me-2"><i class="bi bi-ticket-perforated-fill"></i> Book Now</a>
              <a href="/event/<%= ev._id %>" class="btn-view-details"><i class="bi bi-arrow-right">View Details</i></a>

            <% } else { %>
              <a href="/auth/login?next=/booking/seatmap/<%= ev._id %>" class="btn-ev-book"><i class="bi bi-ticket-perforated-fill"></i> Book Now</a>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>

  <!-- ═══════════════ ABOUT SECTION ═══════════════ -->
  <div class="section" id="about" style="padding-top:2rem;">
