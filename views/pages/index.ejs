<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>NightPass — Book Your Party Entry</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#08080e;--surface:#0f0f18;--card:#13131e;--border:rgba(255,255,255,0.08);--accent:#c8ff00;--accent-dim:rgba(200,255,0,0.09);--text:#e8e8f0;--muted:#5a5a72;--success:#4cdf80;--error:#ff5c5c;}
    *{box-sizing:border-box;margin:0;padding:0;}html{scroll-behavior:smooth;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;overflow-x:hidden;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .orb1{position:fixed;top:-200px;left:50%;transform:translateX(-50%);width:700px;height:500px;border-radius:50%;background:radial-gradient(ellipse,rgba(200,255,0,0.06) 0%,transparent 65%);pointer-events:none;}
    .orb2{position:fixed;bottom:-200px;left:-150px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(100,50,220,0.07) 0%,transparent 65%);pointer-events:none;}

    /* HERO */
    .hero{min-height:calc(100vh - 65px);display:flex;align-items:center;justify-content:center;position:relative;z-index:1;padding:4rem 2rem;text-align:center;}
    .hero-tag{display:inline-flex;align-items:center;gap:0.6rem;background:var(--accent-dim);border:1px solid rgba(200,255,0,0.2);border-radius:20px;padding:0.5rem 1.2rem;font-family:'Space Mono',monospace;font-size:0.68rem;letter-spacing:2px;color:var(--accent);margin-bottom:2rem;}
    .live-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pulse 1.5s infinite;}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.8)}}
    .hero-title{font-family:'Anton',sans-serif;font-size:clamp(3.5rem,10vw,8rem);letter-spacing:3px;color:#fff;line-height:0.92;margin-bottom:1rem;}
    .hero-title .a{color:var(--accent);}
    .hero-title .d{color:rgba(255,255,255,0.18);}
    .hero-sub{font-size:1.1rem;color:var(--muted);line-height:1.7;max-width:550px;margin:0 auto 2.5rem;}
    .hero-cta{display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap;}
    .btn-hero{display:inline-flex;align-items:center;gap:0.6rem;background:var(--accent);color:#000;padding:1rem 2.5rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:1rem;letter-spacing:1px;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 0 30px rgba(200,255,0,0.2);}
    .btn-hero:hover{transform:translateY(-3px);box-shadow:0 0 60px rgba(200,255,0,0.5);color:#000;}
    .btn-hero-out{display:inline-flex;align-items:center;gap:0.6rem;background:transparent;color:var(--text);padding:1rem 2rem;border-radius:6px;text-decoration:none;font-weight:600;font-size:0.95rem;border:1px solid var(--border);transition:border-color 0.2s,color 0.2s;}
    .btn-hero-out:hover{border-color:rgba(255,255,255,0.25);color:#fff;}

    /* SECTIONS */
    .section{max-width:1100px;margin:0 auto;padding:5rem 2rem;position:relative;z-index:1;}
    .section-tag{font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:3px;color:var(--accent);display:block;margin-bottom:0.5rem;}
    .section-title{font-family:'Anton',sans-serif;font-size:clamp(2rem,4vw,3rem);letter-spacing:2px;color:#fff;margin-bottom:2rem;}

    /* EVENT CARDS */
    .events-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.5rem;}
    .event-card{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;transition:border-color 0.2s,transform 0.2s;display:flex;flex-direction:column;}
    .event-card:hover{border-color:rgba(200,255,0,0.2);transform:translateY(-4px);}
    .event-card.featured{border-color:rgba(200,255,0,0.3);}
    .event-card-top{height:3px;background:linear-gradient(90deg,transparent,var(--accent),transparent);}
    .event-poster{height:140px;background:linear-gradient(135deg,#0a0a0f,#1c2200,#3a4a00);display:flex;align-items:center;justify-content:center;font-size:3.5rem;position:relative;}
    .featured-badge{position:absolute;top:10px;left:10px;background:var(--accent);color:#000;font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;padding:0.2rem 0.6rem;border-radius:2px;font-weight:700;}
    .sold-out-overlay{position:absolute;inset:0;background:rgba(8,8,14,0.75);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:3px;color:var(--error);}
    .event-body{padding:1.3rem;flex:1;display:flex;flex-direction:column;}
    .event-name{font-family:'Anton',sans-serif;font-size:1.3rem;letter-spacing:2px;color:#fff;margin-bottom:0.8rem;}
    .event-meta{display:flex;flex-direction:column;gap:0.4rem;margin-bottom:1rem;}
    .event-meta-item{display:flex;align-items:center;gap:0.5rem;font-size:0.8rem;color:var(--muted);}
    .event-meta-item i{color:var(--accent);width:14px;}
    .tier-pills{display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:1.2rem;}
    .tier-pill{font-family:'Space Mono',monospace;font-size:0.56rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;border:1px solid;}
    .event-footer{display:flex;align-items:center;justify-content:space-between;margin-top:auto;}
    .event-price{font-family:'Anton',sans-serif;font-size:1.4rem;color:var(--accent);letter-spacing:1px;}
    .event-price span{font-family:'Outfit',sans-serif;font-size:0.75rem;color:var(--muted);font-weight:400;}
    .btn-book{display:flex;align-items:center;gap:0.4rem;background:var(--accent);color:#000;padding:0.6rem 1.2rem;border-radius:5px;text-decoration:none;font-weight:700;font-size:0.82rem;letter-spacing:1px;transition:box-shadow 0.2s,transform 0.15s;border:none;cursor:pointer;}
    .btn-book:hover{box-shadow:0 0 20px rgba(200,255,0,0.3);transform:translateY(-1px);color:#000;}
    .btn-book.disabled{background:rgba(255,255,255,0.1);color:var(--muted);cursor:not-allowed;pointer-events:none;}

    /* Countdown */
    .countdown-bar{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:1.5rem 2rem;position:relative;z-index:1;}
    .countdown-inner{max-width:700px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:3rem;flex-wrap:wrap;}
    .cd-item{text-align:center;}
    .cd-num{font-family:'Anton',sans-serif;font-size:2.5rem;color:var(--accent);line-height:1;letter-spacing:2px;}
    .cd-lbl{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);margin-top:0.2rem;}
    .cd-sep{font-family:'Anton',sans-serif;font-size:2rem;color:var(--border);line-height:1;}

    /* No events */
    .no-events{text-align:center;padding:4rem;background:var(--card);border:1px solid var(--border);border-radius:12px;}
    .no-events-icon{font-size:3rem;margin-bottom:1rem;}
    .no-events-title{font-family:'Anton',sans-serif;font-size:1.5rem;color:#fff;margin-bottom:0.5rem;}
    .no-events-sub{color:var(--muted);font-size:0.9rem;}

    footer{border-top:1px solid var(--border);padding:2rem;text-align:center;position:relative;z-index:1;}
    .f-logo{font-family:'Anton',sans-serif;font-size:1.8rem;letter-spacing:4px;color:#fff;margin-bottom:0.4rem;}
    .f-logo span{color:var(--accent);}
    .f-sub{font-size:0.8rem;color:var(--muted);}

    @media(max-width:600px){.hero-title{font-size:3rem;}.events-grid{grid-template-columns:1fr;}.countdown-inner{gap:1.5rem;}}
  </style>
</head>
<body>
  <div class="orb1"></div>
  <div class="orb2"></div>

  <%- include('../partials/navbar') %>

  <!-- HERO -->
  <section class="hero">
    <div>
      <div class="hero-tag"><div class="live-dot"></div> NIGHTPASS · KOCHI · 2026</div>
      <h1 class="hero-title">YOUR<br/><span class="a">NIGHT</span><span class="d"> STARTS</span><br/>HERE</h1>
      <p class="hero-sub">Book tickets for Kochi's most electrifying underground parties. Verified entry. QR passes. No queues.</p>
      <div class="hero-cta">
        <% if (locals.user && user) { %>
          <a href="#events" class="btn-hero"><i class="bi bi-ticket-perforated-fill"></i> Browse Events</a>
          <a href="/user/profile" class="btn-hero-out"><i class="bi bi-person-fill"></i> My Profile</a>
        <% } else { %>
          <a href="#events" class="btn-hero"><i class="bi bi-ticket-perforated-fill"></i> Browse Events</a>
          <a href="/auth/signup" class="btn-hero-out"><i class="bi bi-person-plus"></i> Create Account</a>
        <% } %>
      </div>
    </div>
  </section>

  <!-- COUNTDOWN (shows for next upcoming event) -->
  <% if (event) { %>
  <div class="countdown-bar">
    <div class="countdown-inner">
      <div style="font-family:'Space Mono',monospace;font-size:0.62rem;letter-spacing:2px;color:var(--muted);margin-right:1rem;">NEXT EVENT IN</div>
      <div class="cd-item"><div class="cd-num" id="cdDays">--</div><div class="cd-lbl">Days</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><div class="cd-num" id="cdHours">--</div><div class="cd-lbl">Hours</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><div class="cd-num" id="cdMins">--</div><div class="cd-lbl">Minutes</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><div class="cd-num" id="cdSecs">--</div><div class="cd-lbl">Seconds</div></div>
    </div>
  </div>
  <% } %>

  <!-- EVENTS -->
  <div class="section" id="events">
    <span class="section-tag">// upcoming events</span>
    <div class="section-title">EVENTS</div>

    <% const tierColors = {standard:'#a0a0a0',silver:'#c0c8d8',gold:'#f5c842',platinum:'#c8ff00',vip:'#bf80ff',general:'#a0a0a0'}; %>

    <% if (!events || events.length === 0) { %>
      <div class="no-events">
        <div class="no-events-icon">🎶</div>
        <div class="no-events-title">NO EVENTS YET</div>
        <div class="no-events-sub">Check back soon — something big is coming.</div>
      </div>
    <% } else { %>
      <div class="events-grid">
        <% events.forEach(function(ev) { %>
        <%
          const isSoldOut = ev.ticketTypes.length > 0 && ev.ticketTypes.every(t => t.bookedSeats >= t.totalSeats);
          const activeTiers = ev.ticketTypes.filter(t => t.isActive);
          const minPrice = activeTiers.length ? Math.min(...activeTiers.map(t => t.price)) : 0;
        %>
        <div class="event-card <%= ev.isFeatured ? 'featured' : '' %>">
          <div class="event-card-top"></div>
          <div class="event-poster">
            <%= ev.poster || '🎶' %>
            <% if (ev.isFeatured) { %><div class="featured-badge">FEATURED</div><% } %>
            <% if (isSoldOut) { %><div class="sold-out-overlay">SOLD OUT</div><% } %>
          </div>
          <div class="event-body">
            <div class="event-name"><%= ev.name.toUpperCase() %></div>
            <div class="event-meta">
              <div class="event-meta-item"><i class="bi bi-calendar3"></i> <%= new Date(ev.date).toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'long',year:'numeric'}) %></div>
              <div class="event-meta-item"><i class="bi bi-clock"></i> <%= ev.doorsOpen %> – <%= ev.endTime %></div>
              <div class="event-meta-item"><i class="bi bi-geo-alt-fill"></i> <%= ev.venue %></div>
              <div class="event-meta-item"><i class="bi bi-person-check-fill"></i> <%= ev.ageLimit %>+ · <%= ev.dressCode %></div>
            </div>
            <!-- Ticket tier pills -->
            <div class="tier-pills">
              <% ev.ticketTypes.filter(t=>t.isActive).forEach(function(t){ %>
              <span class="tier-pill" style="color:<%= tierColors[t.category]||'#c8ff00' %>;border-color:<%= tierColors[t.category]||'#c8ff00' %>33;background:<%= tierColors[t.category]||'#c8ff00' %>11;">
                <%= t.name %> · ₹<%= t.price.toLocaleString('en-IN') %>
              </span>
              <% }); %>
            </div>
            <div class="event-footer">
              <div class="event-price">
                <% if (minPrice > 0) { %>₹<%= minPrice.toLocaleString('en-IN') %> <span>onwards</span><% } %>
              </div>
              <% if (isSoldOut) { %>
                <span class="btn-book disabled"><i class="bi bi-x-circle"></i> Sold Out</span>
              <% } else if (locals.user && user) { %>
                <a href="/booking/<%= ev._id %>" class="btn-book"><i class="bi bi-ticket-perforated-fill"></i> Book Now</a>
              <% } else { %>
                <a href="/auth/login?next=/booking/<%= ev._id %>" class="btn-book"><i class="bi bi-ticket-perforated-fill"></i> Book Now</a>
              <% } %>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <footer>
    <div class="f-logo">NIGHT<span>PASS</span></div>
    <div class="f-sub">© 2026 NightPass · Kochi · All rights reserved.</div>
  </footer>

  <script>
    <% if (event) { %>
    (function() {
      const target = new Date('<%= new Date(event.date).toISOString() %>').getTime();
      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) { ['cdDays','cdHours','cdMins','cdSecs'].forEach(id => document.getElementById(id).textContent = '00'); return; }
        const pad = n => String(n).padStart(2,'0');
        document.getElementById('cdDays').textContent  = pad(Math.floor(diff/86400000));
        document.getElementById('cdHours').textContent = pad(Math.floor((diff%86400000)/3600000));
        document.getElementById('cdMins').textContent  = pad(Math.floor((diff%3600000)/60000));
        document.getElementById('cdSecs').textContent  = pad(Math.floor((diff%60000)/1000));
      }
      tick(); setInterval(tick, 1000);
    })();
    <% } %>

    if (window.history && window.history.replaceState)
      window.history.replaceState(null, '', window.location.href);
  </script>
</body>
</html>
