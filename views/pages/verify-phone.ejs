<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Verify Phone — NightPass</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/index.css"/>
  <script src="/js/ui.js" defer></script>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--card:#1A1A24;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--text:#fff;--muted:#B3B3B3;--error:#FF4444;--success:#00FF88;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;display:flex;flex-direction:column;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .orb{position:fixed;border-radius:50%;pointer-events:none;}
    .orb1{top:-150px;left:-100px;width:500px;height:500px;background:radial-gradient(circle,rgba(106,13,173,0.07) 0%,transparent 65%);}
    .orb2{bottom:-150px;right:-100px;width:450px;height:450px;background:radial-gradient(circle,rgba(100,50,220,0.08) 0%,transparent 65%);}
    nav{position:relative;z-index:1;padding:1.1rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);}
    .logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:4px;color:#fff;text-decoration:none;}
    .logo span{color:var(--accent);}
    .wrapper{flex:1;display:flex;align-items:center;justify-content:center;padding:2rem 1rem;position:relative;z-index:1;}
    .card{background:var(--card);border:1px solid var(--border);border-radius:16px;width:100%;max-width:440px;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,0.5);}
    .card-bar{height:3px;background:linear-gradient(90deg,transparent,#6A0DAD,transparent);}
    .card-body{padding:2.2rem;}
    .step-label{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:3px;color:var(--accent);margin-bottom:0.5rem;}
    h1{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;line-height:1;margin-bottom:0.5rem;}
    .desc{font-size:0.88rem;color:var(--muted);line-height:1.6;margin-bottom:1.8rem;}
    /* Step indicator */
    .steps{display:flex;align-items:center;gap:0;margin-bottom:2rem;}
    .step{display:flex;align-items:center;gap:0.5rem;font-size:0.72rem;color:#555;}
    .step.done .step-dot{background:var(--success);border-color:var(--success);}
    .step.active .step-dot{background:var(--accent);border-color:var(--accent);}
    .step-dot{width:24px;height:24px;border-radius:50%;border:2px solid #333;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;flex-shrink:0;}
    .step-line{flex:1;height:1px;background:#222;margin:0 0.4rem;}
    /* Phone input */
    .field-group{margin-bottom:1rem;}
    .field-label{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;display:block;margin-bottom:0.5rem;}
    .phone-wrap{display:flex;border:2px solid var(--border);border-radius:8px;overflow:hidden;background:var(--surface);transition:border-color 0.2s;}
    .phone-wrap:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(106,13,173,0.08);}
    .phone-wrap.err{border-color:var(--error);}
    .cc{display:flex;align-items:center;padding:0 1rem;border-right:1px solid var(--border);font-size:0.9rem;color:var(--text);white-space:nowrap;flex-shrink:0;background:rgba(255,255,255,0.03);}
    .ph-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-size:1rem;padding:0.9rem 1rem;font-family:'Outfit',sans-serif;letter-spacing:1px;}
    .ph-input::placeholder{color:var(--muted);font-size:0.9rem;letter-spacing:0;}
    /* OTP boxes */
    .otp-row{display:flex;gap:0.5rem;justify-content:center;margin:1.2rem 0 1.5rem;}
    .otp-box{width:48px;height:56px;background:#0B0B0F;border:2px solid rgba(255,255,255,0.1);border-radius:8px;text-align:center;font-size:1.4rem;font-family:'Space Mono',monospace;color:#fff;outline:none;transition:border-color 0.2s;}
    .otp-box:focus{border-color:var(--accent);}
    /* Buttons */
    .btn{width:100%;padding:1rem;border:none;border-radius:8px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;letter-spacing:0.5px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:0.6rem;}
    .btn-primary{background:var(--accent);color:#fff;box-shadow:0 0 25px rgba(106,13,173,0.25);margin-bottom:0.8rem;}
    .btn-primary:hover:not(:disabled){box-shadow:0 0 45px rgba(106,13,173,0.5);transform:translateY(-1px);}
    .btn-primary:disabled{opacity:0.4;cursor:not-allowed;transform:none;}
    .btn-outline{background:transparent;color:#555;border:1px solid rgba(255,255,255,0.08);}
    .btn-outline:hover{color:var(--muted);border-color:rgba(255,255,255,0.15);}
    .msg{font-size:0.82rem;text-align:center;padding:0.65rem 1rem;border-radius:6px;margin-bottom:1rem;display:none;}
    .msg.err{background:rgba(255,68,68,0.1);border:1px solid rgba(255,68,68,0.3);color:var(--error);}
    .msg.ok{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);color:var(--success);}
    .resend{text-align:center;font-size:0.78rem;color:#555;margin-top:1rem;}
    .resend a{color:var(--accent);cursor:pointer;}
    .spinner{width:18px;height:18px;border:2px solid rgba(255,255,255,0.2);border-top-color:#fff;border-radius:50%;animation:spin 0.7s linear infinite;display:none;}
    @keyframes spin{to{transform:rotate(360deg)}}
    #otpSection{display:none;}
    @media(max-width:480px){.card-body{padding:1.5rem 1.1rem;}.otp-box{width:42px;height:50px;font-size:1.2rem;}}
  </style>
</head>
<body>
  <div class="orb orb1"></div>
  <div class="orb orb2"></div>
  <nav>
    <a href="/" class="logo">MEE<span>ENTERTINMENT EVENTS</span></a>
  </nav>

  <div class="wrapper">
    <div class="card">
      <div class="card-bar"></div>
      <div class="card-body">

        <!-- Step indicator -->
        <div class="steps">
          <div class="step done">
            <div class="step-dot" style="color:var(--success);">✓</div>
            <span style="color:var(--success);">Google</span>
          </div>
          <div class="step-line"></div>
          <div class="step active">
            <div class="step-dot" style="color:#fff;">2</div>
            <span style="color:var(--muted);">Phone</span>
          </div>
          <div class="step-line"></div>
          <div class="step">
            <div class="step-dot">3</div>
            <span>Done</span>
          </div>
        </div>

        <div class="step-label">// step 2 of 3 — verify phone</div>
        <h1>ADD YOUR<br/>PHONE</h1>
        <p class="desc">Enter your mobile number to complete your NightPass account. We'll send a quick OTP to verify.</p>

        <div id="msg" class="msg"></div>

        <!-- Phone entry section -->
        <div id="phoneSection">
          <div class="field-group">
            <label class="field-label">Mobile Number *</label>
            <div class="phone-wrap" id="phoneWrap">
              <div class="cc">🇮🇳 +91</div>
              <input type="tel" class="ph-input" id="phoneInput" placeholder="98765 43210" maxlength="10" inputmode="numeric"/>
            </div>
          </div>
          <button class="btn btn-primary" id="sendBtn" onclick="sendOTP()">
            <i class="bi bi-phone-fill" id="sendIcon"></i>
            <span id="sendText">Send OTP</span>
            <div class="spinner" id="sendSpinner"></div>
          </button>
          <!-- <button class="btn btn-outline" onclick="skipPhone()">Skip for now →</button> -->
        </div>

        <!-- OTP entry section -->
        <div id="otpSection">
          <p style="font-size:0.82rem;color:var(--muted);text-align:center;margin-bottom:0.5rem;">OTP sent to <strong id="phoneDisplay" style="color:#fff;"></strong></p>
          <div class="otp-row" id="otpRow">
            <input class="otp-box" maxlength="1" inputmode="numeric" id="o1"/>
            <input class="otp-box" maxlength="1" inputmode="numeric" id="o2"/>
            <input class="otp-box" maxlength="1" inputmode="numeric" id="o3"/>
            <input class="otp-box" maxlength="1" inputmode="numeric" id="o4"/>
            <input class="otp-box" maxlength="1" inputmode="numeric" id="o5"/>
            <input class="otp-box" maxlength="1" inputmode="numeric" id="o6"/>
          </div>
          <button class="btn btn-primary" id="verifyBtn" onclick="verifyPhone()">
            <i class="bi bi-shield-check-fill" id="verifyIcon"></i>
            <span id="verifyText">Verify OTP</span>
            <div class="spinner" id="verifySpinner"></div>
          </button>
          <button class="btn btn-outline" style="margin-top:0.5rem;" onclick="changePhone()">← Change number</button>
          <div class="resend">Didn't get it? <a onclick="resendOTP()">Resend OTP</a></div>
        </div>

      </div>
    </div>
  </div>

<script>
  // Only digits in phone
  document.getElementById('phoneInput').addEventListener('input', function(){
    this.value = this.value.replace(/\D/g,'').slice(0,10);
  });

  // OTP auto-advance
  const boxes = [...document.querySelectorAll('.otp-box')];
  boxes.forEach((b,i)=>{
    b.addEventListener('input',()=>{ if(b.value.length===1&&boxes[i+1]) boxes[i+1].focus(); });
    b.addEventListener('keydown',e=>{ if(e.key==='Backspace'&&!b.value&&boxes[i-1]) boxes[i-1].focus(); });
    b.addEventListener('paste',e=>{
      e.preventDefault();
      const txt=(e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'');
      txt.split('').forEach((c,j)=>{ if(boxes[i+j]) boxes[i+j].value=c; });
      const next=Math.min(i+txt.length,5);
      if(boxes[next]) boxes[next].focus();
    });
  });

  function getOTP(){ return boxes.map(b=>b.value).join(''); }
  function showMsg(txt,type){ const m=document.getElementById('msg'); m.textContent=txt; m.className='msg '+type; m.style.display='block'; }
  function hideMsg(){ document.getElementById('msg').style.display='none'; }

  function setBtnLoading(prefix, on){
    document.getElementById(prefix+'Btn').disabled=on;
    document.getElementById(prefix+'Icon').style.display=on?'none':'inline';
    document.getElementById(prefix+'Spinner').style.display=on?'block':'none';
  }

  async function sendOTP(){
    const phone = document.getElementById('phoneInput').value.trim();
    if(!phone||phone.length!==10||!/^[6-9]\d{9}$/.test(phone)){
      document.getElementById('phoneWrap').classList.add('err');
      showMsg('Enter a valid 10-digit Indian mobile number.','err');
      return;
    }
    document.getElementById('phoneWrap').classList.remove('err');
    hideMsg();
    setBtnLoading('send',true);
    try{
      const res=await fetch('/auth/send-phone-otp',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({phone})});
      const d=await res.json();
      if(d.success){
        document.getElementById('phoneDisplay').textContent='+91 '+phone;
        document.getElementById('phoneSection').style.display='none';
        document.getElementById('otpSection').style.display='block';
        showMsg('OTP sent to +91 '+phone,'ok');
      } else {
        showMsg(d.message||'Failed to send OTP.','err');
        setBtnLoading('send',false);
      }
    }catch(e){ showMsg('Network error.','err'); setBtnLoading('send',false); }
  }

  async function verifyPhone(){
    const otp=getOTP();
    if(otp.length!==6){ showMsg('Enter the 6-digit OTP','err'); return; }
    hideMsg();
    setBtnLoading('verify',true);
    try{
      const res=await fetch('/auth/verify-phone-otp',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({otp})});
      const d=await res.json();
      if(d.success){ showMsg('Phone verified! Redirecting…','ok'); setTimeout(()=>window.location.href=d.redirect||'/',1000); }
      else{ showMsg(d.message||'Invalid OTP','err'); setBtnLoading('verify',false); }
    }catch(e){ showMsg('Network error.','err'); setBtnLoading('verify',false); }
  }

  async function resendOTP(){
    showMsg('Resending…','ok');
    try{
      const res=await fetch('/auth/resend-phone-otp',{method:'POST',credentials:'include'});
      const d=await res.json();
      showMsg(d.message||'OTP resent!',d.success?'ok':'err');
    }catch(e){ showMsg('Network error.','err'); }
  }

  function changePhone(){
    boxes.forEach(b=>b.value='');
    document.getElementById('otpSection').style.display='none';
    document.getElementById('phoneSection').style.display='block';
    setBtnLoading('send',false);
    hideMsg();
  }

  function skipPhone(){ window.location.href='/'; }
</script>
</body>
</html>
