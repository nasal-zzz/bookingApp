<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>My Profile — NightPass</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    :root{--bg:#08080e;--surface:#0f0f18;--card:#13131e;--card2:#161620;--border:rgba(255,255,255,0.08);--accent:#c8ff00;--accent-dim:rgba(200,255,0,0.09);--text:#e8e8f0;--muted:#5a5a72;--success:#4cdf80;--error:#ff5c5c;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .orb1{position:fixed;top:-200px;right:-100px;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(200,255,0,0.04) 0%,transparent 65%);pointer-events:none;}
    .orb2{position:fixed;bottom:-200px;left:-100px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(100,50,220,0.06) 0%,transparent 65%);pointer-events:none;}

    /* NAV */
    nav{padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:rgba(8,8,14,0.9);backdrop-filter:blur(20px);position:sticky;top:0;z-index:100;}
    .logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:4px;color:#fff;text-decoration:none;}
    .logo span{color:var(--accent);}
    .nav-links{display:flex;align-items:center;gap:1rem;}
    .nav-link{display:flex;align-items:center;gap:0.4rem;color:var(--muted);text-decoration:none;font-size:0.82rem;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s;padding:0.4rem 0.8rem;border-radius:4px;border:1px solid transparent;}
    .nav-link:hover{color:#fff;border-color:var(--border);}
    .nav-link.danger:hover{color:var(--error);border-color:rgba(255,92,92,0.3);}

    /* LAYOUT */
    .page-wrap{max-width:1100px;margin:0 auto;padding:2.5rem 1.5rem 5rem;position:relative;z-index:1;}
    .page-grid{display:grid;grid-template-columns:320px 1fr;gap:1.5rem;align-items:start;}

    /* LEFT COLUMN */
    .profile-card{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;position:sticky;top:80px;}
    .profile-card-top{height:3px;background:linear-gradient(90deg,transparent,var(--accent),transparent);}
    .profile-card-body{padding:1.8rem;}

    /* Avatar */
    .avatar-section{text-align:center;margin-bottom:1.8rem;}
    .avatar{width:90px;height:90px;border-radius:50%;background:linear-gradient(135deg,#1c2200,#3a4a00);border:3px solid rgba(200,255,0,0.3);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:2.2rem;color:var(--accent);margin:0 auto 1rem;position:relative;}
    .avatar-verified{position:absolute;bottom:2px;right:2px;width:22px;height:22px;background:var(--success);border-radius:50%;border:2px solid var(--card);display:flex;align-items:center;justify-content:center;font-size:0.6rem;color:#000;}
    .profile-name{font-family:'Anton',sans-serif;font-size:1.6rem;letter-spacing:2px;color:#fff;margin-bottom:0.2rem;}
    .profile-phone{display:flex;align-items:center;justify-content:center;gap:0.4rem;font-family:'Space Mono',monospace;font-size:0.72rem;letter-spacing:1px;color:var(--muted);}
    .profile-since{font-size:0.72rem;color:var(--muted);margin-top:0.3rem;}

    /* Stats row */
    .stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;margin-bottom:1.5rem;}
    .stat-box{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:0.8rem 0.5rem;text-align:center;}
    .stat-val{font-family:'Anton',sans-serif;font-size:1.6rem;color:var(--accent);line-height:1;}
    .stat-lbl{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:1px;color:var(--muted);margin-top:0.3rem;text-transform:uppercase;}

    /* Edit form */
    .edit-section-title{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;}
    .edit-section-title::after{content:'';flex:1;height:1px;background:var(--border);}
    .field-group{margin-bottom:0.9rem;}
    .field-label{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;display:block;margin-bottom:0.4rem;}
    .field-input{width:100%;background:var(--surface);border:2px solid var(--border);border-radius:7px;color:var(--text);font-size:0.9rem;padding:0.75rem 0.9rem;font-family:'Outfit',sans-serif;outline:none;transition:border-color 0.2s;}
    .field-input:focus{border-color:var(--accent);}
    .field-input[readonly]{opacity:0.5;cursor:not-allowed;}
    .btn-save{width:100%;padding:0.85rem;background:var(--accent);color:#000;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.88rem;border:none;border-radius:7px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.5rem;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 0 20px rgba(200,255,0,0.15);margin-top:1.2rem;}
    .btn-save:hover{transform:translateY(-2px);box-shadow:0 0 35px rgba(200,255,0,0.35);}
    .btn-save:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
    .save-msg{display:none;text-align:center;font-size:0.8rem;margin-top:0.7rem;padding:0.5rem;border-radius:4px;}
    .save-msg.ok{display:block;color:var(--success);background:rgba(76,223,128,0.08);border:1px solid rgba(76,223,128,0.2);}
    .save-msg.err{display:block;color:var(--error);background:rgba(255,92,92,0.08);border:1px solid rgba(255,92,92,0.2);}

    /* Logout btn */
    .btn-logout{width:100%;margin-top:1rem;padding:0.75rem;background:transparent;border:1px solid rgba(255,92,92,0.25);border-radius:7px;color:var(--error);font-family:'Outfit',sans-serif;font-size:0.85rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.5rem;transition:all 0.2s;}
    .btn-logout:hover{background:rgba(255,92,92,0.08);border-color:rgba(255,92,92,0.5);}

    /* RIGHT COLUMN */
    .eyebrow{font-family:'Space Mono',monospace;font-size:0.62rem;letter-spacing:3px;color:var(--accent);display:block;margin-bottom:0.4rem;}
    h1{font-family:'Anton',sans-serif;font-size:clamp(2rem,4vw,3rem);letter-spacing:2px;color:#fff;line-height:1;margin-bottom:2rem;}

    /* Tabs */
    .tabs{display:flex;gap:0.4rem;border-bottom:1px solid var(--border);margin-bottom:1.5rem;}
    .tab{padding:0.75rem 1.2rem;font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:2px;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;transition:color 0.2s,border-color 0.2s;background:none;border-top:none;border-left:none;border-right:none;text-transform:uppercase;}
    .tab:hover{color:var(--text);}
    .tab.active{color:var(--accent);border-bottom-color:var(--accent);}
    .tab-panel{display:none;}.tab-panel.active{display:block;}

    /* Booking card */
    .booking-card{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:1rem;transition:border-color 0.2s;}
    .booking-card:hover{border-color:rgba(200,255,0,0.15);}
    .booking-card-top{height:2px;background:linear-gradient(90deg,transparent,var(--accent),transparent);}
    .booking-main{padding:1.3rem 1.5rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
    .booking-left{display:flex;align-items:center;gap:1rem;}
    .booking-icon{width:52px;height:52px;border-radius:8px;background:linear-gradient(135deg,#1c2200,#3a4a00);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;}
    .booking-event{font-family:'Anton',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;margin-bottom:0.3rem;}
    .booking-meta{display:flex;flex-wrap:wrap;gap:0.8rem;}
    .booking-meta span{display:flex;align-items:center;gap:0.3rem;font-size:0.76rem;color:var(--muted);}
    .booking-meta i{color:var(--accent);font-size:0.8rem;}
    .booking-right{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
    .booking-amount{text-align:right;}
    .booking-amt-val{font-family:'Anton',sans-serif;font-size:1.5rem;color:var(--accent);letter-spacing:1px;}
    .booking-amt-sub{font-size:0.7rem;color:var(--muted);}
    .status-badge{display:inline-flex;align-items:center;gap:0.3rem;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:1px;padding:0.25rem 0.7rem;border-radius:10px;}
    .status-paid{background:rgba(76,223,128,0.1);border:1px solid rgba(76,223,128,0.35);color:var(--success);}
    .status-pending{background:rgba(255,200,0,0.1);border:1px solid rgba(255,200,0,0.35);color:#ffc800;}
    .status-failed{background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.35);color:var(--error);}

    /* Tickets inside booking */
    .tickets-strip{padding:0 1.5rem 1rem;border-top:1px solid var(--border);}
    .tickets-strip-title{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);padding:0.8rem 0 0.6rem;text-transform:uppercase;}
    .ticket-rows{display:flex;flex-direction:column;gap:0.5rem;}
    .ticket-row{background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:0.7rem 1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;}
    .ticket-row-left{display:flex;align-items:center;gap:0.8rem;}
    .ticket-avatar{width:34px;height:34px;border-radius:50%;background:var(--accent-dim);border:1px solid rgba(200,255,0,0.2);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.9rem;color:var(--accent);flex-shrink:0;}
    .ticket-name{font-weight:600;font-size:0.9rem;color:var(--text);}
    .ticket-id{font-family:'Space Mono',monospace;font-size:0.6rem;color:var(--muted);margin-top:1px;}
    .ticket-actions{display:flex;align-items:center;gap:0.5rem;}
    .used-badge{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.3);color:var(--error);}
    .btn-dl-pdf{display:flex;align-items:center;gap:0.4rem;padding:0.4rem 0.8rem;background:var(--surface);border:1px solid var(--border);border-radius:5px;color:var(--text);font-size:0.76rem;font-family:'Outfit',sans-serif;font-weight:600;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
    .btn-dl-pdf:hover{border-color:var(--accent);color:var(--accent);}
    .btn-dl-pdf:disabled{opacity:0.4;cursor:not-allowed;}
    .btn-view-ticket{display:flex;align-items:center;gap:0.4rem;padding:0.4rem 0.8rem;background:var(--accent);border:1px solid var(--accent);border-radius:5px;color:#000;font-size:0.76rem;font-family:'Outfit',sans-serif;font-weight:700;cursor:pointer;text-decoration:none;white-space:nowrap;transition:all 0.2s;}
    .btn-view-ticket:hover{box-shadow:0 0 15px rgba(200,255,0,0.3);}

    /* Empty state */
    .empty-state{text-align:center;padding:4rem 1rem;}
    .empty-icon{font-size:3rem;margin-bottom:1rem;}
    .empty-title{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:2px;color:#fff;margin-bottom:0.5rem;}
    .empty-sub{color:var(--muted);font-size:0.9rem;margin-bottom:2rem;}
    .btn-book-now{display:inline-flex;align-items:center;gap:0.5rem;background:var(--accent);color:#000;padding:0.9rem 2rem;border-radius:6px;text-decoration:none;font-weight:700;letter-spacing:1px;font-size:0.9rem;transition:transform 0.15s,box-shadow 0.15s;}
    .btn-book-now:hover{transform:translateY(-2px);box-shadow:0 0 30px rgba(200,255,0,0.3);}

    /* Activity tab */
    .activity-item{display:flex;align-items:flex-start;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--border);}
    .activity-item:last-child{border-bottom:none;}
    .activity-dot{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.9rem;flex-shrink:0;}
    .dot-green{background:rgba(76,223,128,0.1);border:1px solid rgba(76,223,128,0.3);}
    .dot-accent{background:rgba(200,255,0,0.1);border:1px solid rgba(200,255,0,0.3);}
    .activity-info{flex:1;}
    .activity-title{font-size:0.88rem;font-weight:600;color:var(--text);margin-bottom:0.2rem;}
    .activity-sub{font-size:0.76rem;color:var(--muted);}
    .activity-time{font-family:'Space Mono',monospace;font-size:0.6rem;color:var(--muted);white-space:nowrap;}

    @media(max-width:900px){.page-grid{grid-template-columns:1fr;}.profile-card{position:static;}}
    @media(max-width:600px){.booking-main{flex-direction:column;align-items:flex-start;}.nav-links .nav-link span{display:none;}}
  </style>
</head>
<body>
  <div class="orb1"></div>
  <div class="orb2"></div>

  <%- include('../partials/navbar') %>

  <div class="page-wrap">
    <span class="eyebrow">// my account</span>
    <h1>MY <span style="color:var(--muted);">PROFILE</span></h1>

    <div class="page-grid">

      <!-- ── LEFT — Profile Card ── -->
      <div>
        <div class="profile-card">
          <div class="profile-card-top"></div>
          <div class="profile-card-body">

            <!-- Avatar & name -->
            <div class="avatar-section">
              <div class="avatar">
                <%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName) { %><%= user.lastName.charAt(0).toUpperCase() %><% } %>
                <% if (user.isVerified) { %>
                  <div class="avatar-verified"><i class="bi bi-check"></i></div>
                <% } %>
              </div>
              <div class="profile-name"><%= (user.firstName + ' ' + (user.lastName||'')).trim().toUpperCase() %></div>
              <div class="profile-phone"><i class="bi bi-phone-fill" style="color:var(--accent);"></i> <%= user.phone %></div>
              <div class="profile-since">Member since <%= new Date(user.createdAt).toLocaleDateString('en-IN', {month:'long', year:'numeric'}) %></div>
            </div>

            <!-- Stats -->
            <div class="stats-row">
              <div class="stat-box">
                <div class="stat-val"><%= stats.totalBookings %></div>
                <div class="stat-lbl">Bookings</div>
              </div>
              <div class="stat-box">
                <div class="stat-val"><%= stats.totalTickets %></div>
                <div class="stat-lbl">Tickets</div>
              </div>
              <div class="stat-box">
                <div class="stat-val">₹<%= (stats.totalSpent/1000).toFixed(1) %>k</div>
                <div class="stat-lbl">Spent</div>
              </div>
            </div>

            <!-- Edit Profile -->
            <div class="edit-section-title">Edit Profile</div>

            <div class="field-group">
              <label class="field-label">First Name</label>
              <input type="text" class="field-input" id="editFirstName" value="<%= user.firstName %>" placeholder="First name"/>
            </div>
            <div class="field-group">
              <label class="field-label">Last Name</label>
              <input type="text" class="field-input" id="editLastName" value="<%= user.lastName || '' %>" placeholder="Last name"/>
            </div>
            <div class="field-group">
              <label class="field-label">Email Address</label>
              <input type="email" class="field-input" id="editEmail" value="<%= user.email || '' %>" placeholder="your@email.com"/>
            </div>
            <div class="field-group">
              <label class="field-label">Phone (cannot change)</label>
              <input type="text" class="field-input" value="<%= user.phone %>" readonly/>
            </div>

            <button class="btn-save" id="saveBtn" onclick="saveProfile()">
              <i class="bi bi-check2-circle" id="saveIcon"></i>
              <span id="saveText">Save Changes</span>
            </button>
            <div class="save-msg" id="saveMsg"></div>

            <button class="btn-logout" onclick="window.location.href='/auth/logout'">
              <i class="bi bi-box-arrow-right"></i> Sign Out
            </button>
          </div>
        </div>
      </div>

      <!-- ── RIGHT — Tabs ── -->
      <div>
        <!-- Tabs -->
        <div class="tabs">
          <button class="tab active" onclick="switchTab('bookings', this)">
            <i class="bi bi-ticket-perforated"></i> My Bookings (<%= stats.totalBookings %>)
          </button>
          <button class="tab" onclick="switchTab('activity', this)">
            <i class="bi bi-activity"></i> Activity
          </button>
        </div>

        <!-- BOOKINGS TAB -->
        <div class="tab-panel active" id="tab-bookings">
          <% if (bookings.length === 0) { %>
            <div class="empty-state">
              <div class="empty-icon">🎟</div>
              <div class="empty-title">NO BOOKINGS YET</div>
              <div class="empty-sub">You haven't booked any tickets yet. Get your pass for Eclipse Dark Night!</div>
              <a href="/booking" class="btn-book-now"><i class="bi bi-ticket-perforated-fill"></i> Book Tickets Now</a>
            </div>
          <% } else { %>
            <% bookings.forEach(function(booking, bi) { %>
            <div class="booking-card">
              <div class="booking-card-top"></div>
              <div class="booking-main">
                <div class="booking-left">
                  <div class="booking-icon">🎶</div>
                  <div>
                    <div class="booking-event"><%= booking.event ? booking.event.name.toUpperCase() : 'EVENT' %></div>
                    <div class="booking-meta">
                      <span><i class="bi bi-calendar3"></i> <%= booking.event ? new Date(booking.event.date).toDateString() : '' %></span>
                      <span><i class="bi bi-ticket-perforated"></i> <%= booking.quantity %> × <%= booking.ticketType %></span>
                      <span><i class="bi bi-hash"></i> <%= booking.bookingRef %></span>
                      <span><i class="bi bi-clock"></i> <%= new Date(booking.createdAt).toLocaleDateString('en-IN') %></span>
                    </div>
                  </div>
                </div>
                <div class="booking-right">
                  <div class="booking-amount">
                    <div class="booking-amt-val">₹<%= booking.totalAmount.toLocaleString('en-IN') %></div>
                    <div class="booking-amt-sub"><%= booking.quantity %> ticket<%= booking.quantity > 1 ? 's' : '' %></div>
                  </div>
                  <div>
                    <div class="status-badge status-<%= booking.paymentStatus %>">
                      <i class="bi bi-<%= booking.paymentStatus === 'paid' ? 'check-circle-fill' : booking.paymentStatus === 'pending' ? 'clock-fill' : 'x-circle-fill' %>"></i>
                      <%= booking.paymentStatus.toUpperCase() %>
                    </div>
                  </div>
                  <% if (booking.paymentStatus === 'paid') { %>
                    <a href="/booking/ticket/<%= booking._id %>" class="btn-view-ticket">
                      <i class="bi bi-qr-code"></i> View Tickets
                    </a>
                  <% } %>
                </div>
              </div>

              <!-- Individual tickets -->
              <% if (booking.paymentStatus === 'paid' && booking.tickets && booking.tickets.length > 0) { %>
              <div class="tickets-strip">
                <div class="tickets-strip-title">Entry Passes</div>
                <div class="ticket-rows">
                  <% booking.tickets.forEach(function(ticket, ti) { %>
                  <div class="ticket-row">
                    <div class="ticket-row-left">
                      <div class="ticket-avatar"><%= ticket.attendee.name.charAt(0).toUpperCase() %></div>
                      <div>
                        <div class="ticket-name"><%= ticket.attendee.name %></div>
                        <div class="ticket-id"><%= ticket.ticketId %></div>
                      </div>
                    </div>
                    <div class="ticket-actions">
                      <% if (ticket.isUsed) { %>
                        <span class="used-badge"><i class="bi bi-x-circle-fill"></i> USED</span>
                      <% } else { %>
                        <span class="status-badge status-paid" style="font-size:0.55rem;padding:0.18rem 0.5rem;"><i class="bi bi-check-circle-fill"></i> VALID</span>
                      <% } %>
                      <button class="btn-dl-pdf" id="dlbtn-<%= bi %>-<%= ti %>"
                        onclick="downloadTicketPDF(<%= bi %>, <%= ti %>, this)"
                        data-booking='<%- JSON.stringify({
                          ref: booking.bookingRef,
                          type: booking.ticketType,
                          qty: booking.quantity,
                          price: booking.pricePerTicket
                        }) %>'
                        data-ticket='<%- JSON.stringify({
                          ticketId: ticket.ticketId,
                          attendeeName: ticket.attendee.name,
                          attendeeAge: ticket.attendee.age,
                          qrCode: ticket.qrCode || ""
                        }) %>'
                        data-event='<%- JSON.stringify({
                          name: booking.event ? booking.event.name.toUpperCase() : "EVENT",
                          date: booking.event ? new Date(booking.event.date).toDateString().toUpperCase() : "",
                          doorsOpen: booking.event ? booking.event.doorsOpen : "",
                          endTime: booking.event ? booking.event.endTime : "",
                          venue: booking.event ? booking.event.venue : "",
                          dressCode: booking.event ? booking.event.dressCode : ""
                        }) %>'>
                        <i class="bi bi-file-earmark-pdf-fill"></i> Download PDF
                      </button>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
              <% } %>
            </div>
            <% }); %>
          <% } %>
        </div>

        <!-- ACTIVITY TAB -->
        <div class="tab-panel" id="tab-activity">
          <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.5rem;">
            <% if (bookings.length === 0) { %>
              <div class="empty-state">
                <div class="empty-icon">📋</div>
                <div class="empty-title">NO ACTIVITY YET</div>
                <div class="empty-sub">Your booking history will appear here.</div>
              </div>
            <% } else { %>
              <% bookings.forEach(function(booking) { %>
                <% if (booking.paymentStatus === 'paid') { %>
                <div class="activity-item">
                  <div class="activity-dot dot-green">🎟</div>
                  <div class="activity-info">
                    <div class="activity-title">Booked <%= booking.quantity %> × <%= booking.ticketType %> ticket<%= booking.quantity > 1 ? 's' : '' %></div>
                    <div class="activity-sub"><%= booking.event ? booking.event.name : '' %> · Ref: <%= booking.bookingRef %> · ₹<%= booking.totalAmount.toLocaleString('en-IN') %> paid</div>
                  </div>
                  <div class="activity-time"><%= new Date(booking.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
                </div>
                <% } else { %>
                <div class="activity-item">
                  <div class="activity-dot dot-accent">⚡</div>
                  <div class="activity-info">
                    <div class="activity-title">Payment <%= booking.paymentStatus %></div>
                    <div class="activity-sub"><%= booking.event ? booking.event.name : '' %> · Ref: <%= booking.bookingRef %></div>
                  </div>
                  <div class="activity-time"><%= new Date(booking.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
                </div>
                <% } %>
              <% }); %>

              <!-- Account created -->
              <div class="activity-item">
                <div class="activity-dot dot-accent">🎉</div>
                <div class="activity-info">
                  <div class="activity-title">Account created</div>
                  <div class="activity-sub">Joined NightPass · Phone verified</div>
                </div>
                <div class="activity-time"><%= new Date(user.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
              </div>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    // ── Tab switching ──
    function switchTab(name, btn) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + name).classList.add('active');
    }

    // ── Save profile ──
    async function saveProfile() {
      const btn = document.getElementById('saveBtn');
      const saveText = document.getElementById('saveText');
      const saveIcon = document.getElementById('saveIcon');
      const msg = document.getElementById('saveMsg');

      btn.disabled = true;
      saveText.textContent = 'Saving...';
      saveIcon.className = 'bi bi-hourglass-split';
      msg.className = 'save-msg';

      try {
        const res = await fetch('/user/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: document.getElementById('editFirstName').value.trim(),
            lastName:  document.getElementById('editLastName').value.trim(),
            email:     document.getElementById('editEmail').value.trim(),
          }),
        });
        const data = await res.json();
        msg.textContent = data.message;
        msg.className = 'save-msg ' + (data.success ? 'ok' : 'err');
      } catch(e) {
        msg.textContent = 'Network error. Try again.';
        msg.className = 'save-msg err';
      }

      btn.disabled = false;
      saveText.textContent = 'Save Changes';
      saveIcon.className = 'bi bi-check2-circle';
    }

    // ── Download single ticket as PDF ──
    async function downloadTicketPDF(bi, ti, btnEl) {
      btnEl.disabled = true;
      btnEl.innerHTML = '<i class="bi bi-hourglass-split"></i> Generating...';

      try {
        const bookingData = JSON.parse(btnEl.getAttribute('data-booking'));
        const ticketData  = JSON.parse(btnEl.getAttribute('data-ticket'));
        const eventData   = JSON.parse(btnEl.getAttribute('data-event'));

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a5' });
        const W = doc.internal.pageSize.getWidth();
        const H = doc.internal.pageSize.getHeight();

        // Background
        doc.setFillColor(8, 8, 14); doc.rect(0, 0, W, H, 'F');

        // Header band
        doc.setFillColor(15, 22, 0); doc.rect(0, 0, W * 0.55, H, 'F');

        // Accent top bar
        doc.setFillColor(200, 255, 0); doc.rect(0, 0, W * 0.55, 2, 'F');

        // Brand
        doc.setFont('helvetica', 'normal'); doc.setFontSize(7);
        doc.setTextColor(120, 140, 80);
        doc.text('NIGHTPASS · KOCHI', 12, 14);

        // Event name
        doc.setFont('helvetica', 'bold'); doc.setFontSize(20);
        doc.setTextColor(255, 255, 255);
        const nameLines = doc.splitTextToSize(eventData.name, 90);
        doc.text(nameLines, 12, 25);

        // Divider
        doc.setDrawColor(200, 255, 0); doc.setLineWidth(0.5);
        doc.line(12, 48, W * 0.55 - 10, 48);

        // Info fields
        const fields = [
          { label: 'DATE',        value: eventData.date },
          { label: 'DOORS OPEN',  value: eventData.doorsOpen },
          { label: 'UNTIL',       value: eventData.endTime },
          { label: 'VENUE',       value: eventData.venue },
          { label: 'DRESS CODE',  value: eventData.dressCode },
          { label: 'TICKET TYPE', value: bookingData.type.toUpperCase() },
        ];

        let y = 58;
        fields.forEach((f, i) => {
          const col = i < 3 ? 12 : 60;
          const row = i < 3 ? y + (i * 22) : y + ((i - 3) * 22);
          doc.setFont('helvetica', 'normal'); doc.setFontSize(6);
          doc.setTextColor(120, 140, 80); doc.text(f.label, col, row);
          doc.setFont('helvetica', 'bold'); doc.setFontSize(9);
          doc.setTextColor(230, 230, 230); doc.text(String(f.value), col, row + 5);
        });

        // Price
        doc.setFont('helvetica', 'bold'); doc.setFontSize(18);
        doc.setTextColor(200, 255, 0);
        doc.text('₹' + bookingData.price.toLocaleString('en-IN'), 12, H - 10);

        // Perforated divider
        doc.setDrawColor(50, 50, 50); doc.setLineWidth(0.3);
        for (let dotY = 5; dotY < H - 5; dotY += 4) {
          doc.line(W * 0.55, dotY, W * 0.55, dotY + 2);
        }
        doc.setFillColor(8, 8, 14);
        doc.circle(W * 0.55, 0, 5, 'F');
        doc.circle(W * 0.55, H, 5, 'F');

        // Right side
        const rx = W * 0.55 + 8;

        doc.setFont('helvetica', 'bold'); doc.setFontSize(14);
        doc.setTextColor(255, 255, 255);
        doc.text(ticketData.attendeeName, rx, 18);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(8);
        doc.setTextColor(120, 130, 100);
        doc.text('1 of ' + bookingData.qty + ' · ' + bookingData.type, rx, 25);

        // QR Code
        if (ticketData.qrCode && ticketData.qrCode.startsWith('data:image')) {
          try { doc.addImage(ticketData.qrCode, 'PNG', rx, 32, 55, 55); }
          catch(e) {
            doc.setFillColor(30,30,30); doc.rect(rx, 32, 55, 55, 'F');
            doc.setFont('helvetica','normal'); doc.setFontSize(7);
            doc.setTextColor(100,100,100); doc.text('QR CODE', rx + 16, 60);
          }
        } else {
          doc.setFillColor(30, 30, 30); doc.rect(rx, 32, 55, 55, 'F');
          doc.setFont('helvetica','normal'); doc.setFontSize(7);
          doc.setTextColor(100,100,100); doc.text('QR CODE', rx + 16, 60);
        }

        // Valid badge
        doc.setFillColor(20, 60, 30); doc.roundedRect(rx, 91, 55, 8, 2, 2, 'F');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(7);
        doc.setTextColor(76, 220, 128);
        doc.text('✓ VALID · ONE TIME ENTRY', rx + 4, 96.5);

        // Ticket ID & ref
        doc.setFont('courier', 'bold'); doc.setFontSize(7);
        doc.setTextColor(120, 130, 100);
        doc.text(ticketData.ticketId, rx, 107);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(6);
        doc.setTextColor(80, 90, 70);
        doc.text('REF: ' + bookingData.ref, rx, 113);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(6);
        doc.setTextColor(60, 70, 50);
        doc.text('SCAN AT ENTRY · 18+ · VALID PHOTO ID REQUIRED', rx, H - 6);

        doc.save('NightPass_' + ticketData.ticketId + '.pdf');
      } catch(e) {
        console.error('PDF error:', e);
        alert('PDF generation failed. Please try again.');
      }

      btnEl.disabled = false;
      btnEl.innerHTML = '<i class="bi bi-file-earmark-pdf-fill"></i> Download PDF';
    }
  </script>

  <script>
    // Replace history so back button skips login/otp pages
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', window.location.href);
    }
  </script>
</body>
</html>
