<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>My Profile — MEE</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--card:#14141C;--card2:#1a1a24;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--accent-dim:rgba(106,13,173,0.09);--text:#FFFFFF;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .orb1{position:fixed;top:-200px;right:-100px;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(106,13,173,0.04) 0%,transparent 65%);pointer-events:none;}
    .orb2{position:fixed;bottom:-200px;left:-100px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(100,50,220,0.06) 0%,transparent 65%);pointer-events:none;}

    /* NAV */
    nav{padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:rgba(8,8,14,0.9);backdrop-filter:blur(20px);position:sticky;top:0;z-index:100;}
    .logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:4px;color:#fff;text-decoration:none;}
    .logo span{color:var(--accent);}
    .nav-links{display:flex;align-items:center;gap:1rem;}
    .nav-link{display:flex;align-items:center;gap:0.4rem;color:var(--muted);text-decoration:none;font-size:0.82rem;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s;padding:0.4rem 0.8rem;border-radius:4px;border:1px solid transparent;}
    .nav-link:hover{color:#fff;border-color:var(--border);}
    .nav-link.danger:hover{color:var(--error);border-color:rgba(255,92,92,0.3);}

    /* LAYOUT */
    .page-wrap{max-width:1100px;margin:0 auto;padding:2.5rem 1.5rem 5rem;position:relative;z-index:1;}
    .page-grid{display:grid;grid-template-columns:320px 1fr;gap:1.5rem;align-items:start;}

    /* LEFT COLUMN */
    .profile-card{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;position:sticky;top:80px;}
    .profile-card-top{height:3px;background:linear-gradient(90deg,transparent,#6A0DAD,transparent);}
    .profile-card-body{padding:1.8rem;}

    /* Avatar */
    .avatar-section{text-align:center;margin-bottom:1.8rem;}
    .avatar{width:90px;height:90px;border-radius:50%;background:linear-gradient(135deg,#1a0a2e,#2d0a5c);border:3px solid rgba(106,13,173,0.4);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:2.2rem;color:var(--accent);margin:0 auto 0.4rem;position:relative;overflow:hidden;}
    .avatar:hover .avatar-hover-overlay{opacity:1!important;}
    .avatar-verified{position:absolute;bottom:2px;right:2px;width:22px;height:22px;background:var(--success);border-radius:50%;border:2px solid var(--card);display:flex;align-items:center;justify-content:center;font-size:0.6rem;color:#000;}
    .profile-name{font-family:'Anton',sans-serif;font-size:1.6rem;letter-spacing:2px;color:#fff;margin-bottom:0.2rem;}
    .profile-phone{display:flex;align-items:center;justify-content:center;gap:0.4rem;font-family:'Space Mono',monospace;font-size:0.72rem;letter-spacing:1px;color:var(--muted);}
    .profile-since{font-size:0.72rem;color:var(--muted);margin-top:0.3rem;}

    /* Stats row */
    .stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;margin-bottom:1.5rem;}
    .stat-box{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:0.8rem 0.5rem;text-align:center;}
    .stat-val{font-family:'Anton',sans-serif;font-size:1.6rem;color:var(--accent);line-height:1;}
    .stat-lbl{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:1px;color:var(--muted);margin-top:0.3rem;text-transform:uppercase;}

    /* Edit form */
    .edit-section-title{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;}
    .edit-section-title::after{content:'';flex:1;height:1px;background:var(--border);}
    .field-group{margin-bottom:0.9rem;}
    .field-label{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;display:block;margin-bottom:0.4rem;}
    .field-input{width:100%;background:var(--surface);border:2px solid var(--border);border-radius:7px;color:var(--text);font-size:0.9rem;padding:0.75rem 0.9rem;font-family:'Outfit',sans-serif;outline:none;transition:border-color 0.2s;}
    .field-input:focus{border-color:var(--accent);}
    .field-input[readonly]{opacity:0.5;cursor:not-allowed;}
    .btn-save{width:100%;padding:0.85rem;background:var(--accent);color:#000;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.88rem;border:none;border-radius:7px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.5rem;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 0 20px rgba(106,13,173,0.15);margin-top:1.2rem;}
    .btn-save:hover{transform:translateY(-2px);box-shadow:0 0 35px rgba(106,13,173,0.35);}
    .btn-save:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
    .save-msg{display:none;text-align:center;font-size:0.8rem;margin-top:0.7rem;padding:0.5rem;border-radius:4px;}
    .save-msg.ok{display:block;color:var(--success);background:rgba(144,78,221,0.08);border:1px solid rgba(144,78,221,0.2);}
    .save-msg.err{display:block;color:var(--error);background:rgba(255,92,92,0.08);border:1px solid rgba(255,92,92,0.2);}

    /* Logout btn */
    .btn-logout{width:100%;margin-top:1rem;padding:0.75rem;background:transparent;border:1px solid rgba(255,92,92,0.25);border-radius:7px;color:var(--error);font-family:'Outfit',sans-serif;font-size:0.85rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.5rem;transition:all 0.2s;}
    .btn-logout:hover{background:rgba(255,92,92,0.08);border-color:rgba(255,92,92,0.5);}

    /* RIGHT COLUMN */
    .eyebrow{font-family:'Space Mono',monospace;font-size:0.62rem;letter-spacing:3px;color:var(--accent);display:block;margin-bottom:0.4rem;}
    h1{font-family:'Anton',sans-serif;font-size:clamp(2rem,4vw,3rem);letter-spacing:2px;color:#fff;line-height:1;margin-bottom:2rem;}

    /* Tabs */
    .tabs{display:flex;gap:0.4rem;border-bottom:1px solid var(--border);margin-bottom:1.5rem;}
    .tab{padding:0.75rem 1.2rem;font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:2px;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;transition:color 0.2s,border-color 0.2s;background:none;border-top:none;border-left:none;border-right:none;text-transform:uppercase;}
    .tab:hover{color:var(--text);}
    .tab.active{color:var(--accent);border-bottom-color:var(--accent);}
    .tab-panel{display:none;}.tab-panel.active{display:block;}

    /* Booking card */
    .booking-card{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:1rem;transition:border-color 0.2s;}
    .booking-card:hover{border-color:rgba(106,13,173,0.15);}
    .booking-card-top{height:2px;background:linear-gradient(90deg,transparent,#6A0DAD,transparent);}
    .booking-main{padding:1.3rem 1.5rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
    .booking-left{display:flex;align-items:center;gap:1rem;}
    .booking-icon{width:52px;height:52px;border-radius:8px;background:linear-gradient(135deg,#1a0a2e,#2d0a5c);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;}
    .booking-event{font-family:'Anton',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;margin-bottom:0.3rem;}
    .booking-meta{display:flex;flex-wrap:wrap;gap:0.8rem;}
    .booking-meta span{display:flex;align-items:center;gap:0.3rem;font-size:0.76rem;color:var(--muted);}
    .booking-meta i{color:var(--accent);font-size:0.8rem;}
    .booking-right{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
    .booking-amount{text-align:right;}
    .booking-amt-val{font-family:'Anton',sans-serif;font-size:1.5rem;color:var(--accent);letter-spacing:1px;}
    .booking-amt-sub{font-size:0.7rem;color:var(--muted);}
    .status-badge{display:inline-flex;align-items:center;gap:0.3rem;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:1px;padding:0.25rem 0.7rem;border-radius:10px;}
    .status-paid{background:rgba(106,13,173,0.15);border:1px solid rgba(144,78,221,0.35);color:var(--success);}
    .status-pending{background:rgba(255,200,0,0.1);border:1px solid rgba(255,200,0,0.35);color:#ffc800;}
    .status-failed{background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.35);color:var(--error);}

    /* Tickets inside booking */
    .tickets-strip{padding:0 1.5rem 1rem;border-top:1px solid var(--border);}
    .tickets-strip-title{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);padding:0.8rem 0 0.6rem;text-transform:uppercase;}
    .ticket-rows{display:flex;flex-direction:column;gap:0.5rem;}
    .ticket-row{background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:0.7rem 1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;}
    .ticket-row-left{display:flex;align-items:center;gap:0.8rem;}
    .ticket-avatar{width:34px;height:34px;border-radius:50%;background:var(--accent-dim);border:1px solid rgba(106,13,173,0.25);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.9rem;color:var(--accent);flex-shrink:0;}
    .ticket-name{font-weight:600;font-size:0.9rem;color:var(--text);}
    .ticket-id{font-family:'Space Mono',monospace;font-size:0.6rem;color:var(--muted);margin-top:1px;}
    .ticket-actions{display:flex;align-items:center;gap:0.5rem;}
    .used-badge{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.3);color:var(--error);}
    .btn-dl-pdf{display:flex;align-items:center;gap:0.4rem;padding:0.4rem 0.8rem;background:var(--surface);border:1px solid var(--border);border-radius:5px;color:var(--text);font-size:0.76rem;font-family:'Outfit',sans-serif;font-weight:600;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
    .btn-dl-pdf:hover{border-color:var(--accent);color:var(--accent);}
    .btn-dl-pdf:disabled{opacity:0.4;cursor:not-allowed;}
    .btn-view-ticket{display:flex;align-items:center;gap:0.4rem;padding:0.4rem 0.8rem;background:var(--accent);border:1px solid var(--accent);border-radius:5px;color:#000;font-size:0.76rem;font-family:'Outfit',sans-serif;font-weight:700;cursor:pointer;text-decoration:none;white-space:nowrap;transition:all 0.2s;}
    .btn-view-ticket:hover{box-shadow:0 0 15px rgba(106,13,173,0.4);}
    .btn-pay-now{display:flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;background:linear-gradient(135deg,#6A0DAD,#9D4EDD);border:none;border-radius:6px;color:#fff;font-size:0.78rem;font-family:'Outfit',sans-serif;font-weight:700;cursor:pointer;white-space:nowrap;transition:all 0.2s;letter-spacing:0.5px;}
    .btn-pay-now:hover{box-shadow:0 0 18px rgba(106,13,173,0.5);transform:translateY(-1px);}
    .btn-retry{display:flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;background:rgba(245,200,66,0.12);border:1px solid rgba(245,200,66,0.35);border-radius:6px;color:#f5c842;font-size:0.78rem;font-family:'Outfit',sans-serif;font-weight:700;cursor:pointer;white-space:nowrap;transition:all 0.2s;text-decoration:none;}
    .btn-retry:hover{background:rgba(245,200,66,0.2);}
    .btn-delete-bk{display:flex;align-items:center;gap:0.35rem;padding:0.5rem 0.85rem;background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.25);border-radius:6px;color:var(--error);font-size:0.76rem;font-family:'Outfit',sans-serif;cursor:pointer;white-space:nowrap;transition:all 0.2s;}
    .btn-delete-bk:hover{background:rgba(255,68,68,0.16);}
    .booking-actions-bar{display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.8rem;padding-top:0.8rem;border-top:1px solid rgba(255,255,255,0.05);}

    /* Empty state */
    .empty-state{text-align:center;padding:4rem 1rem;}
    .empty-icon{font-size:3rem;margin-bottom:1rem;}
    .empty-title{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:2px;color:#fff;margin-bottom:0.5rem;}
    .empty-sub{color:var(--muted);font-size:0.9rem;margin-bottom:2rem;}
    .btn-book-now{display:inline-flex;align-items:center;gap:0.5rem;background:var(--accent);color:#000;padding:0.9rem 2rem;border-radius:6px;text-decoration:none;font-weight:700;letter-spacing:1px;font-size:0.9rem;transition:transform 0.15s,box-shadow 0.15s;}
    .btn-book-now:hover{transform:translateY(-2px);box-shadow:0 0 30px rgba(106,13,173,0.4);}

    /* Activity tab */
    .activity-item{display:flex;align-items:flex-start;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--border);}
    .activity-item:last-child{border-bottom:none;}
    .activity-dot{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.9rem;flex-shrink:0;}
    .dot-green{background:rgba(106,13,173,0.15);border:1px solid rgba(144,78,221,0.3);}
    .dot-accent{background:rgba(106,13,173,0.1);border:1px solid rgba(106,13,173,0.4);}
    .activity-info{flex:1;}
    .activity-title{font-size:0.88rem;font-weight:600;color:var(--text);margin-bottom:0.2rem;}
    .activity-sub{font-size:0.76rem;color:var(--muted);}
    .activity-time{font-family:'Space Mono',monospace;font-size:0.6rem;color:var(--muted);white-space:nowrap;}

    @media(max-width:900px){.page-grid{grid-template-columns:1fr;}.profile-card{position:static;}}
    @media(max-width:600px){.booking-main{flex-direction:column;align-items:flex-start;}.nav-links .nav-link span{display:none;}}
  </style>
</head>
<body>
  <div class="orb1"></div>
  <div class="orb2"></div>

  <%- include('../partials/navbar') %>

  <div class="page-wrap">
    <a href="/#events" style="display:inline-flex;align-items:center;gap:0.4rem;color:#B3B3B3;text-decoration:none;font-size:0.78rem;font-family:'Space Mono',monospace;letter-spacing:1px;padding:0.35rem 0.75rem;border:1px solid rgba(255,255,255,0.08);border-radius:5px;background:rgba(255,255,255,0.03);margin-bottom:1.2rem;transition:all 0.15s;" onmouseover="this.style.color='#fff';this.style.borderColor='rgba(255,255,255,0.2)'" onmouseout="this.style.color='#B3B3B3';this.style.borderColor='rgba(255,255,255,0.08)'">
      <i class="bi bi-house-fill"></i> Home
    </a>
    <span class="eyebrow">// my account</span>
    <h1>MY <span style="color:var(--muted);">PROFILE</span></h1>

    <div class="page-grid">

      <!-- ── LEFT — Profile Card ── -->
      <div>
        <div class="profile-card">
          <div class="profile-card-top"></div>
          <div class="profile-card-body">

            <!-- Avatar & name -->
            <div class="avatar-section">
              <div class="avatar" id="avatarCircle" onclick="document.getElementById('avatarFileInput').click()" style="cursor:pointer;position:relative;">
                <% if(user.avatar){ %>
                  <img src="<%= user.avatar %>" id="avatarImg" style="width:100%;height:100%;object-fit:cover;border-radius:50%;position:absolute;inset:0;" alt="Avatar"/>
                <% } else { %>
                  <span id="avatarInitials"><%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %></span>
                <% } %>
                <% if (user.isVerified) { %><div class="avatar-verified"><i class="bi bi-check"></i></div><% } %>
                <div style="position:absolute;inset:0;border-radius:50%;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.18s;" class="avatar-hover-overlay">
                  <i class="bi bi-camera-fill" style="color:#fff;font-size:1.2rem;"></i>
                </div>
              </div>
              <input type="file" id="avatarFileInput" accept="image/*" style="display:none;" onchange="openAvatarCrop(event)"/>
              <div style="font-size:0.65rem;color:#555;margin-top:0.3rem;margin-bottom:0.5rem;">Tap avatar to change photo</div>
              <div class="profile-name"><%= (user.firstName + ' ' + (user.lastName||'')).trim().toUpperCase() %></div>
              <!-- Verification badges -->
              <div style="display:flex;gap:0.4rem;justify-content:center;flex-wrap:wrap;margin:0.4rem 0;">
                <% if(user.isVerified){ %>
                  <span style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.3);color:#00FF88;"><i class="bi bi-phone-fill"></i> Phone Verified</span>
                <% } else { %>
                  <span style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.3);color:#FF4444;"><i class="bi bi-phone"></i> Phone Unverified</span>
                <% } %>
                <% if(user.emailVerified){ %>
                  <span style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.3);color:#00FF88;"><i class="bi bi-envelope-check-fill"></i> Email Verified</span>
                <% } else if(user.email){ %>
                  <span style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;background:rgba(255,200,0,0.08);border:1px solid rgba(255,200,0,0.3);color:#f5c842;"><i class="bi bi-envelope"></i> Email Unverified</span>
                <% } %>
              </div>
              <div class="profile-phone"><i class="bi bi-phone-fill" style="color:var(--accent);"></i> <%= user.phone||'Not added' %></div>
              <% if(user.email){ %><div class="profile-phone" style="margin-top:0.2rem;"><i class="bi bi-envelope-fill" style="color:var(--accent);"></i> <%= user.email %></div><% } %>
              <div class="profile-since">Member since <%= new Date(user.createdAt).toLocaleDateString('en-IN', {month:'long', year:'numeric'}) %></div>
            </div>

            <!-- Stats -->
            <div class="stats-row">
              <div class="stat-box">
                <div class="stat-val"><%= stats.totalBookings %></div>
                <div class="stat-lbl">Bookings</div>
              </div>
              <div class="stat-box">
                <div class="stat-val"><%= stats.totalTickets %></div>
                <div class="stat-lbl">Tickets</div>
              </div>
              <div class="stat-box">
                <div class="stat-val">₹<%= (stats.totalSpent/1000).toFixed(1) %>k</div>
                <div class="stat-lbl">Spent</div>
              </div>
            </div>

            <!-- Edit Profile -->
            <div class="edit-section-title">Edit Profile</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.7rem;">
              <div class="field-group">
                <label class="field-label">First Name</label>
                <input type="text" class="field-input" id="editFirstName" value="<%= user.firstName %>" placeholder="First name"/>
              </div>
              <div class="field-group">
                <label class="field-label">Last Name</label>
                <input type="text" class="field-input" id="editLastName" value="<%= user.lastName || '' %>" placeholder="Last name"/>
              </div>
            </div>
            <div class="field-group">
              <label class="field-label">Email Address</label>
              <input type="email" class="field-input" id="editEmail" value="<%= user.email || '' %>" placeholder="your@email.com"/>
            </div>
            <div class="field-group">
              <label class="field-label">WhatsApp Number</label>
              <input type="text" class="field-input" id="editWhatsapp" value="<%= user.whatsapp ? user.whatsapp.replace('+91','') : '' %>" placeholder="WhatsApp number" maxlength="10" inputmode="numeric"/>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.7rem;">
              <div class="field-group">
                <label class="field-label">Gender</label>
                <select class="field-input" id="editGender" style="appearance:none;cursor:pointer;">
                  <option value="">Select</option>
                  <option value="male" <%= user.gender==='male'?'selected':'' %>>Male</option>
                  <option value="female" <%= user.gender==='female'?'selected':'' %>>Female</option>
                  <option value="other" <%= user.gender==='other'?'selected':'' %>>Other</option>
                  <option value="prefer_not" <%= user.gender==='prefer_not'?'selected':'' %>>Prefer not to say</option>
                </select>
              </div>
              <div class="field-group">
                <label class="field-label">Place / City</label>
                <input type="text" class="field-input" id="editPlace" value="<%= user.place || '' %>" placeholder="City / Town"/>
              </div>
            </div>
            <div class="field-group">
              <label class="field-label">District</label>
              <select class="field-input" id="editDistrict" style="appearance:none;cursor:pointer;">
                <option value="">Select district</option>
                <% ['Thiruvananthapuram','Kollam','Pathanamthitta','Alappuzha','Kottayam','Idukki','Ernakulam','Thrissur','Palakkad','Malappuram','Kozhikode','Wayanad','Kannur','Kasaragod','Other State'].forEach(d=>{ %>
                  <option value="<%= d %>" <%= user.district===d?'selected':'' %>><%= d %></option>
                <% }); %>
              </select>
            </div>
            <div class="field-group">
              <label class="field-label">Phone (cannot change)</label>
              <input type="text" class="field-input" value="<%= user.phone||'Not added' %>" readonly style="opacity:0.5;cursor:not-allowed;"/>
            </div>

            <button class="btn-save" id="saveBtn" onclick="saveProfile()">
              <i class="bi bi-check2-circle" id="saveIcon"></i>
              <span id="saveText">Save Changes</span>
            </button>
            <div class="save-msg" id="saveMsg"></div>

            <button class="btn-logout" onclick="window.location.href='/auth/logout'">
              <i class="bi bi-box-arrow-right"></i> Sign Out
            </button>
          </div>
        </div>
      </div>

      <!-- ── RIGHT — Tabs ── -->
      <div>
        <!-- Tabs -->
        <div class="tabs">
          <button class="tab active" onclick="switchTab('bookings', this)">
            <i class="bi bi-ticket-perforated"></i> My Bookings (<%= stats.totalBookings %>)
          </button>
          <button class="tab" onclick="switchTab('activity', this)">
            <i class="bi bi-activity"></i> Activity
          </button>
        </div>

        <!-- BOOKINGS TAB -->
        <div class="tab-panel active" id="tab-bookings">
          <% if (bookings.length === 0) { %>
            <div class="empty-state">
              <div class="empty-icon">🎟</div>
              <div class="empty-title">NO BOOKINGS YET</div>
              <div class="empty-sub">You haven't booked any tickets yet. Get your pass for Eclipse Dark Night!</div>
              <a href="/booking" class="btn-book-now"><i class="bi bi-ticket-perforated-fill"></i> Book Tickets Now</a>
            </div>
          <% } else { %>
            <% bookings.forEach(function(booking, bi) { %>
            <div class="booking-card">
              <div class="booking-card-top"></div>
              <div class="booking-main">
                <div class="booking-left">
                  <div class="booking-icon">🎶</div>
                  <div>
                    <div class="booking-event"><%= booking.event ? booking.event.name.toUpperCase() : 'EVENT' %></div>
                    <div class="booking-meta">
                      <span><i class="bi bi-calendar3"></i> <%= booking.event ? new Date(booking.event.date).toDateString() : '' %></span>
                      <span><i class="bi bi-ticket-perforated"></i> <%= booking.quantity %> × <%= booking.ticketType %></span>
                      <span><i class="bi bi-hash"></i> <%= booking.bookingRef %></span>
                      <span><i class="bi bi-clock"></i> <%= new Date(booking.createdAt).toLocaleDateString('en-IN') %></span>
                    </div>
                  </div>
                </div>
                <div class="booking-right">
                  <div class="booking-amount">
                    <div class="booking-amt-val">₹<%= booking.totalAmount.toLocaleString('en-IN') %></div>
                    <div class="booking-amt-sub"><%= booking.quantity %> ticket<%= booking.quantity > 1 ? 's' : '' %></div>
                  </div>
                  <div>
                    <div class="status-badge status-<%= booking.paymentStatus %>">
                      <i class="bi bi-<%= booking.paymentStatus === 'paid' ? 'check-circle-fill' : booking.paymentStatus === 'pending' ? 'clock-fill' : 'x-circle-fill' %>"></i>
                      <%= booking.paymentStatus.toUpperCase() %>
                    </div>
                  </div>
                  <% if (booking.paymentStatus === 'paid') { %>
                    <a href="/booking/ticket/<%= booking._id %>" class="btn-view-ticket">
                      <i class="bi bi-qr-code"></i> View Tickets
                    </a>
                  <% } %>
                </div>
              </div>

              <% if (booking.paymentStatus === 'pending' || booking.paymentStatus === 'failed') { %>
              <div class="booking-actions-bar">
                <% if (booking.paymentStatus === 'pending') { %>
                <button class="btn-pay-now" onclick="payNow('<%= booking._id %>', '<%= bi %>')">
                  <i class="bi bi-lightning-charge-fill"></i> Pay Now
                </button>
                <% } %>
                <% if (booking.paymentStatus === 'failed') { %>
                <a href="/booking/retry-payment/<%= booking._id %>" class="btn-retry">
                  <i class="bi bi-arrow-repeat"></i> Retry Payment
                </a>
                <% } %>
                <button class="btn-delete-bk" onclick="deleteBooking('<%= booking._id %>', this)">
                  <i class="bi bi-trash3-fill"></i> Delete
                </button>
              </div>
              <% } %>

              <!-- Individual tickets -->
              <% if (booking.paymentStatus === 'paid' && booking.tickets && booking.tickets.length > 0) { %>
              <div class="tickets-strip">
                <div class="tickets-strip-title">Entry Passes</div>
                <div class="ticket-rows">
                  <% booking.tickets.forEach(function(ticket, ti) { %>
                  <div class="ticket-row">
                    <div class="ticket-row-left">
                      <div class="ticket-avatar"><%= ticket.attendee.name.charAt(0).toUpperCase() %></div>
                      <div>
                        <div class="ticket-name"><%= ticket.attendee.name %></div>
                        <div class="ticket-id"><%= ticket.ticketId %></div>
                      </div>
                    </div>
                    <div class="ticket-actions">
                      <% if (ticket.isUsed) { %>
                        <span class="used-badge"><i class="bi bi-x-circle-fill"></i> USED</span>
                      <% } else { %>
                        <span class="status-badge status-paid" style="font-size:0.55rem;padding:0.18rem 0.5rem;"><i class="bi bi-check-circle-fill"></i> VALID</span>
                      <% } %>
                      <button class="btn-dl-pdf" id="dlbtn-<%= bi %>-<%= ti %>"
                        onclick="downloadTicketPDF(<%= bi %>, <%= ti %>, this)"
                        data-booking='<%- JSON.stringify({
                          ref: booking.bookingRef,
                          type: booking.ticketType,
                          qty: booking.quantity,
                          price: booking.pricePerTicket
                        }) %>'
                        data-ticket='<%- JSON.stringify({
                          ticketId: ticket.ticketId,
                          attendeeName: ticket.attendee.name,
                          attendeeAge: ticket.attendee.age,
                          qrCode: ticket.qrCode || ""
                        }) %>'
                        data-event='<%- JSON.stringify({
                          name: booking.event ? booking.event.name.toUpperCase() : "EVENT",
                          date: booking.event ? new Date(booking.event.date).toDateString().toUpperCase() : "",
                          doorsOpen: booking.event ? booking.event.doorsOpen : "",
                          endTime: booking.event ? booking.event.endTime : "",
                          venue: booking.event ? booking.event.venue : "",
                          dressCode: booking.event ? booking.event.dressCode : ""
                        }) %>'>
                        <i class="bi bi-file-earmark-pdf-fill"></i> Download PDF
                      </button>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
              <% } %>
            </div>
            <% }); %>
          <% } %>
        </div>

        <!-- ACTIVITY TAB -->
        <div class="tab-panel" id="tab-activity">
          <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.5rem;">
            <% if (bookings.length === 0) { %>
              <div class="empty-state">
                <div class="empty-icon">📋</div>
                <div class="empty-title">NO ACTIVITY YET</div>
                <div class="empty-sub">Your booking history will appear here.</div>
              </div>
            <% } else { %>
              <% bookings.forEach(function(booking) { %>
                <% if (booking.paymentStatus === 'paid') { %>
                <div class="activity-item">
                  <div class="activity-dot dot-green">🎟</div>
                  <div class="activity-info">
                    <div class="activity-title">Booked <%= booking.quantity %> × <%= booking.ticketType %> ticket<%= booking.quantity > 1 ? 's' : '' %></div>
                    <div class="activity-sub"><%= booking.event ? booking.event.name : '' %> · Ref: <%= booking.bookingRef %> · ₹<%= booking.totalAmount.toLocaleString('en-IN') %> paid</div>
                  </div>
                  <div class="activity-time"><%= new Date(booking.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
                </div>
                <% } else { %>
                <div class="activity-item">
                  <div class="activity-dot dot-accent">⚡</div>
                  <div class="activity-info">
                    <div class="activity-title">Payment <%= booking.paymentStatus %></div>
                    <div class="activity-sub"><%= booking.event ? booking.event.name : '' %> · Ref: <%= booking.bookingRef %></div>
                  </div>
                  <div class="activity-time"><%= new Date(booking.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
                </div>
                <% } %>
              <% }); %>

              <!-- Account created -->
              <div class="activity-item">
                <div class="activity-dot dot-accent">🎉</div>
                <div class="activity-info">
                  <div class="activity-title">Account created</div>
                  <div class="activity-sub">Joined Melattur Entertainment Events · Phone verified</div>
                </div>
                <div class="activity-time"><%= new Date(user.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
              </div>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    // ── Tab switching ──
    function switchTab(name, btn) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + name).classList.add('active');
    }

    // ── Save profile ──
    async function saveProfile() {
      const btn = document.getElementById('saveBtn');
      const saveText = document.getElementById('saveText');
      const saveIcon = document.getElementById('saveIcon');
      const msg = document.getElementById('saveMsg');

      btn.disabled = true;
      saveText.textContent = 'Saving...';
      saveIcon.className = 'bi bi-hourglass-split';
      msg.className = 'save-msg';

      try {
        const res = await fetch('/user/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: document.getElementById('editFirstName').value.trim(),
            lastName:  document.getElementById('editLastName').value.trim(),
            email:     document.getElementById('editEmail').value.trim(),
            whatsapp:  document.getElementById('editWhatsapp')?.value?.trim()||'',
            gender:    document.getElementById('editGender')?.value||'',
            place:     document.getElementById('editPlace')?.value?.trim()||'',
            district:  document.getElementById('editDistrict')?.value||'',
          }),
        });
        const data = await res.json();
        msg.textContent = data.message;
        msg.className = 'save-msg ' + (data.success ? 'ok' : 'err');
      } catch(e) {
        msg.textContent = 'Network error. Try again.';
        msg.className = 'save-msg err';
      }

      btn.disabled = false;
      saveText.textContent = 'Save Changes';
      saveIcon.className = 'bi bi-check2-circle';
    }

    // ── Pay Now (for pending bookings) ──
    async function payNow(bookingId, bi) {
      try {
        const res = await fetch('/booking/retry-payment-api/' + bookingId, {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (!data.success) { alert(data.message || 'Unable to initiate payment.'); return; }
        const rzp = new Razorpay({
          key: data.key, amount: data.amount, currency: data.currency,
          name: 'Melattur Entertainment Events', description: data.description || 'Ticket Payment',
          order_id: data.orderId, prefill: data.prefill,
          theme: { color: '#6A0DAD', backdrop_color: '#0B0B0F' },
          handler: async function(response) {
            const vres = await fetch('/booking/verify-payment', {
              method: 'POST', credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id:   response.razorpay_order_id,
                razorpay_signature:  response.razorpay_signature,
              })
            });
            const vd = await vres.json();
            if (vd.success) { window.location.href = '/booking/success/' + vd.bookingId; }
            else { alert('Payment verified but failed. ID: ' + response.razorpay_payment_id); }
          },
          modal: { ondismiss: () => {} }
        });
        rzp.open();
      } catch(e) { alert('Error initiating payment. Please try again.'); }
    }

    // ── Delete booking ──
    async function deleteBooking(bookingId, btnEl) {
      if (!confirm('Delete this booking? This cannot be undone.')) return;
      btnEl.disabled = true;
      btnEl.innerHTML = '<i class="bi bi-hourglass-split"></i>';
      try {
        const res = await fetch('/user/delete-booking/' + bookingId, {
          method: 'DELETE', credentials: 'include'
        });
        const data = await res.json();
        if (data.success) {
          const card = btnEl.closest('.booking-card');
          if (card) { card.style.opacity = '0'; card.style.transform = 'scale(0.95)'; card.style.transition = '0.3s'; setTimeout(() => card.remove(), 300); }
        } else { alert(data.message || 'Could not delete booking.'); btnEl.disabled = false; btnEl.innerHTML = '<i class="bi bi-trash3-fill"></i> Delete'; }
      } catch(e) { alert('Error. Try again.'); btnEl.disabled = false; btnEl.innerHTML = '<i class="bi bi-trash3-fill"></i> Delete'; }
    }

    // ── Download single ticket as PDF ──
    async function downloadTicketPDF(bi, ti, btnEl) {
      btnEl.disabled = true;
      btnEl.innerHTML = '<i class="bi bi-hourglass-split"></i> Generating...';

      try {
        const bookingData = JSON.parse(btnEl.getAttribute('data-booking'));
        const ticketData  = JSON.parse(btnEl.getAttribute('data-ticket'));
        const eventData   = JSON.parse(btnEl.getAttribute('data-event'));

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a5' });
        const W = doc.internal.pageSize.getWidth();
        const H = doc.internal.pageSize.getHeight();

        // Background
        doc.setFillColor(8, 8, 14); doc.rect(0, 0, W, H, 'F');

        // Header band
        doc.setFillColor(15, 22, 0); doc.rect(0, 0, W * 0.55, H, 'F');

        // Accent top bar
        doc.setFillColor(200, 255, 0); doc.rect(0, 0, W * 0.55, 2, 'F');

        // Brand
        doc.setFont('helvetica', 'normal'); doc.setFontSize(7);
        doc.setTextColor(120, 140, 80);
        doc.text('MEE · MELATTUR', 12, 14);

        // Event name
        doc.setFont('helvetica', 'bold'); doc.setFontSize(20);
        doc.setTextColor(255, 255, 255);
        const nameLines = doc.splitTextToSize(eventData.name, 90);
        doc.text(nameLines, 12, 25);

        // Divider
        doc.setDrawColor(200, 255, 0); doc.setLineWidth(0.5);
        doc.line(12, 48, W * 0.55 - 10, 48);

        // Info fields
        const fields = [
          { label: 'DATE',        value: eventData.date },
          { label: 'DOORS OPEN',  value: eventData.doorsOpen },
          { label: 'UNTIL',       value: eventData.endTime },
          { label: 'VENUE',       value: eventData.venue },
          { label: 'DRESS CODE',  value: eventData.dressCode },
          { label: 'TICKET TYPE', value: bookingData.type.toUpperCase() },
        ];

        let y = 58;
        fields.forEach((f, i) => {
          const col = i < 3 ? 12 : 60;
          const row = i < 3 ? y + (i * 22) : y + ((i - 3) * 22);
          doc.setFont('helvetica', 'normal'); doc.setFontSize(6);
          doc.setTextColor(120, 140, 80); doc.text(f.label, col, row);
          doc.setFont('helvetica', 'bold'); doc.setFontSize(9);
          doc.setTextColor(230, 230, 230); doc.text(String(f.value), col, row + 5);
        });

        // Price
        doc.setFont('helvetica', 'bold'); doc.setFontSize(18);
        doc.setTextColor(200, 255, 0);
        doc.text('₹' + bookingData.price.toLocaleString('en-IN'), 12, H - 10);

        // Perforated divider
        doc.setDrawColor(50, 50, 50); doc.setLineWidth(0.3);
        for (let dotY = 5; dotY < H - 5; dotY += 4) {
          doc.line(W * 0.55, dotY, W * 0.55, dotY + 2);
        }
        doc.setFillColor(8, 8, 14);
        doc.circle(W * 0.55, 0, 5, 'F');
        doc.circle(W * 0.55, H, 5, 'F');

        // Right side
        const rx = W * 0.55 + 8;

        doc.setFont('helvetica', 'bold'); doc.setFontSize(14);
        doc.setTextColor(255, 255, 255);
        doc.text(ticketData.attendeeName, rx, 18);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(8);
        doc.setTextColor(120, 130, 100);
        doc.text('1 of ' + bookingData.qty + ' · ' + bookingData.type, rx, 25);

        // QR Code
        if (ticketData.qrCode && ticketData.qrCode.startsWith('data:image')) {
          try { doc.addImage(ticketData.qrCode, 'PNG', rx, 32, 55, 55); }
          catch(e) {
            doc.setFillColor(30,30,30); doc.rect(rx, 32, 55, 55, 'F');
            doc.setFont('helvetica','normal'); doc.setFontSize(7);
            doc.setTextColor(100,100,100); doc.text('QR CODE', rx + 16, 60);
          }
        } else {
          doc.setFillColor(30, 30, 30); doc.rect(rx, 32, 55, 55, 'F');
          doc.setFont('helvetica','normal'); doc.setFontSize(7);
          doc.setTextColor(100,100,100); doc.text('QR CODE', rx + 16, 60);
        }

        // Valid badge
        doc.setFillColor(20, 60, 30); doc.roundedRect(rx, 91, 55, 8, 2, 2, 'F');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(7);
        doc.setTextColor(76, 220, 128);
        doc.text('✓ VALID · ONE TIME ENTRY', rx + 4, 96.5);

        // Ticket ID & ref
        doc.setFont('courier', 'bold'); doc.setFontSize(7);
        doc.setTextColor(120, 130, 100);
        doc.text(ticketData.ticketId, rx, 107);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(6);
        doc.setTextColor(80, 90, 70);
        doc.text('REF: ' + bookingData.ref, rx, 113);

        doc.setFont('helvetica', 'normal'); doc.setFontSize(6);
        doc.setTextColor(60, 70, 50);
        doc.text('SCAN AT ENTRY · 18+ · VALID PHOTO ID REQUIRED', rx, H - 6);

        doc.save('Melattur Entertainment Events_' + ticketData.ticketId + '.pdf');
      } catch(e) {
        console.error('PDF error:', e);
        alert('PDF generation failed. Please try again.');
      }

      btnEl.disabled = false;
      btnEl.innerHTML = '<i class="bi bi-file-earmark-pdf-fill"></i> Download PDF';
    }
  </script>

  <script>
    // Replace history so back button skips login/otp pages
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', window.location.href);
    }
  </script>

  <!-- Avatar Crop Modal -->
  <div id="cropModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:1100;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(8px);">
    <div style="background:#14141C;border:1px solid rgba(255,255,255,0.09);border-radius:16px;width:100%;max-width:420px;overflow:hidden;">
      <div style="height:3px;background:linear-gradient(90deg,#6A0DAD,#9D4EDD,#6A0DAD);"></div>
      <div style="padding:1.4rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
          <div style="font-family:var(--font-display);font-size:0.95rem;letter-spacing:2px;color:#fff;">CROP PHOTO</div>
          <button onclick="closeCropModal()" style="background:none;border:none;color:#555;font-size:1.3rem;cursor:pointer;line-height:1;">×</button>
        </div>
        <!-- Canvas crop area -->
        <div style="position:relative;width:100%;aspect-ratio:1;background:#0a0a12;border-radius:10px;overflow:hidden;margin-bottom:1rem;touch-action:none;" id="cropContainer">
          <canvas id="cropCanvas" style="display:block;width:100%;height:100%;"></canvas>
          <!-- Circular overlay mask -->
          <div style="position:absolute;inset:0;pointer-events:none;">
            <svg style="width:100%;height:100%;" viewBox="0 0 300 300">
              <defs>
                <mask id="circleMask">
                  <rect width="300" height="300" fill="white"/>
                  <circle cx="150" cy="150" r="135" fill="black"/>
                </mask>
              </defs>
              <rect width="300" height="300" fill="rgba(0,0,0,0.55)" mask="url(#circleMask)"/>
              <circle cx="150" cy="150" r="135" fill="none" stroke="rgba(106,13,173,0.8)" stroke-width="2"/>
            </svg>
          </div>
        </div>
        <!-- Controls -->
        <div style="margin-bottom:0.8rem;">
          <div style="font-family:var(--font-mono);font-size:0.5rem;letter-spacing:1px;color:#555;text-transform:uppercase;margin-bottom:0.4rem;">Zoom</div>
          <input type="range" id="zoomSlider" min="0.5" max="3" step="0.01" value="1" style="width:100%;accent-color:#6A0DAD;" oninput="updateZoom(this.value)"/>
        </div>
        <div style="font-size:0.7rem;color:#555;text-align:center;margin-bottom:1rem;">Drag to reposition • Pinch or slider to zoom</div>
        <div style="display:flex;gap:0.7rem;">
          <button onclick="closeCropModal()" style="flex:1;padding:0.75rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#ccc;cursor:pointer;font-size:0.85rem;">Cancel</button>
          <button id="cropSaveBtn" onclick="saveCroppedAvatar()" style="flex:2;padding:0.75rem;background:#6A0DAD;border:none;border-radius:8px;color:#fff;font-weight:700;cursor:pointer;font-size:0.85rem;letter-spacing:1px;">
            <i class="bi bi-check-lg"></i> Save Photo
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
  // ── Avatar Crop System ──
  let cropImg = null, cropScale = 1, cropOffX = 0, cropOffY = 0;
  let isDragging = false, lastX = 0, lastY = 0;
  let initPinchDist = 0, initPinchScale = 1;

  function openAvatarCrop(e) {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) { alert('Image too large. Max 5MB.'); return; }

    const reader = new FileReader();
    reader.onload = function(ev) {
      const img = new Image();
      img.onload = function() {
        cropImg = img; cropScale = 1; cropOffX = 0; cropOffY = 0;
        document.getElementById('zoomSlider').value = 1;
        document.getElementById('cropModal').style.display = 'flex';
        setTimeout(drawCrop, 50);
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  }

  function closeCropModal() {
    document.getElementById('cropModal').style.display = 'none';
    cropImg = null;
  }

  function drawCrop() {
    const canvas = document.getElementById('cropCanvas');
    const container = document.getElementById('cropContainer');
    const size = container.offsetWidth;
    canvas.width = size; canvas.height = size;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, size, size);
    ctx.fillStyle = '#0a0a12';
    ctx.fillRect(0, 0, size, size);
    if (!cropImg) return;

    // Fit image to canvas with scale
    const aspect = cropImg.width / cropImg.height;
    let baseW, baseH;
    if (aspect > 1) { baseH = size; baseW = baseH * aspect; }
    else            { baseW = size; baseH = baseW / aspect; }
    const w = baseW * cropScale, h = baseH * cropScale;
    const x = (size - w) / 2 + cropOffX;
    const y = (size - h) / 2 + cropOffY;
    ctx.drawImage(cropImg, x, y, w, h);
  }

  function updateZoom(v) {
    cropScale = parseFloat(v);
    drawCrop();
  }

  // Mouse drag
  const cc = document.getElementById('cropContainer');
  cc.addEventListener('mousedown', e => { isDragging = true; lastX = e.clientX; lastY = e.clientY; e.preventDefault(); });
  window.addEventListener('mousemove', e => {
    if (!isDragging) return;
    cropOffX += e.clientX - lastX; cropOffY += e.clientY - lastY;
    lastX = e.clientX; lastY = e.clientY;
    drawCrop();
  });
  window.addEventListener('mouseup', () => { isDragging = false; });

  // Touch drag + pinch
  cc.addEventListener('touchstart', e => {
    if (e.touches.length === 1) {
      isDragging = true;
      lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
    } else if (e.touches.length === 2) {
      isDragging = false;
      initPinchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      initPinchScale = cropScale;
    }
    e.preventDefault();
  }, { passive: false });
  cc.addEventListener('touchmove', e => {
    if (e.touches.length === 1 && isDragging) {
      cropOffX += e.touches[0].clientX - lastX; cropOffY += e.touches[0].clientY - lastY;
      lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
      drawCrop();
    } else if (e.touches.length === 2) {
      const dist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      cropScale = Math.min(3, Math.max(0.5, initPinchScale * (dist / initPinchDist)));
      document.getElementById('zoomSlider').value = cropScale;
      drawCrop();
    }
    e.preventDefault();
  }, { passive: false });
  cc.addEventListener('touchend', () => { isDragging = false; });

  async function saveCroppedAvatar() {
    const canvas = document.getElementById('cropCanvas');
    const container = document.getElementById('cropContainer');
    const size = container.offsetWidth;

    // Export circular crop as 200x200 PNG
    const outCanvas = document.createElement('canvas');
    outCanvas.width = 200; outCanvas.height = 200;
    const ctx = outCanvas.getContext('2d');
    ctx.beginPath(); ctx.arc(100, 100, 100, 0, Math.PI * 2); ctx.clip();
    ctx.drawImage(canvas, 0, 0, size, size, 0, 0, 200, 200);
    const dataUrl = outCanvas.toDataURL('image/jpeg', 0.88);

    const btn = document.getElementById('cropSaveBtn');
    btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving…';

    try {
      const res = await fetch('/user/avatar', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ avatar: dataUrl }),
      });
      const d = await res.json();
      if (d.success) {
        // Update avatar on page
        let imgEl = document.getElementById('avatarImg');
        const initials = document.getElementById('avatarInitials');
        if (!imgEl) {
          imgEl = document.createElement('img');
          imgEl.id = 'avatarImg';
          imgEl.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;position:absolute;inset:0;';
          imgEl.alt = 'Avatar';
          document.getElementById('avatarCircle').prepend(imgEl);
          if (initials) initials.style.display = 'none';
        }
        imgEl.src = dataUrl;
        closeCropModal();
      } else {
        alert(d.message || 'Failed to save avatar.');
      }
    } catch(e) { alert('Network error.'); }
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> Save Photo';
  }
  </script>
</body>
</html>
