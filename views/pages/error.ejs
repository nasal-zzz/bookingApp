<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;text-align:center;padding:2rem;">
    <div style="font-family:'Anton',sans-serif;font-size:6rem;color:rgba(255,255,255,0.05);line-height:1;"><%= locals.code || 500 %></div>
    <h1 style="font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;color:#fff;margin-top:-2rem;">OOPS!</h1>
    <p style="color:var(--muted);max-width:400px;"><%= locals.message || 'Something went wrong.' %></p>
    <a href="/" style="background:var(--accent);color:#000;padding:0.8rem 2rem;border-radius:4px;text-decoration:none;font-weight:700;margin-top:1rem;">Go Home</a>
  </div>
</body>
</html>
