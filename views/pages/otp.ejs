<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Verify OTP — NightPass</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#08080e;--surface:#0f0f18;--card:#13131e;--border:rgba(255,255,255,0.08);--accent:#c8ff00;--accent-dim:rgba(200,255,0,0.09);--text:#e8e8f0;--muted:#5a5a72;--error:#ff5c5c;--success:#4cdf80;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;display:flex;flex-direction:column;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .orb1{position:fixed;top:-150px;left:-100px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(200,255,0,0.05) 0%,transparent 65%);pointer-events:none;}
    nav{position:relative;z-index:1;padding:1.1rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);}
    .logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:4px;color:#fff;text-decoration:none;}
    .logo span{color:var(--accent);}
    .back-link{display:flex;align-items:center;gap:0.4rem;color:var(--muted);text-decoration:none;font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;}
    .back-link:hover{color:#fff;}
    .auth-wrapper{flex:1;display:flex;align-items:center;justify-content:center;padding:2rem 1rem;position:relative;z-index:1;}
    .auth-card{background:var(--card);border:1px solid var(--border);border-radius:14px;width:100%;max-width:440px;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,0.5);}
    .card-top-bar{height:3px;background:linear-gradient(90deg,transparent,var(--accent),transparent);}
    .card-inner{padding:2.2rem;}

    /* Steps */
    .steps{display:flex;align-items:center;margin-bottom:2rem;}
    .step{display:flex;align-items:center;gap:0.4rem;font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:1px;color:var(--muted);}
    .step-dot{width:22px;height:22px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:0.6rem;flex-shrink:0;font-weight:700;}
    .step.done{color:var(--success);}.step.done .step-dot{border-color:var(--success);color:var(--success);}
    .step.active{color:var(--text);}.step.active .step-dot{background:var(--accent);border-color:var(--accent);color:#000;}
    .step-line{flex:1;height:1px;background:var(--border);margin:0 0.5rem;}
    .step-line.done{background:rgba(76,223,128,0.3);}

    /* Phone badge */
    .phone-badge{display:flex;align-items:center;justify-content:space-between;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1rem 1.2rem;margin-bottom:1.8rem;}
    .phone-badge-left{display:flex;align-items:center;gap:0.8rem;}
    .phone-icon{width:40px;height:40px;background:var(--accent-dim);border:1px solid rgba(200,255,0,0.2);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1rem;}
    .phone-label{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:1px;color:var(--muted);}
    .phone-number{font-size:1rem;font-weight:600;color:#fff;letter-spacing:1px;margin-top:2px;}
    .change-link{font-size:0.8rem;color:var(--accent);text-decoration:none;font-weight:600;border:1px solid rgba(200,255,0,0.25);padding:0.3rem 0.8rem;border-radius:4px;}
    .change-link:hover{background:var(--accent-dim);}

    .eyebrow{font-family:'Space Mono',monospace;font-size:0.62rem;letter-spacing:3px;color:var(--accent);display:block;margin-bottom:0.4rem;}
    h1{font-family:'Anton',sans-serif;font-size:2.4rem;letter-spacing:2px;color:#fff;line-height:1;margin-bottom:0.5rem;}
    .subtitle{font-size:0.88rem;color:var(--muted);line-height:1.6;margin-bottom:1.8rem;}

    /* OTP boxes */
    .otp-row{display:flex;gap:0.6rem;justify-content:center;margin-bottom:1.5rem;}
    .otp-box{width:54px;height:62px;background:var(--surface);border:2px solid var(--border);border-radius:10px;text-align:center;font-family:'Anton',sans-serif;font-size:1.8rem;color:#fff;outline:none;transition:border-color 0.2s,box-shadow 0.2s,transform 0.1s;appearance:none;-moz-appearance:textfield;}
    .otp-box::-webkit-outer-spin-button,.otp-box::-webkit-inner-spin-button{-webkit-appearance:none;}
    .otp-box:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(200,255,0,0.1);transform:scale(1.04);}
    .otp-box.filled{border-color:rgba(200,255,0,0.4);background:rgba(200,255,0,0.05);}
    .otp-box.has-error{border-color:var(--error);box-shadow:0 0 0 3px rgba(255,92,92,0.1);animation:shake 0.4s ease;}
    .otp-box.is-success{border-color:var(--success);box-shadow:0 0 0 3px rgba(76,223,128,0.1);}
    @keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-6px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}

    /* Status messages */
    .status-msg{text-align:center;font-size:0.84rem;padding:0.7rem 1rem;border-radius:6px;margin-bottom:1rem;display:none;align-items:center;justify-content:center;gap:0.5rem;}
    .status-msg.error{display:flex;background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.25);color:var(--error);}
    .status-msg.success-msg{display:flex;background:rgba(76,223,128,0.1);border:1px solid rgba(76,223,128,0.25);color:var(--success);}

    /* Success animation */
    .success-anim{display:none;text-align:center;padding:1rem 0;}
    .success-circle{width:80px;height:80px;border-radius:50%;background:rgba(76,223,128,0.1);border:2px solid var(--success);display:flex;align-items:center;justify-content:center;font-size:2.2rem;margin:0 auto 1rem;animation:popIn 0.4s ease;}
    @keyframes popIn{0%{transform:scale(0.5);opacity:0}70%{transform:scale(1.1)}100%{transform:scale(1);opacity:1}}
    .success-label{color:var(--success);font-weight:700;font-size:1rem;margin-bottom:0.3rem;}
    .success-sub{color:var(--muted);font-size:0.82rem;}

    /* Button */
    .btn-submit{width:100%;padding:1rem;background:var(--accent);color:#000;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;border:none;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.6rem;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 0 25px rgba(200,255,0,0.2);}
    .btn-submit:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 0 45px rgba(200,255,0,0.4);}
    .btn-submit:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
    .spinner{width:18px;height:18px;border:2px solid rgba(0,0,0,0.25);border-top-color:#000;border-radius:50%;animation:spin 0.7s linear infinite;display:none;}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* Resend */
    .resend-area{text-align:center;margin-top:1.2rem;font-size:0.85rem;color:var(--muted);}
    .resend-timer{font-family:'Space Mono',monospace;font-size:0.8rem;color:var(--accent);}
    .resend-btn{background:none;border:none;color:var(--accent);font-weight:700;cursor:pointer;font-size:0.85rem;font-family:'Outfit',sans-serif;text-decoration:underline;display:none;}
    .resend-btn.visible{display:inline;}
    @media(max-width:480px){.card-inner{padding:1.5rem 1.1rem;}h1{font-size:2rem;}.otp-box{width:44px;height:54px;font-size:1.5rem;}.otp-row{gap:0.4rem;}}
  </style>
</head>
<body>
  <div class="orb1"></div>

  <nav>
    <a href="/" class="logo">NIGHT<span>PASS</span></a>
    <a href="/auth/login" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
  </nav>

  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="card-top-bar"></div>
      <div class="card-inner">

        <!-- Steps -->
        <div class="steps">
          <div class="step done">
            <div class="step-dot"><i class="bi bi-check"></i></div>
            <span>Phone</span>
          </div>
          <div class="step-line done"></div>
          <div class="step active">
            <div class="step-dot">2</div>
            <span>Verify OTP</span>
          </div>
          <div class="step-line"></div>
          <div class="step">
            <div class="step-dot">3</div>
            <span>Book</span>
          </div>
        </div>

        <!-- Phone badge -->
        <div class="phone-badge">
          <div class="phone-badge-left">
            <div class="phone-icon"><i class="bi bi-phone-fill"></i></div>
            <div>
              <div class="phone-label">OTP SENT TO</div>
              <div class="phone-number"><%= phone %></div>
            </div>
          </div>
          <a href="/auth/login" class="change-link">Change</a>
        </div>

        <span class="eyebrow">// step 2 of 3</span>
        <h1>VERIFY<br/>NUMBER</h1>
        <p class="subtitle">Enter the 6-digit OTP sent to your phone</p>

        <!-- OTP Inputs -->
        <div class="otp-row" id="otpRow">
          <input class="otp-box" type="tel" maxlength="1" inputmode="numeric" id="otp0" autocomplete="one-time-code"/>
          <input class="otp-box" type="tel" maxlength="1" inputmode="numeric" id="otp1"/>
          <input class="otp-box" type="tel" maxlength="1" inputmode="numeric" id="otp2"/>
          <input class="otp-box" type="tel" maxlength="1" inputmode="numeric" id="otp3"/>
          <input class="otp-box" type="tel" maxlength="1" inputmode="numeric" id="otp4"/>
          <input class="otp-box" type="tel" maxlength="1" inputmode="numeric" id="otp5"/>
        </div>

        <div class="status-msg" id="statusMsg">
          <i class="bi bi-exclamation-circle-fill"></i>
          <span id="statusText"></span>
        </div>

        <div class="success-anim" id="successAnim">
          <div class="success-circle">✓</div>
          <div class="success-label">Phone Verified!</div>
          <div class="success-sub">Redirecting you now...</div>
        </div>

        <button class="btn-submit" id="verifyBtn" onclick="doVerify()">
          <i class="bi bi-shield-check-fill" id="btnIcon"></i>
          <span id="btnText">Verify &amp; Continue</span>
          <div class="spinner" id="spinner"></div>
        </button>

        <div class="resend-area">
          Didn't receive it?
          <span class="resend-timer" id="timerDisplay">Resend in <strong id="timerCount">30</strong>s</span>
          <button class="resend-btn" id="resendBtn" onclick="doResend()">Resend OTP</button>
        </div>

      </div>
    </div>
  </div>

  <script>
    const boxes = Array.from({ length: 6 }, (_, i) => document.getElementById('otp' + i));

    // Auto-focus first box
    setTimeout(() => boxes[0].focus(), 300);

    // Input handling
    boxes.forEach((box, i) => {
      box.addEventListener('keydown', function(e) {
        if (e.key === 'Backspace') {
          if (this.value) {
            this.value = '';
            this.classList.remove('filled');
          } else if (i > 0) {
            boxes[i - 1].value = '';
            boxes[i - 1].classList.remove('filled');
            boxes[i - 1].focus();
          }
          e.preventDefault();
        }
      });

      box.addEventListener('input', function() {
        // Keep only digit
        const val = this.value.replace(/\D/g, '').slice(-1);
        this.value = val;

        if (val) {
          this.classList.add('filled');
          this.classList.remove('has-error');
          // Move to next
          if (i < 5) boxes[i + 1].focus();
          // Auto-submit when all filled
          if (boxes.every(b => b.value)) doVerify();
        } else {
          this.classList.remove('filled');
        }
      });

      // Handle paste
      box.addEventListener('paste', function(e) {
        e.preventDefault();
        const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
        pasted.split('').forEach((char, idx) => {
          if (boxes[idx]) {
            boxes[idx].value = char;
            boxes[idx].classList.add('filled');
          }
        });
        const nextEmpty = pasted.length < 6 ? pasted.length : 5;
        boxes[nextEmpty].focus();
        if (pasted.length === 6) doVerify();
      });
    });

    function setLoading(on) {
      document.getElementById('verifyBtn').disabled = on;
      document.getElementById('btnIcon').style.display = on ? 'none' : 'inline';
      document.getElementById('btnText').textContent = on ? 'Verifying...' : 'Verify & Continue';
      document.getElementById('spinner').style.display = on ? 'block' : 'none';
      boxes.forEach(b => b.disabled = on);
    }

    function showStatus(type, msg) {
      const el = document.getElementById('statusMsg');
      el.className = 'status-msg ' + type;
      document.getElementById('statusText').textContent = msg;
    }

    function clearStatus() {
      document.getElementById('statusMsg').className = 'status-msg';
    }

    async function doVerify() {
      const otp = boxes.map(b => b.value).join('');
      if (otp.length < 6) {
        showStatus('error', 'Please enter all 6 digits.');
        return;
      }

      clearStatus();
      setLoading(true);

      try {
        const res = await fetch('/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ otp }),
        });
        const data = await res.json();

        if (data.success) {
          // Show success animation
          boxes.forEach(b => { b.classList.remove('filled'); b.classList.add('is-success'); });
          document.getElementById('verifyBtn').style.display = 'none';
          document.querySelector('.resend-area').style.display = 'none';
          document.getElementById('successAnim').style.display = 'block';
          setTimeout(() => window.location.href = data.redirect || '/booking', 1500);
        } else {
          // Shake and show error
          boxes.forEach(b => { b.classList.add('has-error'); b.classList.remove('filled'); });
          setTimeout(() => {
            boxes.forEach(b => b.classList.remove('has-error'));
            boxes[0].focus();
            boxes.forEach(b => { b.value = ''; b.disabled = false; });
          }, 600);
          showStatus('error', data.message || 'Incorrect OTP. Please try again.');
          setLoading(false);
          if (data.redirect) setTimeout(() => window.location.href = data.redirect, 2000);
        }
      } catch(e) {
        showStatus('error', 'Network error. Please try again.');
        setLoading(false);
      }
    }

    // Countdown timer
    let timeLeft = 30;
    const timerCount = document.getElementById('timerCount');
    const timerDisplay = document.getElementById('timerDisplay');
    const resendBtn = document.getElementById('resendBtn');

    const countdown = setInterval(() => {
      timeLeft--;
      timerCount.textContent = timeLeft;
      if (timeLeft <= 0) {
        clearInterval(countdown);
        timerDisplay.style.display = 'none';
        resendBtn.classList.add('visible');
      }
    }, 1000);

    async function doResend() {
      resendBtn.textContent = 'Sending...';
      resendBtn.disabled = true;
      try {
        const res = await fetch('/auth/resend-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (data.success) {
          showStatus('success-msg', 'New OTP sent successfully!');
          boxes.forEach(b => { b.value = ''; b.classList.remove('filled', 'has-error', 'is-success'); b.disabled = false; });
          boxes[0].focus();
          // Restart timer
          timeLeft = 30;
          timerCount.textContent = 30;
          timerDisplay.style.display = 'inline';
          resendBtn.classList.remove('visible');
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend OTP';
        } else {
          showStatus('error', data.message || 'Failed to resend. Try again.');
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend OTP';
        }
      } catch(e) {
        showStatus('error', 'Network error.');
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend OTP';
      }
    }
  </script>
</body>
</html>
