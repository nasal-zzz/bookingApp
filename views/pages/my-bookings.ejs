<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <div class="orb-tl"></div>
  <%- include('../partials/navbar') %>

  <div style="max-width:900px;margin:0 auto;padding:2.5rem 1.5rem 5rem;position:relative;z-index:1;">
    <p style="font-family:var(--font-mono);font-size:0.62rem;letter-spacing:3px;color:var(--accent);margin-bottom:0.5rem;">// your passes</p>
    <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);letter-spacing:2px;color:#fff;line-height:1;margin-bottom:2rem;">MY <span style="color:var(--muted);">TICKETS</span></h1>

    <% if(bookings.length===0){ %>
      <div style="text-align:center;padding:5rem 1rem;">
        <div style="font-size:3rem;margin-bottom:1rem;">🎟</div>
        <h2 style="font-family:var(--font-display);letter-spacing:2px;color:#fff;margin-bottom:0.5rem;">NO BOOKINGS YET</h2>
        <p style="color:var(--muted);margin-bottom:2rem;">You haven't booked any tickets yet.</p>
        <a href="/" style="background:var(--accent);color:#fff;padding:0.9rem 2rem;border-radius:6px;text-decoration:none;font-weight:700;letter-spacing:1px;">Book Now</a>
      </div>
    <% } else { %>
    <div style="display:flex;flex-direction:column;gap:1rem;">
      <% bookings.forEach(function(booking){ 
           const isPaid  = booking.paymentStatus === 'paid';
           const isPend  = booking.paymentStatus === 'pending';
           const isFail  = booking.paymentStatus === 'failed';
           const statusColor = isPaid?'#00FF88':(isPend?'#f5c842':'#FF4444');
           const statusBg    = isPaid?'rgba(0,255,136,0.08)':(isPend?'rgba(245,200,66,0.08)':'rgba(255,68,68,0.08)');
           const statusBorder= isPaid?'rgba(0,255,136,0.3)':(isPend?'rgba(245,200,66,0.3)':'rgba(255,68,68,0.3)');
           const statusIcon  = isPaid?'check-circle-fill':(isPend?'clock-fill':'x-circle-fill');
           const statusLbl   = booking.paymentStatus.toUpperCase();
           // Check if event still has tickets (for pay now)
           const evtActive   = booking.event && booking.event.isActive;
           const evtHasSeats = booking.event && booking.event.ticketTypes && booking.event.ticketTypes.some(t=>t.bookedSeats<t.totalSeats);
           const canRetryPay = isPend && evtActive && evtHasSeats;  // Only pending gets Pay Now (not failed)
      %>
      <div data-booking="<%= booking._id %>" style="background:var(--card);border:1px solid rgba(255,255,255,0.07);border-radius:12px;overflow:hidden;">
        <!-- Status accent bar -->
        <div style="height:3px;background:linear-gradient(90deg,transparent,<%= statusColor %>,transparent);"></div>

        <div style="padding:1.4rem;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
            <!-- Event info -->
            <div style="display:flex;align-items:flex-start;gap:1rem;flex:1;min-width:200px;">
              <div style="width:52px;height:52px;border-radius:8px;background:linear-gradient(135deg,#1a1f00,#3d4a00);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;">🎶</div>
              <div>
                <div style="font-family:var(--font-display);font-size:1.1rem;letter-spacing:2px;color:#fff;margin-bottom:0.35rem;"><%= booking.event?booking.event.name.toUpperCase():'EVENT' %></div>
                <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.35rem;">
                  <% if(booking.event){ %><span style="font-size:0.72rem;color:var(--muted);"><i class="bi bi-calendar3"></i> <%= new Date(booking.event.date).toDateString() %></span><% } %>
                  <span style="font-size:0.72rem;color:var(--muted);"><i class="bi bi-ticket-perforated"></i> <%= booking.quantity %> × <%= booking.ticketType %></span>
                  <span style="font-family:var(--font-mono);font-size:0.68rem;color:var(--muted);">REF: <%= booking.bookingRef %></span>
                </div>
                <!-- Payment status badge -->
                <div style="display:inline-flex;align-items:center;gap:0.3rem;font-family:var(--font-mono);font-size:0.58rem;letter-spacing:1px;padding:0.2rem 0.65rem;border-radius:10px;background:<%= statusBg %>;border:1px solid <%= statusBorder %>;color:<%= statusColor %>;">
                  <i class="bi bi-<%= statusIcon %>"></i> <%= statusLbl %>
                </div>
              </div>
            </div>
            <!-- Amount + actions -->
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.7rem;flex-shrink:0;">
              <div style="font-family:var(--font-display);font-size:1.4rem;color:var(--accent);letter-spacing:1px;">₹<%= booking.totalAmount.toLocaleString('en-IN') %></div>
              <div style="display:flex;gap:0.6rem;flex-wrap:wrap;justify-content:flex-end;">
                <% if(isPaid){ %>
                  <!-- View or Download toggle -->
                  <a href="/booking/success/<%= booking._id %>" style="display:flex;align-items:center;gap:0.4rem;background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);color:#00FF88;padding:0.55rem 1rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:0.78rem;white-space:nowrap;">
                    <i class="bi bi-eye-fill"></i> View Ticket
                  </a>
                  <button onclick="dlTicket('<%= booking._id %>')" style="display:flex;align-items:center;gap:0.4rem;background:var(--accent);border:none;color:#fff;padding:0.55rem 1rem;border-radius:6px;font-weight:700;font-size:0.78rem;white-space:nowrap;cursor:pointer;">
                    <i class="bi bi-download"></i> Download PDF
                  </button>
                <% } else if(canRetryPay){ %>
                  <a href="/booking/retry-payment/<%= booking._id %>" style="display:flex;align-items:center;gap:0.4rem;background:var(--accent);color:#fff;padding:0.55rem 1.1rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:0.78rem;white-space:nowrap;box-shadow:0 0 18px rgba(106,13,173,0.22);">
                    <i class="bi bi-credit-card-fill"></i> Pay Now
                  </a>
                <% } else if(isPend||isFail){ %>
                  <span style="font-size:0.72rem;color:#555;font-family:var(--font-mono);">Tickets unavailable</span>
                <% } %>
                <% if(isFail||isPend){ %>
                  <button onclick="deleteBooking('<%= booking._id %>')" style="display:flex;align-items:center;gap:0.4rem;background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.25);color:#FF4444;padding:0.55rem 0.9rem;border-radius:6px;font-weight:700;font-size:0.78rem;white-space:nowrap;cursor:pointer;" title="Delete this failed booking">
                    <i class="bi bi-trash3-fill"></i> Delete
                  </button>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Ticket attendees strip -->
          <% if(booking.tickets&&booking.tickets.length){ %>
          <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.06);display:flex;gap:0.45rem;flex-wrap:wrap;">
            <% booking.tickets.forEach(function(t,ti){ %>
            <div style="display:flex;align-items:center;gap:0.35rem;background:var(--surface);border:1px solid rgba(255,255,255,0.07);border-radius:4px;padding:0.28rem 0.65rem;font-family:var(--font-mono);font-size:0.6rem;color:var(--muted);letter-spacing:1px;">
              <i class="bi bi-person-fill" style="color:var(--accent);"></i>
              <%= t.attendee.name %> · <%= t.ticketId %>
              <% if(t.isUsed){ %><span style="color:#FF4444;margin-left:0.25rem;">USED</span><% } %>
            </div>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>

  <%- include('../partials/scripts') %>
  <script>
  function dlTicket(bookingId){
    window.location.href='/booking/success/'+bookingId+'?autodownload=1';
  }

  async function deleteBooking(bookingId){
    if(!confirm('Delete this booking record? This cannot be undone.')) return;
    try{
      const res=await fetch('/user/delete-booking/'+bookingId,{method:'DELETE',headers:{'Content-Type':'application/json'},credentials:'include'});
      const d=await res.json();
      if(d.success){
        const card=document.querySelector(`[data-booking="${bookingId}"]`);
        if(card){card.style.opacity='0';card.style.transition='opacity 0.3s';setTimeout(()=>card.remove(),300);}
        else window.location.reload();
      } else alert(d.message||'Could not delete booking.');
    }catch(e){alert('Network error.');}
  }

  if(window.history&&window.history.replaceState)window.history.replaceState(null,'',window.location.href);
  </script>
</body>
</html>
