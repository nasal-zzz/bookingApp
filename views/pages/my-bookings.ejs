<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <div class="orb-tl"></div>
  <%- include('../partials/navbar') %>

  <div style="max-width:900px;margin:0 auto;padding:2.5rem 1.5rem 4rem;position:relative;z-index:1;">
    <p style="font-family:var(--font-mono);font-size:0.65rem;letter-spacing:3px;color:var(--accent);margin-bottom:0.5rem;">// your passes</p>
    <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);letter-spacing:2px;color:#fff;line-height:1;margin-bottom:2rem;">MY <span style="color:var(--muted);">BOOKINGS</span></h1>

    <% if (bookings.length === 0) { %>
      <div style="text-align:center;padding:5rem 1rem;">
        <div style="font-size:3rem;margin-bottom:1rem;">🎟</div>
        <h2 style="font-family:var(--font-display);letter-spacing:2px;color:#fff;margin-bottom:0.5rem;">NO BOOKINGS YET</h2>
        <p style="color:var(--muted);margin-bottom:2rem;">You haven't booked any tickets yet.</p>
        <a href="/booking" style="background:var(--accent);color:#000;padding:0.9rem 2rem;border-radius:4px;text-decoration:none;font-weight:700;letter-spacing:1px;">Book Tickets Now</a>
      </div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <% bookings.forEach(function(booking) { %>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;">
          <div style="height:3px;background:linear-gradient(90deg,transparent,<%= booking.paymentStatus === 'paid' ? 'var(--accent)' : 'var(--error)' %>,transparent);"></div>
          <div style="padding:1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <div style="display:flex;align-items:center;gap:1rem;">
              <div style="width:54px;height:54px;border-radius:8px;background:linear-gradient(135deg,#1a1f00,#3d4a00);display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;">🎶</div>
              <div>
                <div style="font-family:var(--font-display);font-size:1.2rem;letter-spacing:2px;color:#fff;margin-bottom:0.3rem;"><%= booking.event ? booking.event.name.toUpperCase() : 'EVENT' %></div>
                <div style="display:flex;flex-wrap:wrap;gap:0.8rem;">
                  <span style="font-size:0.75rem;color:var(--muted);"><i class="bi bi-calendar3"></i> <%= booking.event ? new Date(booking.event.date).toDateString() : '' %></span>
                  <span style="font-size:0.75rem;color:var(--muted);"><i class="bi bi-ticket-perforated"></i> <%= booking.quantity %> × <%= booking.ticketType %></span>
                  <span style="font-family:var(--font-mono);font-size:0.72rem;color:var(--muted);">REF: <%= booking.bookingRef %></span>
                </div>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
              <div style="text-align:right;">
                <div style="font-family:var(--font-display);font-size:1.5rem;color:var(--accent);letter-spacing:1px;">₹<%= booking.totalAmount.toLocaleString('en-IN') %></div>
                <div style="display:inline-flex;align-items:center;gap:0.3rem;font-family:var(--font-mono);font-size:0.6rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;
                  background:<%= booking.paymentStatus==='paid' ? 'rgba(76,223,128,0.1)' : 'rgba(255,92,92,0.1)' %>;
                  border:1px solid <%= booking.paymentStatus==='paid' ? 'rgba(76,223,128,0.4)' : 'rgba(255,92,92,0.4)' %>;
                  color:<%= booking.paymentStatus==='paid' ? 'var(--success)' : 'var(--error)' %>;">
                  <i class="bi bi-<%= booking.paymentStatus==='paid' ? 'check-circle-fill' : 'x-circle-fill' %>"></i>
                  <%= booking.paymentStatus.toUpperCase() %>
                </div>
              </div>
              <% if (booking.paymentStatus === 'paid') { %>
              <a href="/booking/ticket/<%= booking._id %>" style="display:flex;align-items:center;gap:0.5rem;background:var(--accent);color:#000;padding:0.7rem 1.2rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:0.85rem;white-space:nowrap;">
                <i class="bi bi-qr-code"></i> View Ticket
              </a>
              <% } %>
            </div>
          </div>

          <!-- Tickets strip -->
          <div style="padding:0 1.5rem 1.2rem;display:flex;gap:0.5rem;flex-wrap:wrap;">
            <% booking.tickets.forEach(function(t, ti) { %>
            <div style="display:flex;align-items:center;gap:0.4rem;background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:0.3rem 0.7rem;font-family:var(--font-mono);font-size:0.62rem;color:var(--muted);letter-spacing:1px;">
              <i class="bi bi-person-fill" style="color:var(--accent);"></i>
              <%= t.attendee.name %> · <%= t.ticketId %>
              <% if (t.isUsed) { %><span style="color:var(--error);">USED</span><% } %>
            </div>
            <% }); %>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <%- include('../partials/scripts') %>

  <script>
    // Replace history so back button skips login/otp pages
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', window.location.href);
    }
  </script>
</body>
</html>
