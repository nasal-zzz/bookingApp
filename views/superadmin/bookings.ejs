<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#9D4EDD;--accent2:#6A0DAD;--text:#fff;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;--warn:#f5c842;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .main{padding:2rem;position:relative;z-index:1;overflow-x:hidden;}
    .page-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:0.4rem;flex-wrap:wrap;gap:1rem;}
    .page-title{font-family:'Poppins',sans-serif;font-size:2rem;letter-spacing:2px;}
    .page-sub{font-size:0.78rem;color:var(--muted);margin-bottom:1.5rem;}
    .stats-row{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;margin-bottom:1.8rem;}
    .stat-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.1rem 1.2rem;position:relative;overflow:hidden;}
    .stat-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(157,78,221,0.04),transparent);pointer-events:none;}
    .stat-val{font-family:'Poppins',sans-serif;font-size:1.8rem;color:var(--accent);}
    .stat-lbl{font-size:0.7rem;color:var(--muted);margin-top:0.15rem;}
    .stat-icon{position:absolute;right:0.9rem;top:50%;transform:translateY(-50%);font-size:1.8rem;opacity:0.06;}
    .toolbar{background:var(--surface);border:1px solid var(--border);border-radius:10px 10px 0 0;border-bottom:none;}
    .tabs{display:flex;border-bottom:1px solid var(--border);overflow-x:auto;}
    .tab-btn{display:flex;align-items:center;gap:0.4rem;padding:0.9rem 1.2rem;font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);background:none;border:none;cursor:pointer;transition:all 0.15s;border-bottom:2px solid transparent;white-space:nowrap;}
    .tab-btn:hover{color:#fff;}
    .tab-btn.active{color:#fff;border-bottom-color:var(--accent);}
    .tc{background:rgba(157,78,221,0.2);border:1px solid rgba(157,78,221,0.3);border-radius:10px;padding:0.1rem 0.45rem;font-size:0.58rem;margin-left:0.2rem;}
    .tab-btn.active .tc{background:rgba(157,78,221,0.4);}
    .filters-row{display:flex;align-items:center;gap:0.8rem;padding:0.8rem 1.2rem;flex-wrap:wrap;border-bottom:1px solid var(--border);}
    .sw{position:relative;flex:1;min-width:200px;}
    .sw i{position:absolute;left:0.75rem;top:50%;transform:translateY(-50%);color:var(--muted);font-size:0.9rem;}
    .si{width:100%;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:6px;color:#fff;padding:0.55rem 0.9rem 0.55rem 2.2rem;font-family:'Outfit',sans-serif;font-size:0.85rem;outline:none;transition:border 0.15s;}
    .si:focus{border-color:var(--accent);}
    .fs{background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:6px;color:#fff;padding:0.55rem 0.8rem;font-family:'Outfit',sans-serif;font-size:0.82rem;outline:none;cursor:pointer;}
    .fs:focus{border-color:var(--accent);}
    .fs option{background:#1a1a2e;}
    .fc{font-family:'Space Mono',monospace;font-size:0.63rem;color:var(--muted);white-space:nowrap;}
    .table-wrap{background:var(--surface);border:1px solid var(--border);border-top:none;border-radius:0 0 10px 10px;overflow:hidden;}
    .tscroll{overflow-x:auto;}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.54rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.8rem 1rem;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap;}
    td{padding:0.9rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.83rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.015);}
    .b{display:inline-flex;align-items:center;gap:0.25rem;font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;padding:0.18rem 0.52rem;border-radius:20px;white-space:nowrap;}
    .b-paid{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);color:var(--success);}
    .b-pend{background:rgba(245,200,66,0.08);border:1px solid rgba(245,200,66,0.3);color:var(--warn);}
    .b-fail{background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.25);color:var(--error);}
    .ref-pill{font-family:'Space Mono',monospace;font-size:0.73rem;letter-spacing:1px;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.2);border-radius:4px;padding:0.2rem 0.55rem;color:#d8b4fe;cursor:pointer;}
    .ref-pill:hover{background:rgba(157,78,221,0.22);}
    .nr{padding:3rem;text-align:center;color:var(--muted);}
    .nr i{font-size:2.2rem;display:block;margin-bottom:0.8rem;opacity:0.4;}
    #toast{display:none;position:fixed;bottom:1.5rem;right:1.5rem;background:var(--surface);border:1px solid rgba(0,255,136,0.3);border-radius:8px;padding:0.75rem 1.2rem;font-size:0.83rem;color:var(--success);z-index:9999;box-shadow:0 8px 30px rgba(0,0,0,0.5);}
    @media(max-width:960px){.layout{grid-template-columns:1fr;}.stats-row{grid-template-columns:repeat(2,1fr);}}
  </style>
</head>
<body>
<div class="layout">
  <%- include('../partials/superadmin-sidebar', { activePage: 'bookings' }) %>
  <main class="main">
    <div class="page-hd">
      <div class="page-title">BOOKINGS</div>
    </div>
    <p class="page-sub">All bookings across all events — paid, pending, and failed.</p>

    <%
      const totAll  = bookings.length;
      const totPaid = bookings.filter(function(b){return b.paymentStatus==='paid';}).length;
      const totPend = bookings.filter(function(b){return b.paymentStatus==='pending';}).length;
      const totFail = bookings.filter(function(b){return b.paymentStatus==='failed';}).length;
      const totRev  = bookings.filter(function(b){return b.paymentStatus==='paid';}).reduce(function(s,b){return s+(b.totalAmount||0);},0);
    %>

    <div class="stats-row">
      <div class="stat-card"><div class="stat-val"><%= totAll %></div><div class="stat-lbl">Total Bookings</div><i class="bi bi-ticket-perforated stat-icon"></i></div>
      <div class="stat-card"><div class="stat-val" style="color:var(--success);"><%= totPaid %></div><div class="stat-lbl">Paid</div><i class="bi bi-check-circle stat-icon"></i></div>
      <div class="stat-card"><div class="stat-val" style="color:var(--warn);"><%= totPend %></div><div class="stat-lbl">Pending</div><i class="bi bi-clock stat-icon"></i></div>
      <div class="stat-card"><div class="stat-val" style="color:var(--error);"><%= totFail %></div><div class="stat-lbl">Failed</div><i class="bi bi-x-circle stat-icon"></i></div>
      <div class="stat-card"><div class="stat-val">₹<%= totRev.toLocaleString('en-IN') %></div><div class="stat-lbl">Total Revenue</div><i class="bi bi-cash-stack stat-icon"></i></div>
    </div>

    <div class="toolbar">
      <div class="tabs">
        <button class="tab-btn active" data-tab="all"     onclick="swT('all',this)">    <i class="bi bi-grid-fill"></i>     All    <span class="tc" id="tc-all"><%= totAll %></span></button>
        <button class="tab-btn"        data-tab="paid"    onclick="swT('paid',this)">   <i class="bi bi-check-circle-fill"></i> Paid   <span class="tc" id="tc-paid"><%= totPaid %></span></button>
        <button class="tab-btn"        data-tab="pending" onclick="swT('pending',this)"><i class="bi bi-clock-fill"></i>    Pending <span class="tc" id="tc-pend"><%= totPend %></span></button>
        <button class="tab-btn"        data-tab="failed"  onclick="swT('failed',this)"> <i class="bi bi-x-circle-fill"></i> Failed  <span class="tc" id="tc-fail"><%= totFail %></span></button>
      </div>
      <div class="filters-row">
        <div class="sw"><i class="bi bi-search"></i><input class="si" id="srch" placeholder="Search ref, name, phone, event…" oninput="applyF()"/></div>
        <select class="fs" id="fEvent" onchange="applyF()">
          <option value="">All Events</option>
          <% events.forEach(function(ev){ %>
          <option value="<%= ev._id %>"><%= ev.name %></option>
          <% }); %>
        </select>
        <select class="fs" id="fSort" onchange="applyF()">
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
          <option value="amount-high">Highest Amount</option>
          <option value="amount-low">Lowest Amount</option>
        </select>
        <span class="fc" id="fcnt"></span>
      </div>
    </div>

    <div class="table-wrap">
      <div class="tscroll">
      <table id="bkTbl">
        <thead><tr>
          <th>Booking Ref</th>
          <th>Customer</th>
          <th>Event</th>
          <th>Ticket</th>
          <th style="text-align:center;">Qty</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Date</th>
        </tr></thead>
        <tbody id="bkBody">
        <% bookings.forEach(function(b){ %>
        <tr class="brow"
            data-status="<%= b.paymentStatus %>"
            data-event="<%= b.event?b.event._id:'' %>"
            data-q="<%= [b.bookingRef,(b.user?b.user.firstName+' '+(b.user.lastName||''):''), (b.user?b.user.phone:''), (b.event?b.event.name:'')].join(' ').toLowerCase() %>"
            data-amount="<%= b.totalAmount||0 %>"
            data-created="<%= new Date(b.createdAt).getTime() %>">
          <td>
            <span class="ref-pill" onclick="cpCopy('<%= b.bookingRef %>')" title="Click to copy"><%= b.bookingRef %></span>
          </td>
          <td>
            <div style="font-weight:600;"><%= b.user?(b.user.firstName+' '+(b.user.lastName||'')):'—' %></div>
            <div style="color:var(--muted);font-size:0.72rem;"><%= b.user?b.user.phone:'' %></div>
          </td>
          <td>
            <div style="color:#d8b4fe;"><%= b.event?b.event.name:'—' %></div>
            <div style="color:var(--muted);font-size:0.7rem;"><%= b.event?new Date(b.event.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}):'' %></div>
          </td>
          <td style="text-transform:capitalize;"><%= b.ticketType||'—' %></td>
          <td style="text-align:center;font-family:'Space Mono',monospace;"><%= b.quantity||1 %></td>
          <td style="font-family:'Space Mono',monospace;font-weight:700;">₹<%= (b.totalAmount||0).toLocaleString('en-IN') %>
            <% if(b.couponCode){ %><div style="font-size:0.65rem;color:var(--success);">Coupon: <%= b.couponCode %></div><% } %>
          </td>
          <td>
            <% if(b.paymentStatus==='paid'){ %><span class="b b-paid"><i class="bi bi-check-circle-fill" style="font-size:0.6rem;"></i> paid</span>
            <% }else if(b.paymentStatus==='pending'){ %><span class="b b-pend"><i class="bi bi-clock-fill" style="font-size:0.6rem;"></i> pending</span>
            <% }else{ %><span class="b b-fail"><i class="bi bi-x-circle-fill" style="font-size:0.6rem;"></i> failed</span><% } %>
          </td>
          <td style="color:var(--muted);font-size:0.75rem;white-space:nowrap;"><%= new Date(b.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %><br><span style="font-size:0.68rem;"><%= new Date(b.createdAt).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span></td>
        </tr>
        <% }); %>
        </tbody>
      </table>
      </div>
      <div class="nr" id="noRows" style="display:none;"><i class="bi bi-search"></i>No bookings match your filters.</div>
      <% if(bookings.length===0){ %><div class="nr"><i class="bi bi-ticket-perforated"></i>No bookings yet.</div><% } %>
    </div>

  </main>
</div>
<div id="toast"></div>
<script>
var curTab = 'all';
function swT(tab, btn) {
  curTab = tab;
  document.querySelectorAll('.tab-btn').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  applyF();
}
function applyF() {
  var q  = document.getElementById('srch').value.toLowerCase().trim();
  var ev = document.getElementById('fEvent').value;
  var so = document.getElementById('fSort').value;
  var rows = Array.from(document.querySelectorAll('.brow'));
  rows.forEach(function(r) {
    var st = r.dataset.status;
    var tok = curTab==='all'||(curTab===st);
    var sqk = !q || r.dataset.q.includes(q);
    var evk = !ev || r.dataset.event===ev;
    r._sh = tok && sqk && evk;
  });
  rows.sort(function(a,b){
    if(so==='newest')      return Number(b.dataset.created)-Number(a.dataset.created);
    if(so==='oldest')      return Number(a.dataset.created)-Number(b.dataset.created);
    if(so==='amount-high') return Number(b.dataset.amount)-Number(a.dataset.amount);
    if(so==='amount-low')  return Number(a.dataset.amount)-Number(b.dataset.amount);
    return 0;
  });
  var tbody = document.getElementById('bkBody');
  rows.forEach(function(r){ tbody.appendChild(r); });
  var vis=0, np=0, npd=0, nf=0;
  rows.forEach(function(r){
    r.style.display = r._sh?'':'none';
    if(r._sh){ vis++; var st=r.dataset.status; if(st==='paid')np++; if(st==='pending')npd++; if(st==='failed')nf++; }
  });
  document.getElementById('noRows').style.display = vis===0&&rows.length>0?'block':'none';
  document.getElementById('fcnt').textContent = vis<rows.length?('Showing '+vis+' of '+rows.length):'';
  document.getElementById('tc-all').textContent  = rows.length;
  document.getElementById('tc-paid').textContent = np;
  document.getElementById('tc-pend').textContent = npd;
  document.getElementById('tc-fail').textContent = nf;
}
function cpCopy(t){ navigator.clipboard.writeText(t).then(function(){ var el=document.getElementById('toast'); el.textContent='✓ Copied: '+t; el.style.display='block'; setTimeout(function(){ el.style.display='none'; },2000); }); }
applyF();
</script>
</body>
</html>
