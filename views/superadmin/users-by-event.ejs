<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#9D4EDD;--text:#fff;--muted:#B3B3B3;--error:#FF4444;--success:#00FF88;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    .layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;overflow-y:auto;}
    .s-logo{font-family:'Anton',sans-serif;font-size:1.3rem;letter-spacing:3px;color:#fff;text-decoration:none;display:block;padding:0 0.5rem 0.5rem;border-bottom:1px solid var(--border);margin-bottom:0.4rem;}
    .s-logo span{color:var(--accent);}
    .s-badge{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:2px;color:var(--accent);background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);border-radius:10px;padding:0.15rem 0.6rem;margin-bottom:0.8rem;display:inline-block;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(157,78,221,0.08);border-color:rgba(157,78,221,0.2);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,68,68,0.08);}
    .main{padding:2rem;overflow-x:hidden;}
    .page-title{font-family:'Anton',sans-serif;font-size:1.8rem;letter-spacing:2px;margin-bottom:0.3rem;}
    .page-sub{font-size:0.78rem;color:var(--muted);margin-bottom:2rem;}
    .select-bar{display:flex;gap:1rem;align-items:flex-end;margin-bottom:2rem;flex-wrap:wrap;}
    .f-grp{display:flex;flex-direction:column;gap:0.3rem;flex:1;min-width:240px;}
    .f-lbl{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:1px;color:#555;text-transform:uppercase;}
    .f-sel{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.88rem;padding:0.62rem 0.85rem;outline:none;width:100%;}
    .f-sel:focus{border-color:rgba(157,78,221,0.45);}
    .f-sel option{background:#1a1a2e;}
    .filter-btn{padding:0.7rem 1.5rem;background:var(--accent);color:#fff;border:none;border-radius:7px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.85rem;cursor:pointer;white-space:nowrap;}
    .event-header{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.2rem;margin-bottom:1.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.8rem;}
    .ev-name{font-family:'Anton',sans-serif;font-size:1.2rem;letter-spacing:2px;}
    .ev-count{font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:2px;color:var(--accent);}
    .users-table{width:100%;border-collapse:collapse;}
    .users-table th{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:#555;text-transform:uppercase;padding:0.6rem 0.8rem;border-bottom:1px solid var(--border);text-align:left;}
    .users-table td{padding:0.85rem 0.8rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.85rem;vertical-align:middle;}
    .users-table tr:hover td{background:rgba(255,255,255,0.02);}
    .ticket-chip{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:1px;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);color:var(--accent);padding:0.15rem 0.5rem;border-radius:4px;}
    .empty{text-align:center;padding:3rem;color:#555;}
    @media(max-width:900px){.layout{grid-template-columns:1fr;}.sidebar{display:none;}}
  </style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <a href="/superadmin" class="s-logo"><img src="/img/mee-logo.png" alt="MEE" style="height:28px;width:auto;object-fit:contain;"/></a>
    <span class="s-badge">⬡ SUPER ADMIN</span>
    <a href="/superadmin"                class="s-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <a href="/superadmin/staff"          class="s-link"><i class="bi bi-people-fill"></i> Staff & Admins</a>
    <a href="/superadmin/coupons"        class="s-link"><i class="bi bi-tag-fill"></i> Coupons</a>
    <a href="/superadmin/users-by-event" class="s-link active"><i class="bi bi-person-lines-fill"></i> Users by Event</a>
    <a href="/superadmin/entered-tickets"  class="s-link"><i class="bi bi-door-open-fill"></i> Entered Tickets</a>
    <a href="/admin"                     class="s-link"><i class="bi bi-grid-fill"></i> Admin Panel</a>
        <div style="margin-top:auto;border-top:1px solid rgba(255,255,255,0.06);padding-top:0.7rem;">
      <% if(locals.currentAdmin){ %>
      <div style="display:flex;align-items:center;gap:0.6rem;padding:0.6rem 0.8rem;margin-bottom:0.3rem;">
        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3a0870,#6A0DAD);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.9rem;color:#fff;flex-shrink:0;">
          <%= (currentAdmin.name||'S').charAt(0).toUpperCase() %>
        </div>
        <div>
          <div style="font-size:0.78rem;font-weight:700;color:#fff;"><%= currentAdmin.name || currentAdmin.username %></div>
          <div style="font-family:'Space Mono',monospace;font-size:0.52rem;color:#9D4EDD;letter-spacing:1px;">SUPERADMIN</div>
        </div>
      </div>
      <% } %>
          <div style="margin-top:auto;border-top:1px solid rgba(255,255,255,0.06);padding-top:0.7rem;">
      <% if(locals.currentAdmin){ %>
      <div style="display:flex;align-items:center;gap:0.6rem;padding:0.6rem 0.8rem;margin-bottom:0.3rem;">
        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3a0870,#6A0DAD);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.9rem;color:#fff;flex-shrink:0;">
          <%= (currentAdmin.name||'S').charAt(0).toUpperCase() %>
        </div>
        <div>
          <div style="font-size:0.78rem;font-weight:700;color:#fff;"><%= currentAdmin.name || currentAdmin.username %></div>
          <div style="font-family:'Space Mono',monospace;font-size:0.52rem;color:#9D4EDD;letter-spacing:1px;">SUPERADMIN</div>
        </div>
      </div>
      <% } %>
      <a href="/superadmin/logout" class="s-logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>
    </div>
  </aside>
  <main class="main">
    <h1 class="page-title">USERS BY EVENT</h1>
    <p class="page-sub">View all attendees for a selected event.</p>

    <form method="GET" action="/superadmin/users-by-event">
      <div class="select-bar">
        <div class="f-grp">
          <label class="f-lbl">Select Event</label>
          <select class="f-sel" name="eventId">
            <option value="">— Choose an event —</option>
            <% events.forEach(function(ev){ %>
            <option value="<%= ev._id %>" <%= selectedEventId===ev._id.toString()?'selected':'' %>><%= ev.name %> — <%= new Date(ev.date).toLocaleDateString('en-IN') %></option>
            <% }); %>
          </select>
        </div>
        <button type="submit" class="filter-btn"><i class="bi bi-search"></i> View Users</button>
      </div>
    </form>

    <% if(selectedEvent && bookings){ %>
    <div class="event-header">
      <div>
        <div class="ev-name"><%= selectedEvent.name.toUpperCase() %></div>
        <div style="font-size:0.78rem;color:var(--muted);margin-top:0.2rem;"><%= new Date(selectedEvent.date).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></div>
      </div>
      <div class="ev-count"><%= bookings.length %> BOOKINGS</div>
    </div>

    <% if(bookings.length===0){ %>
    <div class="empty"><i class="bi bi-people" style="font-size:2.5rem;display:block;margin-bottom:0.8rem;"></i>No paid bookings for this event yet.</div>
    <% } else { %>
    <div style="overflow-x:auto;">
    <table class="users-table">
      <thead><tr>
        <th>#</th><th>Name</th><th>Email</th><th>Phone</th><th>Ticket Type</th><th>Qty</th><th>Amount</th><th>Booking Ref</th><th>Date</th>
      </tr></thead>
      <tbody>
      <% bookings.forEach(function(b, i){ %>
      <tr>
        <td style="color:var(--muted);font-family:'Space Mono',monospace;font-size:0.72rem;"><%= i+1 %></td>
        <td><strong><%= b.user ? (b.user.firstName+' '+(b.user.lastName||'')) : '—' %></strong></td>
        <td style="font-size:0.8rem;color:var(--muted);"><%= b.user?.email||'—' %></td>
        <td style="font-family:'Space Mono',monospace;font-size:0.75rem;"><%= b.user?.phone||'—' %></td>
        <td><span class="ticket-chip"><%= b.ticketType.toUpperCase() %></span></td>
        <td style="text-align:center;"><%= b.quantity %></td>
        <td style="font-family:'Space Mono',monospace;font-size:0.82rem;color:var(--accent);">₹<%= b.totalAmount.toLocaleString('en-IN') %></td>
        <td style="font-family:'Space Mono',monospace;font-size:0.68rem;color:var(--muted);"><%= b.bookingRef %></td>
        <td style="font-size:0.75rem;color:var(--muted);"><%= new Date(b.createdAt).toLocaleDateString('en-IN') %></td>
      </tr>
      <% }); %>
      </tbody>
    </table>
    </div>
    <% } %>
    <% } %>
  </main>
</div>
</body>
</html>
