<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#9D4EDD;--text:#fff;--muted:#B3B3B3;--error:#FF4444;--success:#00FF88;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    .layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;overflow-y:auto;}
    .s-logo{font-family:'Anton',sans-serif;font-size:1.3rem;letter-spacing:3px;color:#fff;text-decoration:none;display:block;padding:0 0.5rem 0.5rem;border-bottom:1px solid var(--border);margin-bottom:0.4rem;}
    .s-logo span{color:var(--accent);}
    .s-badge{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:2px;color:var(--accent);background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);border-radius:10px;padding:0.15rem 0.6rem;margin-bottom:0.8rem;display:inline-block;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(157,78,221,0.08);border-color:rgba(157,78,221,0.2);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,68,68,0.08);border-color:rgba(255,68,68,0.2);}
    .main{padding:2rem;overflow-x:hidden;}
    .page-title{font-family:'Anton',sans-serif;font-size:1.8rem;letter-spacing:2px;margin-bottom:0.3rem;}
    .page-sub{font-size:0.78rem;color:var(--muted);margin-bottom:2rem;}
    .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:2rem;}
    .stat-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.4rem;}
    .stat-icon{font-size:1.4rem;margin-bottom:0.7rem;}
    .stat-val{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:1px;color:var(--accent);}
    .stat-lbl{font-size:0.75rem;color:var(--muted);margin-top:0.2rem;}
    .quick-links{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;}
    .ql-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.2rem;text-decoration:none;color:var(--text);transition:all 0.18s;display:flex;align-items:center;gap:0.8rem;}
    .ql-card:hover{border-color:rgba(157,78,221,0.3);transform:translateY(-2px);color:#fff;}
    .ql-icon{width:40px;height:40px;border-radius:8px;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.2);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--accent);}
    .ql-label{font-weight:600;font-size:0.88rem;}
    .ql-sub{font-size:0.72rem;color:var(--muted);}
    @media(max-width:900px){.layout{grid-template-columns:1fr;}.sidebar{display:none;}.stats-grid{grid-template-columns:repeat(2,1fr);}}
  </style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <a href="/superadmin" class="s-logo"><img src="/img/mee-logo.png" alt="MEE" style="height:28px;width:auto;object-fit:contain;"/></a>
    <span class="s-badge">⬡ SUPER ADMIN</span>
    <a href="/superadmin"               class="s-link active"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <a href="/superadmin/staff"         class="s-link"><i class="bi bi-people-fill"></i> Staff & Admins</a>
    <a href="/superadmin/coupons"       class="s-link"><i class="bi bi-tag-fill"></i> Coupons</a>
    <a href="/superadmin/users-by-event" class="s-link"><i class="bi bi-person-lines-fill"></i> Users by Event</a>
    <a href="/superadmin/entered-tickets"  class="s-link"><i class="bi bi-door-open-fill"></i> Entered Tickets</a>
    <a href="/admin"                    class="s-link"><i class="bi bi-grid-fill"></i> Admin Panel</a>
    <a href="/" target="_blank"         class="s-link"><i class="bi bi-box-arrow-up-right"></i> View Site</a>
        <div style="margin-top:auto;border-top:1px solid rgba(255,255,255,0.06);padding-top:0.7rem;">
      <% if(locals.currentAdmin){ %>
      <div style="display:flex;align-items:center;gap:0.6rem;padding:0.6rem 0.8rem;margin-bottom:0.3rem;">
        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3a0870,#6A0DAD);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.9rem;color:#fff;flex-shrink:0;">
          <%= (currentAdmin.name||'S').charAt(0).toUpperCase() %>
        </div>
        <div>
          <div style="font-size:0.78rem;font-weight:700;color:#fff;"><%= currentAdmin.name || currentAdmin.username %></div>
          <div style="font-family:'Space Mono',monospace;font-size:0.52rem;color:#9D4EDD;letter-spacing:1px;">SUPERADMIN</div>
        </div>
      </div>
      <% } %>
          <div style="margin-top:auto;border-top:1px solid rgba(255,255,255,0.06);padding-top:0.7rem;">
      <% if(locals.currentAdmin){ %>
      <div style="display:flex;align-items:center;gap:0.6rem;padding:0.6rem 0.8rem;margin-bottom:0.3rem;">
        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3a0870,#6A0DAD);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.9rem;color:#fff;flex-shrink:0;">
          <%= (currentAdmin.name||'S').charAt(0).toUpperCase() %>
        </div>
        <div>
          <div style="font-size:0.78rem;font-weight:700;color:#fff;"><%= currentAdmin.name || currentAdmin.username %></div>
          <div style="font-family:'Space Mono',monospace;font-size:0.52rem;color:#9D4EDD;letter-spacing:1px;">SUPERADMIN</div>
        </div>
      </div>
      <% } %>
      <a href="/superadmin/logout" class="s-logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>
    </div>
  </aside>
  <main class="main">
    <h1 class="page-title">SUPER ADMIN</h1>
    <p class="page-sub">Full system access — manage staff, coupons, and all operations.</p>
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-icon">👥</div><div class="stat-val"><%= staffCount %></div><div class="stat-lbl">Staff & Admins</div></div>
      <div class="stat-card"><div class="stat-icon">🎟️</div><div class="stat-val"><%= totalBookings %></div><div class="stat-lbl">Paid Bookings</div></div>
      <div class="stat-card"><div class="stat-icon">₹</div><div class="stat-val"><%=  (totalRevenue/1000).toFixed(1) %>K</div><div class="stat-lbl">Total Revenue</div></div>
      <div class="stat-card"><div class="stat-icon">🏷️</div><div class="stat-val"><%= coupons %></div><div class="stat-lbl">Coupons</div></div>
    </div>
    <h2 style="font-family:'Anton',sans-serif;font-size:1.1rem;letter-spacing:2px;margin-bottom:1rem;">QUICK ACCESS</h2>
    <div class="quick-links">
      <a href="/superadmin/staff" class="ql-card"><div class="ql-icon"><i class="bi bi-people-fill"></i></div><div><div class="ql-label">Staff Management</div><div class="ql-sub">Add/block admins & staff</div></div></a>
      <a href="/superadmin/coupons" class="ql-card"><div class="ql-icon"><i class="bi bi-tag-fill"></i></div><div><div class="ql-label">Coupons</div><div class="ql-sub">Create & manage codes</div></div></a>
      <a href="/superadmin/users-by-event" class="ql-card"><div class="ql-icon"><i class="bi bi-person-lines-fill"></i></div><div><div class="ql-label">Users by Event</div><div class="ql-sub">View attendee lists</div></div></a>
      <a href="/admin/bookings" class="ql-card"><div class="ql-icon"><i class="bi bi-ticket-perforated-fill"></i></div><div><div class="ql-label">All Bookings</div><div class="ql-sub">View & manage bookings</div></div></a>
      <div class="ql-card" style="cursor:pointer;border-color:rgba(245,200,66,0.2);background:rgba(245,200,66,0.04);" onclick="repairQR(this)">
        <div class="ql-icon" style="background:rgba(245,200,66,0.1);border-color:rgba(245,200,66,0.3);"><i class="bi bi-qr-code" style="color:#f5c842;"></i></div>
        <div><div class="ql-label" style="color:#f5c842;">Fix QR Codes</div><div class="ql-sub">Repair old PENDING tickets</div></div>
      </div>
    </div>
  </main>
</div>
</body>
<script>
async function repairQR(el) {
  if (!confirm('This will fix all existing bookings that have "PENDING" in their QR codes.\n\nContinue?')) return;
  el.style.opacity = '0.6';
  el.querySelector('.ql-label').textContent = 'Fixing...';
  try {
    const r = await fetch('/superadmin/api/repair-qr', { method: 'POST', credentials: 'include' });
    const d = await r.json();
    if (d.success) {
      el.querySelector('.ql-label').textContent = `✅ Done! Fixed ${d.fixed}`;
      el.querySelector('.ql-sub').textContent = `${d.skipped} were already OK`;
    } else {
      el.querySelector('.ql-label').textContent = '❌ Failed';
      el.querySelector('.ql-sub').textContent = d.message;
    }
  } catch(e) {
    el.querySelector('.ql-label').textContent = '❌ Network error';
  }
  el.style.opacity = '1';
}
</script>
</html>
