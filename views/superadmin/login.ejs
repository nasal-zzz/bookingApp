<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:#0B0B0F;color:#fff;font-family:'Outfit',sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .orb{position:fixed;top:-150px;left:50%;transform:translateX(-50%);width:600px;height:400px;border-radius:50%;background:radial-gradient(ellipse,rgba(157,78,221,0.18) 0%,transparent 65%);pointer-events:none;}
    .card{background:#14141C;border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:2.5rem;width:100%;max-width:400px;position:relative;z-index:1;box-shadow:0 40px 80px rgba(0,0,0,0.6);}
    .card-top{height:3px;background:linear-gradient(90deg,transparent,#9D4EDD,#6A0DAD,transparent);margin:-2.5rem -2.5rem 2.2rem;border-radius:14px 14px 0 0;}
    .logo{font-family:'Poppins',sans-serif;font-size:2rem;letter-spacing:4px;color:#fff;text-align:center;margin-bottom:0.2rem;}
    .logo span{color:#9D4EDD;}
    .sub{text-align:center;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:3px;color:#B3B3B3;margin-bottom:0.5rem;}
    .sa-badge{display:flex;align-items:center;justify-content:center;gap:0.5rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.35);border-radius:20px;padding:0.35rem 1.2rem;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#9D4EDD;margin:0 auto 2rem;}
    .field{margin-bottom:1.2rem;}
    .lbl{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:#B3B3B3;display:block;margin-bottom:0.45rem;}
    input{width:100%;background:#0B0B0F;border:1.5px solid rgba(255,255,255,0.08);border-radius:8px;color:#fff;font-size:0.95rem;padding:0.85rem 1rem;font-family:'Outfit',sans-serif;outline:none;transition:border-color 0.2s;}
    input:focus{border-color:#9D4EDD;box-shadow:0 0 0 3px rgba(157,78,221,0.1);}
    .btn{width:100%;padding:0.95rem;background:#9D4EDD;color:#fff;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;border:none;border-radius:8px;cursor:pointer;letter-spacing:1px;transition:box-shadow 0.2s,transform 0.15s;margin-top:0.5rem;}
    .btn:hover{box-shadow:0 0 30px rgba(157,78,221,0.5);transform:translateY(-1px);}
    .err{background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.3);border-radius:8px;padding:0.8rem 1rem;color:#FF4444;font-size:0.85rem;margin-bottom:1.2rem;display:flex;align-items:center;gap:0.5rem;}
    .admin-link{text-align:center;margin-top:1.5rem;font-size:0.78rem;color:#555;}
    .admin-link a{color:#9D4EDD;text-decoration:none;}
  </style>
</head>
<body>
  <div class="orb"></div>
  <div class="card">
    <div class="card-top"></div>
    <div class="logo">NIGHT<span>PASS</span></div>
    <div class="sub">SUPER ADMIN PORTAL</div>
    <div class="sa-badge">⬡ SUPER ADMINISTRATOR</div>
    <% if(error){ %>
    <div class="err"><i>⚠</i> <%= error %></div>
    <% } %>
    <form method="POST" action="/superadmin/login">
      <div class="field">
        <label class="lbl">USERNAME</label>
        <input type="text" name="username" placeholder="superadmin" autocomplete="username" required/>
      </div>
      <div class="field">
        <label class="lbl">PASSWORD</label>
        <input type="password" name="password" placeholder="••••••••" autocomplete="current-password" required/>
      </div>
      <button class="btn" type="submit">LOGIN AS SUPER ADMIN</button>
    </form>
    <div class="admin-link">Regular admin? <a href="/admin/login">Admin Login →</a></div>
  </div>
</body>
</html>
