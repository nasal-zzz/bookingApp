<style>
  .np-nav{padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.08);background:rgba(8,8,14,0.92);backdrop-filter:blur(20px);position:sticky;top:0;z-index:100;}
  .np-logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:4px;color:#fff;text-decoration:none;}
  .np-logo span{color:#c8ff00;}
  .np-links{display:flex;align-items:center;gap:1.2rem;}
  .np-txt{color:#5a5a72;text-decoration:none;font-size:0.82rem;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s;}
  .np-txt:hover{color:#fff;}
  .np-btn{background:#c8ff00;color:#000;padding:0.5rem 1.2rem;border-radius:4px;text-decoration:none;font-weight:700;font-size:0.82rem;letter-spacing:1px;transition:box-shadow 0.2s,transform 0.15s;}
  .np-btn:hover{box-shadow:0 0 25px rgba(200,255,0,0.4);transform:translateY(-1px);color:#000;}
  .np-btn-outline{color:#5a5a72;text-decoration:none;font-size:0.82rem;letter-spacing:1px;text-transform:uppercase;padding:0.45rem 0.8rem;border-radius:4px;border:1px solid rgba(255,255,255,0.08);transition:all 0.2s;}
  .np-btn-outline:hover{color:#fff;border-color:rgba(255,255,255,0.2);}

  /* User dropdown */
  .np-dd-wrap{position:relative;}
  .np-trigger{display:flex;align-items:center;gap:0.5rem;background:#0f0f18;border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:0.38rem 0.85rem 0.38rem 0.45rem;cursor:pointer;font-family:'Outfit',sans-serif;font-size:0.85rem;transition:border-color 0.2s;}
  .np-trigger:hover{border-color:rgba(200,255,0,0.35);}
  .np-uavatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#1c2200,#3a4a00);border:1px solid rgba(200,255,0,0.3);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.7rem;color:#c8ff00;flex-shrink:0;}
  .np-uname{font-weight:600;color:#fff;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .np-chevron{font-size:0.68rem;color:#5a5a72;transition:transform 0.2s;}
  .np-chevron.open{transform:rotate(180deg);}
  .np-dd{display:none;position:absolute;top:calc(100% + 8px);right:0;background:#13131e;border:1px solid rgba(255,255,255,0.08);border-radius:10px;min-width:220px;box-shadow:0 20px 60px rgba(0,0,0,0.7);z-index:300;overflow:hidden;}
  .np-dd.open{display:block;animation:npDdIn 0.15s ease both;}
  @keyframes npDdIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
  .np-dd-head{padding:0.9rem 1.1rem;display:flex;align-items:center;gap:0.8rem;background:rgba(255,255,255,0.02);border-bottom:1px solid rgba(255,255,255,0.08);}
  .np-dd-bigavatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#1c2200,#3a4a00);border:1px solid rgba(200,255,0,0.3);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:0.95rem;color:#c8ff00;flex-shrink:0;}
  .np-dd-name{font-weight:700;font-size:0.88rem;color:#fff;}
  .np-dd-phone{font-family:'Space Mono',monospace;font-size:0.6rem;color:#5a5a72;margin-top:1px;}
  .np-dd-item{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 1.1rem;color:#e8e8f0;text-decoration:none;font-size:0.85rem;transition:background 0.15s;}
  .np-dd-item:hover{background:rgba(255,255,255,0.04);color:#fff;}
  .np-dd-item i{width:16px;color:#5a5a72;font-size:0.85rem;}
  .np-dd-item:hover i{color:#c8ff00;}
  .np-dd-divider{height:1px;background:rgba(255,255,255,0.08);}
  .np-dd-item.np-danger{color:#ff5c5c;}
  .np-dd-item.np-danger i{color:#ff5c5c;}
  .np-dd-item.np-danger:hover{background:rgba(255,92,92,0.06);}

  /* Hamburger */
  .np-ham{display:none;background:none;border:1px solid rgba(255,255,255,0.08);border-radius:6px;padding:0.42rem 0.65rem;cursor:pointer;color:#e8e8f0;}

  /* Mobile drawer */
  .np-drawer{display:none;position:fixed;inset:0;z-index:500;background:rgba(8,8,14,0.98);backdrop-filter:blur(20px);flex-direction:column;padding:1.5rem;}
  .np-drawer.open{display:flex;}
  .np-drawer-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:1.2rem;border-bottom:1px solid rgba(255,255,255,0.08);margin-bottom:1.2rem;}
  .np-drawer-user{display:flex;align-items:center;gap:0.9rem;background:#0f0f18;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:0.9rem 1rem;margin-bottom:1rem;}
  .np-drawer-links{flex:1;display:flex;flex-direction:column;gap:0.2rem;overflow-y:auto;}
  .np-drawer-link{display:flex;align-items:center;gap:0.8rem;padding:0.85rem 1rem;color:#e8e8f0;text-decoration:none;border-radius:8px;font-size:0.92rem;border:1px solid transparent;transition:all 0.15s;}
  .np-drawer-link:hover{background:#0f0f18;border-color:rgba(255,255,255,0.08);}
  .np-drawer-link i{color:#c8ff00;width:20px;text-align:center;}
  .np-drawer-footer{padding-top:1.2rem;border-top:1px solid rgba(255,255,255,0.08);display:flex;flex-direction:column;gap:0.6rem;}
  .np-drawer-cta{display:flex;align-items:center;justify-content:center;gap:0.6rem;padding:0.95rem;background:#c8ff00;border-radius:8px;color:#000;font-weight:700;text-decoration:none;font-size:0.9rem;letter-spacing:1px;border:none;cursor:pointer;font-family:'Outfit',sans-serif;}
  .np-drawer-logout{display:flex;align-items:center;justify-content:center;gap:0.6rem;padding:0.85rem;background:transparent;border:1px solid rgba(255,92,92,0.3);border-radius:8px;color:#ff5c5c;font-weight:600;text-decoration:none;font-size:0.88rem;}

  @media(max-width:768px){.np-links{display:none!important;}.np-ham{display:flex!important;}}
</style>

<nav class="np-nav">
  <a href="/" class="np-logo">NIGHT<span>PASS</span></a>

  <!-- Desktop links -->
  <div class="np-links">
    <a href="/#details" class="np-txt">Details</a>
    <a href="/#lineup"  class="np-txt">Lineup</a>
    <a href="/booking"  class="np-txt">Tickets</a>

    <% if (locals.user && user) { %>
      <!-- Logged in — dropdown -->
      <div class="np-dd-wrap" id="npDdWrap">
        <button class="np-trigger" onclick="npToggleDD()">
          <div class="np-uavatar">
            <%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %>
          </div>
          <span class="np-uname"><%= user.firstName %></span>
          <i class="bi bi-chevron-down np-chevron" id="npChevron"></i>
        </button>

        <div class="np-dd" id="npDd">
          <div class="np-dd-head">
            <div class="np-dd-bigavatar">
              <%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %>
            </div>
            <div>
              <div class="np-dd-name"><%= (user.firstName + ' ' + (user.lastName||'')).trim() %></div>
              <div class="np-dd-phone"><%= user.phone.startsWith('GOOGLE_') ? user.email : user.phone %></div>
            </div>
          </div>
          <a href="/user/profile"        class="np-dd-item"><i class="bi bi-person-fill"></i> My Profile</a>
          <a href="/booking"             class="np-dd-item"><i class="bi bi-ticket-perforated-fill"></i> Book Tickets</a>
          <a href="/booking/my-bookings" class="np-dd-item"><i class="bi bi-collection-fill"></i> My Bookings</a>
          <div class="np-dd-divider"></div>
          <a href="/auth/logout" class="np-dd-item np-danger"><i class="bi bi-box-arrow-right"></i> Sign Out</a>
        </div>
      </div>

    <% } else { %>
      <!-- Not logged in -->
      <a href="/auth/login"              class="np-btn-outline">Login</a>
      <a href="/auth/login?next=/booking" class="np-btn">Get Tickets</a>
    <% } %>
  </div>

  <!-- Hamburger -->
  <button class="np-ham" onclick="npToggleMobile()">
    <i class="bi bi-list" style="font-size:1.3rem;"></i>
  </button>
</nav>

<!-- Mobile Drawer -->
<div class="np-drawer" id="npDrawer">
  <div class="np-drawer-head">
    <span class="np-logo">NIGHT<span>PASS</span></span>
    <button onclick="npToggleMobile()" style="background:none;border:1px solid rgba(255,255,255,0.08);border-radius:6px;padding:0.42rem 0.65rem;cursor:pointer;color:#e8e8f0;">
      <i class="bi bi-x" style="font-size:1.3rem;"></i>
    </button>
  </div>

  <% if (locals.user && user) { %>
    <div class="np-drawer-user">
      <div class="np-dd-bigavatar">
        <%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %>
      </div>
      <div>
        <div style="font-weight:700;color:#fff;font-size:0.95rem;"><%= (user.firstName + ' ' + (user.lastName||'')).trim() %></div>
        <div style="font-size:0.72rem;color:#5a5a72;font-family:'Space Mono',monospace;"><%= user.phone.startsWith('GOOGLE_') ? user.email : user.phone %></div>
      </div>
    </div>
  <% } %>

  <div class="np-drawer-links">
    <a href="/"        class="np-drawer-link" onclick="npToggleMobile()"><i class="bi bi-house-fill"></i> Home</a>
    <a href="/#details" class="np-drawer-link" onclick="npToggleMobile()"><i class="bi bi-info-circle-fill"></i> Event Details</a>
    <a href="/#lineup"  class="np-drawer-link" onclick="npToggleMobile()"><i class="bi bi-music-note-list"></i> Lineup</a>
    <a href="/booking"  class="np-drawer-link" onclick="npToggleMobile()"><i class="bi bi-ticket-perforated-fill"></i> Book Tickets</a>
    <% if (locals.user && user) { %>
      <a href="/user/profile"        class="np-drawer-link" onclick="npToggleMobile()"><i class="bi bi-person-fill"></i> My Profile</a>
      <a href="/booking/my-bookings" class="np-drawer-link" onclick="npToggleMobile()"><i class="bi bi-collection-fill"></i> My Bookings</a>
    <% } else { %>
      <a href="/auth/login"  class="np-drawer-link" onclick="npToggleMobile()"><i class="bi bi-person-fill"></i> Login</a>
      <a href="/auth/signup" class="np-drawer-link" onclick="npToggleMobile()"><i class="bi bi-person-plus-fill"></i> Sign Up</a>
    <% } %>
  </div>

  <div class="np-drawer-footer">
    <% if (locals.user && user) { %>
      <a href="/booking"     class="np-drawer-cta"    onclick="npToggleMobile()"><i class="bi bi-ticket-perforated-fill"></i> Book Tickets</a>
      <a href="/auth/logout" class="np-drawer-logout"><i class="bi bi-box-arrow-right"></i> Sign Out</a>
    <% } else { %>
      <a href="/auth/login?next=/booking" class="np-drawer-cta" onclick="npToggleMobile()"><i class="bi bi-ticket-perforated-fill"></i> Get Tickets</a>
    <% } %>
  </div>
</div>

<script>
  function npToggleDD() {
    const dd      = document.getElementById('npDd');
    const chevron = document.getElementById('npChevron');
    dd.classList.toggle('open');
    chevron.classList.toggle('open');
    if (dd.classList.contains('open')) {
      setTimeout(() => document.addEventListener('click', npCloseDDOutside, { once: true }), 10);
    }
  }
  function npCloseDDOutside(e) {
    const wrap = document.getElementById('npDdWrap');
    if (wrap && !wrap.contains(e.target)) {
      document.getElementById('npDd').classList.remove('open');
      const c = document.getElementById('npChevron');
      if (c) c.classList.remove('open');
    }
  }
  function npToggleMobile() {
    const drawer = document.getElementById('npDrawer');
    drawer.classList.toggle('open');
    document.body.style.overflow = drawer.classList.contains('open') ? 'hidden' : '';
  }
</script>
