<style>
  /* ── NAVBAR ── */
  .np-nav {
    padding: 0 2rem;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background: rgba(8,8,14,0.96);
    backdrop-filter: blur(24px);
    position: sticky;
    top: 0;
    z-index: 200;
    gap: 1rem;
  }

  .np-logo {
    display: flex; align-items: center; gap: 0.5rem;
    text-decoration: none; flex-shrink: 0;
  }
  .np-logo i { color: #6A0DAD; font-size: 1.1rem; }
  .np-logo-text {
    font-family: 'Poppins', sans-serif; font-weight: 700;
    font-size: 1rem; color: #fff; letter-spacing: 0.5px;
  }
  .np-search {
    flex: 1; max-width: 480px; position: relative;
    display: flex; align-items: center;
  }
  .np-search input {
    width: 100%;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px; color: #fff;
    font-family: 'Poppins', sans-serif; font-size: 0.75rem;
    padding: 0.5rem 1rem 0.5rem 2.4rem; outline: none;
    transition: border-color 0.2s;
  }
  .np-search input::placeholder { color: #555; }
  .np-search input:focus { border-color: rgba(106,13,173,0.4); }
  .np-search-icon { position: absolute; left: 0.75rem; color: #555; font-size: 0.8rem; pointer-events: none; }

  .np-right { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; }

  /* Login button */
  .np-login-btn {
    display: flex; align-items: center; gap: 0.4rem;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 6px; color: #fff;
    font-family: 'Poppins', sans-serif; font-size: 0.75rem; font-weight: 600;
    padding: 0.42rem 0.9rem; text-decoration: none;
    transition: border-color 0.2s, background 0.2s; white-space: nowrap;
  }
  .np-login-btn:hover { border-color: rgba(106,13,173,0.5); background: rgba(106,13,173,0.08); color: #fff; }
  .np-login-btn i { font-size: 0.85rem; color: #B3B3B3; }

  /* Profile pill */
  .np-profile-wrap { position: relative; }
  .np-profile-pill {
    display: flex; align-items: center; gap: 0.5rem;
    background: rgba(106,13,173,0.12);
    border: 1px solid rgba(106,13,173,0.25);
    border-radius: 50px;
    padding: 0.28rem 0.75rem 0.28rem 0.3rem;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .np-profile-pill:hover { border-color: rgba(106,13,173,0.55); background: rgba(106,13,173,0.2); }
  .np-avatar {
    width: 28px; height: 28px; border-radius: 50%;
    background: linear-gradient(135deg,#3a0870,#6A0DAD);
    border: 1.5px solid rgba(106,13,173,0.6);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Montserrat', sans-serif; font-size: 0.65rem; color: #fff; flex-shrink: 0;
  }
  .np-profile-name {
    font-family: 'Poppins', sans-serif; font-size: 0.78rem; font-weight: 600; color: #fff;
    max-width: 90px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Profile dropdown */
  .np-profile-dd {
    display: none; position: absolute; top: calc(100% + 10px); right: 0;
    background: #13131b; border: 1px solid rgba(255,255,255,0.09);
    border-radius: 10px; min-width: 200px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.8); z-index: 400; overflow: hidden;
  }
  .np-profile-dd.open { display: block; animation: npDdIn 0.15s ease both; }
  @keyframes npDdIn { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:translateY(0)} }
  .np-dd-head {
    padding: 0.85rem 1rem; display: flex; align-items: center; gap: 0.7rem;
    background: rgba(106,13,173,0.06); border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .np-dd-bigav {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg,#3a0870,#6A0DAD);
    border: 1.5px solid rgba(106,13,173,0.5);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Montserrat', sans-serif; font-size: 0.9rem; color: #fff; flex-shrink: 0;
  }
  .np-dd-uname { font-weight: 700; font-size: 0.82rem; color: #fff; }
  .np-dd-uid { font-family: 'Space Mono', monospace; font-size: 0.58rem; color: #777; margin-top: 2px; }
  .np-dd-link {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.65rem 1rem; color: #ccc; text-decoration: none;
    font-size: 0.78rem; font-family: 'Poppins', sans-serif;
    transition: background 0.15s, color 0.15s;
  }
  .np-dd-link:hover { background: rgba(255,255,255,0.04); color: #fff; }
  .np-dd-link i { width: 16px; font-size: 0.8rem; color: #6A0DAD; }
  .np-dd-div { height: 1px; background: rgba(255,255,255,0.07); }
  .np-dd-link.danger { color: #FF4444; }
  .np-dd-link.danger i { color: #FF4444; }
  .np-dd-link.danger:hover { background: rgba(255,68,68,0.06); }

  /* Hamburger */
  .np-ham-btn {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px; cursor: pointer; color: #fff; flex-shrink: 0;
    transition: background 0.2s;
  }
  .np-ham-btn:hover { background: rgba(255,255,255,0.09); }
  .np-ham-btn i { font-size: 1.2rem; }

  /* ── DRAWER ── */
  .np-drawer-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.65); z-index: 590; backdrop-filter: blur(4px);
  }
  .np-drawer-overlay.open { display: block; }

  .np-drawer {
    display: none; position: fixed;
    top: 0; right: 0;
    width: min(310px, 88vw); height: 100vh;
    background: #0e0e18;
    border-left: 1px solid rgba(255,255,255,0.07);
    z-index: 600; flex-direction: column;
    box-shadow: -20px 0 60px rgba(0,0,0,0.8);
  }
  .np-drawer.open { display: flex; animation: drawerIn 0.22s ease both; }
  @keyframes drawerIn { from{transform:translateX(100%)} to{transform:translateX(0)} }

  .np-drawer-top {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.1rem 1.2rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .np-drawer-logo {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: 'Poppins', sans-serif; font-weight: 700;
    font-size: 0.95rem; color: #6A0DAD; text-decoration: none;
  }
  .np-drawer-close {
    width: 32px; height: 32px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px; cursor: pointer; color: #fff;
    display: flex; align-items: center; justify-content: center;
  }

  .np-drawer-links { flex: 1; overflow-y: auto; padding: 0.6rem 0; }
  .np-drawer-link {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.85rem 1.2rem;
    color: #ccc; text-decoration: none;
    font-family: 'Poppins', sans-serif; font-size: 0.88rem; font-weight: 500;
    transition: background 0.15s, color 0.15s;
  }
  .np-drawer-link:hover { background: rgba(106,13,173,0.08); color: #fff; }
  .np-drawer-link i { font-size: 1rem; color: #6A0DAD; width: 20px; text-align: center; }

  .np-drawer-social {
    display: flex; justify-content: center; gap: 0.7rem;
    padding: 0.9rem 1.2rem;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .np-soc-btn {
    width: 40px; height: 40px; border-radius: 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.09);
    display: flex; align-items: center; justify-content: center;
    color: #aaa; font-size: 0.95rem; text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .np-soc-btn:hover { background: rgba(106,13,173,0.2); color: #fff; border-color: rgba(106,13,173,0.4); }

  .np-drawer-footer { padding: 0.8rem 1.2rem 1.5rem; }
  .np-drawer-cta {
    display: flex; align-items: center; justify-content: center; gap: 0.55rem;
    width: 100%; padding: 0.85rem;
    background: #6A0DAD; border-radius: 8px;
    color: #fff; font-family: 'Poppins', sans-serif;
    font-size: 0.82rem; font-weight: 700; letter-spacing: 1px;
    text-decoration: none; text-transform: uppercase; border: none; cursor: pointer;
    transition: box-shadow 0.2s;
  }
  .np-drawer-cta:hover { box-shadow: 0 0 30px rgba(106,13,173,0.5); color: #fff; }

  @media(max-width: 640px) { .np-search { display: none; } }
</style>

<nav class="np-nav">
  <a href="/" class="np-logo">
    <img src="/img/mee-logo.png" alt="MEE Logo" style="height:38px;width:auto;object-fit:contain;"/>
  </a>

  <!-- <div class="np-search">
    <i class="bi bi-search np-search-icon"></i>
    <input type="text" placeholder="Search for events, artists, or venues..." />
  </div> -->

  <div class="np-right">
    <% if (locals.user && user) { %>
      <div class="np-profile-wrap" id="npProfileWrap">
        <div class="np-profile-pill" onclick="npToggleProfile()">
          <div class="np-avatar">
            <%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %>
          </div>
          <span class="np-profile-name"><%= user.firstName %></span>
        </div>
        <div class="np-profile-dd" id="npProfileDd">
          <div class="np-dd-head">
            <div class="np-dd-bigav">
              <%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %>
            </div>
            <div>
              <div class="np-dd-uname"><%= (user.firstName + ' ' + (user.lastName||'')).trim() %></div>
              <div class="np-dd-uid"><%= user.phone && !user.phone.startsWith('GOOGLE_') ? user.phone : (user.email||'') %></div>
            </div>
          </div>
          <a href="/user/profile"         class="np-dd-link"><i class="bi bi-person-fill"></i> View Profile</a>
          <a href="/booking/my-bookings"  class="np-dd-link"><i class="bi bi-ticket-perforated-fill"></i> My Tickets</a>
          <a href="/support"               class="np-dd-link"><i class="bi bi-headset"></i> Help & Support</a>
          <div class="np-dd-div"></div>
          <a href="/auth/logout" class="np-dd-link danger"><i class="bi bi-box-arrow-right"></i> Log Out</a>
        </div>
      </div>
    <% } else { %>
      <a href="/auth/login" class="np-login-btn">
        <i class="bi bi-person-fill"></i> Login / Sign Up
      </a>
    <% } %>

    <button class="np-ham-btn" onclick="npToggleDrawer()" aria-label="Menu">
      <i class="bi bi-list"></i>
    </button>
  </div>
</nav>

<div class="np-drawer-overlay" id="npOverlay" onclick="npToggleDrawer()"></div>
<div class="np-drawer" id="npDrawer">
  <div class="np-drawer-top">
    <a href="/" class="np-drawer-logo" onclick="npToggleDrawer()">
      <img src="/img/mee-logo.png" alt="MEE Logo" style="height:30px;width:auto;object-fit:contain;"/>
    </a>
    <button class="np-drawer-close" onclick="npToggleDrawer()">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <div class="np-drawer-links">
    <a href="/"                    class="np-drawer-link" onclick="npToggleDrawer()"><i class="bi bi-house-fill"></i> Home</a>
    <a href="/#events"             class="np-drawer-link" onclick="npToggleDrawer()"><i class="bi bi-calendar-event-fill"></i> Events</a>
    <% if(locals.user && user){ %>
    <a href="/booking/my-bookings" class="np-drawer-link" onclick="npToggleDrawer()"><i class="bi bi-ticket-perforated-fill"></i> My Tickets</a>
    <% } else { %>
    <a href="/auth/login?next=/booking/my-bookings" class="np-drawer-link" onclick="npToggleDrawer()"><i class="bi bi-ticket-perforated-fill"></i> My Tickets</a>
    <% } %>
    <a href="/#about"              class="np-drawer-link" onclick="npToggleDrawer()"><i class="bi bi-info-circle-fill"></i> About Us</a>
    <a href="/support"             class="np-drawer-link" onclick="npToggleDrawer()"><i class="bi bi-headset"></i> Help & Support</a>
  </div>

  <div class="np-drawer-social">
    <a href="#" class="np-soc-btn" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
    <a href="#" class="np-soc-btn" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
    <a href="#" class="np-soc-btn" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
  </div>

  <div class="np-drawer-footer">
    <% if (locals.user && user) { %>
      <a href="/auth/logout" class="np-drawer-cta" style="background:rgba(255,68,68,0.12);border:1px solid rgba(255,68,68,0.3);color:#FF5555;">
        <i class="bi bi-box-arrow-right"></i> SIGN OUT
      </a>
    <% } else { %>
      <a href="/auth/login" class="np-drawer-cta" onclick="npToggleDrawer()">
        <i class="bi bi-box-arrow-in-right"></i> LOGIN / SIGN UP
      </a>
    <% } %>
  </div>
</div>

<script>
  function npToggleProfile() {
    const dd = document.getElementById('npProfileDd');
    dd.classList.toggle('open');
    if (dd.classList.contains('open')) {
      setTimeout(() => document.addEventListener('click', _npCloseProfile, { once: true }), 10);
    }
  }
  function _npCloseProfile(e) {
    const wrap = document.getElementById('npProfileWrap');
    if (wrap && !wrap.contains(e.target)) {
      const dd = document.getElementById('npProfileDd');
      if (dd) dd.classList.remove('open');
    }
  }
  function npToggleDrawer() {
    const drawer  = document.getElementById('npDrawer');
    const overlay = document.getElementById('npOverlay');
    const isOpen  = drawer.classList.toggle('open');
    overlay.classList.toggle('open', isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }
</script>
