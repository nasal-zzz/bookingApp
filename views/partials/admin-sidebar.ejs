<%
var _active = locals.activePage || '';
var _isSA   = locals.isSuperAdmin || (locals.currentAdmin && locals.currentAdmin.role === 'superadmin');
function _isActive(page) { return _active === page ? ' active' : ''; }
%>
<style>
  .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;z-index:10;overflow-y:auto;scrollbar-width:none;-ms-overflow-style:none;}
  .sidebar::-webkit-scrollbar{display:none;}
  .s-logo{display:block;padding:0 0.5rem 1rem;border-bottom:1px solid var(--border);margin-bottom:0.5rem;text-decoration:none;}
  .s-badge{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:#9D4EDD;text-transform:uppercase;padding:0.3rem 0.5rem;margin-bottom:0.3rem;border:1px solid rgba(157,78,221,0.2);border-radius:4px;background:rgba(157,78,221,0.06);text-align:center;}
  .s-section{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.5rem 0.5rem 0.2rem;margin-top:0.3rem;}
  .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
  .s-link:hover,.s-link.active{background:rgba(106,13,173,0.08);border-color:rgba(106,13,173,0.2);color:#fff;}
  .s-link i{color:var(--accent, #6A0DAD);width:18px;}
  .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error, #FF4444);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
  .s-logout:hover{background:rgba(255,68,68,0.08);}
</style>
<aside class="sidebar">
  <a href="/admin" class="s-logo">
    <img src="/img/mee-logo.png" alt="MEE" style="height:28px;width:auto;object-fit:contain;"/>
  </a>

  <div class="s-section">Main</div>
  <a href="/admin"                 class="s-link<%- _isActive('dashboard') %>">        <i class="bi bi-speedometer2"></i>            Dashboard</a>
  <a href="/admin/bookings"        class="s-link<%- _isActive('bookings') %>">         <i class="bi bi-ticket-perforated-fill"></i>   Bookings</a>
  <a href="/admin/participants"    class="s-link<%- _isActive('participants') %>">      <i class="bi bi-person-badge-fill"></i>         Staff Activity</a>
  <a href="/admin/entered-tickets" class="s-link<%- _isActive('entered-tickets') %>">  <i class="bi bi-door-open-fill"></i>           Entered Tickets</a>
  <a href="/admin/users-by-event"  class="s-link<%- _isActive('users-by-event') %>">   <i class="bi bi-people-fill"></i>              Attendees</a>

  <div class="s-section">Events</div>
  <a href="/admin/events/new" class="s-link<%- _isActive('new-event') %>">  <i class="bi bi-plus-circle-fill"></i>  New Event</a>
  <a href="/admin/reviews"    class="s-link<%- _isActive('reviews') %>">    <i class="bi bi-star-fill"></i>         Reviews</a>
  <a href="/admin/banners"    class="s-link<%- _isActive('banners') %>">    <i class="bi bi-image-fill"></i>        Banners</a>
  <a href="/admin/coupons"    class="s-link<%- _isActive('coupons') %>">    <i class="bi bi-tag-fill"></i>          Coupons</a>

  <div class="s-section">Team</div>
  <a href="/admin/staff"   class="s-link<%- _isActive('staff') %>">   <i class="bi bi-people-fill"></i>   Staff</a>
  <a href="/admin/profile" class="s-link<%- _isActive('profile') %>"> <i class="bi bi-person-circle"></i> My Profile</a>
  <a href="/" class="s-link" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> View Site</a>

  <% if (_isSA) { %>
  <div class="s-section">Super</div>
  <a href="/superadmin" class="s-link" style="color:#9D4EDD;border-color:rgba(157,78,221,0.2);background:rgba(157,78,221,0.06);">
    <i class="bi bi-shield-lock-fill" style="color:#9D4EDD;"></i> SuperAdmin Panel
  </a>
  <% } %>

  <a href="/admin/logout" class="s-logout" style="margin-top:auto;">
    <i class="bi bi-box-arrow-right"></i> Logout
  </a>
</aside>
